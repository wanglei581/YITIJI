node_modules
# Keep environment variables out of version control
.env

/src/generated/prisma

# prisma/ 下的 SQLite 库一律是本地开发库或 verify 脚本的临时库,绝不入库。
# 此前只按文件名逐个忽略(dev.db / ci-test.db),verify 脚本用随机名建的临时库
# 不在名单里,被 git add -A 顺手提交(verify-advisor-bc0b76f7.db,743942db2)。
# 改成按扩展名整体忽略,新脚本不必再回来补名单。
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# BE-1 文件物理落盘目录,绝不入库
/storage/

# 历史泄漏兜底:storage.ts 早期版本因 FILE_STORAGE_DIR="" 落到 cwd,
# 这些 purpose 顶级目录绝不入库
/resume_upload/
/resume_scan/
/id_scan/
/print_doc/
/fair_material/
/cover_letter/
