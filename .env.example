# ============================================================
# AI求职打印服务终端 - 环境变量示例
# 复制本文件为 .env，填入真实值，不要提交 .env 到 Git
# ============================================================

# ------ 前端（VITE_ 前缀才会暴露给浏览器） ------
VITE_API_BASE_URL=http://localhost:3000

# ------ 对象存储后端（仅服务端读取，禁止加 VITE_ 前缀） ------
# 权威配置见 services/api/.env.example；此处为部署总览。
# 存储后端选择：local(开发) | cos(腾讯云 COS) | bos(百度智能云 BOS)
# 生产必须显式设为 cos 或 bos；当前目标为 bos，新上传全部写入百度 BOS。
FILE_STORAGE_DRIVER=bos
FILE_STORAGE_SIGN_URL_EXPIRES_SECONDS=1800

# 百度智能云 BOS（当前默认生产目标；私有桶）
BAIDU_BOS_ACCESS_KEY_ID=
BAIDU_BOS_SECRET_ACCESS_KEY=
BAIDU_BOS_BUCKET=
BAIDU_BOS_REGION=
BAIDU_BOS_ENDPOINT=
BAIDU_BOS_SIGN_URL_EXPIRES_SECONDS=1800

# 腾讯云 COS 历史读取配置。迁移完成前保留；新文件不会再写入 COS。
FILE_STORAGE_LEGACY_DRIVER=cos
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=
TENCENT_COS_SIGN_URL_EXPIRES_SECONDS=1800

# 本地开发回落本地 FS：将 FILE_STORAGE_DRIVER 改为 local，文件落 FILE_STORAGE_DIR（空则 cwd/storage）
# FILE_STORAGE_DRIVER=local
# FILE_STORAGE_DIR=

# ------ 奔图打印机（仅服务端，禁止加 VITE_ 前缀） ------
PANTUM_APP_KEY=
PANTUM_APP_SECRET=
PANTUM_CALLBACK_URL=

# ------ 数据库 ------
DATABASE_URL=postgresql://user:password@localhost:5432/ai_job_print

# ------ Redis ------
REDIS_URL=redis://localhost:6379

# ------ 后端服务 ------
NODE_ENV=development
PORT=3000
JWT_SECRET=
# 凭证加密密钥（AES-256-GCM，用于数据源 apiSecret/webhookSecret 落库加密）。
# secret-cipher.ts 缺失即抛错；生产须为高强度随机值。
SECRET_ENCRYPTION_KEY=
# 文件签名密钥（HMAC，用于打印/上传临时签名 URL）。signing.ts 缺失即抛错。
FILE_SIGNING_SECRET=
# 支付会话签名密钥（HMAC，用于打印订单出码/轮询短期 token）。生产必须独立配置且不少于 32 字符。
PAYMENT_SESSION_SECRET=

# ------ Windows Terminal Agent（本地配置，不提交） ------
TERMINAL_ID=
AGENT_API_BASE_URL=
AGENT_HEARTBEAT_INTERVAL_MS=30000
TERMINAL_ADMIN_SECRET=
TERMINAL_ACTION_TOKEN_SECRET=
