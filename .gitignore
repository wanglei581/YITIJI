# Codex temp
.codex-tmp/
.codegraph/

# Dependencies
node_modules
.pnpm-store

# Build output
dist
*.tsbuildinfo
apps/*/vite.config.js
apps/*/vite.config.d.ts

# Generated artifacts (manual exports / presentations)
outputs/

# One-off root-level design previews should live under docs/design/ instead.
/kiosk-home*.html

# Environment
.env
.env.local
.env.*.local
# 忽略所有 .env.* 环境文件（可能含密钥）；下方显式放行示例/模板
.env.*
!.env.example
!**/.env.example
!.env.template
!**/.env.template
# .env 备份文件不入库（可能含密钥）；保留 .env.example / .env.template 跟踪
.env.bak*
*.env.bak*
.env.*.bak
services/**/.env.bak-*

# Editor
.vscode
.idea
*.swp
*.swo

# WeChat DevTools local machine state (generated when importing the miniapp)
apps/miniapp/project.private.config.json

# OS
.DS_Store
Thumbs.db

# Archives（旧项目参考包，不入仓库）
*.zip

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Browser verification artifacts
.playwright-cli/
test-results/
playwright-report/
blob-report/
# Firefox profiles created by the protected Kiosk redesign screenshot scripts.
/docs/design/kiosk-redesign-2026-08/.ffprof-*/
/docs/design/kiosk-redesign-2026-08/assets/.ff*/

# Temp
.tmp
/tmp/
.cache/
mavis-workspace/
.mavis/
.opencode/

# Local collaboration/tool workspaces (keep locally, do not track)
# 注：.ccg/spec 是正式工程规范，保持跟踪，不在此列
/.ccg/commander/
/.ccg/tasks/
/.product-pm/
/.workbuddy/
/.superpowers/
/.worktrees/
/opc-doc/
/其他文档/

# Runtime-generated API state（含 ai-model-config.json 的 apiKeyEncrypted 等密钥材料，不入仓库）
services/api/data/
dump.rdb

# Terminal Agent local runtime config backups / production hardening snapshots
/apps/terminal-agent/config/agent-config.json.bak.*
/apps/terminal-agent/config/agent-config.json.before-*

# docs 下的二进制文档（如机器生成 / 外部 .docx）不入库，结论沉淀为同名 .md
docs/**/*.docx
services/api/prisma/ci-test.db
services/api/prisma/verify-print-outcome.db
services/api/src/generated/prisma-pg/

# deliverables 下的二进制成品（演示 PPT / PDF / DOCX）不入库，防止误提交撑大历史；文本类（.md / .html）仍可入库
/deliverables/**/*.pdf
/deliverables/**/*.pptx
/deliverables/**/*.docx

# ── 2026-09-06 资产体积治理（审计发现：722 MB 未跟踪证据无任何规则拦截；
#    docs/design/kiosk-redesign-2026-08 的 549 MB 截图就是这样进的历史）──────
# 这些目录是「一次性验收/对比证据」，按 .ccg/spec/guides §五「大批量截图、
# 一次性验收素材不得进入跟踪范围」。目录本身按产品负责人要求保留在磁盘上，
# 只是不再跟踪，不删除任何文件。
docs/design/kiosk-redesign-2026-08/kimi-full-coverage-v2/evidence/
# 例外：s24 的 13 个 fixtures 是被引用的测试夹具（specimen PDF/PNG），必须保留跟踪。
!docs/design/kiosk-redesign-2026-08/kimi-full-coverage-v2/evidence/*/fixtures/
!docs/design/kiosk-redesign-2026-08/kimi-full-coverage-v2/evidence/*/fixtures/**
docs/design/kiosk-redesign-2026-08/review-2026-08-23/
docs/design/compare-2026-08-23/
docs/design/_backup-*/
docs/design/.kiosk-redesign-backup-*.tar.gz
/.codex-video-build/

# 本地 worktree 与外部项目：原先只写在 .git/info/exclude（不入库，
# 换机器或新 clone 完全没有保护）。搬进来使其可移植。
/.claude/worktrees/
**/.claude/worktrees/
/_external/
