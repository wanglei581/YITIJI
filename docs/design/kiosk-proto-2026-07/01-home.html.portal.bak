<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>职易达AI求职操作系统 · 首页</title>
<link rel="stylesheet" href="shared.css">
<style>
/* 参考图精准还原 · 米纸大字Hero + AI接待卡 + 列表服务格 */
/* 英雄区 */
.welcome{flex:none;padding:24px 48px 20px;position:relative;overflow:hidden;}
.wave-bg{position:absolute;inset:0;pointer-events:none;}
.welcome-inner{position:relative;z-index:1;display:flex;align-items:flex-end;justify-content:space-between;gap:24px;}
.welcome-text{}
.welcome h1{font-family:var(--serif);font-size:54px;font-weight:900;letter-spacing:1px;line-height:1.18;color:var(--ink);}
.welcome h1 em{font-style:normal;color:var(--teal-deep);}
.welcome p{margin-top:10px;font-size:22px;color:var(--muted);letter-spacing:1px;}
.login-btn{flex:none;display:flex;align-items:center;gap:16px;min-height:88px;padding:0 36px;
  background:var(--dark);color:#f4f1e8;border:none;border-radius:var(--r-md);
  cursor:pointer;font-family:var(--sans);font-size:27px;font-weight:600;letter-spacing:1px;
  box-shadow:0 6px 18px rgba(16,48,43,.18);}
.login-btn:active{transform:scale(.98);}
.login-btn svg{width:34px;height:34px;}
.login-btn small{display:block;font-size:15px;font-weight:400;opacity:.62;margin-top:4px;text-align:left;}

/* AI接待区 双列 */
.reception{flex:none;padding:0 48px;display:grid;grid-template-columns:1fr auto;gap:16px;}
.ar-card{background:var(--surface);border:1px solid rgba(31,158,134,.28);border-radius:var(--r-md);
  padding:22px 28px 18px;box-shadow:0 4px 18px rgba(31,158,134,.08);position:relative;overflow:hidden;}
.ar-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,var(--teal),rgba(53,171,142,.5),transparent);}
.ar-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
.ar-badge{display:inline-flex;align-items:center;gap:7px;font-size:16px;color:var(--teal-deep);
  font-weight:600;background:var(--teal-soft);border:1px solid rgba(31,158,134,.28);
  padding:5px 14px;border-radius:999px;}
.ar-badge .dot{width:7px;height:7px;border-radius:50%;background:var(--teal);}
.ar-h{font-family:var(--serif);font-size:34px;font-weight:700;color:var(--ink);
  letter-spacing:1px;margin-bottom:16px;line-height:1.3;}
.ar-input-row{display:flex;gap:0;margin-bottom:14px;
  background:var(--paper);border:1px solid var(--line);border-radius:var(--r-sm);overflow:hidden;}
.ar-input{flex:1;min-height:76px;padding:0 22px;font-size:22px;font-family:var(--sans);
  color:var(--ink);background:transparent;border:none;outline:none;}
.ar-input::placeholder{color:#9ea8a2;}
.ar-mic{width:76px;flex:none;border:none;border-left:1px solid var(--line);
  background:var(--paper);display:grid;place-items:center;cursor:pointer;color:var(--teal);}
.ar-mic svg{width:30px;height:30px;}
.ar-cta{width:100%;min-height:80px;background:var(--dark);color:#f4f1e8;border:none;
  border-radius:var(--r-md);font-family:var(--serif);font-size:30px;font-weight:700;
  letter-spacing:2px;cursor:pointer;box-shadow:0 6px 20px rgba(16,48,43,.2);}
.ar-cta:active{transform:scale(.99);}
.ar-hint{font-size:16px;color:var(--muted);text-align:center;margin:9px 0 14px;}
.ar-chips{display:flex;gap:10px;flex-wrap:wrap;}
.ar-chip{min-height:56px;padding:0 20px;background:var(--paper);border:1px solid var(--line);
  border-radius:999px;font-family:var(--sans);font-size:20px;color:var(--ink);
  cursor:pointer;display:inline-flex;align-items:center;gap:8px;}
.ar-chip:active{background:var(--teal-soft);border-color:rgba(31,158,134,.3);}
.ar-chip svg{width:18px;height:18px;color:var(--teal);}
.ar-wave{display:flex;align-items:flex-end;gap:3px;margin-top:14px;height:24px;}
.ar-wave span{width:4px;border-radius:2px;background:var(--teal);opacity:.22;}

/* 右侧：本机办结能力 */
.device-card{width:312px;background:var(--surface);border:1px solid var(--line);
  border-radius:var(--r-md);padding:22px 24px;box-shadow:0 3px 10px rgba(16,48,43,.04);}
.device-card h3{font-family:var(--serif);font-size:26px;font-weight:700;color:var(--ink);}
.device-card .dc-sub{font-size:17px;color:var(--muted);margin-top:4px;margin-bottom:16px;}
.dc-items{display:flex;flex-direction:column;gap:10px;}
.dc-item{display:flex;align-items:center;justify-content:space-between;
  background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:13px 16px;}
.dc-left{display:flex;align-items:center;gap:12px;}
.dc-left svg{width:24px;height:24px;color:var(--teal-deep);}
.dc-left span{font-size:20px;color:var(--ink);font-weight:500;}
.dc-dot{width:10px;height:10px;border-radius:50%;background:#2db88a;
  box-shadow:0 0 0 3px rgba(45,184,138,.2);}
.dc-footer{margin-top:14px;display:flex;align-items:center;gap:7px;font-size:15px;color:var(--muted);}
.dc-footer svg{width:16px;height:16px;flex:none;}

/* AI调度分隔 */
.dispatch{flex:none;padding:12px 48px;display:flex;align-items:center;gap:14px;}
.d-line{flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(31,158,134,.25),transparent);}
.d-label{display:flex;align-items:center;gap:8px;font-size:16px;color:var(--teal-deep);
  font-weight:600;background:var(--teal-soft);border:1px solid rgba(31,158,134,.22);
  padding:5px 16px;border-radius:999px;white-space:nowrap;}
.d-label svg{width:14px;height:14px;}

/* 继续办理横幅 */
.continue-bar{flex:none;margin:0 48px;background:linear-gradient(90deg,rgba(31,158,134,.06),rgba(31,158,134,.03));
  border:1px solid rgba(31,158,134,.18);border-radius:var(--r-md);padding:18px 26px;
  display:flex;align-items:center;gap:20px;}
.cb-body{flex:1;}
.cb-body b{display:block;font-size:24px;font-weight:700;color:var(--ink);}
.cb-body span{display:block;font-size:17px;color:var(--muted);margin-top:4px;}
.cb-btn{min-height:64px;padding:0 28px;background:var(--surface);border:1px solid var(--line);
  border-radius:var(--r-md);font-family:var(--sans);font-size:22px;font-weight:600;
  color:var(--ink);cursor:pointer;display:flex;align-items:center;gap:10px;white-space:nowrap;}
.cb-btn svg{width:22px;height:22px;}

/* 核心服务 */
.svc-header{flex:none;padding:14px 48px 10px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
.svc-title{font-family:var(--serif);font-size:34px;font-weight:700;color:var(--ink);letter-spacing:1px;}
.svc-badge{display:inline-flex;align-items:center;gap:6px;font-size:16px;color:var(--teal-deep);
  font-weight:600;background:var(--teal-soft);border:1px solid rgba(31,158,134,.22);
  padding:4px 14px;border-radius:999px;}
.svc-badge svg{width:13px;height:13px;}
.svc-hint{font-size:18px;color:var(--muted);}

/* 服务磁贴 2列 */
.svc-grid{flex:none;padding:0 48px;display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.svc-tile{display:flex;align-items:center;gap:16px;min-height:112px;padding:16px 18px 14px;
  background:var(--surface);border:1px solid var(--line);
  border-left:5px solid var(--accent,var(--teal));border-radius:var(--r-md);
  cursor:pointer;text-align:left;font-family:var(--sans);color:var(--ink);
  transition:transform .08s;box-shadow:0 2px 8px rgba(16,48,43,.04);}
.svc-tile:active{transform:scale(.98);}
.st-icon{width:58px;height:58px;flex:none;border-radius:15px;display:grid;place-items:center;
  background:var(--accent-soft,var(--teal-soft));color:var(--accent-deep,var(--teal-deep));}
.st-icon svg{width:30px;height:30px;}
.st-body{flex:1;min-width:0;}
.st-body b{display:block;font-size:25px;font-weight:700;letter-spacing:.3px;}
.st-body .st-sub{display:block;font-size:17px;color:var(--muted);margin-top:4px;}
.ai-chip{display:inline-flex;align-items:center;gap:4px;font-size:14px;font-style:normal;
  font-weight:600;color:var(--teal-deep);background:var(--teal-soft);
  border:1px solid rgba(31,158,134,.2);padding:3px 9px;border-radius:999px;margin-top:6px;}
.ai-chip::before{content:"✦";font-size:10px;}
.st-arr{flex:none;width:22px;height:22px;color:var(--muted);opacity:.4;}

.notice{margin:10px 48px 0;}
.navbar{margin-top:10px;}
</style>
</head>
<body>
<div id="stage">

  <header class="topbar">
    <div class="brand"><b>职易达AI求职操作系统</b><span>AI求职打印服务终端</span></div>
    <div class="right">
      <span class="clock" id="clock">2026年7月28日 15:09</span>
      <span class="status-chip"><span class="dot"></span>打印机在线</span>
    </div>
  </header>

  <!-- 英雄区：大字标题 + 波浪背景 -->
  <div class="welcome">
    <div class="wave-bg">
      <svg preserveAspectRatio="none" viewBox="0 0 1080 168" xmlns="http://www.w3.org/2000/svg" style="position:absolute;inset:0;width:100%;height:100%">
        <path d="M0 75 C180 22,380 118,570 58 S840 85,1080 45 L1080 0 L0 0 Z" fill="rgba(31,158,134,.06)"/>
        <path d="M0 95 C210 42,440 125,660 68 S900 98,1080 60" fill="none" stroke="rgba(31,158,134,.2)" stroke-width="1.5"/>
        <path d="M0 115 C250 62,500 140,740 82 S960 115,1080 78" fill="none" stroke="rgba(31,158,134,.1)" stroke-width="1"/>
        <path d="M0 55 C160 15,360 88,540 40 S770 70,1080 30" fill="none" stroke="rgba(31,158,134,.08)" stroke-width="1.2"/>
        <circle cx="920" cy="28" r="3" fill="rgba(31,158,134,.22)"/>
        <circle cx="740" cy="50" r="2" fill="rgba(31,158,134,.16)"/>
        <circle cx="520" cy="20" r="2.5" fill="rgba(31,158,134,.2)"/>
        <circle cx="310" cy="68" r="2" fill="rgba(31,158,134,.14)"/>
      </svg>
    </div>
    <div class="welcome-inner">
      <div class="welcome-text">
        <h1>简历、岗位、打印，<em>一趟办完</em></h1>
        <p>现场准备材料、了解机会，并在本机完成打印扫描</p>
      </div>
      <button class="login-btn" onclick="location='15-login.html'">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/></svg>
        <span>登录 / 注册<small>同步本人文档与办理记录</small></span>
      </button>
    </div>
  </div>

  <!-- AI接待区 -->
  <div class="reception">
    <!-- 左：AI接待卡 -->
    <div class="ar-card">
      <div class="ar-top">
        <span class="ar-badge"><span class="dot"></span>AI接待台 · 等待目标</span>
      </div>
      <p class="ar-h">不知道从哪开始？说出你想办的事</p>
      <div class="ar-input-row">
        <input class="ar-input" placeholder="例如：我周五参加招聘会，需要准备简历并打印" readonly/>
        <button class="ar-mic">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0014 0M12 18v3"/></svg>
        </button>
      </div>
      <button class="ar-cta" onclick="location='13-assistant.html'">让小青安排</button>
      <p class="ar-hint">将进入 AI 顾问，由你确认办理方案</p>
      <div class="ar-chips">
        <button class="ar-chip" onclick="location='13-assistant.html'">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 3h8l4 4v14H7z"/><path d="M15 3v4h4M10 12l2 2 4-4"/></svg>
          优化简历并打印
        </button>
        <button class="ar-chip" onclick="location='13-assistant.html'">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-6.1-7-11a7 7 0 0114 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
          准备招聘会材料
        </button>
        <button class="ar-chip" onclick="location='02-print-hub.html'">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 9V3h12v6M6 18h-2a1 1 0 01-1-1v-6a1 1 0 011-1h16a1 1 0 011 1v6a1 1 0 01-1 1h-2M6 15h12v6H6z"/></svg>
          打印手机里的文件
        </button>
      </div>
      <div class="ar-wave">
        <span style="height:6px"></span><span style="height:14px"></span><span style="height:22px"></span><span style="height:12px"></span><span style="height:18px"></span><span style="height:8px"></span><span style="height:16px"></span><span style="height:10px"></span><span style="height:20px"></span><span style="height:14px"></span><span style="height:8px"></span><span style="height:18px"></span><span style="height:12px"></span><span style="height:6px"></span><span style="height:16px"></span><span style="height:10px"></span><span style="height:14px"></span><span style="height:20px"></span><span style="height:8px"></span><span style="height:16px"></span><span style="height:22px"></span><span style="height:7px"></span><span style="height:13px"></span><span style="height:18px"></span><span style="height:11px"></span>
      </div>
    </div>

    <!-- 右：本机办结能力 -->
    <div class="device-card">
      <h3>本机办结能力</h3>
      <p class="dc-sub">AI调用设备，现场完成</p>
      <div class="dc-items">
        <div class="dc-item">
          <div class="dc-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 9V3h12v6M6 18h-2a1 1 0 01-1-1v-6a1 1 0 011-1h16a1 1 0 011 1v6a1 1 0 01-1 1h-2M6 15h12v6H6z"/></svg>
            <span>文档打印就绪</span>
          </div>
          <span class="dc-dot"></span>
        </div>
        <div class="dc-item">
          <div class="dc-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8V5a2 2 0 012-2h3M16 3h3a2 2 0 012 2v3M21 16v3a2 2 0 01-2 2h-3M8 21H5a2 2 0 01-2-2v-3M3 12h18"/></svg>
            <span>材料扫描就绪</span>
          </div>
          <span class="dc-dot"></span>
        </div>
        <div class="dc-item">
          <div class="dc-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5a2 2 0 012-2h5v18H6a2 2 0 01-2-2zM11 3h7a2 2 0 012 2v14a2 2 0 01-2 2h-7"/></svg>
            <span>自动双面可用</span>
          </div>
          <span class="dc-dot"></span>
        </div>
      </div>
      <div class="dc-footer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
        设备状态实时检测
      </div>
    </div>
  </div>

  <!-- AI能力调度分隔 -->
  <div class="dispatch">
    <div class="d-line"></div>
    <span class="d-label">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l2.4 2.4L17 3l.6 2.8 2.8.6-1.4 2.6 1.4 2.6-2.8.6L17 15l-2.6-1.4L12 15l-2.4-1.4L7 15l-.6-2.8-2.8-.6 1.4-2.6L3.6 6.4l2.8-.6L7 3z"/></svg>
      AI能力调度
    </span>
    <div class="d-line"></div>
  </div>

  <!-- 继续办理横幅 -->
  <div class="continue-bar">
    <div class="cb-body">
      <b>继续办理</b>
      <span>登录后可查看并继续本人未完成事项</span>
    </div>
    <button class="cb-btn" onclick="location='15-login.html'">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/></svg>
      登录后查看
    </button>
  </div>

  <!-- 核心服务 -->
  <div class="svc-header">
    <span class="svc-title">核心服务</span>
    <span class="svc-badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l2.4 2.4L17 3l.6 2.8 2.8.6-1.4 2.6 1.4 2.6-2.8.6L17 15l-2.6-1.4L12 15l-2.4-1.4L7 15l-.6-2.8-2.8-.6 1.4-2.6L3.6 6.4l2.8-.6L7 3z"/></svg>
      AI增强服务
    </span>
    <span class="svc-hint">知道要办什么，也可以直接进入</span>
  </div>

  <div class="svc-grid">
    <button class="svc-tile a-slate" onclick="location='02-print-hub.html'">
      <span class="st-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 9V3h12v6M6 18h-2a1 1 0 01-1-1v-6a1 1 0 011-1h16a1 1 0 011 1v6a1 1 0 01-1 1h-2M6 15h12v6H6z"/></svg></span>
      <span class="st-body"><b>打印扫描</b><span class="st-sub">上传、扫描与本机出纸</span><em class="ai-chip">AI文件预检</em></span>
      <svg class="st-arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
    </button>
    <button class="svc-tile a-teal" onclick="location='05-resume-source.html'">
      <span class="st-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 3h8l4 4v14H7z"/><path d="M15 3v4h4M10 12l2 2 4-4"/></svg></span>
      <span class="st-body"><b>AI简历服务</b><span class="st-sub">诊断、优化、生成与打印</span><em class="ai-chip">AI诊断优化</em></span>
      <svg class="st-arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
    </button>
    <button class="svc-tile a-clay" onclick="location='08-jobs-list.html'">
      <span class="st-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"/></svg></span>
      <span class="st-body"><b>岗位信息</b><span class="st-sub">查看第三方来源岗位</span><em class="ai-chip">AI岗位研判</em></span>
      <svg class="st-arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
    </button>
    <button class="svc-tile a-wheat" onclick="location='10-fairs-list.html'">
      <span class="st-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-6.1-7-11a7 7 0 0114 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
      <span class="st-body"><b>招聘会</b><span class="st-sub">场次、企业与现场导览</span><em class="ai-chip">AI材料清单</em></span>
      <svg class="st-arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
    </button>
    <button class="svc-tile a-plum" onclick="location='38-interview-setup.html'">
      <span class="st-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0014 0M12 18v3"/></svg></span>
      <span class="st-body"><b>AI面试训练</b><span class="st-sub">模拟问答与训练报告</span><em class="ai-chip">AI模拟反馈</em></span>
      <svg class="st-arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
    </button>
    <button class="svc-tile a-wheat" onclick="location='12-policy.html'">
      <span class="st-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 4h14v16l-3.5-2-3.5 2-3.5-2L5 20z"/><path d="M9 9h6M9 13h4"/></svg></span>
      <span class="st-body"><b>政策服务</b><span class="st-sub">政策查询与材料指引</span><em class="ai-chip">AI来源解读</em></span>
      <svg class="st-arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
    </button>
