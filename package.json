{
  "name": "ai-job-print-terminal",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.13 <23",
    "pnpm": ">=11.2.2 <12"
  },
  "scripts": {
    "dev": "concurrently --names kiosk,admin,partner --prefix-colors blue,green,yellow \"pnpm --filter ./apps/kiosk dev\" \"pnpm --filter ./apps/admin dev\" \"pnpm --filter ./apps/partner dev\"",
    "dev:kiosk": "pnpm --filter ./apps/kiosk dev",
    "dev:admin": "pnpm --filter ./apps/admin dev",
    "dev:partner": "pnpm --filter ./apps/partner dev",
    "build:kiosk:production": "pnpm --filter @ai-job-print/kiosk build && pnpm --filter @ai-job-print/kiosk verify:prod-build-config",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:refresh": "pnpm --filter @ai-job-print/refresh typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .prettierignore",
    "clean": "rimraf \"apps/*/dist\" \"packages/*/dist\" \"apps/*/vite.config.js\" \"apps/*/vite.config.d.ts\" \"apps/*/tsconfig.tsbuildinfo\"",
    "graph": "node scripts/generate-project-graph.mjs",
    "graph:check": "node scripts/generate-project-graph.mjs --check",
    "graph:query": "node scripts/project-graph-query.mjs",
    "verify:ci-gate-coverage": "node scripts/verify-ci-gate-coverage.mjs",
    "verify:fixture-time-bombs": "node scripts/verify-fixture-time-bombs.mjs",
    "verify:repository-integrity": "node scripts/verify-repository-integrity.mjs",
    "verify:deploy-authorization-gate": "node scripts/verify-deploy-authorization-gate.mjs",
    "verify:dependency-security": "node scripts/verify-dependency-security.mjs",
    "verify:compliance-copy": "node scripts/verify-compliance-copy.mjs && pnpm run verify:datetime-honesty && pnpm run verify:list-truncation-honesty",
    "verify:datetime-honesty": "node --experimental-strip-types scripts/verify-datetime-honesty.mjs",
    "verify:list-truncation-honesty": "node scripts/verify-list-truncation-honesty.mjs",
    "verify:mock-server-contract": "node scripts/verify-mock-server-contract.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0"
  }
}
