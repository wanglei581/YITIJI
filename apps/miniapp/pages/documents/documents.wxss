/* pages/documents/documents.wxss */

/* 列表标题行 + 刷新：承接原导航栏右上角的「刷新」。
   导航栏右侧被微信胶囊常驻遮挡，不可放操作。触控区 96rpx = 48px（CLAUDE.md §9）。 */
.list-toolbar {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx; padding-right: 32rpx; padding-bottom: 8rpx;
}
.lt-title { flex: 1; padding-bottom: 0; }
.lt-action {
  flex-shrink: 0;
  min-width: 132rpx; height: 96rpx; padding: 0 28rpx;
  display: inline-flex; align-items: center; justify-content: center;
  border-radius: 22rpx; border: 1rpx solid var(--line);
  background: var(--surface); color: var(--ink-soft);
  font-size: 27rpx; font-weight: 600;
}

.doc-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-faint);
}
.doc-item:last-child { border-bottom: none; }

.doc-ic {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--r);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #fff;
}
.doc-ic.ic-pdf  { background: #d9534f; }
.doc-ic.ic-img  { background: #3fa46a; }
.doc-ic.ic-doc  { background: #3f68b0; }
.doc-ic.ic-scan { background: #a9781f; }
.doc-ic.ic-ai   { background: var(--plum-deep); }

.doc-body { flex: 1; min-width: 0; }
.doc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.doc-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 23rpx;
  color: var(--muted);
  flex-wrap: wrap;
}
.doc-dot { color: var(--faint); }
.doc-exp {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: var(--r-full);
  background: var(--clay-wash);
  color: var(--clay-deep);
  font-size: 21rpx;
  font-weight: 600;
}
.doc-more {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--faint);
}

.empty-slot {
  padding: 60rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.es-ic { font-size: 88rpx; color: var(--faint); margin-bottom: 20rpx; }
.es-t { font-size: 30rpx; font-weight: 600; color: var(--ink-soft); }
.es-d { margin-top: 8rpx; font-size: 24rpx; color: var(--muted); }
