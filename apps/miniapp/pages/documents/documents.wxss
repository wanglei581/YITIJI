/* pages/documents/documents.wxss  我的文档（墨翠鎏金白瓷） */

.list-toolbar {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx; padding-right: 32rpx; padding-bottom: 8rpx;
}
.lt-title { flex: 1; padding-bottom: 0; }
.lt-action {
  flex-shrink: 0;
  min-width: 132rpx; height: 96rpx; padding: 0 28rpx;
  display: inline-flex; align-items: center; justify-content: center;
  border-radius: var(--r-full); border: 1rpx solid var(--line);
  background: var(--surface); color: var(--teal-deep);
  box-shadow: var(--sh-xs);
  font-size: var(--fs-base); font-weight: 650;
}

.doc-item {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--line-faint);
}
.doc-item:last-child { border-bottom: none; }
.doc-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.doc-ic {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #fff;
}
.doc-ic.ic-long { font-size: var(--fs-xs); letter-spacing: 0; }
.doc-ic.ic-pdf  { background: #d9534f; }
.doc-ic.ic-img  { background: #0f7a5a; }
.doc-ic.ic-doc  { background: #2e538e; }
.doc-ic.ic-scan { background: #a9781f; }
.doc-ic.ic-ai   { background: var(--plum-deep); }

.doc-body { flex: 1; min-width: 0; }
.doc-name {
  font-size: var(--fs-md);
  font-weight: 650;
  color: var(--ink);
  line-height: 1.4;
  overflow-wrap: break-word;
  word-break: normal;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.doc-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--fs-sm);
  color: var(--muted);
  flex-wrap: wrap;
}
.doc-dot { color: var(--faint); }
.doc-exp {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: var(--r-full);
  background: var(--clay-wash);
  color: var(--clay-deep);
  font-size: var(--fs-xs);
  font-weight: 600;
}
/* 保持 FLOW1a 断言：⋯ 真实点击盒 96rpx 见方 */
.doc-more {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  margin: -12rpx -24rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-xl);
  color: var(--faint);
}

.empty-slot {
  padding: 60rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.es-ic { font-size: var(--fs-2xl); color: var(--faint); margin-bottom: 20rpx; }
.es-t { font-size: var(--fs-md); font-weight: 700; color: var(--ink-soft); }
.es-d { margin-top: 8rpx; font-size: var(--fs-sm); color: var(--muted); }

.doc-retention { margin-top: 6rpx; font-size: var(--fs-xs); color: var(--muted); line-height: 1.5; }
.load-hint { padding: 24rpx 0 8rpx; text-align: center; font-size: var(--fs-xs); color: var(--faint); }

.doc-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}
/* 保持 FLOW1a 断言：底行离 ⋯ 至少 20rpx */
.doc-item .doc-actions { justify-content: flex-end; margin-top: 20rpx; }
.doc-action {
  position: relative;
  flex-shrink: 0;
  min-width: 112rpx;
  min-height: 60rpx;
  padding: 0 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
  border: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--ink-soft);
  font-size: var(--fs-sm);
  font-weight: 650;
}
/* 保持 FLOW1a 断言：上下各扩 18rpx 触控区 */
.doc-action::after {
  content: '';
  position: absolute;
  left: -8rpx;
  right: -8rpx;
  top: -18rpx;
  bottom: -18rpx;
}
.doc-action.primary {
  border-color: rgba(223, 198, 147, .36);
  background: linear-gradient(135deg, #16483E 0%, #0A2720 100%);
  color: var(--gold-bright);
}
.doc-action.is-disabled {
  color: var(--ghost);
  background: var(--surface-2);
}
.doc-hint {
  margin-top: 8rpx;
  font-size: var(--fs-xs);
  color: var(--faint);
  line-height: 1.5;
}
.convert-result {
  margin: 0 32rpx 16rpx;
  padding: 24rpx;
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line-soft);
  background: var(--surface);
  box-shadow: var(--sh-sm);
}
.convert-result-title {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--ink);
  word-break: break-all;
}
.convert-result-meta {
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  color: var(--muted);
  line-height: 1.5;
}
