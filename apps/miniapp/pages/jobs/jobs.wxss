/* pages/jobs/jobs.wxss — Direction B: 奶油质感 */

.page-wrap { min-height: 100vh; background: #FAF7F2; }

.page-hd { padding: 14rpx 32rpx 10rpx; }
.page-title { font-size: 48rpx; font-weight: 900; color: #2C1A0E; letter-spacing: -1rpx; }

/* 搜索栏 */
.search-bar {
  margin: 8rpx 32rpx 16rpx;
  background: #F2EAE0; border-radius: 200rpx;
  padding: 20rpx 28rpx;
  display: flex; align-items: center; gap: 14rpx;
}
.sb-ic { font-size: 30rpx; color: #A89080; }
.sb-ph { font-size: 28rpx; color: #C8B4A0; }
.sb-input { flex: 1; min-width: 0; font-size: 28rpx; color: #2C1A0E; }

/* 筛选条 */
.filter-scroll { width: 100%; }
.filter-row {
  display: flex; flex-direction: row;
  padding: 4rpx 24rpx 20rpx; gap: 12rpx; white-space: nowrap;
}
.f-chip {
  display: inline-block; flex-shrink: 0;
  background: #F2EAE0; color: #7A5C48;
  font-size: 26rpx; font-weight: 500;
  padding: 12rpx 28rpx; border-radius: 200rpx;
}
.f-on {
  background: #2C1A0E; color: #FFFDF9;
  font-weight: 700;
}

/* 加载状态 */
.list-state {
  display: flex; justify-content: center; gap: 12rpx;
  padding: 60rpx 0;
}
.ls-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #C8B4A0;
}

/* 岗位卡 */
.job-list { padding: 0 32rpx; display: flex; flex-direction: column; gap: 20rpx; }
.job-card {
  background: #FFFDF9;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(44,26,14,.07);
}
.jc-top {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 8rpx;
}
.jc-title { font-size: 32rpx; font-weight: 800; color: #2C1A0E; flex: 1; line-height: 1.3; }
.jc-salary { font-size: 30rpx; font-weight: 900; color: #C84B2F; flex-shrink: 0; margin-left: 12rpx; }
.jc-company { font-size: 24rpx; color: #7A5C48; display: block; margin-bottom: 14rpx; }
.jc-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 16rpx; }
.j-tag {
  background: #F2EAE0; color: #4A3020;
  font-size: 22rpx; font-weight: 500;
  padding: 6rpx 16rpx; border-radius: 200rpx;
}
.jc-footer {
  display: flex; justify-content: space-between; align-items: center;
  padding-top: 16rpx; border-top: 1rpx solid #F0E8DC;
}
.jc-source { font-size: 22rpx; color: #A89080; flex: 1; }
.jc-cta {
  background: #F2EAE0; color: #2C1A0E;
  font-size: 22rpx; font-weight: 700;
  padding: 10rpx 22rpx; border-radius: 200rpx;
  flex-shrink: 0;
}
.act-press { opacity: .7; }

/* 空态/错误态 */
.empty-wrap {
  margin: 40rpx 32rpx;
  background: #FFFDF9;
  border-radius: 28rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  border: 1rpx solid #E5D8C8;
}
.ev-icon { font-size: 72rpx; display: block; margin-bottom: 20rpx; }
.ev-title { font-size: 32rpx; font-weight: 800; color: #2C1A0E; margin-bottom: 12rpx; }
.ev-desc { font-size: 26rpx; color: #A89080; line-height: 1.6; margin-bottom: 32rpx; display: block; }
.btn-retry {
  display: inline-block; background: #2C1A0E; color: #fff;
  font-size: 28rpx; font-weight: 600; padding: 18rpx 48rpx; border-radius: 200rpx;
}

/* 合规声明 */
.compliance-note {
  margin: 24rpx 32rpx 0;
  font-size: 22rpx; color: #C8B4A0; line-height: 1.7;
}

.tap { transition: opacity 80ms; }
.tap-press { opacity: .7; }
