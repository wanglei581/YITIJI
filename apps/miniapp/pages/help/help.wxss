/* pages/help/help.wxss */
.help-search {
  display: flex;
  align-items: center;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-full);
  padding: 0 28rpx;
  height: 80rpx;
  box-shadow: var(--sh-xs);
}
.hs-ic {
  font-size: 32rpx;
  color: var(--muted);
  margin-right: 16rpx;
}
.hs-ph {
  font-size: 28rpx;
  color: var(--faint);
}

.hot-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 8rpx;
}
.hot-cell {
  border-radius: var(--r-lg);
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
}
.hot-cell.c-teal  { background: var(--teal-wash);  color: var(--teal-deep); }
.hot-cell.c-plum  { background: var(--plum-wash);  color: var(--plum-deep); }
.hot-cell.c-clay  { background: var(--clay-wash);  color: var(--clay-deep); }
.hot-cell.c-wheat { background: var(--wheat-wash); color: var(--wheat-deep); }

.faq-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line-faint);
}
.faq-item:last-child { border-bottom: none; }
.faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.fq-t {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
  padding-right: 16rpx;
}
.faq-arrow {
  font-size: 34rpx;
  color: var(--faint);
  line-height: 1;
  transform: rotate(0deg);
  transition: transform .2s ease;
}
.faq-arrow.open { transform: rotate(90deg); }
.faq-a {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.75;
  color: var(--ink-soft);
}
