.page-wrap { min-height: 100vh; background: var(--paper); }
.file-card { display: flex; align-items: center; gap: 24rpx; }
.fc-main { flex: 1; min-width: 0; }
.fc-preview { flex-shrink: 0; font-size: 24rpx; font-weight: 600; color: var(--teal-deep); }
.fc-ic { width: 88rpx; height: 88rpx; border-radius: var(--r-md); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.fc-ic .ficon { width: 44rpx; height: 44rpx; }
.fc-name { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.fc-meta { font-size: 24rpx; color: var(--ink-soft); margin-top: 6rpx; }

.ai-card { margin-top: 20rpx; padding: 24rpx 28rpx; border-radius: var(--r-lg); background: var(--teal-wash); border: 1rpx solid var(--teal-soft); }
.ai-head { display: flex; align-items: center; gap: 10rpx; font-size: 26rpx; font-weight: 600; color: var(--teal-deep); }
.ai-head .ficon { width: 32rpx; height: 32rpx; }
.ai-body { margin-top: 12rpx; font-size: 25rpx; line-height: 1.6; color: var(--muted); }

.opt-list { display: flex; flex-direction: column; gap: 16rpx; }
.opt { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 28rpx; background: var(--surface); border-radius: var(--r-lg); border: 2rpx solid transparent; box-shadow: var(--sh-sm); }
.opt.on { border-color: var(--teal); background: var(--teal-wash); }
.opt.off, .duplex-opt.off { opacity: .58; }
.o-radio { width: 40rpx; height: 40rpx; border-radius: 50%; border: 2rpx solid var(--line); display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; flex-shrink: 0; }
.opt.on .o-radio { background: var(--teal); border-color: var(--teal); }
.o-main { flex: 1; }
.o-title { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.o-sub { font-size: 23rpx; color: var(--ink-soft); margin-top: 4rpx; }
.o-price { font-size: 26rpx; font-weight: 600; color: var(--clay-deep); }

.paper-row { display: flex; align-items: center; justify-content: space-between; }
.paper-badge { font-size: 23rpx; color: var(--teal-deep); background: var(--teal-wash); padding: 8rpx 18rpx; border-radius: 999rpx; }

.duplex-row { display: flex; gap: 16rpx; }
.duplex-opt { flex: 1; text-align: center; padding: 26rpx 0; background: var(--surface); border-radius: var(--r-lg); border: 2rpx solid transparent; font-size: 27rpx; color: var(--muted); box-shadow: var(--sh-sm); }
.duplex-opt.on { border-color: var(--teal); background: var(--teal-wash); color: var(--teal-deep); font-weight: 600; }

.stepper-row { display: flex; align-items: center; justify-content: space-between; }
.stepper { display: flex; align-items: center; gap: 8rpx; }
.s-btn { width: 64rpx; height: 64rpx; border-radius: var(--r-sm); background: var(--paper); display: flex; align-items: center; justify-content: center; font-size: 40rpx; color: var(--ink); }
.s-btn.off { color: var(--line); }
.s-val { min-width: 72rpx; text-align: center; font-size: 30rpx; font-weight: 600; color: var(--ink); }

.ab-label { font-size: 22rpx; color: var(--ink-soft); display: block; }
.ab-amt { font-size: 40rpx; font-weight: 700; color: var(--clay-deep); font-family: var(--font-serif); }

/* 纸张规格行主内容区 */
.pr-main { flex: 1; }
.privacy-check { display: flex; flex-direction: column; gap: 18rpx; }
.pc-state, .pc-note { font-size: 24rpx; line-height: 1.6; color: var(--ink-soft); }
.pc-title { font-size: 27rpx; font-weight: 600; color: var(--ink); }
.pc-error { color: var(--danger); font-size: 24rpx; }
.pc-ready { color: var(--teal-deep); font-size: 25rpx; font-weight: 600; }
.pc-finding { padding: 16rpx; background: var(--paper); border-radius: var(--r-sm); display: flex; flex-direction: column; gap: 8rpx; font-size: 24rpx; }
.pc-snippet { color: var(--ink-soft); word-break: break-all; }
.quote-error { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 24rpx; border-radius: var(--r-lg); background: #fff6ec; border: 1rpx solid #f0d6b4; }
.qe-main { flex: 1; min-width: 0; }
.qe-title { color: var(--clay-deep); font-size: 25rpx; font-weight: 600; }
.qe-text { margin-top: 6rpx; color: var(--ink-soft); font-size: 22rpx; line-height: 1.5; }
