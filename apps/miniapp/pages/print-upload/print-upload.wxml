<view class="page-wrap">
<view class="navbar col">
  <view style="height:{{statusBarHeight}}px"></view>
  <view class="nav-inner">
    <view class="nav-back tap" hover-class="tap-press" bindtap="back" aria-role="button" aria-label="返回"><text class="ficon i-right nav-back-ic"></text></view>
    <view class="nav-title">确认文件</view>
    <view class="nav-right"></view>
  </view>
</view>

<view class="content has-bar">
  <!-- 步骤条文案与 print-store / print-pay 保持同一套，避免同一笔订单在相邻两页读到不同流程。
       第 2 步在终端选定后统一设置颜色、单双面、份数；第 3 步还在手机上确认提交，到机核验是第 4 步的事（FLOW1a）。 -->
  <view class="steps rise-d1">
    <view class="st on"><text class="n">1</text><text class="nl">选择文件</text></view>
    <view class="line"></view>
    <view class="st"><text class="n">2</text><text class="nl">终端和参数</text></view>
    <view class="line"></view>
    <view class="st"><text class="n">3</text><text class="nl">确认提交</text></view>
    <view class="line"></view>
    <view class="st"><text class="n">4</text><text class="nl">{{priceStatus === 'ready' && amountCents > 0 ? '机端支付' : (priceStatus === 'ready' ? '现场打印' : '到机完成')}}</text></view>
  </view>

  <!-- 文件：标题只放主名，扩展名在 fc-tag 里，「.pdf」不会被拆到下一行。点整卡或「查看原文」直接打开原文。 -->
  <view class="card file-card rise-d2 tap" hover-class="tap-press" bindtap="tapFile">
    <view class="fc-ic a-teal"><text class="ficon i-file-text"></text></view>
    <view class="fc-main">
      <view class="fc-name">{{fileBase}}</view>
      <view class="fc-meta">
        <text wx:if="{{hasFile}}" class="fc-tag">{{fileExt}}</text>
        <text class="fc-sub">{{hasFile ? (hasPageCount ? '服务端核定 ' + file.pages + ' 页' : (priceStatus === 'loading' ? '正在由服务端识别页数…' : '页数待服务端核定')) : '从本人文档或真实 AI 成果选择'}}</text>
      </view>
    </view>
    <view class="fc-go"><text>{{hasFile ? '查看原文' : '选择文件'}}</text><text class="ficon i-right"></text></view>
  </view>

  <!-- 颜色、单双面、份数都挪到第 2 步，选定终端、知道它开放什么之后统一设置（FLOW1a）。
       这里只留页数核定失败时的说明和重试；核定中、已核定都写在上面文件卡里，不再另起一块明细。 -->
  <view wx:if="{{hasFile && priceStatus === 'unavailable'}}" class="card flat bill rise-d3">
    <view class="bl-fail">
      <view class="bl-fail-t"><text class="ficon i-warning"></text><text>暂时无法核定页数</text></view>
      <view class="bl-fail-s">{{priceError || '服务端暂时无法核定页数'}}</view>
      <view class="btn ghost bl-retry" bindtap="retryQuote">重新核定</view>
    </view>
  </view>

  <!-- 隐私检查 -->
  <view class="section-t rise-d5">打印隐私检查</view>
  <view class="card flat privacy-check rise-d5">
    <view wx:if="{{privacyStatus === 'scanning'}}" class="pc-state">正在检查文件中的手机号、证件号等敏感片段…</view>
    <view wx:elif="{{privacyStatus === 'error'}}" class="pc-block">
      <view class="pc-error">{{privacyError}}</view>
      <view class="btn ghost pc-btn" bindtap="retryPrivacy">重新检查</view>
    </view>
    <view wx:elif="{{privacyStatus === 'review'}}" class="pc-block">
      <view class="pc-title">发现 {{privacyFindings.length}} 处可能的敏感信息</view>
      <view wx:for="{{privacyFindings}}" wx:key="id" class="pc-finding">
        <text>{{item.label}}{{item.pageNumber ? ' · 第' + item.pageNumber + '页' : ''}}</text>
        <text class="pc-snippet">{{item.snippet || '未返回原文片段'}}</text>
      </view>
      <view class="pc-note">继续表示你确认这些内容属于本次打印文件，并选择原样保留。</view>
      <view class="btn primary pc-btn" bindtap="confirmPrivacy">{{privacySubmitting ? '确认中…' : '确认保留并继续'}}</view>
    </view>
    <!-- 提交在第 3 步，这里不说「可以提交打印订单」 -->
    <view wx:elif="{{privacyStatus === 'ready'}}" class="pc-ready"><text class="ficon i-check"></text><text>隐私检查已完成</text></view>
    <view wx:else class="pc-state">选择文件后开始检查</view>
  </view>
</view>

<view class="actionbar">
  <view class="ab-price">
    <!-- 第 1 步只按 1 份黑白单面核定，付费时不能叫这一单的「精确报价」；最终金额在第 2、3 步按所选参数核定 -->
    <text class="ab-label">{{priceStatus === 'ready' && amountCents > 0 ? '1 份黑白参考价' : (priceStatus === 'ready' ? '免费试运营' : (priceStatus === 'loading' ? '正在核定页数' : (hasFile ? '页数待核定' : '')))}}</text>
    <text wx:if="{{priceStatus === 'ready'}}" class="ab-amt">{{priceStatus === 'ready' && amountCents > 0 ? '¥' + total : '免费'}}</text>
    <text wx:elif="{{hasFile}}" class="ab-amt pending">—</text>
  </view>
  <view class="btn primary lg {{priceStatus !== 'ready' || !hasFile || privacyStatus !== 'ready' ? 'disabled' : ''}}" bindtap="toStore">{{!hasFile ? '请先选择文件' : (privacyStatus !== 'ready' ? '请完成隐私检查' : '选终端和参数')}}</view>
</view>
</view>
