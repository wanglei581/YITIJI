<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="nav-back tap" bindtap="goBack"><text class="ficon i-right nav-back-ic"></text></view>
    <view class="nav-title">参会企业</view>
  </view>

  <view class="content">
    <view wx:if="{{loading}}" class="list-state">加载中…</view>
    <view wx:elif="{{loadError}}" class="list-state">{{loadError}}</view>
    <view wx:else class="list-state">该页面正在接入中，暂未开放。</view>
  </view>
</view>
