.page-wrap { min-height: 100vh; background: var(--paper); }
.sb-tint { background: var(--wheat-deep); }
.navbar.tinted { background: var(--wheat-deep); border-bottom: none; }
.nav-back-ic.light { color: rgba(255,255,255,.9); }
.nav-title.light { color: #fff; }

.fair-hero { background: linear-gradient(150deg,#8a6018,#a9781f); padding: 40rpx 40rpx 52rpx;
  position: relative; overflow: hidden; }
.fair-hero::before { content:''; position: absolute; right: -60rpx; top: -40rpx;
  width: 280rpx; height: 280rpx; border-radius: 50%; background: rgba(255,255,255,.07); }
.fh-title { font-family: var(--font-serif); font-size: 46rpx; font-weight: 700; color: #fff; position: relative; }
.fh-sub { font-size: 25rpx; color: rgba(255,255,255,.72); margin-top: 12rpx; position: relative; }

.fair-list-card { background: var(--surface); border-radius: 24rpx; margin: 0 32rpx 24rpx;
  box-shadow: var(--sh-sm); overflow: hidden; }
.flc-banner { height: 192rpx; background: linear-gradient(135deg,var(--wheat-soft),var(--wheat-wash));
  display: flex; align-items: center; justify-content: center; font-size: 76rpx; position: relative; }
.flc-live { position: absolute; top: 20rpx; left: 20rpx; display: inline-flex; align-items: center;
  gap: 8rpx; height: 44rpx; padding: 0 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.9);
  font-size: 22rpx; font-weight: 600; color: var(--teal-deep); }
.flc-live .d { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--teal); }
.flc-body { padding: 28rpx 32rpx; }
.flc-title { font-family: var(--font-serif); font-size: 32rpx; font-weight: 600; color: var(--ink); line-height: 1.4; }
.flc-meta { font-size: 24rpx; color: var(--muted); margin-top: 16rpx; display: flex; flex-direction: column; gap: 10rpx; }
.flc-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx;
  padding-top: 24rpx; border-top: 1rpx solid var(--line-faint); }
.flc-source { font-size: 22rpx; color: var(--faint); }

/* 招聘会卡片 meta 行 */
.m { font-size: 24rpx; color: var(--muted); line-height: 1.5; }
