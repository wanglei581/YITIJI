.page-wrap { min-height: 100vh; background: var(--paper); }
.fair-content { padding-top: 8rpx; }
.fair-hero { min-height: 214rpx; margin: 0 32rpx; padding: 30rpx; border-radius: 32rpx; border: 1rpx solid #dce9ff; background: #eef5ff; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.fh-copy { flex: 1; min-width: 0; }
.fh-kicker { font-size: 21rpx; font-weight: 650; color: var(--teal-deep); }
.fh-title { margin-top: 9rpx; font-size: 38rpx; font-weight: 780; color: var(--ink); line-height: 1.25; }
.fh-sub { margin-top: 9rpx; max-width: 470rpx; font-size: 22rpx; color: var(--muted); line-height: 1.55; }
.fh-icon { width: 96rpx; height: 96rpx; border-radius: 30rpx; background: var(--teal); color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 28rpx rgba(22,119,255,.18); }
.fh-icon .ficon { width: 47rpx; height: 47rpx; }
.filter-bar { padding-top: 24rpx; padding-bottom: 20rpx; }

.fair-list-card { min-height: 184rpx; margin: 0 32rpx 16rpx; padding: 24rpx; border-radius: 28rpx; background: var(--surface); border: 1rpx solid var(--line-soft); display: flex; align-items: flex-start; gap: 20rpx; }
.flc-icon { width: 78rpx; height: 78rpx; border-radius: 24rpx; background: var(--teal-soft); color: var(--teal); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.flc-icon .ficon { width: 38rpx; height: 38rpx; }
.flc-body { flex: 1; min-width: 0; }
.flc-head { display: flex; align-items: flex-start; gap: 12rpx; }
.flc-title { flex: 1; min-width: 0; font-size: 29rpx; font-weight: 700; color: var(--ink); line-height: 1.45; }
.flc-meta { margin-top: 13rpx; display: flex; flex-direction: column; gap: 7rpx; }
.m { font-size: 23rpx; color: var(--muted); line-height: 1.5; }
.flc-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 17rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line-faint); }
.flc-source, .flc-sync { font-size: 20rpx; color: var(--faint); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.flc-source { flex: 1; }
.flc-sync { flex-shrink: 0; }
.flc-arrow { width: 22rpx; height: 22rpx; color: var(--ghost); align-self: center; }
.flc-bell { width: 34rpx; height: 34rpx; color: var(--teal); flex-shrink: 0; display: flex; align-items: center; }
.flc-bell .ficon { width: 28rpx; height: 28rpx; }

.state-card { margin: 0 32rpx; padding: 58rpx 40rpx; border-radius: 30rpx; background: var(--surface); border: 1rpx solid var(--line-soft); display: flex; flex-direction: column; align-items: center; text-align: center; }
.state-icon { width: 92rpx; height: 92rpx; border-radius: 28rpx; background: var(--teal-soft); color: var(--teal); display: flex; align-items: center; justify-content: center; }
.state-icon.warn { background: var(--warn-soft); color: var(--warn); }
.state-icon .ficon { width: 43rpx; height: 43rpx; }
.state-title { margin-top: 20rpx; font-size: 30rpx; font-weight: 720; color: var(--ink); }
.state-desc { margin-top: 8rpx; font-size: 23rpx; color: var(--muted); line-height: 1.6; }
