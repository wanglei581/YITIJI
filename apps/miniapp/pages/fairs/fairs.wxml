<view class="page-wrap">
  <view class="navbar col">
    <view style="height:{{statusBarHeight}}px"></view>
    <view class="nav-inner">
      <view class="nav-back tap" hover-class="tap-press" bindtap="back"><text class="ficon i-right nav-back-ic"></text></view>
      <view class="nav-title">招聘会</view>
      <view class="nav-right"></view>
    </view>
  </view>

  <view class="content fair-content">
    <view class="fair-hero">
      <view class="fh-copy">
        <view class="fh-kicker">公开活动信息</view>
        <view class="fh-title">近期招聘会</view>
        <view class="fh-sub">来自官方或第三方来源，预约与报名均在来源平台完成</view>
      </view>
      <view class="fh-icon"><text class="ficon i-calendar"></text></view>
    </view>

    <view class="filter-bar">
      <view class="f-chip {{activeFilter === index ? 'on' : ''}}"
        wx:for="{{filters}}" wx:key="*this" data-index="{{index}}" bindtap="tapFilter">{{item}}</view>
    </view>

    <view wx:if="{{loading}}" class="state-card">
      <view class="state-icon"><text class="ficon i-calendar"></text></view>
      <view class="state-title">正在加载招聘会</view>
      <view class="state-desc">请稍候，正在同步公开活动信息</view>
    </view>

    <view wx:elif="{{loadError}}" class="state-card">
      <view class="state-icon warn"><text class="ficon i-warning"></text></view>
      <view class="state-title">加载失败</view>
      <view class="state-desc">{{loadError}}</view>
      <view class="state-retry tap" hover-class="tap-press" bindtap="reload">重试</view>
    </view>

    <view wx:elif="{{filteredFairs.length === 0}}" class="state-card">
      <view class="state-icon"><text class="ficon i-calendar"></text></view>
      <view class="state-title">暂无符合条件的招聘会</view>
      <view class="state-desc">可以切换筛选条件，或稍后再来查看最新排期</view>
    </view>

    <block wx:else>
        <view class="fair-list-card tap rise-d{{index + 1}}" wx:for="{{filteredFairs}}" wx:key="id"
          hover-class="tap-press" bindtap="tapFair" data-id="{{item.id}}">
          <view class="flc-icon"><text class="ficon i-calendar"></text></view>
          <view class="flc-body">
            <view class="flc-head">
              <view class="flc-title">{{item.title}}</view>
              <view wx:if="{{item.tag}}" class="chip {{item.tagTone}}">{{item.tag}}</view>
              <view wx:if="{{item.reminded}}" class="flc-bell"><text class="ficon i-bell"></text></view>
            </view>
            <view class="flc-meta">
              <view class="m" wx:for="{{item.metaLines}}" wx:for-item="ml" wx:key="*this">{{ml}}</view>
            </view>
            <view class="flc-foot">
              <text class="flc-source">来源：{{item.source || '未标注'}}</text>
              <view class="flc-sync">{{item.sync || '同步时间未提供'}}</view>
            </view>
          </view>
          <text class="ficon i-right flc-arrow"></text>
        </view>
    </block>

    <view class="compliance-note">以上招聘会信息来自第三方 / 官方主办方，本终端仅作信息展示，报名及预约请前往来源平台或现场办理。</view>
    <view class="spacer-lg"></view>
  </view>
</view>
