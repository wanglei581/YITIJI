.page-wrap { min-height: 100vh; background: var(--paper); }

.pickup-hero {
  margin: 8rpx 32rpx 20rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  text-align: center;
}
.ph-status-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--teal); margin: 0 auto 10rpx; }
.ph-status-text { display: block; color: var(--teal-deep); font-size: 24rpx; font-weight: 700; }
.ph-status-detail { display: block; max-width: 560rpx; margin: 10rpx auto 24rpx; color: var(--muted); font-size: 23rpx; line-height: 1.6; }
.status-awaiting_payment .ph-status-dot,
.status-awaiting_release .ph-status-dot,
.status-queued .ph-status-dot,
.status-printing .ph-status-dot { background: var(--warn); }
.status-awaiting_payment .ph-status-text,
.status-awaiting_release .ph-status-text,
.status-queued .ph-status-text,
.status-printing .ph-status-text { color: var(--warn); }
.status-completed .ph-status-dot { background: var(--ok); }
.status-completed .ph-status-text { color: var(--ok); }
.status-failed .ph-status-dot,
.status-expired .ph-status-dot,
.status-cancelled .ph-status-dot,
.status-abandoned .ph-status-dot { background: var(--error); }
.status-failed .ph-status-text,
.status-expired .ph-status-text,
.status-cancelled .ph-status-text,
.status-abandoned .ph-status-text { color: var(--error); }

.pickup-qr-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 auto 26rpx;
  padding: 22rpx 22rpx 24rpx;
  border: 1rpx solid #dce9ff;
  border-radius: 28rpx;
  background: #f3f8ff;
}
.pickup-qr { display: block; background: #fff; border-radius: 16rpx; }
.pickup-qr-error {
  width: 420rpx;
  min-height: 300rpx;
  padding: 32rpx;
  border-radius: 18rpx;
  background: var(--surface);
  color: var(--warn);
  font-size: 24rpx;
  line-height: 1.6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pickup-qr-title { display: block; margin-top: 17rpx; font-size: 28rpx; font-weight: 750; color: var(--ink); }
.pickup-qr-sub { display: block; margin-top: 7rpx; font-size: 21rpx; line-height: 1.5; color: var(--muted); }
.ph-divider { display: block; margin: 2rpx 0 16rpx; font-size: 21rpx; color: var(--faint); }
.ph-code-wrap { margin-bottom: 17rpx; }
.ph-code { display: block; color: var(--ink); font-size: 52rpx; line-height: 1.1; font-weight: 850; letter-spacing: 3rpx; font-variant-numeric: tabular-nums; white-space: nowrap; }
.ph-hint { display: block; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.ph-countdown { display: block; margin-top: 10rpx; color: var(--teal); font-size: 21rpx; font-weight: 600; }

.status-visual { padding: 24rpx 0 12rpx; }
.sv-icon { width: 108rpx; height: 108rpx; margin: 0 auto 20rpx; border-radius: 34rpx; background: var(--warn-soft); color: var(--warn); display: flex; align-items: center; justify-content: center; }
.sv-icon .ficon { width: 52rpx; height: 52rpx; }
.status-completed .sv-icon { background: var(--ok-soft); color: var(--ok); }
.status-failed .sv-icon,
.status-expired .sv-icon,
.status-cancelled .sv-icon,
.status-abandoned .sv-icon { background: var(--error-soft); color: var(--error); }
.sv-text { font-size: 24rpx; color: var(--muted); line-height: 1.6; }

.steps-card,
.next-card,
.info-card {
  margin: 0 32rpx 20rpx;
  border-radius: 26rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
}
.steps-card { padding: 22rpx 26rpx; display: flex; flex-direction: column; gap: 18rpx; }
.step-item { display: flex; align-items: center; gap: 16rpx; }
.step-num { width: 44rpx; height: 44rpx; border-radius: 15rpx; background: var(--teal-soft); color: var(--teal); font-size: 22rpx; font-weight: 750; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.step-text { font-size: 25rpx; color: var(--ink-soft); line-height: 1.5; }
.next-card { padding: 26rpx 28rpx; }
.next-title { font-size: 28rpx; font-weight: 750; color: var(--ink); }
.next-text { margin-top: 9rpx; font-size: 23rpx; line-height: 1.7; color: var(--muted); }
.info-card { padding: 7rpx 28rpx; }
.info-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 19rpx 0; border-bottom: 1rpx solid var(--line-faint); }
.info-row:last-child { border-bottom: none; }
.info-key { font-size: 24rpx; color: var(--muted); }
.info-val { font-size: 24rpx; color: var(--ink); font-weight: 600; text-align: right; }
.iv-status { color: var(--teal-deep); }

.notice-card { margin: 0 32rpx 20rpx; padding: 18rpx 22rpx; border-radius: 20rpx; background: var(--teal-wash); }
.nc-text { font-size: 22rpx; color: var(--ink-soft); line-height: 1.65; }
.sync-note { margin: 0 32rpx 14rpx; text-align: center; color: var(--muted); font-size: 21rpx; }
.sync-warning { margin: 0 32rpx 14rpx; padding: 16rpx 20rpx; border-radius: 17rpx; background: var(--warn-soft); color: var(--warn); font-size: 21rpx; line-height: 1.5; }
.pk-actions { padding: 7rpx 32rpx; text-align: center; }
.btn-ghost { display: inline-flex; min-height: 72rpx; padding: 0 36rpx; border-radius: 22rpx; border: 1rpx solid var(--line); background: var(--surface); color: var(--ink-soft); font-size: 26rpx; font-weight: 600; align-items: center; justify-content: center; }

.state-center { margin: 40rpx 32rpx; padding: 80rpx 40rpx; border-radius: 28rpx; background: var(--surface); border: 1rpx solid var(--line-soft); text-align: center; }
.spinner { width: 60rpx; height: 60rpx; margin: 0 auto 24rpx; border-radius: 50%; border: 4rpx solid var(--line); border-top-color: var(--teal); animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.state-icon { width: 92rpx; height: 92rpx; margin: 0 auto 20rpx; border-radius: 29rpx; background: var(--error-soft); color: var(--error); display: flex; align-items: center; justify-content: center; }
.state-icon .ficon { width: 44rpx; height: 44rpx; }
.state-label { display: block; margin-bottom: 30rpx; font-size: 27rpx; color: var(--muted); line-height: 1.6; }
.btn-retry { display: inline-flex; min-height: 76rpx; padding: 0 40rpx; border-radius: 22rpx; background: var(--teal); color: #fff; font-size: 27rpx; font-weight: 650; align-items: center; justify-content: center; }

.action-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--line-soft); }
.ab-btn { min-height: 88rpx; border-radius: 25rpx; background: var(--teal); color: #fff; font-size: 30rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; box-shadow: 0 10rpx 24rpx rgba(22,119,255,.16); }
