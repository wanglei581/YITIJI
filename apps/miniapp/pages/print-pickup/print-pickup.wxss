/* pages/print-pickup/print-pickup.wxss  打印到机码（墨翠鎏金白瓷） */
.page-wrap { min-height: 100vh; background: var(--paper); }

.pickup-hero {
  margin: 12rpx 32rpx 22rpx;
  padding: 34rpx 30rpx;
  border-radius: var(--r-lg);
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  box-shadow: var(--sh-md);
  text-align: center;
}
.ph-status-dot { width: 14rpx; height: 14rpx; border-radius: var(--r-full); background: var(--teal); margin: 0 auto 10rpx; }
.ph-status-text { display: block; color: var(--teal-deep); font-size: var(--fs-base); font-weight: 750; }
.ph-status-detail { display: block; max-width: 560rpx; margin: 10rpx auto 24rpx; color: var(--muted); font-size: var(--fs-sm); line-height: 1.6; }
.status-awaiting_payment .ph-status-dot,
.status-awaiting_release .ph-status-dot,
.status-queued .ph-status-dot,
.status-printing .ph-status-dot { background: var(--warn); }
.status-awaiting_payment .ph-status-text,
.status-awaiting_release .ph-status-text,
.status-queued .ph-status-text,
.status-printing .ph-status-text { color: var(--warn); }
.status-completed .ph-status-dot { background: var(--ok); }
.status-completed .ph-status-text { color: var(--ok); }
.status-failed .ph-status-dot,
.status-expired .ph-status-dot,
.status-cancelled .ph-status-dot,
.status-abandoned .ph-status-dot { background: var(--error); }
.status-failed .ph-status-text,
.status-expired .ph-status-text,
.status-cancelled .ph-status-text,
.status-abandoned .ph-status-text { color: var(--error); }

/* 鎏金细框白瓷二维码展台（移除旧亮蓝 #f3f8ff） */
.pickup-qr-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 auto 26rpx;
  padding: 26rpx 24rpx 24rpx;
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-lg);
  background: linear-gradient(180deg, #F4F9F6 0%, #FFFFFF 100%);
  box-shadow: var(--sh-xs);
}
.pickup-qr { display: block; background: #fff; border-radius: var(--r-sm); }
.pickup-qr-error {
  width: 420rpx;
  min-height: 300rpx;
  padding: 32rpx;
  border-radius: var(--r-sm);
  background: var(--surface);
  color: var(--warn);
  font-size: var(--fs-sm);
  line-height: 1.6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pickup-qr-title { display: block; margin-top: 18rpx; font-size: var(--fs-md); font-weight: 750; color: var(--ink); }
.pickup-qr-sub { display: block; margin-top: 8rpx; font-size: var(--fs-xs); line-height: 1.5; color: var(--muted); }
.ph-divider { display: block; margin: 4rpx 0 16rpx; font-size: var(--fs-xs); color: var(--faint); }
.ph-code-wrap { margin-bottom: 18rpx; }
.ph-code {
  display: block;
  color: var(--teal-deep);
  font-size: var(--fs-2xl);
  line-height: 1.1;
  font-weight: 850;
  letter-spacing: 4rpx;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.ph-hint { display: block; color: var(--muted); font-size: var(--fs-sm); line-height: 1.5; }
.ph-countdown { display: block; margin-top: 10rpx; color: var(--gold-deep); font-size: var(--fs-xs); font-weight: 700; }

.ph-acts { display: flex; gap: 14rpx; width: 100%; margin-top: 24rpx; }
.ph-act {
  flex: 1;
  min-width: 0;
  min-height: 96rpx;
  padding: 0 12rpx;
  border-radius: var(--r-full);
  border: 1rpx solid rgba(15, 106, 87, .24);
  background: var(--teal-wash);
  color: var(--teal-deep);
  font-size: var(--fs-base);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.ph-act.off { opacity: .5; }
.ph-share-note { display: block; margin-top: 12rpx; color: var(--muted); font-size: var(--fs-sm); line-height: 1.5; }
.share-card-canvas { position: fixed; left: -2000rpx; top: 0; width: 600px; height: 840px; }

.status-visual { padding: 24rpx 0 12rpx; }
.sv-icon {
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 20rpx;
  border-radius: var(--r-full);
  background: var(--warn-soft);
  color: var(--warn);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sv-icon .ficon { width: 52rpx; height: 52rpx; }
.status-completed .sv-icon { background: var(--ok-soft); color: var(--ok); }
.status-failed .sv-icon,
.status-expired .sv-icon,
.status-cancelled .sv-icon,
.status-abandoned .sv-icon { background: var(--error-soft); color: var(--error); }
.sv-text { font-size: var(--fs-sm); color: var(--muted); line-height: 1.6; }

.steps-card,
.next-card,
.info-card {
  margin: 0 32rpx 20rpx;
  border-radius: var(--r-lg);
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  box-shadow: var(--sh-sm);
}
.steps-card { padding: 24rpx 28rpx; display: flex; flex-direction: column; gap: 18rpx; }
.step-item { display: flex; align-items: center; gap: 16rpx; }
.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, #16483E 0%, #0A2720 100%);
  color: var(--gold-bright);
  font-size: var(--fs-sm);
  font-weight: 750;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.step-text { font-size: var(--fs-base); color: var(--ink-soft); line-height: 1.5; }
.next-card { padding: 26rpx 28rpx; }
.next-title { font-size: var(--fs-md); font-weight: 750; color: var(--ink); }
.next-text { margin-top: 10rpx; font-size: var(--fs-sm); line-height: 1.7; color: var(--muted); }
.info-card { padding: 8rpx 28rpx; }
.info-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--line-faint); }
.info-row:last-child { border-bottom: none; }
.info-key { font-size: var(--fs-sm); color: var(--muted); }
.info-val { font-size: var(--fs-sm); color: var(--ink); font-weight: 650; text-align: right; }
.iv-status { color: var(--teal-deep); }

.notice-card { margin: 0 32rpx 20rpx; padding: 18rpx 22rpx; border-radius: var(--r-md); background: var(--teal-wash); border: 1rpx solid var(--teal-soft); }
.nc-text { font-size: var(--fs-sm); color: var(--ink-soft); line-height: 1.65; }
.sync-note { margin: 0 32rpx 14rpx; text-align: center; color: var(--muted); font-size: var(--fs-xs); }
.sync-warning { margin: 0 32rpx 14rpx; padding: 16rpx 20rpx; border-radius: var(--r-sm); background: var(--warn-soft); color: var(--warn); font-size: var(--fs-xs); line-height: 1.5; }
.pk-actions { padding: 8rpx 32rpx; text-align: center; }
.btn-ghost {
  display: inline-flex;
  min-height: 76rpx;
  padding: 0 36rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--ink-soft);
  font-size: var(--fs-base);
  font-weight: 600;
  align-items: center;
  justify-content: center;
}

.state-center {
  margin: 40rpx 32rpx;
  padding: 80rpx 40rpx;
  border-radius: var(--r-lg);
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  box-shadow: var(--sh-sm);
  text-align: center;
}
.spinner { width: 60rpx; height: 60rpx; margin: 0 auto 24rpx; border-radius: var(--r-full); border: 4rpx solid var(--line); border-top-color: var(--teal); animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.state-icon { width: 92rpx; height: 92rpx; margin: 0 auto 20rpx; border-radius: var(--r-full); background: var(--error-soft); color: var(--error); display: flex; align-items: center; justify-content: center; }
.state-icon .ficon { width: 44rpx; height: 44rpx; }
.state-label { display: block; margin-bottom: 30rpx; font-size: var(--fs-base); color: var(--muted); line-height: 1.6; }
.btn-retry {
  display: inline-flex;
  min-height: 96rpx;
  padding: 0 44rpx;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, #16483E 0%, #0A2720 100%);
  color: var(--gold-bright);
  font-size: var(--fs-base);
  font-weight: 700;
  align-items: center;
  justify-content: center;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--line-soft);
  box-shadow: 0 -8rpx 24rpx rgba(11, 39, 33, .06);
}
.ab-btn {
  min-height: 92rpx;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, #16483E 0%, #0A2720 100%);
  border: 1rpx solid rgba(223, 198, 147, .36);
  color: var(--gold-bright);
  font-size: var(--fs-md);
  font-weight: 750;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-sm);
}

.btn-retry-sub {
  display: flex;
  width: fit-content;
  min-height: 96rpx;
  margin: 20rpx auto 0;
  padding: 0 40rpx;
  border-radius: var(--r-full);
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--ink-soft);
  font-size: var(--fs-base);
  font-weight: 600;
  align-items: center;
  justify-content: center;
}
