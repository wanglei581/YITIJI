/* pages/print-pickup/print-pickup.wxss — Direction B */

.page-wrap { min-height: 100vh; background: #FAF7F2; }
.navbar { display: flex; align-items: center; padding: 10rpx 28rpx 14rpx; background: #FAF7F2; }
.nb-back { font-size: 28rpx; color: #7A5C48; min-width: 80rpx; }
.nb-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: 800; color: #2C1A0E; }
.nb-right { min-width: 80rpx; }

/* 英雄区：大取件码 */
.pickup-hero {
  background: #FFFDF9; margin: 8rpx 32rpx 20rpx;
  border-radius: 36rpx; padding: 36rpx 32rpx;
  text-align: center; box-shadow: 0 8rpx 40rpx rgba(44,26,14,.10);
}
.ph-status-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: #3A6648; margin: 0 auto 12rpx;
}
.ph-status-text { font-size: 24rpx; color: #3A6648; font-weight: 600; display: block; margin-bottom: 28rpx; }
.ph-code-wrap { margin: 0 0 20rpx; }
.ph-code {
  font-size: 72rpx; font-weight: 900; color: #2C1A0E;
  letter-spacing: 8rpx; font-variant-numeric: tabular-nums;
  display: block; line-height: 1.1;
}
.ph-hint { font-size: 24rpx; color: #A89080; display: block; line-height: 1.5; }
.ph-countdown { font-size: 22rpx; color: #9C6E0A; display: block; margin-top: 12rpx; }

/* 操作步骤 */
.steps-card {
  background: #FFFDF9; margin: 0 32rpx 20rpx;
  border-radius: 24rpx; padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(44,26,14,.06);
  display: flex; flex-direction: column; gap: 18rpx;
}
.step-item { display: flex; align-items: center; gap: 16rpx; }
.step-num {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #2C1A0E; color: #FFFDF9;
  font-size: 24rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.step-text { font-size: 26rpx; color: #2C1A0E; line-height: 1.4; }

/* 订单信息 */
.info-card {
  background: #FFFDF9; margin: 0 32rpx 20rpx;
  border-radius: 24rpx; padding: 8rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(44,26,14,.06);
}
.info-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 0; border-bottom: 1rpx solid #F0E8DC;
}
.info-row:last-child { border-bottom: none; }
.info-key { font-size: 26rpx; color: #A89080; }
.info-val { font-size: 26rpx; color: #2C1A0E; font-weight: 600; }
.iv-status { color: #3A6648; }

/* 提示 */
.notice-card {
  margin: 0 32rpx 20rpx; background: #F5EDD8; border-radius: 20rpx; padding: 18rpx 22rpx;
}
.nc-text { font-size: 23rpx; color: #9C6E0A; line-height: 1.6; }

.pk-actions { text-align: center; padding: 8rpx 32rpx; }
.btn-ghost {
  display: inline-block; border: 1.5rpx solid #E5D8C8;
  color: #7A5C48; font-size: 28rpx; font-weight: 600;
  padding: 18rpx 48rpx; border-radius: 200rpx;
}

/* 加载/错误状态 */
.state-center { padding: 80rpx 32rpx; text-align: center; }
.spinner {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  border: 4rpx solid #E5D8C8; border-top-color: #C84B2F;
  margin: 0 auto 24rpx;
}
.state-icon { font-size: 72rpx; display: block; margin-bottom: 20rpx; }
.state-label { font-size: 28rpx; color: #7A5C48; display: block; margin-bottom: 32rpx; line-height: 1.6; }
.btn-retry {
  display: inline-block; background: #2C1A0E; color: #fff;
  font-size: 28rpx; font-weight: 600; padding: 18rpx 48rpx; border-radius: 200rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #FFFDF9; border-top: 1rpx solid #EDE5D8;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.ab-btn {
  background: #C84B2F; color: #fff; border-radius: 200rpx;
  padding: 24rpx; text-align: center;
  font-size: 32rpx; font-weight: 700;
}
.tap { transition: opacity 80ms; }
.tap-press { opacity: .7; }
