<!--pages/print-pickup/print-pickup.wxml-->
<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px;background:#FAF7F2"></view>

  <view class="navbar">
    <view class="nb-back tap" hover-class="tap-press" bindtap="back">‹ 返回</view>
    <view class="nb-title">打印取件</view>
    <view class="nb-right"></view>
  </view>

  <view class="state-center" wx:if="{{state === 'loading'}}">
    <view class="spinner"></view>
    <text class="state-label">正在读取订单实时状态…</text>
  </view>

  <view class="state-center" wx:elif="{{state === 'error'}}">
    <view class="state-icon">⚠️</view>
    <text class="state-label">{{errorMsg}}</text>
    <view class="btn-retry tap" hover-class="tap-press" bindtap="retry">重新加载</view>
  </view>

  <block wx:elif="{{state === 'ready'}}">
    <view class="pickup-hero status-{{statusKey}}">
      <view class="ph-status-dot"></view>
      <text class="ph-status-text">{{statusTitle}}</text>
      <text class="ph-status-detail">{{statusDetail}}</text>

      <view class="pickup-qr-card" wx:if="{{showQr}}">
        <canvas
          wx:if="{{qrStatus !== 'error'}}"
          type="2d"
          id="pickup-qr"
          class="pickup-qr"
          style="width:{{qrSizePx}}px;height:{{qrSizePx}}px"
          aria-label="打印取件核销二维码"
        ></canvas>
        <view class="pickup-qr-error" wx:else>二维码暂不可用，请使用下方取件码</view>
        <text class="pickup-qr-title">请将此二维码对准一体机扫码器</text>
        <text class="pickup-qr-sub">扫码器读取后会自动核销，无需在手机上扫码</text>
      </view>

      <block wx:if="{{showQr}}">
        <text class="ph-divider">扫码不便时，手动输入</text>
        <view class="ph-code-wrap"><text class="ph-code">{{code}}</text></view>
        <text class="ph-hint">二维码与下方 10 位码对应同一笔订单</text>
        <text class="ph-countdown" wx:if="{{countdown}}">{{countdown}}</text>
      </block>

      <view class="status-visual" wx:else>
        <view class="sv-icon">{{statusKey === 'completed' ? '✓' : (statusKey === 'failed' || statusKey === 'expired' || statusKey === 'cancelled' ? '!' : '…')}}</view>
        <view class="sv-text">{{statusKey === 'awaiting_payment' ? '请继续在终端操作' : (statusKey === 'queued' || statusKey === 'printing' ? '请在终端旁等待' : '本次取件码已停止展示')}}</view>
      </view>
    </view>

    <view class="steps-card" wx:if="{{statusKey === 'pending'}}">
      <view class="step-item">
        <view class="step-num">1</view>
        <text class="step-text">走到所选的一体机终端</text>
      </view>
      <view class="step-item">
        <view class="step-num">2</view>
        <text class="step-text">在终端选择「扫码或输入取件码」</text>
      </view>
      <view class="step-item">
        <view class="step-num">3</view>
        <text class="step-text">核销后在终端确认、付款并等待出纸</text>
      </view>
    </view>

    <view class="next-card" wx:elif="{{statusKey === 'awaiting_payment'}}">
      <view class="next-title">二维码已自动撤下</view>
      <view class="next-text">终端已经认领这笔订单。请查看一体机屏幕并完成现场支付，手机端会继续刷新打印状态。</view>
    </view>

    <view class="next-card" wx:elif="{{statusKey === 'queued' || statusKey === 'printing'}}">
      <view class="next-title">订单已进入终端打印流程</view>
      <view class="next-text">请不要离开设备。若长时间没有出纸，请先查看终端错误提示，再联系现场工作人员。</view>
    </view>

    <view class="info-card" wx:if="{{orderNo || taskStatus || pickupStatus}}">
      <view class="info-row" wx:if="{{orderNo}}">
        <text class="info-key">订单号</text>
        <text class="info-val">{{orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="info-key">当前状态</text>
        <text class="info-val iv-status">{{statusTitle}}</text>
      </view>
    </view>

    <view class="sync-note" wx:if="{{refreshing}}">正在同步终端状态…</view>
    <view class="sync-warning" wx:if="{{errorMsg}}">状态同步暂时失败，当前展示最近一次可用状态：{{errorMsg}}</view>

    <view class="notice-card">
      <text class="nc-text">二维码只包含本订单的 10 位取件码，不含文件、姓名或手机号。扫码、付款和打印状态以服务端与终端实时结果为准。</text>
    </view>

    <view class="pk-actions">
      <view class="btn-ghost tap" hover-class="tap-press" bindtap="toOrders">查看全部订单</view>
    </view>
  </block>

  <view style="height:calc(140rpx + env(safe-area-inset-bottom))"></view>
</view>

<view class="action-bar" wx:if="{{state === 'ready'}}">
  <view class="ab-btn tap" hover-class="tap-press" bindtap="home">完成</view>
</view>
