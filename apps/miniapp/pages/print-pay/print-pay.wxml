<view class="page-wrap">
<view style="height:{{statusBarHeight}}px"></view>
<view class="navbar">
  <view class="nav-back tap" bindtap="back"><text class="ficon i-right nav-back-ic"></text></view>
  <view class="nav-title">确认到机打印</view>
  <view class="nav-right"></view>
</view>

<view class="content has-bar">
  <view class="steps rise-d1">
    <view class="st done"><text class="n"><text class="ficon i-check"></text></text><text class="nl">选择文件</text></view>
    <view class="line done"></view>
    <view class="st done"><text class="n"><text class="ficon i-check"></text></text><text class="nl">选终端</text></view>
    <view class="line done"></view>
    <view class="st on"><text class="n">3</text><text class="nl">到机码</text></view>
    <view class="line"></view>
    <view class="st"><text class="n">4</text><text class="nl">{{isFreeOrder ? '现场打印' : '机端支付'}}</text></view>
  </view>

  <view class="section-t rise-d2">选定终端</view>
  <view class="card flat store-mini rise-d2">
    <view class="sm-ic a-teal"><text class="ficon i-location"></text></view>
    <view class="sm-main">
      <view class="sm-name">{{q.store || '未选择终端'}}</view>
      <view class="sm-sub">{{isFreeOrder ? '免费试运营：到机核验后直接进入打印队列' : '到机核验后再进入现场支付与打印'}}</view>
    </view>
  </view>

  <view class="section-t rise-d3">打印文件</view>
  <view class="card flat rise-d3">
    <view wx:for="{{files}}" wx:key="name" class="order-file">
      <view class="of-ic a-teal"><text class="ficon i-file-text"></text></view>
      <view class="of-main"><view class="of-name">{{item.name}}</view><view class="of-desc">{{colorLabel}} · {{duplexLabel}} · {{pageCountLabel}} · ×{{copiesLabel}}</view></view>
      <view class="of-price">{{item.price === '—' || item.price === '免费' ? item.price : '¥' + item.price}}</view>
    </view>
  </view>

  <view class="section-t rise-d4">费用（服务端核定）</view>
  <view class="card flat fee rise-d4">
    <view class="fee-row total"><text>{{isFreeOrder ? '免费试运营' : (quoteState === 'ready' ? '服务端核定金额' : '金额待服务端核定')}}</text><text class="amt">{{isFreeOrder ? '免费' : (quoteState === 'ready' ? '¥' + fee.total : '—')}}</text></view>
    <!-- 报价拿不到时**不本地补一个数字**：只说清楚，并给一条可执行的重试。
         下单本身不被挡住——建单时服务端会自己计价。 -->
    <view class="fee-row quote-fail" wx:if="{{quoteState === 'error'}}">
      <text class="qf-text">{{quoteError}}</text>
      <!-- 按 quoteRecover 这个**状态字段**分流，不按文案里有没有「登录」两个字。
           认不出人时「重新核价」是个死循环：再点一次还是同一条 fail-closed，
           真正有效的下一步是重新登录。 -->
      <view wx:if="{{quoteRecover === 'login'}}" class="qf-login tap" hover-class="tap-press" bindtap="toLogin" role="button">去登录</view>
      <view wx:else class="qf-retry tap" hover-class="tap-press" bindtap="retryQuote" role="button">重新核价</view>
    </view>
    <view class="fee-row" wx:elif="{{quoteState === 'loading'}}"><text class="qf-text">正在向服务端核定页数与金额…</text></view>
  </view>

  <!-- 订单已经建成、只是没能自动跳转：必须说清楚它在哪、并且不许再提交一次。 -->
  <view class="notice warn rise-d5" wx:if="{{createdLocked}}">
    <text class="ficon i-info n-ic"></text>
    <view class="locked-main">
      <view class="locked-t">订单已创建，请不要重复提交</view>
      <view class="locked-d">到机码已经生成，只是这一步没能自动跳转。到「我的 · 打印订单」就能找回这张订单，点进去即是到机码。</view>
      <view class="locked-btn tap" hover-class="tap-press" bindtap="toOrders" role="button">去我的打印订单</view>
    </view>
  </view>

  <view class="notice info rise-d6">
    <text class="ficon i-info n-ic"></text>
    <text>{{isFreeOrder ? '当前订单为免费试运营。到机确认前不会创建 Agent 可领取的 PrintTask；核验成功后才进入真实打印队列。' : '本期方案为小程序预提交、到机码核验、机端支付。到机确认前不会创建 Agent 可领取的 PrintTask，页面也不会伪造支付或打印成功。'}}</text>
  </view>
</view>

<view class="actionbar">
  <view class="ab-price"><text class="ab-label">{{isFreeOrder ? '免费试运营' : (quoteState === 'ready' ? '到机应付' : '金额待核定')}}</text><text class="ab-amt">{{isFreeOrder ? '免费' : (quoteState === 'ready' ? '¥' + fee.total : '—')}}</text></view>
  <!-- 订单建成后按钮永久变灰。服务端现在按 (endUserId, idempotency-key) 回放，
       再点一次不会多出一张单；但页面仍必须变灰 —— 让一个已经下过单的人反复点
       「提交」本身就是在骗他，而且那次回放对他毫无意义。 -->
  <view class="btn wx lg {{submitting || createdLocked ? 'disabled' : ''}}" bindtap="continueFlow">{{createdLocked ? '订单已创建' : (submitting ? '正在提交…' : '提交并生成到机码')}}</view>
</view>
</view>
