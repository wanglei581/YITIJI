/* pages/print-pay/print-pay.wxss  确认提交（墨翠鎏金白瓷） */
.page-wrap { min-height: 100vh; background: var(--paper); }
.store-mini { display: flex; align-items: center; gap: 20rpx; }
.sm-ic {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.sm-ic .ficon { width: 38rpx; height: 38rpx; }
.sm-name { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.sm-sub { font-size: var(--fs-sm); color: var(--muted); margin-top: 4rpx; }

.order-file { display: flex; align-items: center; gap: 20rpx; }
.order-file + .order-file { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line-faint); }
.of-ic { width: 68rpx; height: 68rpx; border-radius: var(--r-md); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.of-ic .ficon { width: 34rpx; height: 34rpx; }
.of-main { flex: 1; min-width: 0; }
.of-name { font-size: var(--fs-base); font-weight: 700; color: var(--ink); }
.of-desc { font-size: var(--fs-sm); color: var(--muted); margin-top: 4rpx; }
.of-price { font-size: var(--fs-base); font-weight: 700; color: var(--gold-deep); }

.fee { display: flex; flex-direction: column; gap: 16rpx; }
.fee-row { display: flex; align-items: center; justify-content: space-between; font-size: var(--fs-base); color: var(--muted); }
.fee-row text:last-child { color: var(--ink); font-weight: 600; }
.fee-row .minus { color: var(--teal-deep); }
.fee-row.total { padding-top: 16rpx; border-top: 1rpx solid var(--line); }
.fee-row.total .amt { color: var(--teal-deep); font-weight: 800; font-size: var(--fs-lg); }

.pay-list { display: flex; flex-direction: column; gap: 16rpx; }
.pay-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  background: var(--surface);
  border-radius: var(--r-lg);
  border: 2rpx solid var(--line-soft);
  box-shadow: var(--sh-sm);
}
.pay-opt.on { border-color: var(--teal); background: linear-gradient(180deg, #FFFFFF 0%, #F1F8F5 100%); }
.po-ic { width: 64rpx; height: 64rpx; border-radius: var(--r-md); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.po-ic.wx { background: #07c160; }
.po-ic.bal { background: var(--gold-deep); }
.po-ic .ficon { width: 34rpx; height: 34rpx; color: #fff; }
.po-main { flex: 1; }
.po-title { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.po-sub { font-size: var(--fs-sm); color: var(--muted); margin-top: 4rpx; }
.po-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--r-full);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
  color: #fff;
  flex-shrink: 0;
}
.pay-opt.on .po-radio { background: var(--teal-deep); border-color: var(--teal-deep); color: var(--gold-bright); }

.ab-label { font-size: var(--fs-sm); color: var(--muted); display: block; }
.ab-amt { font-size: var(--fs-xl); font-weight: 800; color: var(--teal-deep); font-variant-numeric: tabular-nums; }

.sm-main { flex: 1; min-width: 0; }

.fee-row.quote-fail { align-items: flex-start; gap: 20rpx; }
.qf-text { flex: 1; font-size: var(--fs-sm); line-height: 1.6; color: var(--muted); }
.qf-retry {
  flex-shrink: 0;
  display: inline-flex;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--ink-soft);
  font-size: var(--fs-sm);
  font-weight: 650;
  align-items: center;
  justify-content: center;
}

.qf-login {
  flex-shrink: 0;
  display: inline-flex;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--teal);
  background: var(--teal-wash);
  color: var(--teal-deep);
  font-size: var(--fs-sm);
  font-weight: 700;
  align-items: center;
  justify-content: center;
}

.locked-main { flex: 1; }
.locked-t { font-size: var(--fs-base); font-weight: 750; color: var(--ink); }
.locked-d { margin-top: 8rpx; font-size: var(--fs-sm); line-height: 1.65; color: var(--muted); }
.locked-btn {
  display: flex;
  width: fit-content;
  min-height: 96rpx;
  margin-top: 18rpx;
  padding: 0 32rpx;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, #16483E 0%, #0A2720 100%);
  color: var(--gold-bright);
  font-size: var(--fs-base);
  font-weight: 700;
  align-items: center;
  justify-content: center;
}
.locked-btn.ghost {
  background: var(--surface);
  color: var(--teal-deep);
  border: 2rpx solid var(--teal);
}
