page { height: 100%; overflow: hidden; background: var(--paper); }
.home-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); color: var(--ink); }
.home-scroll { flex: 1; min-height: 0; }

/* 墨翠深松鎏金弧形头区：高定瓷釉渐变 + 极细香槟底光 */
.home-band {
  position: relative;
  overflow: hidden;
  padding-bottom: 92rpx;
  border-radius: 0 0 var(--r-xl) var(--r-xl);
  background: linear-gradient(162deg, #174B40 0%, #0D2D26 56%, #071915 100%);
  color: #F7F5EE;
  box-shadow: 0 14rpx 40rpx -12rpx rgba(7, 25, 21, .34);
}
.home-band::before {
  content: "";
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: 0;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(182, 154, 104, 0) 0%, rgba(212, 186, 135, .52) 50%, rgba(182, 154, 104, 0) 100%);
  pointer-events: none;
}
.home-band::after {
  content: "";
  position: absolute;
  right: -90rpx;
  top: -70rpx;
  width: 380rpx;
  height: 380rpx;
  border-radius: var(--r-full);
  background: radial-gradient(circle, rgba(212, 186, 135, .15) 0%, rgba(60, 224, 169, .08) 42%, rgba(7, 25, 21, 0) 72%);
  pointer-events: none;
}
.home-head {
  position: relative;
  z-index: 1;
  height: 96rpx;
  padding: 6rpx 32rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.brand-row { display: flex; align-items: center; gap: 16rpx; min-width: 0; flex: 1; }
.brand-row.is-co { min-height: 96rpx; }
.brand-seal {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--r-sm);
  background: linear-gradient(145deg, #E2CA98 0%, #B69A68 100%);
  color: #081E19;
  font-size: var(--fs-md);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .45), 0 6rpx 16rpx rgba(0, 0, 0, .24);
}
.brand-copy { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; flex: 1; }
.brand-co-line { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.brand-name { font-size: var(--fs-lg); line-height: 1.15; font-weight: 700; letter-spacing: 2rpx; color: #F7F5EE; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.brand-co-sep { width: 2rpx; height: 24rpx; background: rgba(223, 198, 147, .55); flex-shrink: 0; }
.brand-co-with { font-size: var(--fs-xs); font-weight: 600; color: var(--gold-bright); white-space: nowrap; flex-shrink: 0; }
.brand-en { font-size: var(--fs-xs); line-height: 1; letter-spacing: 2rpx; color: var(--gold-bright); opacity: .78; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 保留 96rpx=48px 完整可点热区，但视觉收束为精致 64rpx 圆形微光按钮，绝不喧宾夺主 */
.head-btn { width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; }
.head-btn-disc {
  width: 66rpx;
  height: 66rpx;
  border-radius: var(--r-full);
  border: 1rpx solid rgba(223, 198, 147, .28);
  background: rgba(255, 255, 255, .08);
  color: #F7F5EE;
  display: flex;
  align-items: center;
  justify-content: center;
}
.head-btn-disc .ficon { width: 30rpx; height: 30rpx; }

.greeting { position: relative; z-index: 1; padding: 18rpx 32rpx 10rpx; display: flex; flex-direction: column; }
.greet-title { font-size: var(--fs-xl); line-height: 1.25; font-weight: 700; letter-spacing: .5rpx; color: #FFFFFF; }
.greet-sub { margin-top: 10rpx; font-size: var(--fs-sm); color: var(--mint); opacity: .88; letter-spacing: .4rpx; }

.home-body { position: relative; z-index: 2; padding: 0 28rpx; }

/* 悬浮问小青高定卡片：纯白浮层 + 极细香槟金描边 + 精裁小青肖像金环 */
.qing-bar {
  min-height: 140rpx;
  margin-top: -58rpx;
  padding: 22rpx 24rpx 22rpx 22rpx;
  border-radius: var(--r-lg);
  background: var(--surface);
  border: 1rpx solid var(--gold-line);
  box-shadow: var(--sh-md);
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.qing-avatar-ring {
  width: 96rpx;
  height: 96rpx;
  padding: 4rpx;
  box-sizing: border-box;
  border-radius: var(--r-full);
  background: linear-gradient(145deg, #DFC693 0%, #174B40 100%);
  box-shadow: 0 8rpx 20rpx -4rpx rgba(11, 39, 33, .22);
  flex-shrink: 0;
}
.qing-face { width: 100%; height: 100%; border-radius: var(--r-full); background: var(--teal-soft); display: block; }
.qing-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.qing-head-row { display: flex; align-items: center; gap: 10rpx; }
.qing-name { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.qing-tag {
  padding: 3rpx 12rpx;
  border-radius: var(--r-full);
  background: var(--gold-soft);
  border: 1rpx solid var(--gold-line);
  color: var(--gold-deep);
  font-size: var(--fs-xs);
  font-weight: 600;
}
.qing-say { font-size: var(--fs-sm); line-height: 1.45; color: var(--muted); }
.qing-go {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  border-radius: var(--r-full);
  background: linear-gradient(145deg, var(--teal) 0%, var(--teal-deep) 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(15, 106, 87, .24);
}
.qing-go .ficon { width: 20rpx; height: 20rpx; }

/* 一机构一码鎏金铭牌条：白瓷底 + 细金线，厚度紧凑不抢核心 AI 入口重心 */
.org-plate {
  min-height: 96rpx;
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--r-md);
  background: linear-gradient(135deg, #FFFFFF 0%, #FBF8F1 100%);
  border: 1rpx solid var(--gold-line);
  box-shadow: var(--sh-xs);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.org-plate-seal {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--r-sm);
  background: linear-gradient(145deg, #184E43 0%, #0B2721 100%);
  border: 1rpx solid rgba(212, 186, 135, .45);
  color: var(--gold-bright);
  font-size: var(--fs-base);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.org-plate-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.org-plate-name { font-size: var(--fs-base); font-weight: 700; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.org-plate-sub { font-size: var(--fs-xs); color: var(--gold-deep); }
.org-plate-stat { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }
.org-plate-badge {
  padding: 4rpx 14rpx;
  border-radius: var(--r-full);
  background: var(--teal-soft);
  color: var(--teal-deep);
  font-size: var(--fs-xs);
  font-weight: 700;
}
.org-plate-arrow { width: 18rpx; height: 18rpx; color: var(--gold); }

/* 待取件优先动态卡 */
.pickup-card {
  margin-top: 22rpx;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1rpx solid rgba(15, 106, 87, .28);
  box-shadow: var(--sh-sm);
  overflow: hidden;
}
.pickup-main { min-height: 120rpx; padding: 22rpx 22rpx 18rpx; display: flex; align-items: center; gap: 18rpx; }
.pickup-icon {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: var(--r-full);
  background: radial-gradient(circle at 30% 30%, #E7F5F0 0%, #D2EAE2 100%);
  color: var(--teal-deep);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pickup-icon .ficon { width: 36rpx; height: 36rpx; }
.pickup-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.pickup-title { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.pickup-sub { font-size: var(--fs-sm); color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pickup-go {
  flex-shrink: 0;
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: var(--r-full);
  background: linear-gradient(145deg, var(--teal) 0%, var(--teal-deep) 100%);
  color: #FFFFFF;
  font-size: var(--fs-sm);
  font-weight: 600;
  display: flex;
  align-items: center;
}
.pickup-more { min-height: 96rpx; border-top: 1rpx solid var(--line-faint); display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); color: var(--teal-deep); font-weight: 600; }
.pickup-latest {
  min-height: 96rpx;
  margin-top: 22rpx;
  padding: 0 24rpx;
  border-radius: var(--r-md);
  background: var(--surface);
  box-shadow: var(--sh-xs);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--fs-sm);
  color: var(--ink-soft);
}
.pickup-latest .ficon { width: 20rpx; height: 20rpx; color: var(--ghost); }

/* 编辑级分区标题：左配极细翡翠鎏金竖条，彻底建立高定节奏 */
.section-head { height: 84rpx; padding: 28rpx 4rpx 12rpx; display: flex; align-items: center; justify-content: space-between; }
.section-head.compact { height: 74rpx; padding-top: 26rpx; }
.section-title-wrap { display: flex; align-items: center; gap: 12rpx; }
.section-bar {
  width: 6rpx;
  height: 26rpx;
  border-radius: var(--r-full);
  background: linear-gradient(180deg, var(--teal) 0%, var(--gold) 100%);
}
.section-title { font-size: var(--fs-md); font-weight: 700; color: var(--ink); letter-spacing: .4rpx; }
.section-more { font-size: var(--fs-sm); color: var(--teal-deep); font-weight: 600; display: inline-flex; align-items: center; min-height: 96rpx; padding: 0 8rpx; }

/* 金刚区四项：纯白浮雕无粗灰边 + 径向柔光圆形徽章（去方块化） */
.service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; padding: 4rpx 0 0; }
.service-item {
  min-width: 0;
  padding: 22rpx 8rpx 18rpx;
  background: var(--surface);
  border-radius: var(--r-md);
  box-shadow: var(--sh-xs);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.service-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-full);
  display: flex;
  align-items: center;
  justify-content: center;
}
.service-icon .ficon { width: 38rpx; height: 38rpx; }
.tone-blue   { background: radial-gradient(circle at 30% 25%, #EAF7F2 0%, #D4EDE4 100%); color: var(--teal-deep); }
.tone-violet { background: radial-gradient(circle at 30% 25%, #F4F0FD 0%, #E5DDF9 100%); color: var(--plum-deep); }
.tone-cyan   { background: radial-gradient(circle at 30% 25%, #EEF4FC 0%, #DAE6F7 100%); color: var(--slate-deep); }
.tone-orange { background: radial-gradient(circle at 30% 25%, #FCF3E4 0%, #F4E2C1 100%); color: var(--gold-deep); }
.service-title { margin-top: 14rpx; font-size: var(--fs-sm); line-height: 1.25; font-weight: 600; color: var(--ink); white-space: nowrap; }

/* 双端联动墨翠鎏金旗舰主卡：瓷釉渐变 + 顶部内高光 + 鎏金极细描边 */
.print-banner {
  min-height: 174rpx;
  margin-top: 26rpx;
  padding: 28rpx 26rpx;
  border-radius: var(--r-lg);
  border: 1rpx solid rgba(212, 186, 135, .30);
  background: linear-gradient(152deg, #184E43 0%, #0E3129 58%, #081D18 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .12), 0 16rpx 40rpx -12rpx rgba(8, 29, 24, .44);
  display: flex;
  align-items: center;
  gap: 22rpx;
  position: relative;
  overflow: hidden;
}
.print-banner::after {
  content: "";
  position: absolute;
  right: -50rpx;
  top: -70rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: var(--r-full);
  background: radial-gradient(circle, rgba(223, 198, 147, .20) 0%, rgba(60, 224, 169, .08) 45%, rgba(8, 29, 24, 0) 72%);
  pointer-events: none;
}
.print-icon {
  width: 86rpx;
  height: 86rpx;
  flex-shrink: 0;
  border-radius: var(--r-md);
  background: rgba(223, 198, 147, .14);
  border: 1rpx solid rgba(223, 198, 147, .32);
  color: var(--gold-bright);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}
.print-icon .ficon { width: 42rpx; height: 42rpx; }
.print-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; position: relative; z-index: 1; }
.print-kicker { font-size: var(--fs-xs); font-weight: 600; letter-spacing: 2rpx; color: var(--gold-bright); opacity: .9; }
.print-title { margin-top: 6rpx; font-size: var(--fs-md); font-weight: 700; color: #FFFFFF; letter-spacing: .2rpx; }
.print-desc { margin-top: 8rpx; font-size: var(--fs-sm); line-height: 1.45; color: var(--mint); opacity: .9; }
.print-go {
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  border-radius: var(--r-full);
  color: #081E19;
  background: linear-gradient(145deg, #E5CE9E 0%, #BEA16C 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, .24);
}
.print-go .ficon, .info-arrow .ficon { width: 20rpx; height: 20rpx; }

/* 纯白浮层联动列表卡：双层墨翠微阴影替代粗灰边框 */
.info-card { border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--sh-xs); overflow: hidden; }
.info-row { min-height: 118rpx; padding: 22rpx 24rpx; display: flex; align-items: center; gap: 20rpx; }
.info-row + .info-row { border-top: 1rpx solid var(--line-faint); }
.info-icon { width: 72rpx; height: 72rpx; border-radius: var(--r-full); flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.info-icon .ficon { width: 34rpx; height: 34rpx; }
.soft-jade   { background: radial-gradient(circle at 30% 25%, #EAF7F2 0%, #D6EFE6 100%); color: var(--teal-deep); }
.soft-indigo { background: radial-gradient(circle at 30% 25%, #EEF4FC 0%, #DBE7F8 100%); color: var(--slate-deep); }
.soft-rose   { background: radial-gradient(circle at 30% 25%, #FDF2EB 0%, #F5E0D3 100%); color: var(--clay-deep); }
.soft-amber  { background: radial-gradient(circle at 30% 25%, #FCF4E4 0%, #F5E5C5 100%); color: var(--gold-deep); }
.info-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.info-title { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
.info-desc { margin-top: 5rpx; font-size: var(--fs-sm); color: var(--muted); }
.info-arrow { color: var(--ghost); }

.home-note { padding: 28rpx 12rpx 4rpx; color: var(--faint); font-size: var(--fs-xs); line-height: 1.6; text-align: center; }
.home-legal { display: flex; align-items: center; justify-content: center; gap: 6rpx; }
.home-legal-link { display: inline-flex; align-items: center; min-height: 96rpx; padding: 0 18rpx; color: var(--teal-deep); font-size: var(--fs-sm); font-weight: 500; }
.home-legal-sep { color: var(--ghost); font-size: var(--fs-sm); }
/* 预留足量空间给悬浮瓷白底栏，滚到最底绝不重叠 */
.tab-spacer { height: calc(196rpx + env(safe-area-inset-bottom)); }
@media (max-height: 720px) { .section-head { height: 74rpx; padding-top: 20rpx; } }
