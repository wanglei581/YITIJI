page { height: 100%; overflow: hidden; background: var(--paper); }
.home-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); color: var(--ink); }
.home-head { height: 94rpx; padding: 8rpx 32rpx 10rpx; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
.brand-row { display: flex; align-items: center; gap: 16rpx; }
.brand-name { font-size: 34rpx; line-height: 1.2; font-weight: 800; letter-spacing: 1rpx; color: var(--ink); }
.head-btn { width: 88rpx; height: 88rpx; border-radius: 27rpx; border: 1rpx solid var(--line-soft); background: #fff; color: var(--ink-soft); display: flex; align-items: center; justify-content: center; }
.head-btn .ficon { width: 30rpx; height: 30rpx; }
.home-scroll { flex: 1; min-height: 0; }
.home-body { padding: 6rpx 28rpx 0; }
.greeting { padding: 14rpx 4rpx 22rpx; display: flex; flex-direction: column; }
.greet-title { font-size: 42rpx; line-height: 1.2; font-weight: 800; letter-spacing: -1rpx; }
.greet-sub { margin-top: 9rpx; font-size: 23rpx; color: var(--muted); }
.ask-bar { height: 92rpx; padding: 0 18rpx; background: #fff; border: 1rpx solid var(--line-soft); border-radius: 26rpx; box-shadow: var(--sh-sm); display: flex; align-items: center; gap: 14rpx; }
.ask-icon { width: 52rpx; height: 52rpx; border-radius: 16rpx; color: var(--teal); background: var(--teal-soft); display: flex; align-items: center; justify-content: center; }
.ask-icon .ficon { width: 28rpx; height: 28rpx; }
.ask-placeholder { flex: 1; min-width: 0; color: var(--faint); font-size: 25rpx; }
.ask-action { height: 52rpx; padding: 0 20rpx; border-radius: 15rpx; color: #fff; background: var(--teal); display: flex; align-items: center; font-size: 23rpx; font-weight: 650; }
/* 小青对话入口条：从 320rpx 的营销 hero 压到 136rpx 的功能条，
   省出的首屏空间留给真正该占位的内容。头像用真人小图 + 一圈品牌色描边，
   保住"有个人在"的信任感，同时和整页扁平图标语言不冲突。 */
.qing-bar { min-height: 136rpx; margin-top: 22rpx; padding: 22rpx 22rpx 22rpx 20rpx; border-radius: 30rpx; background: linear-gradient(120deg, var(--teal-wash) 0%, #fff 62%); border: 1rpx solid var(--teal-soft); display: flex; align-items: center; gap: 20rpx; }
.qing-face { width: 92rpx; height: 92rpx; flex-shrink: 0; border-radius: 50%; background: var(--teal-soft); border: 3rpx solid #fff; box-shadow: 0 6rpx 16rpx -4rpx rgba(35,84,230,.30); }
.qing-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 7rpx; }
.qing-name { font-size: 27rpx; font-weight: 700; color: var(--ink); }
.qing-say { font-size: 23rpx; line-height: 1.4; color: var(--muted); }
.qing-go { width: 46rpx; height: 46rpx; flex-shrink: 0; border-radius: 50%; background: var(--teal); color: #fff; display: flex; align-items: center; justify-content: center; }
.qing-go .ficon { width: 20rpx; height: 20rpx; }
.section-head { height: 90rpx; padding: 28rpx 4rpx 14rpx; display: flex; align-items: center; justify-content: space-between; }
.section-title { font-size: 31rpx; font-weight: 750; color: var(--ink); }
.section-more { font-size: 24rpx; color: var(--teal); font-weight: 600; }
.service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; padding: 4rpx 6rpx 0; }
/* 去卡片化：原本每个图标外面还套一层白底描边卡片，形成「卡片里的图标」双层容器，
   那是后台管理系统的写法。市面消费级小程序的金刚区是图标直接落在页面底色上、
   靠间距分隔，图标本身就是视觉主体，因而可以做得更大。 */
.service-item { min-width: 0; padding: 8rpx 0 0; background: transparent; border: none; display: flex; flex-direction: column; align-items: center; text-align: center; }
.service-icon { position: relative; width: 104rpx; height: 104rpx; border-radius: 30rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.service-icon .ficon { position: relative; z-index: 1; width: 50rpx; height: 50rpx; }
/* 彩色渐变实底 + 白色图标：消费级产品的金刚区语言。
   每个功能一个专属色相，图标反白后形态差异被放大，不再是"同一个灰图标染四种色"。
   底部投影用各自色相的低透明度，让色块"落"在纸面上而不是贴上去。 */
.tone-blue   { background: linear-gradient(145deg,#5B9CFF 0%,#2563EB 100%); color:#fff; box-shadow: 0 10rpx 20rpx -6rpx rgba(37,99,235,.42); }
.tone-violet { background: linear-gradient(145deg,#A98BFA 0%,#7C3AED 100%); color:#fff; box-shadow: 0 10rpx 20rpx -6rpx rgba(124,58,237,.40); }
.tone-cyan   { background: linear-gradient(145deg,#2ED3BE 0%,#0D9488 100%); color:#fff; box-shadow: 0 10rpx 20rpx -6rpx rgba(13,148,136,.40); }
.tone-orange { background: linear-gradient(145deg,#FFA857 0%,#F0682C 100%); color:#fff; box-shadow: 0 10rpx 20rpx -6rpx rgba(240,104,44,.40); }
/* 高光：左上一道极淡内高光，给色块一点弧面感，避免纯平贴纸感 */
.service-icon::after {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background: linear-gradient(160deg, rgba(255,255,255,.28) 0%, rgba(255,255,255,0) 52%);
}
.service-title { margin-top: 16rpx; font-size: 23rpx; line-height: 1.25; font-weight: 650; white-space: nowrap; }
/* 首屏视觉重心。商用 App 的首页都有一个明确的重心（京东快递的大促位、
   Tracck 的数据卡），而不是一串等重的白卡片——后者正是「模板感」的根源。
   这个产品真正的差异化是「手机准备 → 到机出纸」的双端联动，
   所以把它做成深色渐变主卡，与周围白卡拉开量级。 */
.print-banner { min-height: 168rpx; margin-top: 24rpx; padding: 30rpx 26rpx; border-radius: 32rpx; border: none;
  background: linear-gradient(128deg, #2E5BEA 0%, #1A3FB8 62%, #16308C 100%);
  box-shadow: 0 18rpx 40rpx -14rpx rgba(26,63,184,.55);
  display: flex; align-items: center; gap: 20rpx; position: relative; overflow: hidden; }
/* 右上角一枚淡光斑，避免大色块死板 */
.print-banner::after { content:""; position:absolute; right:-60rpx; top:-70rpx; width:220rpx; height:220rpx; border-radius:50%;
  background: radial-gradient(circle, rgba(255,255,255,.16) 0%, rgba(255,255,255,0) 70%); pointer-events:none; }
.print-icon { width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: 26rpx; background: rgba(255,255,255,.18); color: #fff; display: flex; align-items: center; justify-content: center; position: relative; z-index: 1; }
.print-icon .ficon { width: 44rpx; height: 44rpx; }
.print-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; position: relative; z-index: 1; }
.print-title { font-size: 31rpx; font-weight: 750; color: #fff; letter-spacing: -.3rpx; }
.print-desc { margin-top: 9rpx; font-size: 22rpx; line-height: 1.45; color: rgba(255,255,255,.78); }
.print-go { width: 52rpx; height: 52rpx; flex-shrink: 0; border-radius: 50%; color: #1A3FB8; background: #fff; display: flex; align-items: center; justify-content: center; position: relative; z-index: 1; }
.print-go .ficon, .info-arrow .ficon { width: 20rpx; height: 20rpx; }
.info-card { border: 1rpx solid var(--line-soft); border-radius: 26rpx; background: #fff; overflow: hidden; }
.info-row { min-height: 118rpx; padding: 20rpx 22rpx; display: flex; align-items: center; gap: 18rpx; }
.info-row + .info-row { border-top: 1rpx solid var(--line-faint); }
.info-icon { width: 66rpx; height: 66rpx; border-radius: 20rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.info-icon .ficon { width: 32rpx; height: 32rpx; }
/* 次级列表用「浅色底 + 同色相深色图标」，与首屏服务区的「实底白图标」形成层级差：
   主操作有重量、次级信息克制。三条各自色相，避免三行图标完全同形同色。 */
.soft-indigo { background:#EEF2FF; color:#4F55C7; }
.soft-rose   { background:#FFF0F3; color:#C6386B; }
.soft-amber  { background:#FFF6E6; color:#A96A08; }
.info-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.info-title { font-size: 27rpx; font-weight: 650; }
.info-desc { margin-top: 5rpx; font-size: 21rpx; color: var(--muted); }
.info-arrow { color: var(--ghost); }
.home-note { padding: 24rpx 12rpx 8rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; text-align: center; }
.tab-spacer { height: calc(130rpx + env(safe-area-inset-bottom)); }
@media (max-height: 720px) { .section-head { height: 78rpx; padding-top: 20rpx; } }
