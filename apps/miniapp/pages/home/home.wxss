/* pages/home/home.wxss — existing cream-paper visual, one-screen workspace */

page { height: 100%; overflow: hidden; background: #FAF7F2; }

.home-wrap {
  height: 100vh;
  overflow: hidden;
  background: #FAF7F2;
  color: #2C1A0E;
  display: flex;
  flex-direction: column;
}

.page-hd {
  height: 94rpx;
  padding: 8rpx 30rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.greet-col { display: flex; flex-direction: column; gap: 2rpx; min-width: 0; }
.greet-main { font-size: 38rpx; font-weight: 750; line-height: 1.2; color: #2C1A0E; letter-spacing: 0; }
.greet-date { font-size: 21rpx; color: #A89080; }
.head-tools { display: flex; align-items: center; gap: 12rpx; }
.head-icon {
  width: 62rpx;
  height: 62rpx;
  border: 1rpx solid #E5D8C8;
  border-radius: 50%;
  color: #7A5C48;
  display: flex;
  align-items: center;
  justify-content: center;
}
.head-icon .ficon { width: 29rpx; height: 29rpx; }
.assistant-icon { background: #F3E8E1; color: #A4422D; border-color: #E6CFC3; }

.focus-strip {
  height: 112rpx;
  margin: 0 30rpx 16rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #FFFDF9;
  border: 1rpx solid #E5D8C8;
  box-shadow: 0 5rpx 18rpx rgba(44,26,14,.05);
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.focus-mark {
  width: 58rpx;
  height: 58rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #FAEDEA;
  color: #C84B2F;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.focus-mark .ficon { width: 28rpx; height: 28rpx; }
.focus-copy { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.focus-label { font-size: 19rpx; font-weight: 700; color: #C84B2F; }
.focus-title { margin-top: 2rpx; font-size: 28rpx; font-weight: 700; color: #2C1A0E; }
.focus-action { flex-shrink: 0; font-size: 24rpx; font-weight: 700; color: #C84B2F; }

.workspace {
  flex: 1;
  min-height: 0;
  padding: 0 30rpx calc(150rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.work-panel {
  min-height: 0;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #FFFDF9;
  border: 1rpx solid #E5D8C8;
  box-shadow: 0 4rpx 14rpx rgba(44,26,14,.04);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.prep-panel { flex: 1.08; }
.material-panel { flex: 1; }
.discovery-panel { flex: .72; }
.panel-hd {
  height: 38rpx;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.panel-tag { font-size: 24rpx; font-weight: 750; }
.tag-clay { color: #B6442D; }
.tag-wheat { color: #8B650E; }
.tag-blue { color: #2D5A8E; }
.panel-note { font-size: 19rpx; color: #A89080; }

.prep-body,
.material-body,
.discovery-body {
  flex: 1;
  min-height: 0;
  display: flex;
  gap: 14rpx;
}
.prep-lead {
  width: 41%;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #FAEDEA;
  display: flex;
  flex-direction: column;
  position: relative;
}
.lead-icon,
.bundle-icon,
.jobs-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.lead-icon { background: #C84B2F; color: #fff; }
.lead-icon .ficon,
.bundle-icon .ficon,
.jobs-icon .ficon { width: 26rpx; height: 26rpx; }
.lead-title { margin-top: 10rpx; font-size: 28rpx; font-weight: 750; color: #6F2E21; }
.lead-sub { margin-top: 4rpx; max-width: 190rpx; font-size: 19rpx; line-height: 1.35; color: #98685B; }
.lead-arrow { position: absolute; right: 14rpx; bottom: 10rpx; font-size: 34rpx; color: #C84B2F; }
.prep-directory { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.prep-link,
.discovery-link {
  flex: 1;
  min-height: 0;
  border-bottom: 1rpx solid #F0E8DC;
  display: flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 650;
  color: #4A3020;
}
.prep-link:last-child,
.discovery-link:last-child { border-bottom: 0; }
.mini-icon,
.discovery-icon {
  width: 44rpx;
  color: #9B5F4C;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.mini-icon .ficon,
.discovery-icon .ficon { width: 24rpx; height: 24rpx; }
.mini-arrow { margin-left: auto; font-size: 29rpx; color: #C8B4A0; }

.bundle-lead {
  width: 38%;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #F5EDD8;
  display: flex;
  flex-direction: column;
}
.bundle-icon { background: #9C6E0A; color: #fff; }
.bundle-title { margin-top: 9rpx; font-size: 27rpx; font-weight: 750; color: #654909; }
.bundle-sub { margin-top: 3rpx; font-size: 18rpx; line-height: 1.35; color: #8F783F; }
.bundle-action { margin-top: auto; font-size: 21rpx; font-weight: 700; color: #8B650E; }
.material-grid {
  flex: 1;
  min-width: 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap: 8rpx;
}
.material-link {
  min-width: 0;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #F8F3E9;
  color: #624D31;
  display: flex;
  align-items: center;
  gap: 7rpx;
  font-size: 20rpx;
  font-weight: 650;
}
.material-link.wide { grid-column: span 2; }
.material-icon { color: #9C6E0A; display: flex; align-items: center; flex-shrink: 0; }
.material-icon .ficon { width: 22rpx; height: 22rpx; }

.jobs-lead {
  width: 52%;
  padding: 12rpx 14rpx;
  border-radius: 10rpx;
  background: #E8EFF8;
  display: flex;
  align-items: center;
  position: relative;
}
.jobs-icon { margin-right: 12rpx; background: #2D5A8E; color: #fff; }
.jobs-copy { display: flex; flex-direction: column; min-width: 0; }
.jobs-title { font-size: 26rpx; font-weight: 750; color: #244B76; }
.jobs-sub { margin-top: 4rpx; max-width: 210rpx; font-size: 17rpx; line-height: 1.35; color: #68809B; }
.jobs-arrow { position: absolute; right: 10rpx; bottom: 5rpx; font-size: 30rpx; color: #2D5A8E; }
.discovery-directory { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.discovery-link { font-size: 21rpx; }
.discovery-icon { color: #2D5A8E; }

.tap { transition: opacity 80ms; }
.tap-press { opacity: .68; }

@media (max-height: 720px) {
  .page-hd { height: 82rpx; }
  .focus-strip { height: 96rpx; margin-bottom: 10rpx; }
  .workspace { gap: 9rpx; padding-bottom: calc(142rpx + env(safe-area-inset-bottom)); }
  .work-panel { padding: 11rpx 14rpx; }
  .panel-hd { height: 32rpx; margin-bottom: 6rpx; }
  .lead-sub,
  .bundle-sub,
  .jobs-sub { display: none; }
}
