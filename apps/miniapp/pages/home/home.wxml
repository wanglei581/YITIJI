<view class="home-page">
  <view style="height:{{statusBarHeight}}px"></view>

  <!-- padding-right 让开微信胶囊：本行右侧的按钮实测整个落在胶囊矩形内，点不到。
       值由 app.js 运行时按 getMenuButtonBoundingClientRect 算，不能写死 rpx。 -->
  <view class="home-head" style="padding-right:{{capsuleInsetRight}}px">
    <!-- 原为「方块 logo + 主标题 + 副标题」的 B 端 header 写法，
         与下方「晚上好，同学」构成两个自我介绍区块叠在一起。
         收敛成一行品牌字：C 端小程序顶部要克制，把注意力让给问候与主功能。 -->
    <view class="brand-row">
      <text class="brand-name">职易达</text>
    </view>
    <view class="head-btn icon-action tap" hover-class="tap-press" bindtap="tapNotify" role="button" aria-label="查看消息通知">
      <text class="ficon i-bell" aria-hidden="true"></text>
    </view>
  </view>

  <scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="home-body">
      <view class="greeting">
        <text class="greet-title">{{greetWord}}，{{userName}}</text>
        <text class="greet-sub">{{todayStr}} · 今天也向理想工作靠近一点</text>
      </view>


      <!-- 原为 320rpx 的落地页式 hero（大标题+描述+CTA+半身抠图）。
           那是营销页语言，占掉首屏三分之一却只承载一个入口。
           改为对话入口条：圆头像 + 她「说」的一句话 + 箭头，像微信里一个真人在讲话。
           真人形象保留（对低数字素养用户，"有个人在帮我"比抽象图标更可信），
           但裁成 220px 头像后仅 7KB，远低于图片预算。 -->
      <view class="qing-bar tap" hover-class="tap-press" bindtap="tapService" data-url="/pages/assistant/assistant" role="button" aria-label="打开小青 AI 职业助手">
        <image class="qing-face" src="/assets/xiaoqing-avatar.jpg" mode="aspectFill" aria-hidden="true" />
        <view class="qing-copy">
          <view class="qing-name">小青 · AI 职业助手</view>
          <view class="qing-say">问我：简历怎么改、面试怎么准备、文件怎么打印</view>
        </view>
        <view class="qing-go"><text class="ficon i-right"></text></view>
      </view>

      <view class="info-card" style="margin-top:22rpx">
        <view class="info-row tap" hover-class="tap-press" bindtap="tapService"
              data-url="/pages/resume-voice/resume-voice"
              role="button" aria-label="语音说简历，一题一问，看字确认后再生成">
          <view class="info-icon soft-indigo"><text class="ficon i-comment"></text></view>
          <view class="info-copy">
            <text class="info-title">语音说简历</text>
            <text class="info-desc">一题一问，看字确认后再生成</text>
          </view>
          <view class="info-arrow"><text class="ficon i-right"></text></view>
        </view>
      </view>

      <view class="section-head">
        <text class="section-title">常用服务</text>
        <text class="section-more text-action" bindtap="tapLifeCircle" role="button" aria-label="查看 AI 百宝箱">AI 百宝箱</text>
      </view>
      <view class="service-grid">
        <view
          class="service-item tap"
          wx:for="{{primaryServices}}"
          wx:key="url"
          hover-class="tap-press"
          bindtap="tapService"
          data-url="{{item.url}}"
          role="button"
          aria-label="{{item.title}}"
        >
          <view class="service-icon tone-{{item.tone}}"><text class="ficon i-{{item.icon}}"></text></view>
          <text class="service-title">{{item.title}}</text>
        </view>
      </view>

      <view class="print-banner tap" hover-class="tap-press" bindtap="tapService" data-url="/pages/documents/documents" role="button" aria-label="从我的文档发起打印">
        <view class="print-icon"><text class="ficon i-printer"></text></view>
        <view class="print-copy">
          <text class="print-title">手机准备文件，到终端直接打印</text>
          <text class="print-desc">选择本人文档 · 生成到机码 · 扫码出纸</text>
        </view>
        <view class="print-go"><text class="ficon i-right"></text></view>
      </view>

      <view class="home-note">AI 生成的内容仅供参考，请核对后再使用。</view>
      <view class="tab-spacer"></view>
    </view>
  </scroll-view>
</view>
