/* pages/orders/orders.wxss  打印订单（墨翠鎏金白瓷） */
.orders-intro {
  margin: 16rpx 32rpx 0;
  padding: 26rpx 26rpx;
  border-radius: var(--r-lg);
  border: 1rpx solid rgba(223, 198, 147, .28);
  background: linear-gradient(150deg, #16483E 0%, #0C2B24 58%, #071915 100%);
  box-shadow: var(--sh-md);
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.oi-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: var(--r-full);
  background: rgba(223, 198, 147, .16);
  border: 1rpx solid rgba(223, 198, 147, .38);
  color: var(--gold-bright);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.oi-icon .ficon { width: 36rpx; height: 36rpx; }
.oi-copy { flex: 1; min-width: 0; }
.oi-title { font-size: var(--fs-md); font-weight: 750; color: #FFFFFF; }
.oi-sub { margin-top: 6rpx; font-size: var(--fs-xs); color: rgba(255, 255, 255, .74); }
.ord-content { padding-top: 20rpx; }

.ord-card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-sm);
  padding: 26rpx;
  margin: 0 32rpx 20rpx;
}

.oc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.oc-store {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--fs-sm);
  color: var(--muted);
  min-width: 0;
}
.oc-store-ic { font-size: var(--fs-base); color: var(--teal); flex-shrink: 0; }

.oc-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
}
.oc-thumb {
  flex-shrink: 0;
  width: 82rpx;
  height: 82rpx;
  border-radius: var(--r-full);
  background: radial-gradient(circle at 30% 28%, #ECF7F3 0%, #D9EEE6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-xl);
  color: var(--teal-deep);
}
.oc-info { flex: 1; min-width: 0; }
.oc-title {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.oc-spec {
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  color: var(--muted);
}

/* FG-2 规则保留：标签与 8 位到机码同行不折断，提示语独立折行 */
.pk-strip {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  row-gap: 8rpx;
  column-gap: 14rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--r-md);
  background: linear-gradient(135deg, #F3F9F6 0%, #FAF7F0 100%);
  border: 1rpx solid var(--gold-line);
  margin-bottom: 18rpx;
}
.pk-label { font-size: var(--fs-sm); color: var(--gold-deep); font-weight: 700; flex-shrink: 0; white-space: nowrap; }
.pk-code {
  font-size: var(--fs-lg);
  font-weight: 800;
  letter-spacing: 4rpx;
  color: var(--teal-deep);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  white-space: nowrap;
}
.pk-hint { font-size: var(--fs-xs); color: var(--muted); flex: 1 0 100%; line-height: 1.4; }

.oc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid var(--line-faint);
  padding-top: 18rpx;
}
.oc-price {
  font-size: var(--fs-lg);
  font-weight: 800;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  white-space: nowrap;
}
.oc-btns { display: flex; flex-wrap: wrap; gap: 14rpx; justify-content: flex-end; }
.oc-note {
  flex: 1;
  align-self: center;
  font-size: var(--fs-sm);
  line-height: 1.5;
  color: var(--ink-faint, var(--ink-soft));
}
.oc-btn {
  min-height: 48px;
  min-width: 48px;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
  border: 1rpx solid var(--line);
  font-size: var(--fs-sm);
  font-weight: 650;
  color: var(--ink-soft);
  background: var(--surface);
}
.oc-btn.pri {
  background: linear-gradient(135deg, #16483E 0%, #0A2720 100%);
  color: var(--gold-bright);
  border-color: rgba(223, 198, 147, .36);
}
.oc-btn.cancel {
  color: var(--ink);
}
.oc-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.empty-slot {
  padding: 60rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.es-ic { font-size: var(--fs-2xl); color: var(--faint); margin-bottom: 20rpx; }
.es-t { font-size: var(--fs-md); font-weight: 700; color: var(--ink-soft); }
.es-d { margin-top: 8rpx; font-size: var(--fs-sm); color: var(--muted); }
.empty-slot .btn { margin-top: 28rpx; }

.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 28rpx 32rpx 14rpx;
}
.sh-t { font-size: var(--fs-lg); font-weight: 750; color: var(--ink); }
.sh-n { font-size: var(--fs-sm); color: var(--muted); font-variant-numeric: tabular-nums; }

.ord-card.pkg { border-left: 6rpx solid var(--gold); }

.pkg-meta { margin-top: 16rpx; display: flex; flex-direction: column; gap: 10rpx; }
.pm-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.pm-k { flex: 0 0 auto; font-size: var(--fs-sm); color: var(--muted); }
.pm-v {
  flex: 1;
  text-align: right;
  font-size: var(--fs-sm);
  color: var(--ink-soft);
  word-break: break-all;
}

.load-more {
  margin: 16rpx 32rpx 20rpx;
  min-height: 48px;
  border-radius: var(--r-full);
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  box-shadow: var(--sh-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--teal-deep);
}
.list-foot {
  padding: 24rpx 0;
  text-align: center;
  font-size: var(--fs-sm);
  color: var(--muted);
}
.list-foot.warn { color: var(--clay); }
.lf-retry {
  display: inline-block;
  margin-left: 12rpx;
  min-height: 48px;
  line-height: 48px;
  padding: 0 24rpx;
  color: var(--teal-deep);
  font-weight: 650;
}
