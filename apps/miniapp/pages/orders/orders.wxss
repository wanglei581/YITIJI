/* pages/orders/orders.wxss */
.orders-intro {
  margin: 20rpx 32rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid #dce9ff;
  background: #f3f8ff;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.oi-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 21rpx;
  background: var(--teal);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.oi-icon .ficon { width: 34rpx; height: 34rpx; }
.oi-copy { flex: 1; min-width: 0; }
.oi-title { font-size: var(--fs-base); font-weight: 700; color: var(--ink); }
.oi-sub { margin-top: 4rpx; font-size: var(--fs-sm); color: var(--muted); }
.ord-content { padding-top: 20rpx; }

.ord-card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: none;
  padding: 24rpx;
  margin: 0 32rpx 20rpx;
}

.oc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.oc-store {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--fs-sm);
  color: var(--muted);
  min-width: 0;
}
.oc-store-ic { font-size: var(--fs-base); color: var(--teal); flex-shrink: 0; }

.oc-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
}
.oc-thumb {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r);
  background: var(--teal-wash);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-xl);
  color: var(--teal-deep);
}
.oc-info { flex: 1; min-width: 0; }
.oc-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
  /* 文件名最多两行、可任意处断行：选错的两份文件往往只差中间一段，单行省略会把它截掉。 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}
.oc-spec {
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  color: var(--muted);
}

/* 到机码：标签和码同一行、都不折行；说明另起一行（10/16 截图：三列挤在一行时，8 位码和
   「到机码」都被挤成两行）。卡片自己有边框，这一条只用浅底，不再卡里套卡。 */
.pk-strip {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r);
  background: var(--teal-wash);
  margin-bottom: 18rpx;
}
.pk-row { display: flex; align-items: baseline; gap: 16rpx; }
.pk-label { flex-shrink: 0; white-space: nowrap; font-size: var(--fs-sm); color: var(--teal-deep); font-weight: 600; }
.pk-code {
  flex-shrink: 0;
  white-space: nowrap;
  font-size: var(--fs-lg);
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.pk-hint { font-size: var(--fs-sm); color: var(--muted); line-height: 1.5; }

.oc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid var(--line-faint);
  padding-top: 18rpx;
}
.oc-price {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  white-space: nowrap;
}
.oc-btns { display: flex; flex-wrap: wrap; gap: 14rpx; justify-content: flex-end; }
/* 一体机历史任务的说明文字。不是按钮：它没有可点的去处，
   做成按钮样子等于又给一次点击预期。 */
.oc-note {
  flex: 1;
  align-self: center;
  font-size: var(--fs-sm);
  line-height: 1.5;
  color: var(--ink-faint, var(--ink-soft));
}
.oc-btn {
  min-height: 48px;
  min-width: 48px;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r);
  border: 1rpx solid var(--line-soft);
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink-soft);
  background: var(--surface);
}
.oc-btn.pri {
  background: var(--teal);
  color: #fff;
  border-color: var(--teal);
}
.oc-btn.cancel {
  color: var(--ink);
}
.oc-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.empty-slot {
  padding: 60rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.es-ic { font-size: 88rpx; color: var(--faint); margin-bottom: 20rpx; }
.es-t { font-size: var(--fs-md); font-weight: 600; color: var(--ink-soft); }
.es-d { margin-top: 8rpx; font-size: var(--fs-sm); color: var(--muted); }
.empty-slot .btn { margin-top: 28rpx; }

/* ── 分区头：材料包 / 单件打印是两个独立来源，标题必须把这件事说清楚，
   否则用户会以为「材料包订单」只是同一列表的一段，看不到就以为丢了。 */
.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 28rpx 32rpx 12rpx;
}

/* 「从来没有订单」的紧凑空态：一行说清，不再用整张空卡把另一个分区的真实订单挤下去。 */
.empty-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 32rpx 20rpx;
  padding: 18rpx 24rpx;
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line-soft);
  background: var(--surface);
}
.er-ic { flex-shrink: 0; font-size: var(--fs-lg); color: var(--faint); }
.er-body { flex: 1; min-width: 0; }
.er-t { flex: 1; min-width: 0; font-size: var(--fs-base); font-weight: 600; color: var(--ink-soft); }
.er-body .er-t { flex: none; }
.er-d { margin-top: 4rpx; font-size: var(--fs-sm); color: var(--muted); line-height: 1.5; }
.er-act {
  flex-shrink: 0;
  min-height: 48px;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  border-radius: var(--r);
  border: 1rpx solid var(--teal);
  color: var(--teal);
  background: var(--surface);
  font-size: var(--fs-sm);
  font-weight: 600;
}
.sh-t { font-size: var(--fs-lg); font-weight: 700; color: var(--ink); }
.sh-n { font-size: var(--fs-sm); color: var(--muted); font-variant-numeric: tabular-nums; }

/* 材料包卡片整卡可点（只带 orderId 进到机码页），左侧留一条色带作区分。 */
.ord-card.pkg { border-left: 6rpx solid var(--teal); }

.pkg-meta { margin-top: 16rpx; display: flex; flex-direction: column; gap: 10rpx; }
.pm-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.pm-k { flex: 0 0 auto; font-size: var(--fs-sm); color: var(--muted); }
.pm-v {
  flex: 1;
  text-align: right;
  font-size: var(--fs-sm);
  color: var(--ink-soft);
  word-break: break-all;
}

/* 「加载更多」是材料包分区自己的游标出口，48px 触控高度。 */
.load-more { min-height: 48px; margin-top: 16rpx; }
.list-foot {
  padding: 24rpx 0;
  text-align: center;
  font-size: var(--fs-sm);
  color: var(--muted);
}

/* 失败页脚：分区已经有内容时，失败信息降为一条页脚，不把已加载的订单顶掉。 */
.list-foot.warn { color: var(--clay); }
.lf-retry {
  display: inline-block;
  margin-left: 12rpx;
  min-height: 48px;
  line-height: 48px;
  padding: 0 24rpx;
  color: var(--teal);
  font-weight: 600;
}
