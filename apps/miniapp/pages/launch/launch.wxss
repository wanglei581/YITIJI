page {
  height: 100%;
  background: linear-gradient(160deg, #0d2b24 0%, #1a4438 100%);
}

.launch-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.launch-mid {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx 48rpx;
}

.launch-icon-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 56rpx;
  background: rgba(31, 158, 134, .18);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 56rpx;
  box-shadow:
    0 0 0 20rpx rgba(31, 158, 134, .09),
    0 0 0 44rpx rgba(31, 158, 134, .045),
    0 0 120rpx rgba(31, 158, 134, .22),
    inset 0 2rpx 0 rgba(255, 255, 255, .08);
}

.launch-icon-ic {
  font-size: 96rpx;
  color: rgba(31, 158, 134, .9);
}

.launch-brand {
  font-family: var(--font-serif);
  font-size: 46rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, .95);
  text-align: center;
  letter-spacing: 3rpx;
  line-height: 1.45;
}

.launch-sub {
  font-size: 23rpx;
  color: rgba(255, 255, 255, .38);
  letter-spacing: 5rpx;
  text-align: center;
  margin-top: 16rpx;
}

.launch-divider {
  width: 80rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, .12);
  margin-top: 64rpx;
}

.launch-btns {
  padding: 0 48rpx 96rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 覆盖 btn 默认样式以适配深色背景 */
.launch-btn-wx {
  height: 112rpx !important;
  font-size: 32rpx !important;
  border-radius: 32rpx !important;
  letter-spacing: 2rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.launch-btn-guest {
  height: 104rpx !important;
  background: transparent !important;
  color: rgba(255, 255, 255, .75) !important;
  border: 3rpx solid rgba(255, 255, 255, .28) !important;
  border-radius: 32rpx !important;
  font-size: 30rpx !important;
}

.launch-btn-guest::after {
  border: none !important;
}

.launch-alt {
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, .55);
  padding: 8rpx 0;
  letter-spacing: 1rpx;
}

.launch-legal {
  font-size: 20rpx;
  color: rgba(255, 255, 255, .28);
  text-align: center;
  line-height: 1.75;
  margin-top: 4rpx;
}

.launch-agree {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 48rpx;
  color: rgba(255, 255, 255, .52);
}

.launch-check {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, .45);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
}

.launch-check.checked {
  background: #1f9e86;
  border-color: #1f9e86;
}

.launch-link {
  color: rgba(255, 255, 255, .5);
  text-decoration: underline;
}

/* ── 短信验证码内嵌表单 ─────────────────────────────────────────── */

.sms-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sms-phone-wrap {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, .08);
  border: 2rpx solid rgba(255, 255, 255, .18);
  border-radius: 24rpx;
  height: 104rpx;
  padding: 0 24rpx;
  gap: 16rpx;
}

.sms-prefix {
  font-size: 28rpx;
  color: rgba(255, 255, 255, .6);
  flex-shrink: 0;
  padding-right: 12rpx;
  border-right: 2rpx solid rgba(255, 255, 255, .15);
}

.sms-phone-input {
  flex: 1;
  font-size: 30rpx;
  color: #fff;
  height: 100%;
}

.sms-send-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #1f9e86;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(31, 158, 134, .15);
  white-space: nowrap;
}

.sms-send-btn.counting {
  color: rgba(255, 255, 255, .35);
  background: transparent;
}

.sms-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, .4);
  padding-left: 8rpx;
}

/* OTP 格子 */
.sms-otp-wrap {
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  padding: 8rpx 0;
}

.sms-otp-box {
  flex: 1;
  height: 96rpx;
  border: 2rpx solid rgba(255, 255, 255, .2);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
}

.sms-otp-box.active {
  border-color: #1f9e86;
  background: rgba(31, 158, 134, .1);
}

.sms-otp-box.filled {
  border-color: rgba(255, 255, 255, .45);
}

/* 透明覆盖层承接键盘输入 */
.sms-otp-hidden {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  opacity: 0;
  font-size: 1rpx;
}

/* 短信模式确认按钮 */
.launch-btn-sms-confirm {
  height: 112rpx !important;
  font-size: 32rpx !important;
  border-radius: 32rpx !important;
  background: #1f9e86 !important;
  color: #fff !important;
}

.launch-btn-sms-confirm::after {
  border: none !important;
}
