/* pages/launch/launch.wxss
   青绪 · 墨翠鎏金白瓷旗舰版登录页：只动本页样式，登录逻辑与文案零改动。
   颜色全部取 app.wxss 体系，字号与圆角严格落在 --fs-* / --r-* 刻度内。 */

page { height: 100%; background: #0C2B24; }

.lg {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(162deg, #174B40 0%, #0D2F28 48%, #071A15 100%);
}

/* ── 上半：墨翠品牌 + 出纸台 ───────────────────────────────── */
.lg-hero { flex: 1; position: relative; z-index: 1; display: flex; flex-direction: column; }

.lg-brand {
  flex: 1;
  min-height: 240rpx;
  padding: 112rpx 48rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lg-mark {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: var(--r-md);
  background: linear-gradient(140deg, rgba(223, 198, 147, .22) 0%, rgba(182, 154, 104, .08) 100%);
  border: 2rpx solid rgba(223, 198, 147, .48);
  color: var(--gold-bright);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, .24);
}
.lg-mark-ic { width: 56rpx; height: 56rpx; }
.lg-brand-copy { margin-left: 24rpx; display: flex; flex-direction: column; }
.lg-name { font-size: var(--fs-2xl); line-height: 1.15; font-weight: 800; letter-spacing: 6rpx; color: #FFFFFF; }
.lg-tagline { margin-top: 8rpx; font-size: var(--fs-sm); line-height: 1.4; letter-spacing: 2rpx; color: var(--gold-bright); }

/* 出纸台：纯白高定信纸自出纸槽升出 */
.lg-stage { position: relative; height: 520rpx; flex-shrink: 0; }
.lg-sheet {
  position: absolute;
  left: 50%;
  top: 32rpx;
  width: 540rpx;
  height: 640rpx;
  margin-left: -270rpx;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1rpx solid rgba(223, 198, 147, .35);
}
.lg-sheet-back {
  background: #F4F6F4;
  border-color: rgba(223, 198, 147, .25);
  transform: rotate(4deg) translate(6%, 1%);
  animation: lg-print-back 1s cubic-bezier(.16, .84, .3, 1) .05s both;
}
.lg-sheet-front {
  padding: 52rpx 56rpx 0;
  box-shadow: var(--sh-lg);
  animation: lg-print 1s cubic-bezier(.16, .84, .3, 1) .15s both;
}
.lg-sheet-rule {
  width: 64rpx;
  height: 8rpx;
  margin-bottom: 32rpx;
  border-radius: var(--r-full);
  background: linear-gradient(90deg, var(--teal) 0%, var(--gold) 100%);
}
.lg-sheet-h { font-size: var(--fs-xl); line-height: 1.4; font-weight: 800; letter-spacing: 1rpx; color: var(--ink); }
.lg-sheet-sub { margin-top: 14rpx; font-size: var(--fs-base); line-height: 1.5; font-weight: 700; letter-spacing: 2rpx; color: var(--gold-deep); }
.lg-sheet-line { height: 10rpx; margin-top: 22rpx; border-radius: var(--r-full); background: var(--surface-3); }
.lg-sheet-sub + .lg-sheet-line { margin-top: 44rpx; }
.lg-w86 { width: 86%; }
.lg-w92 { width: 92%; }
.lg-w60 { width: 60%; }
.lg-para { margin-top: 40rpx; }

@keyframes lg-print {
  from { transform: translateY(80%); }
  to   { transform: translateY(0); }
}
@keyframes lg-print-back {
  from { transform: rotate(4deg) translate(6%, 84%); }
  to   { transform: rotate(4deg) translate(6%, 1%); }
}

/* ── 下半：纯白瓷登录底座卡片 ──────────────────────────────── */
.lg-panel {
  position: relative;
  z-index: 2;
  padding: 56rpx 44rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  background: var(--surface);
  box-shadow: 0 -16rpx 44rpx rgba(5, 19, 16, .28);
}
.lg-slot {
  position: absolute;
  left: 50%;
  top: -12rpx;
  width: 640rpx;
  height: 24rpx;
  margin-left: -320rpx;
  border-radius: var(--r-full);
  background: linear-gradient(180deg, #071915 0%, #17463C 100%);
  border: 1rpx solid rgba(223, 198, 147, .35);
}

.lg-title { font-size: var(--fs-lg); line-height: 1.3; font-weight: 800; color: var(--ink); }
.lg-sub { margin-top: 10rpx; font-size: var(--fs-sm); line-height: 1.5; color: var(--muted); }

/* 协议未发布（C4） */
.lg-blocked { margin-top: 28rpx; padding: 22rpx 24rpx; border-radius: var(--r-md); background: var(--warn-soft); border: 1rpx solid var(--gold-line); display: flex; align-items: flex-start; }
.lg-blocked-ic { width: 30rpx; height: 30rpx; margin-top: 5rpx; margin-right: 14rpx; color: var(--wheat-deep); }
.lg-blocked-body { flex: 1; min-width: 0; }
.lg-blocked-t { font-size: var(--fs-base); line-height: 1.5; font-weight: 700; color: var(--wheat-deep); }
.lg-blocked-d { margin-top: 6rpx; font-size: var(--fs-sm); line-height: 1.6; color: var(--ink-soft); }

/* 短信验证码表单 */
.lg-field {
  margin-top: 32rpx;
  height: 100rpx;
  padding-left: 24rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--surface-2);
  display: flex;
  align-items: center;
}
.lg-prefix { padding-right: 18rpx; margin-right: 18rpx; border-right: 1rpx solid var(--line); font-size: var(--fs-md); line-height: 1.2; color: var(--ink-soft); }
.lg-phone { flex: 1; min-width: 0; height: 100%; font-size: var(--fs-md); color: var(--ink); }
.lg-ph { color: var(--faint); }
.lg-send {
  align-self: stretch;
  flex-shrink: 0;
  min-width: 196rpx;
  padding: 0 24rpx;
  border-left: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-base);
  font-weight: 650;
  color: var(--link);
  white-space: nowrap;
}
.lg-send.is-off { color: var(--faint); font-weight: 500; }
.lg-hint { margin-top: 12rpx; padding-left: 4rpx; font-size: var(--fs-sm); line-height: 1.5; color: var(--muted); }

.lg-otp { position: relative; margin-top: 24rpx; display: flex; justify-content: space-between; }
.lg-otp-box {
  width: 96rpx;
  height: 100rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r);
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-xl);
  font-weight: 750;
  color: var(--ink);
}
.lg-otp-box.is-filled { background: var(--surface); }
.lg-otp-box.is-active { border-color: var(--teal); background: var(--teal-wash); }
.lg-otp-input { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; font-size: 1rpx; }

/* 协议勾选 */
.lg-consent { margin-top: 28rpx; min-height: 96rpx; padding: 10rpx 0; display: flex; align-items: flex-start; }
.lg-check {
  width: 36rpx;
  height: 36rpx;
  margin-top: 2rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--ghost);
  border-radius: var(--r-full);
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color .18s ease, border-color .18s ease;
}
.lg-check.is-on { border-color: var(--teal-deep); background: var(--teal-deep); }
.lg-check-ic { width: 22rpx; height: 22rpx; color: var(--gold-bright); }
.lg-consent-copy { flex: 1; min-width: 0; font-size: var(--fs-sm); line-height: 1.75; color: var(--muted); }
.lg-link { padding: 34rpx 2rpx; color: var(--link); font-weight: 600; }

/* 主按钮：墨翠深松渐变 + 鎏金高光字 */
.lg-btn {
  margin-top: 20rpx !important;
  height: 100rpx !important;
  border-radius: var(--r-full) !important;
  background: linear-gradient(135deg, #16483E 0%, #0A2720 100%) !important;
  border: 1rpx solid rgba(223, 198, 147, .4) !important;
  color: var(--gold-bright) !important;
  font-size: var(--fs-md) !important;
  font-weight: 700 !important;
  letter-spacing: 2rpx;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-shadow: var(--sh-sm);
}
.lg-btn::after { border: none !important; }
.lg-btn[disabled] { opacity: .42; }

.lg-alts { margin-top: 8rpx; display: flex; align-items: center; }
.lg-alt { flex: 1; min-height: 96rpx; display: flex; align-items: center; justify-content: center; font-size: var(--fs-base); color: var(--muted); }
.lg-alt-sms { font-weight: 650; color: var(--link); }
.lg-alt-sep { width: 1rpx; height: 28rpx; background: var(--line); }

.lg-back { margin-top: 8rpx; min-height: 96rpx; display: flex; align-items: center; justify-content: center; font-size: var(--fs-base); font-weight: 650; color: var(--link); }
.lg-back-ic { width: 22rpx; height: 22rpx; margin-right: 10rpx; transform: rotate(180deg); }

.is-sms .lg-brand { min-height: 200rpx; padding-bottom: 20rpx; }
.is-sms .lg-stage { height: 340rpx; }

@media (max-height: 700px) {
  .lg-brand { min-height: 172rpx; padding-top: 72rpx; padding-bottom: 12rpx; }
  .lg-mark { width: 88rpx; height: 88rpx; }
  .lg-mark-ic { width: 48rpx; height: 48rpx; }
  .lg-name { font-size: var(--fs-xl); }
  .lg-stage { height: 400rpx; }
  .lg-sheet { top: 24rpx; width: 480rpx; margin-left: -240rpx; }
  .lg-sheet-front { padding: 44rpx 48rpx 0; }
  .is-sms .lg-brand { min-height: 172rpx; padding-bottom: 12rpx; }
  .is-sms .lg-stage { height: 304rpx; }
}
