/* pages/launch/launch.wxss
   2026-11-12 登录页改版：只动本页，共用类一个不改。
   颜色全部取 app.wxss 的变量；字号、圆角只用 --fs-* / --r-* 刻度（verify-miniapp-visual-scale）。
   本页不再用 .btn.wx 的绿色，主按钮是小程序品牌主色 --teal。
   阴影只用中性的 --sh-*（app.wxss 质感层：不用彩色辉光）。 */

page { height: 100%; background: var(--teal-soft); }

.lg {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, var(--teal-soft) 0%, var(--teal-wash) 52%, var(--paper-deep) 100%);
}

/* ── 上半：品牌 + 出纸 ─────────────────────────────────────── */
.lg-hero { flex: 1; position: relative; z-index: 1; display: flex; flex-direction: column; }

/* 顶部留出右上角系统胶囊那一行，字标不进那一行；上多下少，字标落在胶囊和纸之间的视觉中线上 */
.lg-brand {
  flex: 1;
  min-height: 240rpx;
  padding: 112rpx 48rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lg-mark {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: var(--r);
  background: var(--teal);
  color: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
}
.lg-mark-ic { width: 56rpx; height: 56rpx; }
.lg-brand-copy { margin-left: 24rpx; display: flex; flex-direction: column; }
.lg-name { font-size: var(--fs-2xl); line-height: 1.15; font-weight: 800; letter-spacing: 6rpx; color: var(--ink); }
.lg-tagline { margin-top: 8rpx; font-size: var(--fs-sm); line-height: 1.4; letter-spacing: 2rpx; color: var(--muted); }

/* 出纸台：纸的下沿落到登录卡片后面，看上去是从出纸口里出来的 */
.lg-stage { position: relative; height: 520rpx; flex-shrink: 0; }
.lg-sheet {
  position: absolute;
  left: 50%;
  top: 32rpx;
  width: 540rpx;
  height: 640rpx;
  margin-left: -270rpx;
  border-radius: var(--r-xs);
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
}
.lg-sheet-back {
  border-color: var(--line);
  transform: rotate(4deg) translate(34rpx, 6rpx);
  animation: lg-print-back 1s cubic-bezier(.16, .84, .3, 1) .05s both;
}
.lg-sheet-front {
  padding: 52rpx 56rpx 0;
  box-shadow: var(--sh-md);
  animation: lg-print 1s cubic-bezier(.16, .84, .3, 1) .15s both;
}
.lg-sheet-rule { width: 56rpx; height: 8rpx; margin-bottom: 32rpx; border-radius: var(--r-full); background: var(--teal); }
.lg-sheet-h { font-size: var(--fs-xl); line-height: 1.4; font-weight: 800; letter-spacing: 1rpx; color: var(--ink); }
.lg-sheet-sub { margin-top: 14rpx; font-size: var(--fs-base); line-height: 1.5; font-weight: 600; letter-spacing: 2rpx; color: var(--teal-deep); }
.lg-sheet-line { height: 10rpx; margin-top: 22rpx; border-radius: var(--r-full); background: var(--surface-3); }
.lg-sheet-sub + .lg-sheet-line { margin-top: 44rpx; }
.lg-w86 { width: 86%; }
.lg-w92 { width: 92%; }
.lg-w60 { width: 60%; }
.lg-para { margin-top: 40rpx; }

/* 打开页面时纸从出纸口里出来一次；起点整张藏在卡片后面 */
@keyframes lg-print {
  from { transform: translateY(470rpx); }
  to   { transform: translateY(0); }
}
@keyframes lg-print-back {
  from { transform: rotate(4deg) translate(34rpx, 520rpx); }
  to   { transform: rotate(4deg) translate(34rpx, 6rpx); }
}

/* ── 下半：登录卡片 ───────────────────────────────────────── */
.lg-panel {
  position: relative;
  z-index: 2;
  padding: 56rpx 44rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  background: var(--surface);
}
/* 出纸口：横在卡片上沿的一道深色槽 */
.lg-slot {
  position: absolute;
  left: 50%;
  top: -12rpx;
  width: 640rpx;
  height: 24rpx;
  margin-left: -320rpx;
  border-radius: var(--r-full);
  background: linear-gradient(180deg, var(--ink) 0%, var(--ink-soft) 100%);
}

.lg-title { font-size: var(--fs-lg); line-height: 1.3; font-weight: 750; color: var(--ink); }
.lg-sub { margin-top: 10rpx; font-size: var(--fs-sm); line-height: 1.5; color: var(--muted); }

/* 协议未发布（C4）：写清为什么不能登录、不登录还能做什么 */
.lg-blocked { margin-top: 28rpx; padding: 22rpx 24rpx; border-radius: var(--r); background: var(--warn-soft); display: flex; align-items: flex-start; }
.lg-blocked-ic { width: 30rpx; height: 30rpx; margin-top: 5rpx; margin-right: 14rpx; color: var(--wheat-deep); }
.lg-blocked-body { flex: 1; min-width: 0; }
.lg-blocked-t { font-size: var(--fs-base); line-height: 1.5; font-weight: 700; color: var(--wheat-deep); }
.lg-blocked-d { margin-top: 6rpx; font-size: var(--fs-sm); line-height: 1.6; color: var(--ink-soft); }

/* 短信验证码表单 */
.lg-field {
  margin-top: 32rpx;
  height: 100rpx;
  padding-left: 24rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r);
  background: var(--surface-2);
  display: flex;
  align-items: center;
}
.lg-prefix { padding-right: 18rpx; margin-right: 18rpx; border-right: 1rpx solid var(--line); font-size: var(--fs-md); line-height: 1.2; color: var(--ink-soft); }
.lg-phone { flex: 1; min-width: 0; height: 100%; font-size: var(--fs-md); color: var(--ink); }
.lg-ph { color: var(--faint); }
/* 整条右侧都是「发送验证码」的可点区（96rpx 高），不是一颗小胶囊 */
.lg-send {
  align-self: stretch;
  flex-shrink: 0;
  min-width: 196rpx;
  padding: 0 24rpx;
  border-left: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--link);
  white-space: nowrap;
}
.lg-send.is-off { color: var(--faint); font-weight: 500; }
.lg-hint { margin-top: 12rpx; padding-left: 4rpx; font-size: var(--fs-sm); line-height: 1.5; color: var(--muted); }

.lg-otp { position: relative; margin-top: 24rpx; display: flex; justify-content: space-between; }
.lg-otp-box {
  width: 96rpx;
  height: 100rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r);
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--ink);
}
.lg-otp-box.is-filled { background: var(--surface); }
.lg-otp-box.is-active { border-color: var(--teal); background: var(--teal-wash); }
/* 透明输入框盖在格子上收数字。1rpx 字号沿用改版前那一行：聚焦时原生输入框可能不吃 opacity，字号压到最小免得露字 */
.lg-otp-input { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; font-size: 1rpx; }

/* 协议勾选：两行，整块可点（96rpx 起）；协议名是单独的链接 */
.lg-consent { margin-top: 28rpx; min-height: 96rpx; padding: 10rpx 0; display: flex; align-items: flex-start; }
.lg-check {
  width: 36rpx;
  height: 36rpx;
  margin-top: 2rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--ghost);
  border-radius: var(--r-full);
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color .18s ease, border-color .18s ease;
}
.lg-check.is-on { border-color: var(--teal); background: var(--teal); }
.lg-check-ic { width: 22rpx; height: 22rpx; color: var(--surface); }
.lg-consent-copy { flex: 1; min-width: 0; font-size: var(--fs-sm); line-height: 1.75; color: var(--muted); }
/* 链接上下各补 34rpx 内边距，可点区到 96rpx，不撑开行距 */
.lg-link { padding: 34rpx 2rpx; color: var(--link); }

/* 主按钮：品牌蓝实底；没勾协议时整颗变淡（.btn[disabled]） */
.lg-btn {
  margin-top: 20rpx !important;
  height: 100rpx !important;
  border-radius: var(--r-md) !important;
  background: var(--teal) !important;
  color: var(--surface) !important;
  font-size: var(--fs-md) !important;
  font-weight: 650 !important;
  letter-spacing: 2rpx;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}
.lg-btn::after { border: none !important; }
.lg-btn[disabled] { opacity: .42; }

.lg-alts { margin-top: 8rpx; display: flex; align-items: center; }
.lg-alt { flex: 1; min-height: 96rpx; display: flex; align-items: center; justify-content: center; font-size: var(--fs-base); color: var(--muted); }
.lg-alt-sms { font-weight: 600; color: var(--link); }
.lg-alt-sep { width: 1rpx; height: 28rpx; background: var(--line); }

.lg-back { margin-top: 8rpx; min-height: 96rpx; display: flex; align-items: center; justify-content: center; font-size: var(--fs-base); font-weight: 600; color: var(--link); }
.lg-back-ic { width: 22rpx; height: 22rpx; margin-right: 10rpx; transform: rotate(180deg); }

/* 短信表单展开时卡片高出一截：出纸台收矮，纸只露出标题，表单不用滚动 */
.is-sms .lg-brand { min-height: 200rpx; padding-bottom: 20rpx; }
.is-sms .lg-stage { height: 340rpx; }

/* 矮屏（iPhone SE 一类）：字标、出纸台收小，把高度让给登录卡片 */
@media (max-height: 700px) {
  .lg-brand { min-height: 172rpx; padding-top: 72rpx; padding-bottom: 12rpx; }
  .lg-mark { width: 88rpx; height: 88rpx; }
  .lg-mark-ic { width: 48rpx; height: 48rpx; }
  .lg-name { font-size: var(--fs-xl); }
  .lg-stage { height: 400rpx; }
  .lg-sheet { top: 24rpx; width: 480rpx; margin-left: -240rpx; }
  .lg-sheet-front { padding: 44rpx 48rpx 0; }
  .is-sms .lg-brand { min-height: 172rpx; padding-bottom: 12rpx; }
  .is-sms .lg-stage { height: 304rpx; }
}
