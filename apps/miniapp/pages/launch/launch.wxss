page { height: 100%; background: #eef4ff; }

.launch-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: #eef4ff;
}

.launch-mid {
  flex: 1;
  min-height: 520rpx;
  padding: 70rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.launch-icon-wrap {
  width: 150rpx;
  height: 150rpx;
  border-radius: 42rpx;
  background: var(--teal);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 44rpx rgba(22,119,255,.2);
}
.launch-icon-ic { width: 76rpx; height: 76rpx; }
.launch-brand { margin-top: 38rpx; font-size: 54rpx; line-height: 1.2; font-weight: 850; color: #14213d; letter-spacing: 3rpx; }
.launch-sub { margin-top: 16rpx; font-size: 24rpx; color: #536580; letter-spacing: 2rpx; }
.launch-slogan { margin-top: 48rpx; font-size: 25rpx; color: #7b8aa1; }

.launch-btns {
  padding: 18rpx 42rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 46rpx 46rpx 0 0;
  background: #fff;
  box-shadow: 0 -16rpx 48rpx rgba(28,45,72,.07);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 4rpx; border-radius: 999rpx; background: #dbe2ec; }
.sheet-title { margin-top: 6rpx; font-size: 36rpx; font-weight: 780; color: var(--ink); }
.sheet-sub { margin-top: -8rpx; margin-bottom: 10rpx; font-size: 22rpx; color: var(--muted); line-height: 1.5; }

.launch-btn-wx,
.launch-btn-sms-confirm {
  height: 100rpx !important;
  border-radius: 25rpx !important;
  font-size: 29rpx !important;
  font-weight: 700 !important;
  color: #fff !important;
  background: #07c160 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-shadow: 0 12rpx 26rpx rgba(7,193,96,.15);
}
.launch-btn-sms-confirm { background: var(--teal) !important; box-shadow: 0 12rpx 26rpx rgba(22,119,255,.15); }
.launch-wx-icon { width: 34rpx; height: 34rpx; margin-right: 12rpx; }
.launch-btn-guest {
  height: 88rpx !important;
  border-radius: 23rpx !important;
  border: 1rpx solid var(--line) !important;
  background: var(--surface-2) !important;
  color: var(--ink-soft) !important;
  font-size: 27rpx !important;
}
.launch-btn-wx::after,
.launch-btn-guest::after,
.launch-btn-sms-confirm::after { border: none !important; }
.launch-btn-wx[disabled] { opacity: .45; }
.launch-alt { min-height: 54rpx; display: flex; align-items: center; justify-content: center; color: var(--teal); font-size: 23rpx; font-weight: 600; }
.launch-back-icon { width: 20rpx; height: 20rpx; margin-right: 9rpx; transform: rotate(180deg); }

.launch-legal { padding-top: 4rpx; color: var(--faint); font-size: 20rpx; line-height: 1.7; text-align: center; }
.launch-agree { min-height: 46rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; color: var(--muted); }
.launch-check { width: 30rpx; height: 30rpx; border-radius: 9rpx; border: 2rpx solid var(--ghost); display: flex; align-items: center; justify-content: center; }
.launch-check.checked { border-color: var(--teal); background: var(--teal); }
.check-dot { width: 11rpx; height: 11rpx; border-radius: 50%; background: #fff; }
.launch-link { color: var(--teal); }

.sms-field { display: flex; flex-direction: column; gap: 10rpx; }
.sms-phone-wrap { height: 96rpx; padding: 0 22rpx; border: 2rpx solid var(--line); border-radius: 24rpx; background: var(--surface-2); display: flex; align-items: center; gap: 16rpx; }
.sms-prefix { padding-right: 14rpx; border-right: 1rpx solid var(--line); color: var(--muted); font-size: 26rpx; }
.sms-phone-input { flex: 1; height: 100%; color: var(--ink); font-size: 28rpx; }
.sms-send-btn { flex-shrink: 0; padding: 12rpx 18rpx; border-radius: 15rpx; color: var(--teal); background: var(--teal-soft); font-size: 22rpx; white-space: nowrap; }
.sms-send-btn.counting { color: var(--faint); background: var(--surface-3); }
.sms-hint { padding-left: 6rpx; color: var(--muted); font-size: 21rpx; }
.sms-otp-wrap { display: flex; gap: 12rpx; justify-content: space-between; padding: 4rpx 0; }
.sms-otp-box { flex: 1; height: 82rpx; border-radius: 20rpx; border: 2rpx solid var(--line); background: var(--surface-2); color: var(--ink); font-size: 34rpx; font-weight: 650; display: flex; align-items: center; justify-content: center; }
.sms-otp-box.active { border-color: var(--teal); background: var(--teal-wash); }
.sms-otp-box.filled { border-color: #a9c9ff; }
.sms-otp-hidden { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; font-size: 1rpx; }

@media (max-height: 720px) {
  .launch-mid { min-height: 390rpx; padding-top: 32rpx; padding-bottom: 28rpx; }
  .launch-icon-wrap { width: 116rpx; height: 116rpx; border-radius: 34rpx; }
  .launch-icon-ic { width: 58rpx; height: 58rpx; }
  .launch-brand { margin-top: 24rpx; font-size: 45rpx; }
  .launch-slogan { margin-top: 24rpx; }
}
