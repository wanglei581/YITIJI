<!--pages/about/about.wxml-->
<view class="page-wrap">

  <view class="navbar col">
    <view style="height:{{statusBarHeight}}px"></view>
    <view class="nav-inner">
      <view class="nav-back tap" hover-class="tap-press" bindtap="back" role="button" aria-label="返回">
        <text class="ficon i-right nav-back-ic"></text>
      </view>
      <view class="nav-title">关于我们</view>
      <view class="nav-right"></view>
    </view>
  </view>

  <view class="content">

    <!-- Logo 区 -->
    <view class="ab-logo">
      <view class="ab-mark"><text class="ficon i-aim ab-ic"></text></view>
      <view class="ab-name">职易达</view>
      <view class="ab-ver">版本 1.0.2</view>
      <view class="ab-slogan">{{slogan}}</view>
    </view>

    <!-- 链接组1：协议与隐私 -->
    <view class="ab-group">
      <view
        class="ab-item tap"
        wx:for="{{links1}}"
        wx:key="id"
        data-id="{{item.id}}"
        hover-class="tap-press"
        bindtap="tapLink"
        role="button"
        aria-label="{{item.title}}"
      >
        <view class="ab-t">{{item.title}}</view>
        <text class="ficon i-right ab-go"></text>
      </view>
    </view>

    <!-- 链接组2：AI 服务说明（模型名称与备案号）与经营者信息，都读后台发布的正式版本 -->
    <view class="ab-group mt12">
      <view
        class="ab-item tap"
        wx:for="{{links2}}"
        wx:key="id"
        data-id="{{item.id}}"
        hover-class="tap-press"
        bindtap="tapLink"
        role="button"
        aria-label="{{item.title}}，{{item.sub}}"
      >
        <view class="ab-t">{{item.title}}</view>
        <view class="ab-sub">{{item.sub}}</view>
        <text class="ficon i-right ab-go"></text>
      </view>
    </view>

    <view class="notice info">
      <text class="ficon i-info n-ic"></text>
      <view>{{notice}}</view>
    </view>

    <view class="ab-foot">© 2026 职易达</view>

  </view>
</view>
