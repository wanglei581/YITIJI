/* pages/about/about.wxss */
.ab-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 0 32rpx;
}
.ab-mark {
  width: 144rpx;
  height: 144rpx;
  border-radius: 42rpx;
  background: var(--teal);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 40rpx rgba(22,119,255,.16);
}
.ab-ic {
  width: 70rpx;
  height: 70rpx;
  color: #fff;
}
.ab-name {
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 780;
  color: var(--ink);
}
.ab-ver {
  margin-top: 8rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: var(--surface-3);
  font-size: 21rpx;
  color: var(--muted);
}
.ab-slogan {
  margin-top: 18rpx;
  max-width: 560rpx;
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  padding: 0 24rpx;
  line-height: 1.6;
}

.ab-group {
  margin: 0 32rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: 28rpx;
  box-shadow: var(--sh-xs);
  overflow: hidden;
}
.ab-group.mt12 { margin-top: 12rpx; }

.ab-item {
  display: flex;
  align-items: center;
  min-height: 106rpx;
  padding: 18rpx 26rpx;
  border-bottom: 1rpx solid var(--line-faint);
}
.ab-item:last-child { border-bottom: none; }
.ab-t {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}
.ab-sub {
  font-size: 26rpx;
  color: var(--muted);
  margin-right: 8rpx;
}
.ab-go {
  width: 22rpx;
  height: 22rpx;
  color: var(--faint);
}

.ab-foot {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--faint);
}

.notice { margin-top: 24rpx; }
