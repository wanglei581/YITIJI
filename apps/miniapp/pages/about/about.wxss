/* pages/about/about.wxss  关于职易达（墨翠鎏金白瓷） */
.ab-logo { display: flex; flex-direction: column; align-items: center; padding: 48rpx 0 32rpx; }
.ab-mark {
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--r-xl);
  background: linear-gradient(150deg, #16483E 0%, #0C2B24 58%, #071915 100%);
  border: 2rpx solid rgba(223, 198, 147, .48);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-md);
}
.ab-ic { width: 70rpx; height: 70rpx; color: var(--gold-bright); }
.ab-name { margin-top: 28rpx; font-size: var(--fs-xl); font-weight: 800; color: var(--ink); }
.ab-ver {
  margin-top: 10rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--r-full);
  background: var(--gold-soft);
  border: 1rpx solid var(--gold-line);
  font-size: var(--fs-xs);
  font-weight: 700;
  color: var(--gold-deep);
}
.ab-slogan { margin-top: 18rpx; max-width: 560rpx; font-size: var(--fs-sm); color: var(--muted); text-align: center; padding: 0 24rpx; line-height: 1.6; }

.ab-group {
  margin: 0 32rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-sm);
  overflow: hidden;
}
.ab-group.mt12 { margin-top: 14rpx; }

.ab-item { display: flex; align-items: center; min-height: 106rpx; padding: 18rpx 26rpx; border-bottom: 1rpx solid var(--line-faint); }
.ab-item:last-child { border-bottom: none; }
.ab-t { flex: 1; font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
.ab-sub { font-size: var(--fs-base); color: var(--muted); margin-right: 8rpx; }
.ab-go { width: 22rpx; height: 22rpx; color: var(--faint); }

.ab-foot { margin-top: 48rpx; text-align: center; font-size: var(--fs-sm); color: var(--faint); }
.notice { margin-top: 24rpx; }
