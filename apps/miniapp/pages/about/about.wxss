/* pages/about/about.wxss */
.ab-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 0 28rpx;
}
.ab-mark {
  width: 156rpx;
  height: 156rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, var(--teal-soft), var(--teal));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-md);
}
.ab-ic {
  font-size: 80rpx;
  color: #fff;
}
.ab-name {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}
.ab-ver {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--muted);
}
.ab-slogan {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--ink-soft);
  text-align: center;
  padding: 0 24rpx;
  line-height: 1.6;
}

.ab-group {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-xs);
  overflow: hidden;
}
.ab-group.mt12 { margin-top: 12rpx; }

.ab-item {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--line-faint);
}
.ab-item:last-child { border-bottom: none; }
.ab-t {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}
.ab-sub {
  font-size: 26rpx;
  color: var(--muted);
  margin-right: 8rpx;
}
.ab-go {
  font-size: 34rpx;
  color: var(--faint);
  line-height: 1;
}

.ab-foot {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--faint);
}
