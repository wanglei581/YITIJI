<view class="me-page">
  <view style="height:{{statusBarHeight}}px"></view>

  <view class="me-head">
    <view>
      <view class="me-page-title">我的</view>
      <view class="me-page-sub">管理本人资料、记录与服务</view>
    </view>
    <view class="notify-btn icon-action tap" hover-class="tap-press" bindtap="tapNotify" role="button" aria-label="查看消息通知">
      <text class="ficon i-bell" aria-hidden="true"></text>
    </view>
  </view>

  <scroll-view class="me-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="me-body">
      <view class="profile-card">
        <view class="profile-row">
          <view class="profile-avatar"><text class="ficon i-user"></text></view>
          <view class="profile-copy">
            <view class="profile-name">{{isLoggedIn ? (user.nickname || '职易达用户') : '登录职易达'}}</view>
            <view wx:if="{{isLoggedIn}}" class="profile-meta">{{user.phoneMasked || '已登录并同步本人数据'}}</view>
            <!-- 未登录态原本没有任何说明行，用户只看到一个标题。补一句真实状态与登录后能得到什么。 -->
            <view wx:else class="profile-meta">未登录 · 登录后同步本人简历、文档与打印订单</view>
            <view wx:else class="profile-login tap" hover-class="tap-press" bindtap="tapLogin" role="button" aria-label="微信一键登录，解锁完整服务">微信一键登录，解锁完整服务</view>
          </view>
          <view wx:if="{{isLoggedIn}}" class="profile-arrow tap" hover-class="tap-press" bindtap="tapEntry" data-id="settings" role="button" aria-label="打开账号设置">
            <text class="ficon i-right"></text>
          </view>
          <view wx:else class="profile-arrow tap" hover-class="tap-press" bindtap="tapLogin" role="button" aria-label="登录职易达">
            <text class="ficon i-right"></text>
          </view>
        </view>

        <view class="benefit-strip tap" hover-class="tap-press" bindtap="tapEntry" data-id="membership" role="button" aria-label="查看我的实际权益记录">
          <view class="benefit-icon"><text class="ficon i-crown"></text></view>
          <view class="benefit-copy">
            <view class="benefit-title">我的权益</view>
            <view class="benefit-desc">只展示服务端实际发放记录</view>
          </view>
          <view class="benefit-go">查看 <text class="ficon i-right"></text></view>
        </view>
      </view>

      <view class="stats-card" wx:if="{{isLoggedIn}}">
        <view class="stat-item" wx:for="{{stats}}" wx:key="key">
          <view class="stat-value">{{item.value}}</view>
          <view class="stat-label">{{item.label}}</view>
        </view>
      </view>

      <view class="section-row">
        <text class="section-title">我的服务</text>
      </view>
      <view class="asset-grid">
        <view
          class="asset-item tap"
          wx:for="{{entries}}"
          wx:key="id"
          wx:if="{{index < 4}}"
          hover-class="tap-press"
          data-id="{{item.id}}"
          bindtap="tapEntry"
          role="button"
          aria-label="{{item.title}}，{{item.sub}}"
        >
          <view class="asset-icon tone-{{item.accent}}"><text class="ficon i-{{item.icon}}"></text></view>
          <view class="asset-title">{{item.title}}</view>
          <view class="asset-desc">{{item.sub}}</view>
        </view>
      </view>

      <view class="section-row">
        <text class="section-title">更多功能</text>
      </view>
      <view class="menu-card">
        <view
          class="menu-item tap"
          wx:for="{{entries}}"
          wx:key="id"
          wx:if="{{index >= 4 && item.id !== 'membership'}}"
          hover-class="tap-press"
          data-id="{{item.id}}"
          bindtap="tapEntry"
          role="button"
          aria-label="{{item.title}}，{{item.sub}}"
        >
          <view class="menu-icon soft-{{item.accent}}"><text class="ficon i-{{item.icon}}"></text></view>
          <view class="menu-copy">
            <view class="menu-title">
              {{item.title}}
            </view>
            <view class="menu-desc">{{item.sub}}</view>
          </view>
          <view class="menu-arrow"><text class="ficon i-right"></text></view>
        </view>
      </view>

      <view class="privacy-note">系统只记录本人的浏览、收藏、外部跳转、打印与 AI 调用行为，不记录投递或预约结果。</view>
      <view class="tab-spacer"></view>
    </view>
  </scroll-view>
</view>
