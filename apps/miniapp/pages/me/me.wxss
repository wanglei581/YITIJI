page { height: 100%; overflow: hidden; background: var(--paper); }
.me-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); }
.me-head { min-height: 112rpx; padding: 14rpx 32rpx 18rpx; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
.me-page-title { font-size: var(--fs-xl); line-height: 1.2; font-weight: 700; letter-spacing: .5rpx; color: var(--ink); }
.me-page-sub { margin-top: 6rpx; font-size: var(--fs-sm); color: var(--muted); }
/* 实测 45x45 → 96rpx=48px 可点热区，精致纯白圆形视觉 */
.notify-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-full);
  background: var(--surface);
  color: var(--ink-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-xs);
}
.notify-btn .ficon { width: 30rpx; height: 30rpx; }
.me-scroll { flex: 1; min-height: 0; }
.me-body { padding: 0 28rpx; }

/* 私人银行级墨翠黑金账户卡：瓷釉墨翠渐变 + 鎏金极细描边 + 顶部镜面高光 */
.profile-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx 28rpx;
  border-radius: var(--r-lg);
  border: 1rpx solid rgba(212, 186, 135, .32);
  background: linear-gradient(150deg, #184E43 0%, #0D2E27 56%, #071915 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .12), 0 16rpx 40rpx -12rpx rgba(7, 25, 21, .42);
}
.profile-card::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -70rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: var(--r-full);
  background: radial-gradient(circle, rgba(223, 198, 147, .22) 0%, rgba(60, 224, 169, .07) 44%, rgba(7, 25, 21, 0) 72%);
  pointer-events: none;
}
.profile-row { position: relative; z-index: 1; display: flex; align-items: center; gap: 20rpx; }
.profile-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: var(--r-full);
  background: rgba(223, 198, 147, .14);
  border: 2rpx solid rgba(223, 198, 147, .42);
  color: var(--gold-bright);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.profile-avatar .ficon { width: 42rpx; height: 42rpx; }
.profile-copy { flex: 1; min-width: 0; }
.profile-name { font-size: var(--fs-lg); font-weight: 700; color: #FFFFFF; letter-spacing: .4rpx; }
.profile-meta { margin-top: 8rpx; font-size: var(--fs-sm); color: var(--mint); opacity: .88; line-height: 1.45; }
/* 香槟鎏金主按钮：守住 112rpx=56px 高可点标准 */
.profile-cta {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  height: 112rpx;
  border-radius: var(--r-md);
  background: linear-gradient(135deg, #E5CE9E 0%, #C2A36B 100%);
  color: #081E19;
  font-size: var(--fs-md);
  font-weight: 700;
  letter-spacing: .5rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .45), 0 10rpx 24rpx -6rpx rgba(0, 0, 0, .28);
}
.profile-arrow {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-full);
  background: rgba(255, 255, 255, .10);
  border: 1rpx solid rgba(223, 198, 147, .24);
  color: var(--gold-bright);
  display: flex;
  align-items: center;
  justify-content: center;
}
.profile-arrow .ficon { width: 20rpx; height: 20rpx; }

/* 已登录三栏数据卡：纯白浮层 + 墨翠清晰数字 */
.stats-card {
  margin-top: 20rpx;
  padding: 24rpx 8rpx;
  border-radius: var(--r-lg);
  background: var(--surface);
  display: flex;
  box-shadow: var(--sh-xs);
}
.stat-item { flex: 1; text-align: center; }
.stat-item + .stat-item { border-left: 1rpx solid var(--line-faint); }
.stat-value { font-size: var(--fs-xl); line-height: 1; font-weight: 700; color: var(--teal-deep); font-variant-numeric: tabular-nums; }
.stat-label { margin-top: 10rpx; font-size: var(--fs-sm); color: var(--muted); }

/* 编辑级分区标题 */
.section-row { height: 84rpx; padding: 28rpx 4rpx 12rpx; display: flex; align-items: center; gap: 12rpx; }
.section-title {
  position: relative;
  padding-left: 16rpx;
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: .4rpx;
}
.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  border-radius: var(--r-full);
  background: linear-gradient(180deg, var(--teal) 0%, var(--gold) 100%);
}

/* 我的服务 2×2 卡片：紧凑干练无多余空白，纯白双层柔影 + 径向光晕圆形图标 */
.asset-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.asset-item {
  min-height: 176rpx;
  padding: 24rpx 22rpx;
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: var(--sh-xs);
}
.asset-icon {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: var(--r-full);
  display: flex;
  align-items: center;
  justify-content: center;
}
.asset-icon .ficon { width: 36rpx; height: 36rpx; }
.tone-teal  { background: radial-gradient(circle at 30% 25%, #EAF7F2 0%, #D3EDE3 100%); color: var(--teal-deep); }
.tone-plum  { background: radial-gradient(circle at 30% 25%, #F3EFFD 0%, #E4DCF8 100%); color: var(--plum-deep); }
.tone-clay  { background: radial-gradient(circle at 30% 25%, #FCF1EA 0%, #F4DFD1 100%); color: var(--clay-deep); }
.tone-wheat { background: radial-gradient(circle at 30% 25%, #FCF4E3 0%, #F4E3C2 100%); color: var(--gold-deep); }
.tone-cyan  { background: radial-gradient(circle at 30% 25%, #E7F7F5 0%, #CDEEE9 100%); color: #0B5E54; }
.tone-slate { background: radial-gradient(circle at 30% 25%, #EEF4FC 0%, #DAE6F7 100%); color: var(--slate-deep); }
.asset-title { margin-top: 18rpx; font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.asset-desc { margin-top: 6rpx; font-size: var(--fs-sm); color: var(--muted); line-height: 1.45; }

/* 更多功能列表：纯白浮层 + 细分割线 */
.menu-card { border-radius: var(--r-lg); background: var(--surface); overflow: hidden; box-shadow: var(--sh-xs); }
.menu-item { min-height: 114rpx; padding: 20rpx 24rpx; display: flex; align-items: center; gap: 18rpx; }
.menu-item + .menu-item { border-top: 1rpx solid var(--line-faint); }
.menu-icon { width: 64rpx; height: 64rpx; border-radius: var(--r-full); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.soft-teal  { background: radial-gradient(circle at 30% 25%, #EAF7F2 0%, #D6EFE6 100%); color: var(--teal-deep); }
.soft-plum  { background: radial-gradient(circle at 30% 25%, #F3EFFD 0%, #E6DEF9 100%); color: var(--plum-deep); }
.soft-clay  { background: radial-gradient(circle at 30% 25%, #FCF1EA 0%, #F5E1D4 100%); color: var(--clay-deep); }
.soft-wheat { background: radial-gradient(circle at 30% 25%, #FCF4E3 0%, #F5E5C5 100%); color: var(--gold-deep); }
.soft-cyan  { background: radial-gradient(circle at 30% 25%, #E7F7F5 0%, #D0EFEA 100%); color: #0B5E54; }
.soft-slate { background: radial-gradient(circle at 30% 25%, #EEF4FC 0%, #DCE7F8 100%); color: var(--slate-deep); }
.menu-icon .ficon { width: 30rpx; height: 30rpx; }
.menu-copy { flex: 1; min-width: 0; }
.menu-title { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
.menu-desc { margin-top: 5rpx; font-size: var(--fs-sm); color: var(--muted); }
.menu-arrow { color: var(--ghost); }
.menu-arrow .ficon { width: 20rpx; height: 20rpx; }
.menu-badge {
  display: inline-block;
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, #C9AD78 0%, #9E7E48 100%);
  color: #FFFFFF;
  font-size: var(--fs-xs);
  font-weight: 700;
  vertical-align: middle;
  line-height: 1.4;
}
.privacy-note { padding: 28rpx 12rpx 8rpx; color: var(--faint); font-size: var(--fs-xs); line-height: 1.65; text-align: center; }
.privacy-link { color: var(--teal-deep); font-weight: 600; }
/* 预留足量空间给悬浮瓷白底栏，滚到最底绝不重叠 */
.tab-spacer { height: calc(196rpx + env(safe-area-inset-bottom)); }
