/* 我的页（M0.2 登录态） */
.tab-page {
  min-height: 100vh;
  background: #f4f1e8;
  box-sizing: border-box;
}
.tab-hd {
  padding: 8rpx 32rpx 16rpx;
}
.tab-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #10302b;
}
.tab-body {
  padding: 24rpx 32rpx;
}
.me-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 48rpx;
  background: #fffdf8;
  border: 1rpx solid #e2dccb;
  border-radius: 24rpx;
}
.me-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #f6e7dd;
}
.me-avatar .ficon {
  width: 52rpx;
  height: 52rpx;
  color: #b8683c;
}
.me-name {
  margin-top: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #274b43;
}
.me-hint {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5d6b63;
  text-align: center;
}
.me-login {
  margin-top: 48rpx;
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #1f9e86;
  color: #fffdf8;
  font-size: 30rpx;
  font-weight: 600;
}
.me-login::after {
  border: none;
}
.me-logout {
  margin-top: 48rpx;
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #fffdf8;
  color: #9a5530;
  font-size: 28rpx;
  border: 1rpx solid #e2dccb;
}
.me-logout::after {
  border: none;
}
