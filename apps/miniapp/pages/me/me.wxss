/* pages/me/me.wxss — Direction B: 奶油质感 */

.page-wrap { min-height: 100vh; background: #FAF7F2; }

/* ── Hero 头部 ── */
.me-hero {
  background: #FFFDF9;
  padding: 16rpx 32rpx 28rpx;
  border-bottom: 1rpx solid #EDE5D8;
  margin-bottom: 24rpx;
}
.me-user-row { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; }
.avatar-wrap { flex-shrink: 0; }
.avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: #F2EAE0; border: 3rpx solid #E5D8C8;
  display: flex; align-items: center; justify-content: center;
}
.av-ic { font-size: 44rpx; color: #A89080; }
.me-id { flex: 1; min-width: 0; }
.me-name { font-size: 36rpx; font-weight: 900; color: #2C1A0E; display: block; margin-bottom: 6rpx; }
.me-phone { font-size: 24rpx; color: #A89080; display: block; }
.me-login-hint { font-size: 24rpx; color: #C84B2F; font-weight: 600; display: block; }
.me-member-tag {
  display: flex; align-items: center; gap: 8rpx;
  background: #F5EDD8; border-radius: 200rpx;
  padding: 6rpx 16rpx; margin-top: 8rpx;
  width: fit-content;
  font-size: 22rpx; color: #9C6E0A; font-weight: 600;
}
.mt-upgrade { color: #C84B2F; }
.notify-btn {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #F2EAE0; display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; color: #7A5C48; flex-shrink: 0;
}

/* 大数字统计 */
.me-stats {
  display: flex;
  border-top: 1rpx solid #EDE5D8;
  padding-top: 20rpx;
}
.ms-cell { flex: 1; text-align: center; }
.ms-cell:not(:last-child) { border-right: 1rpx solid #EDE5D8; }
.ms-val { font-size: 48rpx; font-weight: 900; color: #2C1A0E; display: block; line-height: 1; letter-spacing: -2rpx; }
.ms-lbl { font-size: 22rpx; color: #A89080; display: block; margin-top: 8rpx; }

/* ── 菜单分组 ── */
.menu-group { margin: 0 32rpx 20rpx; }
.mg-title { font-size: 24rpx; font-weight: 700; color: #A89080; letter-spacing: 2rpx; margin-bottom: 12rpx; }
.menu-card {
  background: #FFFDF9; border-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(44,26,14,.06);
  overflow: hidden;
}
.menu-item {
  display: flex; align-items: center; gap: 18rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #F0E8DC;
}
.menu-item:last-child { border-bottom: none; }
.mi-icon {
  width: 72rpx; height: 72rpx; border-radius: 18rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx;
}
.mi-ic-plum  { background: #F0E8F5; color: #6B3FA0; }
.mi-ic-teal  { background: #E8F0EA; color: #3A6648; }
.mi-ic-clay  { background: #FAEDEA; color: #C84B2F; }
.mi-ic-wheat { background: #F5EDD8; color: #9C6E0A; }
.mi-ic-slate { background: #EEE8E0; color: #7A5C48; }
.mi-body { flex: 1; min-width: 0; }
.mi-title { font-size: 28rpx; font-weight: 700; color: #2C1A0E; display: block; }
.mi-sub { font-size: 22rpx; color: #A89080; display: block; margin-top: 3rpx; }
.mi-arrow { font-size: 30rpx; color: #C8B4A0; flex-shrink: 0; }

/* 合规声明 */
.compliance-note {
  margin: 8rpx 32rpx 24rpx;
  font-size: 22rpx; color: #C8B4A0; line-height: 1.7;
}

.tap { transition: opacity 80ms; }
.tap-press { opacity: .7; }
