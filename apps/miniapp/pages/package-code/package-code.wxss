/* pages/package-code/package-code.wxss  材料包到机码（墨翠鎏金白瓷） */
page { height: 100%; overflow: hidden; background: var(--paper); }
.code-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); }
.code-scroll { flex: 1; min-height: 0; }
.code-body { padding: 12rpx 32rpx 40rpx; }

.success-banner {
  padding: 28rpx 26rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(150deg, #16483E 0%, #0C2B24 58%, #071915 100%);
  border: 1rpx solid rgba(223, 198, 147, .28);
  box-shadow: var(--sh-md);
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.success-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-full);
  background: rgba(223, 198, 147, .18);
  border: 1rpx solid rgba(223, 198, 147, .42);
  color: var(--gold-bright);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.success-icon .ficon { width: 36rpx; height: 36rpx; }
.success-copy { flex: 1; }
.success-title { font-size: var(--fs-md); font-weight: 750; color: #FFFFFF; display: block; }
.success-desc { margin-top: 6rpx; font-size: var(--fs-sm); color: var(--gold-bright); display: block; }

.qr-card {
  padding: 36rpx 28rpx 32rpx;
  border-radius: var(--r-lg);
  background: var(--surface);
  border: 1rpx solid var(--gold-line);
  box-shadow: var(--sh-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.qr-box {
  width: 400rpx;
  min-height: 400rpx;
  border-radius: var(--r-md);
  background: #fff;
  border: 1rpx solid var(--line-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  padding: 16rpx;
}
.package-qr { display: block; }
.qr-placeholder-text { padding: 24rpx; font-size: var(--fs-sm); line-height: 1.6; color: var(--muted); text-align: center; }
.qr-hint { font-size: var(--fs-sm); color: var(--muted); text-align: center; }

.digital-code {
  padding: 32rpx 28rpx;
  border-radius: var(--r-lg);
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  box-shadow: var(--sh-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}
.code-label { font-size: var(--fs-sm); color: var(--gold-deep); font-weight: 700; margin-bottom: 16rpx; }
.code-hint { font-size: var(--fs-sm); color: var(--muted); margin-top: 16rpx; }

.code-acts { display: flex; gap: 16rpx; margin-top: 16rpx; width: 100%; }
.code-act {
  flex: 1;
  min-height: 96rpx;
  border-radius: var(--r-full);
  border: 1rpx solid rgba(15, 106, 87, .24);
  background: var(--teal-wash);
  color: var(--teal-deep);
  font-size: var(--fs-base);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.code-act.off { opacity: .5; }
.code-share-note { margin-top: 12rpx; font-size: var(--fs-sm); color: var(--muted); line-height: 1.5; text-align: center; }
.share-card-canvas { position: fixed; left: -2000rpx; top: 0; width: 600px; height: 840px; }

.info-row { display: flex; align-items: center; justify-content: space-between; min-height: 72rpx; }
.info-label { font-size: var(--fs-base); color: var(--muted); }
.info-val { font-size: var(--fs-base); font-weight: 650; color: var(--ink); text-align: right; }

.step-list { display: flex; flex-direction: column; gap: 24rpx; }
.step-item { display: flex; align-items: flex-start; gap: 18rpx; }
.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, #16483E 0%, #0A2720 100%);
  color: var(--gold-bright);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
  font-weight: 750;
  flex-shrink: 0;
}
.step-text { flex: 1; padding-top: 6rpx; font-size: var(--fs-base); line-height: 1.6; color: var(--ink-soft); }

.actionbar {
  padding: 20rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--line-soft);
  box-shadow: 0 -8rpx 24rpx rgba(11, 39, 33, .06);
  display: flex;
  gap: 16rpx;
}
.actionbar .btn { flex: 1; height: 112rpx; }

.retry-btn {
  margin: 24rpx auto 0;
  min-height: 96rpx;
  line-height: 96rpx;
  padding: 0 48rpx;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, #16483E 0%, #0A2720 100%);
  color: var(--gold-bright);
  font-size: var(--fs-md);
  font-weight: 700;
  text-align: center;
  display: inline-block;
}
