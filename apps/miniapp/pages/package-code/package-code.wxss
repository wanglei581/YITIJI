page { height: 100%; overflow: hidden; background: var(--paper); }
.code-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); }
.code-scroll { flex: 1; min-height: 0; }
.code-body { padding: 0 32rpx 40rpx; }

/* 成功提示 */
.success-banner {
  padding: 32rpx 28rpx;
  border-radius: 26rpx;
  background: var(--ok-soft);
  border: 1rpx solid rgba(18, 168, 121, 0.15);
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.success-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--ok);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.success-icon .ficon { width: 36rpx; height: 36rpx; }
.success-copy { flex: 1; }
.success-title {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--ok);
  display: block;
}
.success-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--ok);
  display: block;
}

/* 二维码 */
.qr-card {
  padding: 36rpx 28rpx 32rpx;
  border-radius: 26rpx;
  background: #fff;
  border: 1rpx solid var(--line-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.qr-box {
  width: 400rpx;
  height: 400rpx;
  border-radius: 20rpx;
  background: var(--surface-2);
  border: 2rpx dashed var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.qr-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.qr-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--teal-soft);
  color: var(--teal);
  display: flex;
  align-items: center;
  justify-content: center;
}
.qr-icon .ficon { width: 48rpx; height: 48rpx; }
.qr-text {
  font-size: 25rpx;
  color: var(--muted);
}
.qr-hint {
  font-size: 23rpx;
  color: var(--muted);
  text-align: center;
}

/* 数字码 */
.digital-code {
  padding: 32rpx 28rpx;
  border-radius: 26rpx;
  background: #fff;
  border: 1rpx solid var(--line-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}
.code-label {
  font-size: 23rpx;
  color: var(--muted);
  margin-bottom: 16rpx;
}
.code-hint {
  font-size: 23rpx;
  color: var(--muted);
  margin-top: 16rpx;
}

/* 订单信息 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
}
.info-label {
  font-size: 25rpx;
  color: var(--muted);
}
.info-val {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: right;
}

/* 使用说明 */
.step-list { display: flex; flex-direction: column; gap: 24rpx; }
.step-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}
.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--teal-soft);
  color: var(--teal);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.step-text {
  flex: 1;
  padding-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-soft);
}

/* 底部按钮 */
.actionbar {
  padding: 20rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--line-soft);
  display: flex;
  gap: 16rpx;
}
.actionbar .btn {
  flex: 1;
  height: 88rpx;
}
