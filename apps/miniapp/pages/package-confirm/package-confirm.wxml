<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>
  
  <view class="navbar col">
    <view class="nav-back icon-action tap" hover-class="tap-press" bindtap="goBack" role="button" aria-label="返回">
      <text class="ficon i-right nav-back-ic"></text>
    </view>
    <text class="nav-title">确认订单</text>
  </view>

  <scroll-view class="confirm-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="confirm-body">
      <!-- 服务点信息 -->
      <view class="section-card">
        <view class="section-header">
          <text class="ficon i-map-pin"></text>
          <text class="section-title">服务点信息</text>
        </view>
        <view class="store-info-compact">
          <text class="store-name-text">{{storeData.name}}</text>
          <text class="store-address-text">{{storeData.address}}</text>
        </view>
      </view>

      <!-- 订单摘要 -->
      <view class="section-card">
        <view class="section-header">
          <text class="ficon i-file-text"></text>
          <text class="section-title">订单摘要</text>
        </view>
        <view class="summary-rows">
          <view class="summary-row">
            <text class="summary-label">订单编号</text>
            <text class="summary-value">{{orderSummary.orderId}}</text>
          </view>
          <view class="summary-row">
            <text class="summary-label">文件数量</text>
            <text class="summary-value">{{orderSummary.fileCount}} 个</text>
          </view>
          <view class="summary-row">
            <text class="summary-label">总页数</text>
            <text class="summary-value">{{orderSummary.totalPages}} 页</text>
          </view>
          <view class="summary-row">
            <text class="summary-label">打印方式</text>
            <text class="summary-value">
              {{orderSummary.colorMode === 'bw' ? '黑白' : '彩色'}} · 
              {{orderSummary.duplex === 'single' ? '单面' : '双面'}}
            </text>
          </view>
          <view class="summary-row">
            <text class="summary-label">打印份数</text>
            <text class="summary-value">{{orderSummary.copies}} 份</text>
          </view>
        </view>
      </view>

      <!-- 支付方式 -->
      <view class="section-card">
        <view class="section-header">
          <text class="ficon i-credit-card"></text>
          <text class="section-title">支付方式</text>
        </view>
        <view class="payment-methods">
          <view 
            class="payment-item tap {{selectedPayment === item.id ? 'selected' : ''}} {{!item.enabled ? 'disabled' : ''}}" 
            wx:for="{{paymentMethods}}" 
            wx:key="id"
            hover-class="{{item.enabled ? 'tap-press' : ''}}"
            bindtap="selectPayment"
            data-id="{{item.id}}"
          >
            <view class="payment-left">
              <view class="payment-radio">
                <view class="radio-inner" wx:if="{{selectedPayment === item.id}}"></view>
              </view>
              <text class="ficon i-{{item.icon}}"></text>
              <text class="payment-name">{{item.name}}</text>
            </view>
            <text class="payment-tip" wx:if="{{item.tip}}">{{item.tip}}</text>
          </view>
        </view>
      </view>

      <!-- 费用明细：金额由服务端建单后确认，此处只展示规格摘要 -->
      <view class="section-card">
        <view class="section-header">
          <text class="ficon i-dollar-sign"></text>
          <text class="section-title">费用明细</text>
        </view>
        <view class="price-rows">
          <view class="price-row">
            <text class="price-label">计费页数</text>
            <text class="price-value">{{orderSummary.totalPages}} 页</text>
          </view>
          <view class="price-row">
            <text class="price-label">打印方式</text>
            <text class="price-value">{{orderSummary.colorMode === 'bw' ? '黑白' : '彩色'}} · {{orderSummary.duplex === 'single' ? '单面' : '双面'}}</text>
          </view>
          <view class="price-row total">
            <text class="price-label">实付金额</text>
            <text class="price-value final">由服务端确认</text>
          </view>
        </view>
      </view>

      <!-- 服务协议 -->
      <view class="agreement-section">
        <checkbox-group bindchange="toggleAgreement">
          <label class="agreement-label">
            <checkbox value="agreed" checked="{{agreedToTerms}}" color="#1677ff" />
            <text>我已阅读并同意</text>
            <text class="link" bindtap="viewTerms">《打印服务协议》</text>
          </label>
        </checkbox-group>
      </view>

      <!-- 底部占位 -->
      <view style="height: 140rpx;"></view>
    </view>
  </scroll-view>

  <!-- 底部提交栏 -->
  <view class="bottom-bar">
    <view class="price-info">
      <text class="label">实付金额</text>
      <text class="amount">¥{{finalPrice}}</text>
    </view>
    <button class="submit-btn" bindtap="submitOrder">提交订单</button>
  </view>
</view>
