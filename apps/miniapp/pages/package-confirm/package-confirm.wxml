<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>

  <view class="navbar col">
    <view class="nav-back icon-action tap" hover-class="tap-press" bindtap="goBack" role="button" aria-label="返回">
      <text class="ficon i-right nav-back-ic"></text>
    </view>
    <text class="nav-title">确认订单</text>
  </view>

  <scroll-view class="confirm-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="confirm-body">

      <!-- 未登录：材料包订单绑在会员账号上，不登录连文件都读不到 -->
      <view class="section-card" wx:if="{{!isLoggedIn}}">
        <view class="state-t">请先登录小程序</view>
        <view class="state-d">材料包的文件、报价与到机码都绑定本人账号，登录后才能下单。</view>
        <view class="btn primary block tap" hover-class="tap-press" bindtap="toLogin" role="button">去登录</view>
      </view>

      <!-- 草稿缺失：深链直进或草稿已清，说清原因并给回到第一步的出口 -->
      <view class="section-card" wx:elif="{{draftState === 'missing'}}">
        <view class="state-t">没有可确认的材料包</view>
        <view class="state-d">这一步要用前两步选好的文件与服务点，而当前没有草稿（可能是直接打开了本页，或草稿已被清理）。</view>
        <view class="btn primary block tap" hover-class="tap-press" bindtap="backToFiles" role="button">回到选择文件</view>
      </view>

      <block wx:else>
        <!-- 服务点信息 -->
        <view class="section-card">
          <view class="section-header">
            <text class="ficon i-map-pin"></text>
            <text class="section-title">服务点信息</text>
          </view>
          <view class="store-info-compact">
            <text class="store-name-text">{{storeName}}</text>
            <text class="store-address-text">{{storeAddress}}</text>
          </view>
        </view>

        <!-- 订单摘要：订单号在建单后才有，这里不放占位 -->
        <view class="section-card">
          <view class="section-header">
            <text class="ficon i-file-text"></text>
            <text class="section-title">订单摘要</text>
          </view>
          <view class="summary-rows">
            <view class="summary-row" wx:for="{{files}}" wx:key="fileId">
              <text class="summary-label">材料 {{index + 1}}</text>
              <text class="summary-value">{{item.name}}</text>
            </view>
            <view class="summary-row">
              <text class="summary-label">文件数量</text>
              <text class="summary-value">{{orderSummary.fileCount}} 个</text>
            </view>
            <view class="summary-row">
              <text class="summary-label">打印方式</text>
              <text class="summary-value">{{orderSummary.colorLabel}} · {{orderSummary.duplexLabel}}</text>
            </view>
            <view class="summary-row">
              <text class="summary-label">打印份数</text>
              <text class="summary-value">{{orderSummary.copies}} 份</text>
            </view>
          </view>
        </view>

        <!-- 费用明细：页数与金额全部来自服务端多行报价，前端不做单价乘法 -->
        <view class="section-card">
          <view class="section-header">
            <text class="ficon i-dollar-sign"></text>
            <text class="section-title">服务端报价</text>
          </view>

          <view wx:if="{{quoteState === 'loading'}}" class="state-d">正在向服务端核定页数与金额…</view>

          <view wx:elif="{{quoteState === 'error'}}" class="state-block">
            <view class="state-t">{{quoteErrorTitle}}</view>
            <view class="state-d">{{quoteErrorText}}</view>
            <view class="btn ghost block tap" hover-class="tap-press" bindtap="recover" data-recover="{{quoteRecover}}" role="button">
              {{quoteRecover === 'login' ? '去登录' : quoteRecover === 'store' ? '换一个服务点' : quoteRecover === 'files' || quoteRecover === 'privacy' ? '回到选择文件' : quoteRecover === 'orders' ? '去我的打印订单' : '重新核价'}}
            </view>
          </view>

          <view wx:elif="{{quoteState === 'ready'}}" class="price-rows">
            <view class="price-row">
              <text class="price-label">计费页数（服务端识别）</text>
              <text class="price-value">{{quotePages}} 页</text>
            </view>
            <view class="price-row total">
              <text class="price-label">应付金额</text>
              <text class="price-value final">{{quoteAmountText}}</text>
            </view>
            <view class="state-d">这是服务端按真实文件页数与当前价目算出来的金额；下单结果里的金额为最终值。</view>
          </view>

          <view wx:else class="state-d">等待核价。</view>
        </view>

        <!-- 付款方式：材料包没有在线支付，只有现场付款 -->
        <view class="section-card">
          <view class="section-header">
            <text class="ficon i-credit-card"></text>
            <text class="section-title">付款方式</text>
          </view>
          <view class="state-d">{{onsiteNotice}}</view>
          <view class="state-d">{{noCancelNotice}}</view>
        </view>

        <!-- 建单失败：按服务端错误码给可执行的下一步 -->
        <view class="section-card" wx:if="{{submitErrorTitle}}">
          <view class="state-t">{{submitErrorTitle}}</view>
          <view class="state-d">{{submitErrorText}}</view>
          <view class="btn ghost block tap" hover-class="tap-press" bindtap="recover" data-recover="{{submitRecover}}" role="button">
            {{submitRecover === 'login' ? '去登录' : submitRecover === 'store' ? '换一个服务点' : submitRecover === 'files' || submitRecover === 'privacy' ? '回到选择文件' : submitRecover === 'orders' ? '去我的打印订单' : '重新核价'}}
          </view>
        </view>

        <!-- 服务协议。
             **《打印服务协议》这个链接必须留在 <label> 之外。** 小程序里 label 包住
             checkbox 时，label 内任意一次点击都会切换那个 checkbox —— 于是"点开协议
             看一眼"会被同时记成"我已阅读并同意"，而这份同意用户从来没做过；更糟的是
             返回本页时它已经勾上了，用户不会知道自己什么时候勾的。
             同意只能由用户**点中那个勾选框（或它前面那句话）**产生。 -->
        <view class="agreement-section">
          <checkbox-group bindchange="toggleAgreement">
            <label class="agreement-label">
              <checkbox value="agreed" checked="{{agreedToTerms}}" color="#1677ff" />
              <text>我已阅读并同意</text>
            </label>
          </checkbox-group>
          <text class="link agreement-link" bindtap="viewTerms">《打印服务协议》</text>
        </view>
        <view class="agreement-hint" wx:if="{{quoteState === 'ready' && !agreedToTerms}}">勾选上面的《打印服务协议》后才能下单。</view>
      </block>

      <!-- 底部占位 -->
      <view style="height: 140rpx;"></view>
    </view>
  </scroll-view>

  <!-- 底部提交栏：金额只在服务端报价就绪后才显示 -->
  <view class="bottom-bar">
    <view class="price-info">
      <text class="label">{{quoteState === 'ready' ? '到机应付' : '金额待服务端核定'}}</text>
      <text class="amount" wx:if="{{quoteState === 'ready'}}">{{quoteAmountText}}</text>
    </view>
    <!-- disabled 与 submitOrder() 的守卫**逐条对齐**（报价就绪 + 已同意协议 + 不在提交中）。
         此前按钮只按报价与提交中两条变灰，未勾协议时它是亮的，点下去只弹一句 toast ——
         一个看起来能用、按下去却不做事的主按钮。上面那行 agreement-hint 负责说清原因。 -->
    <button class="submit-btn {{quoteState === 'ready' && agreedToTerms && !submitting ? '' : 'disabled'}}" bindtap="submitOrder" disabled="{{quoteState !== 'ready' || !agreedToTerms || submitting}}">{{submitting ? '提交中…' : '确认下单'}}</button>
  </view>
</view>
