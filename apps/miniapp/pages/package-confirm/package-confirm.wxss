/* pages/package-confirm/package-confirm.wxss */

.confirm-page {
  min-height: 100vh;
  background: var(--bg, #f5f7fa);
  display: flex;
  flex-direction: column;
}

.navbar {
  position: relative;
  height: 88rpx;
  background: var(--card-bg, #ffffff);
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid var(--border, #e5e8ed);
  z-index: 10;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-ic {
  transform: rotate(180deg);
  font-size: 32rpx;
  color: var(--text, #2c3e50);
}

.nav-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text, #2c3e50);
}

.confirm-scroll {
  flex: 1;
  overflow-y: scroll;
}

/* 给固定底栏留位。实测（390pt 模拟器）：.bottom-bar 高 197px，
   而滚动内容零垫底——滑到底时最后 197px 被压在栏下面，最后一个服务点点不到。
   底栏内容是 rpx 排的，197px @390pt ≈ 380rpx，所以垫底也用 rpx 跟着缩放；
   var(--sab) 单列，因为模拟器里 env(safe-area-inset-bottom) 恒为 0，
   真机全面屏才有值，不能把它算进那 380rpx 里。
   删掉这条：列表最后一项被底栏遮住，用户以为没加载出来。 */
.confirm-body {
  padding: 24rpx;
  padding-bottom: calc(400rpx + var(--sab));
}

/* 卡片区块 */
.section-card {
  background: var(--card-bg, #ffffff);
  border-radius: var(--r-md, 12rpx);
  padding: 32rpx;
  box-shadow: var(--sh-xs, 0 2rpx 8rpx rgba(0,0,0,0.04));
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-header .ficon {
  font-size: 32rpx;
  color: var(--teal, #1677ff);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text, #2c3e50);
}

/* 服务点信息 */
.store-info-compact {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.store-name-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text, #2c3e50);
}

.store-address-text {
  font-size: 26rpx;
  color: var(--text-secondary, #5c6b7a);
  line-height: 1.5;
}

/* 订单摘要 */
.summary-rows {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-label {
  font-size: 26rpx;
  color: var(--text-secondary, #5c6b7a);
}

.summary-value {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text, #2c3e50);
}

/* 支付方式 */
.payment-methods {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.payment-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: var(--bg, #f5f7fa);
  border-radius: var(--r-sm, 8rpx);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.payment-item.selected {
  background: rgba(22, 119, 255, 0.05);
  border-color: var(--teal, #1677ff);
}

.payment-item.disabled {
  opacity: 0.5;
}

.payment-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.payment-radio {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--border, #e5e8ed);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.payment-item.selected .payment-radio {
  border-color: var(--teal, #1677ff);
}

.radio-inner {
  width: 20rpx;
  height: 20rpx;
  background: var(--teal, #1677ff);
  border-radius: 50%;
  animation: radioIn 0.2s ease;
}

@keyframes radioIn {
  0% { transform: scale(0); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.payment-left .ficon {
  font-size: 36rpx;
  color: var(--text-secondary, #5c6b7a);
}

.payment-name {
  font-size: 28rpx;
  color: var(--text, #2c3e50);
}

.payment-tip {
  font-size: 24rpx;
  color: var(--text-tertiary, #8d98a9);
}

/* 优惠券选择器 */
.coupon-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: var(--bg, #f5f7fa);
  border-radius: var(--r-sm, 8rpx);
}

.coupon-text {
  font-size: 26rpx;
  color: var(--text-tertiary, #8d98a9);
}

.coupon-text.selected {
  color: var(--clay, #f06a3c);
  font-weight: 500;
}

.coupon-selector .ficon {
  font-size: 28rpx;
  color: var(--text-tertiary, #8d98a9);
}

/* 费用明细 */
.price-rows {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-row.total {
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border, #e5e8ed);
}

.price-label {
  font-size: 26rpx;
  color: var(--text-secondary, #5c6b7a);
}

.price-row.total .price-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text, #2c3e50);
}

.price-value {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text, #2c3e50);
}

.price-value.discount {
  color: var(--clay, #f06a3c);
}

.price-value.final {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--clay, #f06a3c);
}

/* 服务协议 */
.agreement-section {
  padding: 32rpx 24rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #5c6b7a);
}

.agreement-label checkbox {
  transform: scale(0.9);
}

.agreement-label .link {
  color: var(--teal, #1677ff);
}

/* 底部提交栏 */
/* 2026-09-03 补安全区。原来是 padding: 24rpx，320pt 下底部只有 ~9.6px，
   全面屏（iPhone X 及以后 / 大多数安卓全面屏）的 home indicator 会压住按钮。
   全仓按「position:fixed + bottom:0」属性枚举扫出 6 个族群，其中三个用了
   .actionbar 以外的类名——上一轮按 .actionbar **类名**扫的 26 页把它们全漏了。
   （第六个 privacy 的 .su-mask 是全屏遮罩不是底栏，属误报，未动。）
   写法对齐 app.wxss 的 .actionbar：calc(原内距 + var(--sab))。
   删掉 var(--sab)：全面屏上按钮被 home indicator 压住，点不准。 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card-bg, #ffffff);
  padding: 24rpx 24rpx calc(24rpx + var(--sab));
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  z-index: 100;
}

.price-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.price-info .label {
  font-size: 24rpx;
  color: var(--text-secondary, #5c6b7a);
}

.price-info .amount {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--clay, #f06a3c);
}

.submit-btn {
  flex-shrink: 0;
  padding: 24rpx 56rpx;
  background: var(--teal, #1677ff);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: all 0.2s ease;
}

.submit-btn:active {
  transform: scale(0.98);
}
