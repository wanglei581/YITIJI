/* pages/package-confirm/package-confirm.wxss  材料包确认（墨翠鎏金白瓷） */

.confirm-page { min-height: 100vh; background: var(--paper); display: flex; flex-direction: column; }

.navbar {
  position: relative;
  height: 88rpx;
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.nav-back { position: absolute; left: 24rpx; top: 50%; transform: translateY(-50%); width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.nav-back-ic { transform: rotate(180deg); font-size: var(--fs-lg); color: var(--ink); }
.nav-title { font-size: var(--fs-lg); font-weight: 700; color: var(--ink); }

.confirm-scroll { flex: 1; overflow-y: scroll; }
.confirm-body { padding: 16rpx 32rpx calc(400rpx + var(--sab)); }

.section-card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  padding: 28rpx;
  box-shadow: var(--sh-sm);
  margin-bottom: 20rpx;
}
.section-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.section-header .ficon { font-size: var(--fs-lg); color: var(--teal-deep); }
.section-title { font-size: var(--fs-md); font-weight: 750; color: var(--ink); }

.store-info-compact { display: flex; flex-direction: column; gap: 10rpx; }
.store-name-text { font-size: var(--fs-md); font-weight: 650; color: var(--ink); }
.store-address-text { font-size: var(--fs-base); color: var(--muted); line-height: 1.5; }

.summary-rows { display: flex; flex-direction: column; gap: 18rpx; }
.summary-row { display: flex; justify-content: space-between; align-items: center; }
.summary-label { font-size: var(--fs-base); color: var(--muted); }
.summary-value { font-size: var(--fs-base); font-weight: 600; color: var(--ink); }

.state-block { display: flex; flex-direction: column; gap: 14rpx; }
.state-t { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.state-d { margin-top: 8rpx; font-size: var(--fs-base); line-height: 1.6; color: var(--muted); }
.section-card .btn { min-height: 48px; margin-top: 16rpx; }

.coupon-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: var(--paper);
  border-radius: var(--r-md);
}
.coupon-text { font-size: var(--fs-base); color: var(--faint); }
.coupon-text.selected { color: var(--gold-deep); font-weight: 650; }
.coupon-selector .ficon { font-size: var(--fs-base); color: var(--faint); }

.price-rows { display: flex; flex-direction: column; gap: 18rpx; }
.price-row { display: flex; justify-content: space-between; align-items: center; }
.price-row.total { padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.price-label { font-size: var(--fs-base); color: var(--muted); }
.price-row.total .price-label { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.price-value { font-size: var(--fs-base); font-weight: 600; color: var(--ink); }
.price-value.discount { color: var(--clay-deep); }
.price-value.final { font-size: var(--fs-lg); font-weight: 800; color: var(--teal-deep); }

.agreement-section { display: flex; align-items: center; flex-wrap: wrap; padding: 24rpx 8rpx; }
.agreement-label { display: flex; align-items: center; gap: 12rpx; font-size: var(--fs-base); color: var(--muted); }
.agreement-label checkbox { transform: scale(0.9); }
.agreement-section .link { color: var(--link); font-weight: 600; display: inline-block; font-size: var(--fs-base); padding: 30rpx 6rpx; }
.agreement-hint { margin: -12rpx 8rpx 8rpx; font-size: var(--fs-sm); line-height: 1.6; color: var(--warn); }

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--surface);
  padding: 20rpx 32rpx calc(20rpx + var(--sab));
  border-top: 1rpx solid var(--line-soft);
  box-shadow: 0 -8rpx 24rpx rgba(11, 39, 33, .06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  z-index: 100;
}

.price-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.price-info .label { font-size: var(--fs-sm); color: var(--muted); }
.price-info .amount { font-size: var(--fs-xl); font-weight: 800; color: var(--teal-deep); font-variant-numeric: tabular-nums; }

.submit-btn {
  flex-shrink: 0;
  min-height: 112rpx;
  padding: 24rpx 52rpx;
  background: linear-gradient(135deg, #16483E 0%, #0A2720 100%);
  border: 1rpx solid rgba(223, 198, 147, .38);
  color: var(--gold-bright);
  border-radius: var(--r-full);
  font-size: var(--fs-base);
  font-weight: 700;
  box-shadow: var(--sh-sm);
  transition: all 0.2s ease;
}
.submit-btn:active { transform: scale(0.98); }
.submit-btn.disabled { opacity: 0.45; pointer-events: none; }
