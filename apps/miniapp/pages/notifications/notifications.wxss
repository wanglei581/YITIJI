/* pages/notifications/notifications.wxss  消息通知（墨翠鎏金白瓷） */

.list-toolbar { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; padding: 0 32rpx 12rpx; }
.lt-action {
  flex-shrink: 0;
  min-width: 132rpx;
  height: 96rpx;
  padding: 0 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
  border: 1rpx solid var(--line);
  background: var(--surface);
  box-shadow: var(--sh-xs);
  color: var(--teal-deep);
  font-size: var(--fs-base);
  font-weight: 650;
}

.nt-list { padding: 0 32rpx; }
.nt-item { display: flex; align-items: flex-start; padding: 28rpx 0; border-bottom: 1rpx solid var(--line-faint); }
.nt-item:last-child { border-bottom: none; }

.nt-item.unread .nt-t::before {
  content: "";
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  vertical-align: middle;
  border-radius: var(--r-full);
  background: var(--error);
}

.nt-ic {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 22rpx;
}
.nt-ic .ficon { width: 40rpx; height: 40rpx; }

.tone-teal  { background: var(--teal-wash);  }
.tone-teal .ficon  { color: var(--teal-deep);  }
.tone-wheat { background: var(--wheat-wash); }
.tone-wheat .ficon { color: var(--wheat-deep); }
.tone-plum  { background: var(--plum-wash);  }
.tone-plum .ficon  { color: var(--plum-deep);  }
.tone-clay  { background: var(--clay-wash);  }
.tone-clay .ficon  { color: var(--clay-deep);  }

.nt-body { flex: 1; }
.nt-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.nt-t { flex: 1; font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.nt-time { font-size: var(--fs-sm); color: var(--faint); flex-shrink: 0; }
.nt-text { margin-top: 10rpx; font-size: var(--fs-base); line-height: 1.7; color: var(--ink-soft); }
.nt-link { display: inline-flex; align-items: center; gap: 8rpx; margin-top: 14rpx; font-size: var(--fs-base); font-weight: 650; color: var(--teal-deep); }
.nt-link-arrow { width: 18rpx; height: 18rpx; }

.empty-slot { padding: 60rpx 20rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.es-ic { font-size: var(--fs-2xl); color: var(--faint); margin-bottom: 20rpx; }
.es-t { font-size: var(--fs-md); font-weight: 700; color: var(--ink-soft); }
.es-d { margin-top: 8rpx; font-size: var(--fs-sm); color: var(--muted); }
