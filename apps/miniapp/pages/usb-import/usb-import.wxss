/* pages/usb-import/usb-import.wxss  P16 U盘打印指引 */
.usb-hero { margin: 8rpx 32rpx 0; padding: 34rpx 30rpx; border-radius: 32rpx; border: 1rpx solid #dce9ff; background: #eaf2ff; text-align: center; }
.usb-hero .usb-ic { width: 112rpx; height: 112rpx; border-radius: 34rpx; background: var(--teal); color: #fff;
  display: flex; align-items: center; justify-content: center; margin: 0 auto 24rpx; box-shadow: 0 12rpx 28rpx rgba(22,119,255,.18); }
.usb-hero .usb-ic .ficon { width: 56rpx; height: 56rpx; }
.usb-hero .usb-title { font-size: 36rpx; font-weight: 750; color: #17233e; }
.usb-hero .usb-sub { font-size: 26rpx; color: var(--muted); margin-top: 16rpx; line-height: 1.65; }

.guide-step { display: flex; gap: 28rpx; padding: 24rpx 4rpx; }
.guide-step + .guide-step { border-top: 2rpx solid var(--line-faint); }
.guide-step .gs-n { width: 56rpx; height: 56rpx; border-radius: 18rpx; background: var(--teal-soft); color: var(--teal);
  font-weight: 700; font-size: 28rpx; display: flex; align-items: center;
  justify-content: center; flex-shrink: 0; }
.guide-step .gs-body { flex: 1; }
.guide-step .gs-t { font-size: 29rpx; font-weight: 600; color: var(--ink); }
.guide-step .gs-d { font-size: 25rpx; color: var(--muted); margin-top: 8rpx; line-height: 1.55; }

.fmt-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
