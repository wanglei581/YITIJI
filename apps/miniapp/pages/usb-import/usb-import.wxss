/* pages/usb-import/usb-import.wxss  P16 U盘打印指引 */
.usb-hero { text-align: center; padding: 40rpx 48rpx 8rpx; }
.usb-hero .usb-ic { width: 160rpx; height: 160rpx; border-radius: 40rpx; background: var(--slate-wash);
  display: flex; align-items: center; justify-content: center; font-size: 80rpx; margin: 0 auto 28rpx; }
.usb-hero .usb-title { font-family: var(--font-serif); font-size: 38rpx; font-weight: 700; color: var(--ink); }
.usb-hero .usb-sub { font-size: 26rpx; color: var(--muted); margin-top: 16rpx; line-height: 1.65; }

.guide-step { display: flex; gap: 28rpx; padding: 24rpx 4rpx; }
.guide-step + .guide-step { border-top: 2rpx solid var(--line-faint); }
.guide-step .gs-n { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--slate); color: #fff;
  font-family: var(--font-serif); font-weight: 700; font-size: 28rpx; display: flex; align-items: center;
  justify-content: center; flex-shrink: 0; }
.guide-step .gs-body { flex: 1; }
.guide-step .gs-t { font-size: 29rpx; font-weight: 600; color: var(--ink); }
.guide-step .gs-d { font-size: 25rpx; color: var(--muted); margin-top: 8rpx; line-height: 1.55; }

.fmt-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
