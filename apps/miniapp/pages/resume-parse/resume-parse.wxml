<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>
  <view class="navbar">
    <view class="nav-back tap" hover-class="tap-press" bindtap="back">
      <text class="ficon i-right nav-back-ic"></text>
    </view>
    <view class="nav-title">{{fileChanged || fileChangedBlocked ? '请重新上传' : terminalCharge || terminalBlocked ? '原标识已结束' : conflict === 'blocked' ? '不能开始这次解析' : conflict ? '另一次标识还在' : phase === 'unknown' ? '解析结果未知' : 'AI 解析中'}}</view>
    <view style="width:64rpx"></view>
  </view>

  <!-- 步骤指示 -->
  <view class="steps">
    <view class="st done"><view class="n"><text class="ficon i-right" style="font-size:20rpx;transform:rotate(-45deg) scaleX(.8)"></text></view><view class="nl">上传</view></view>
    <view class="line done"></view>
    <view class="st on"><view class="n">2</view><view class="nl">解析</view></view>
    <view class="line"></view>
    <view class="st"><view class="n">3</view><view class="nl">诊断</view></view>
  </view>

  <scroll-view scroll-y class="content has-bar">

    <!-- 解析中:后端只给总状态,不给分阶段进度,因此只显示真实已用时长,不显示百分比 -->
    <view wx:if="{{phase === 'parsing'}}" class="parse-center">
      <view class="ring spin">
        <view class="ring-inner">
          <view class="pr-pct">{{elapsed}}s</view>
          <view class="pr-label">已用时</view>
        </view>
      </view>
      <view class="ai-status">
        <view class="dots"><view></view><view></view><view></view></view>
        {{atext}}
      </view>
    </view>

    <!-- 失败:把后端原因原样说清,不静默重试也不假装完成 -->
    <view wx:elif="{{phase === 'failed'}}" class="parse-center">
      <view class="fail-ic"><text class="ficon i-info"></text></view>
      <view class="fail-title">解析未完成</view>
      <view class="fail-msg">{{failMsg}}</view>
    </view>

    <!-- 未知：服务端可能已完成。只按已有编号查询；无编号时明确告知核对限制。 -->
    <view wx:elif="{{phase === 'unknown'}}" class="parse-center">
      <view class="fail-ic"><text class="ficon i-info"></text></view>
      <view class="fail-title">{{terminalTitle || '本次解析结果未知'}}</view>
      <view class="fail-msg">{{unknownCause}}</view>
      <view wx:if="{{terminalCharge}}" class="unknown-next">同一标识不能恢复。连续确认两次后才会清除本机标识并开始新的一次，那会再次调用 AI。本页不会自动提交。</view>
      <view wx:elif="{{terminalBlocked}}" class="unknown-next">没有清除本机标识，也没有另起一次解析。</view>
      <view wx:elif="{{settleBlocked}}" class="unknown-next">读取凭证已留在本机。点“继续打开结果”只会再次尝试释放这一次的解析标识，不会另起一次解析。</view>
      <view wx:elif="{{intentReplay}}" class="unknown-next">结果还没写入完成。点“同一次重查”会用原来的解析标识再提交一次，并核对还是不是同一个任务编号，不会另起一次解析。</view>
      <view wx:elif="{{conflict === 'fresh'}}" class="unknown-next">连续确认两次后才会清除本机这一条标识并开始新的一次，那会调用 AI。本页不会自动提交。</view>
      <view wx:elif="{{conflict === 'blocked'}}" class="unknown-next">没有清除本机标识，也没有开始新的一次解析。</view>
      <view wx:elif="{{conflict}}" class="unknown-next">点“继续提交这次材料”会先核对并释放上次已保存结果的标识；成功后才提交这次材料并调用 AI。本页不会自行提交。</view>
      <view wx:elif="{{pendingTaskId && recheck !== 'not-found'}}" class="unknown-next">已收到本次任务编号。点击下方“查询本次结果”会按同一编号查询，不会再次提交解析。</view>
      <!-- 没有本次意图的旧任务：404 不区分原因，只给核对方向。换回提交时的账号后同一编号可能又读得到。 -->
      <view wx:elif="{{pendingTaskId}}" class="unknown-next">如果提交后退出过登录或换过账号，请先换回提交时的账号，再点“查询本次结果”按同一编号查询，或到 AI 服务记录查看。</view>
      <view wx:else class="unknown-next">这台手机没有收到本次任务编号。点“同一次重查”会用原来的解析标识再提交一次，不会另起一次解析。</view>
      <view wx:if="{{recheck === 'not-ready' && !intentReplay}}" class="unknown-next">本次任务仍在处理中，稍后可按同一编号再查。</view>
      <view wx:elif="{{recheck === 'error'}}" class="unknown-next">查询暂时失败，稍后可按同一编号再查。</view>
      <view wx:elif="{{recheck === 'malformed'}}" class="unknown-next">查询答复不完整，仍无法确认结果；稍后可按同一编号再查。</view>
      <view wx:if="{{canCheckRecords || recheck === 'not-found'}}" class="unknown-link tap" hover-class="tap-press" bindtap="toAiRecords" role="button" aria-label="到我的 AI 服务记录核对">到我的 AI 服务记录核对</view>
      <view wx:if="{{pendingTaskId && recheck === 'not-found' && !intentReplay && !settleBlocked}}" class="unknown-link tap" hover-class="tap-press" bindtap="confirmResubmit" role="button" aria-label="改为重新提交（新的一次），提交前会再确认">改为重新提交（新的一次）</view>
      <view wx:if="{{!pendingTaskId && !conflict && !intentReplay && !settleBlocked && !terminalCharge && !terminalBlocked}}" class="unknown-link tap" hover-class="tap-press" bindtap="confirmResubmit" role="button" aria-label="改为重新提交（新的一次），提交前会再确认">改为重新提交（新的一次）</view>
    </view>

    <!-- 无待解析文件 -->
    <view wx:else class="parse-center">
      <view class="fail-ic"><text class="ficon i-file-text"></text></view>
      <view class="fail-title">缺少待解析的简历</view>
      <view class="fail-msg">请先选择或拍摄一份简历文件,上传成功后才会开始 AI 解析。</view>
    </view>

    <!-- 解析环节说明。后端不返回分阶段进度,这里只说明 AI 会检查什么,不标注完成状态 -->
    <view wx:if="{{phase === 'parsing'}}" class="section-t">本次解析包含</view>
    <view wx:if="{{phase === 'parsing'}}" class="card">
      <view class="parse-stages">
        <block wx:for="{{stages}}" wx:key="id">
          <view class="ps-row">
            <view class="ps-ic"><text style="font-size:22rpx">·</text></view>
            <view class="ps-label">{{item.label}}</view>
            <view class="ps-desc">{{item.desc}}</view>
          </view>
        </block>
      </view>
    </view>

    <view wx:if="{{phase === 'parsing'}}" class="notice info">
      <text class="ficon i-info n-ic"></text>
      <view>本次解析会同时生成诊断，不会再单独重复解析。没有指定方向时按通用方向诊断；结果仅供参考，不代表用人单位意见。</view>
    </view>
    <view wx:if="{{phase === 'failed' && fileChangedBlocked}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <view>这次没有调用模型。本机解析标识还在，页面不会自动重试，也不会另起一次。</view>
    </view>
    <view wx:elif="{{phase === 'failed' && fileChanged}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <view>这次没有调用模型。请重新上传新文件，不要用这份已停用的文件再解析。</view>
    </view>
    <view wx:elif="{{phase === 'failed' && quotaReleaseBlocked}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <view>这次没有调用新的解析。本机解析标识还在，页面不会自动重试，也不会另起一次。</view>
    </view>
    <view wx:elif="{{phase === 'failed' && quotaReleased}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <view>这次没有调用新的解析。点“开始新的一次”才会另起一次；也可以明天或换一份文件后再试。</view>
    </view>
    <view wx:elif="{{phase === 'failed'}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <view>本次未产生诊断结果。上传的文件有有效期,超时后需要重新选择文件上传。</view>
    </view>
    <view wx:if="{{phase === 'unknown' && terminalCharge}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <view>这次标识已经结束。本页不会自动重新提交。开始新的一次需要连续确认，并会再次调用 AI。</view>
    </view>
    <view wx:elif="{{phase === 'unknown' && terminalBlocked}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <view>本机标识对不上或没能清除。本页不会自动重新提交，也不会另起一次。</view>
    </view>
    <view wx:elif="{{phase === 'unknown' && settleBlocked}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <view>刚才那次的读取凭证还在本机。本页不会自动重新提交，也不会另起一次解析。</view>
    </view>
    <view wx:elif="{{phase === 'unknown' && intentReplay}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <view>刚才那次可能已经完成。本页不会自动重新提交；“同一次重查”使用原来的解析标识，不会开始新的一次解析。</view>
    </view>
    <view wx:elif="{{phase === 'unknown' && conflict}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <view>本页不会自动重新提交。另一次解析可能已经完成。</view>
    </view>
    <view wx:elif="{{phase === 'unknown' && pendingTaskId && recheck !== 'not-found' && !intentReplay}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <view>刚才那次可能已经完成。本页不会自动重新提交；“查询本次结果”只按同一编号读取，不会再次解析。</view>
    </view>
    <view wx:elif="{{phase === 'unknown'}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <view>刚才那次可能已经完成。本页不会自动重新提交；手动重新提交会发起新的一次 AI 解析，可能重复处理。</view>
    </view>
    <view style="height:40rpx"></view>
  </scroll-view>

  <view class="actionbar">
    <button wx:if="{{phase === 'parsing' && !done}}" class="btn ghost block" disabled>等待解析完成…</button>
    <button wx:elif="{{phase === 'parsing' && done}}" class="btn primary block" disabled>解析完成,正在进入诊断…</button>
    <block wx:elif="{{phase === 'failed'}}">
      <view class="btn ghost tap" bindtap="toUpload">重新选择</view>
      <button wx:if="{{quotaReleaseBlocked}}" class="btn primary flex-1-5" disabled>暂不能开始新的一次</button>
      <view wx:elif="{{quotaReleased}}" class="btn primary tap flex-1-5" bindtap="retry">开始新的一次</view>
      <button wx:elif="{{fileChangedBlocked}}" class="btn primary flex-1-5" disabled>暂不能开始新的一次</button>
      <view wx:elif="{{fileChanged}}" class="btn primary tap flex-1-5" bindtap="toUpload">重新上传</view>
      <view wx:else class="btn primary tap flex-1-5" bindtap="retry">重试解析</view>
    </block>
    <block wx:elif="{{phase === 'unknown'}}">
      <view class="btn ghost tap" bindtap="toUpload">重新选择</view>
      <button wx:if="{{settleBlocked}}" class="btn primary flex-1-5 unknown-action" disabled="{{recheck === 'checking'}}" bindtap="retrySettle">继续打开结果</button>
      <button wx:elif="{{terminalCharge}}" class="btn primary flex-1-5 unknown-action" bindtap="confirmResubmit">重新解析（新的一次）</button>
      <button wx:elif="{{terminalBlocked || conflict === 'blocked'}}" class="btn primary flex-1-5" disabled>暂不能开始新的一次</button>
      <button wx:elif="{{conflict === 'fresh'}}" class="btn primary flex-1-5 unknown-action" bindtap="confirmResubmit">重新解析（新的一次）</button>
      <button wx:elif="{{conflict === 'retry'}}" class="btn primary flex-1-5 unknown-action" bindtap="replaySame">继续提交这次材料</button>
      <button wx:elif="{{pendingTaskId && intentReplay}}" class="btn primary flex-1-5 unknown-action" disabled="{{recheck === 'checking'}}" bindtap="replayKnown">同一次重查</button>
      <button wx:elif="{{pendingTaskId}}" class="btn primary flex-1-5 unknown-action" disabled="{{recheck === 'checking'}}" bindtap="recheck">{{recheck === 'checking' ? '正在查询…' : '查询本次结果'}}</button>
      <button wx:else class="btn primary flex-1-5 unknown-action" disabled="{{recheck === 'checking'}}" bindtap="replaySame">同一次重查</button>
    </block>
    <view wx:else class="btn primary block tap" bindtap="toUpload">去选择简历</view>
  </view>
</view>
