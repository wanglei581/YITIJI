/* pages/career-plan/career-plan.wxss  职业规划（墨翠鎏金白瓷） */
.page-wrap { min-height: 100vh; background: var(--paper); }

.running-state { display: flex; flex-direction: column; align-items: center; padding: 100rpx 32rpx 0; gap: 20rpx; }
.rs-anim { position: relative; width: 120rpx; height: 120rpx; margin-bottom: 16rpx; }
.rs-ring { position: absolute; inset: 0; border-radius: var(--r-full); border: 4rpx solid transparent; border-top-color: var(--teal); animation: spin 1s linear infinite; }
.rs-ic { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: var(--fs-2xl); color: var(--teal); }
@keyframes spin { to { transform: rotate(360deg); } }
.st-ic { width: 128rpx; height: 128rpx; border-radius: var(--r-full); background: radial-gradient(circle at 30% 28%, #ECF7F3 0%, #D9EEE6 100%); display: flex; align-items: center; justify-content: center; font-size: var(--fs-2xl); color: var(--teal-deep); margin-bottom: 8rpx; }
.st-ic.warn { background: var(--warn-soft); color: var(--warn); }
.rs-title { font-size: var(--fs-lg); font-weight: 750; color: var(--ink); }
.rs-sub { font-size: var(--fs-base); color: var(--muted); text-align: center; line-height: 1.6; }
.rs-disclaimer { font-size: var(--fs-sm); color: var(--faint); text-align: center; line-height: 1.6; }

.cp-cta {
  margin-top: 12rpx;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 40rpx;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, #16483E 0%, #0A2720 100%);
  color: var(--gold-bright);
  font-size: var(--fs-base);
  font-weight: 700;
  box-shadow: var(--sh-sm);
}
.cp-cta-arrow { width: 20rpx; height: 20rpx; }

.cp-p { font-size: var(--fs-base); color: var(--muted); line-height: 1.75; margin-bottom: 14rpx; }
.cp-p:last-child { margin-bottom: 0; }
.cp-strong { color: var(--ink); font-weight: 700; }
.cp-file { display: flex; align-items: center; gap: 12rpx; margin-top: 6rpx; padding: 18rpx 20rpx; background: var(--paper); border-radius: var(--r-sm); border: 1rpx solid var(--line); }
.cp-file-ic { font-size: var(--fs-md); color: var(--teal); flex-shrink: 0; }
.cp-file-name { flex: 1; min-width: 0; font-size: var(--fs-base); color: var(--ink); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.cp-act { margin: 16px 16px 0; }

.cp-based { margin: 0 16px 12px; padding: 24rpx 26rpx; background: var(--surface); border: 1rpx solid var(--line-soft); border-radius: var(--r-lg); box-shadow: var(--sh-sm); }
.cb-cap { font-size: var(--fs-sm); color: var(--muted); margin-bottom: 14rpx; }
.cb-hint { font-size: var(--fs-sm); color: var(--faint); line-height: 1.6; margin-top: 12rpx; }
.cb-link { font-size: var(--fs-sm); color: var(--link); font-weight: 600; }

.cp-summary { font-size: var(--fs-base); color: var(--ink); line-height: 1.8; }
.cp-hint { font-size: var(--fs-sm); color: var(--faint); line-height: 1.6; margin: 10rpx 16px 0; }

.cp-list { margin: 0 16px; display: flex; flex-direction: column; gap: 14rpx; }

.cs-item { display: flex; gap: 14rpx; padding: 24rpx 26rpx; background: var(--surface); border: 1rpx solid var(--line-soft); border-radius: var(--r-lg); box-shadow: var(--sh-sm); }
.cs-mark { flex-shrink: 0; width: 42rpx; height: 42rpx; border-radius: var(--r-full); background: var(--teal-soft); color: var(--teal-deep); display: flex; align-items: center; justify-content: center; margin-top: 2rpx; }
.cs-mark .ficon { width: 22rpx; height: 22rpx; }
.cs-body { flex: 1; min-width: 0; }
.cs-point { font-size: var(--fs-base); color: var(--ink); font-weight: 650; line-height: 1.6; }
.cs-ev { font-size: var(--fs-sm); color: var(--muted); line-height: 1.6; margin-top: 8rpx; padding-left: 16rpx; border-left: 4rpx solid var(--gold); }

.dir-list { margin: 0 16px; display: flex; flex-direction: column; gap: 16rpx; }
.dir-item { background: var(--surface); border: 1rpx solid var(--line-soft); border-radius: var(--r-lg); box-shadow: var(--sh-sm); padding: 26rpx; }
.di-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.di-rank { width: 40rpx; height: 40rpx; border-radius: var(--r-full); background: linear-gradient(135deg, #16483E 0%, #0A2720 100%); color: var(--gold-bright); font-size: var(--fs-sm); font-weight: 750; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.di-title { flex: 1; font-size: var(--fs-md); font-weight: 750; color: var(--ink); }
.di-reason { font-size: var(--fs-base); color: var(--muted); line-height: 1.7; }
.di-step { margin-top: 14rpx; padding: 16rpx 20rpx; background: var(--paper); border-radius: var(--r-sm); border-left: 4rpx solid var(--teal); }
.ds-cap { font-size: var(--fs-sm); color: var(--teal-deep); font-weight: 700; margin-bottom: 6rpx; }
.ds-text { font-size: var(--fs-base); color: var(--ink); line-height: 1.7; }

.sk-item { padding: 24rpx 26rpx; background: var(--surface); border: 1rpx solid var(--line-soft); border-radius: var(--r-lg); box-shadow: var(--sh-sm); }
.sk-head { display: flex; align-items: center; gap: 12rpx; }
.sk-name { flex: 1; font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.sk-time { flex-shrink: 0; font-size: var(--fs-xs); padding: 6rpx 16rpx; border-radius: var(--r-full); background: var(--gold-soft); color: var(--gold-deep); border: 1rpx solid var(--gold-line); font-weight: 650; }
.sk-act { font-size: var(--fs-base); color: var(--muted); line-height: 1.7; margin-top: 10rpx; }

.action-list { margin: 0 16px; display: flex; flex-direction: column; background: var(--surface); border: 1rpx solid var(--line-soft); border-radius: var(--r-lg); box-shadow: var(--sh-sm); overflow: hidden; }
.al-item { display: flex; align-items: flex-start; gap: 16rpx; padding: 20rpx 24rpx; border-bottom: 1rpx solid var(--line-faint); }
.al-item:last-child { border-bottom: none; }
.al-dot { width: 14rpx; height: 14rpx; border-radius: var(--r-full); background: var(--gold); flex-shrink: 0; margin-top: 14rpx; }
.al-text { flex: 1; font-size: var(--fs-base); color: var(--ink); line-height: 1.7; }

.flex-1-4 { flex: 1.4; }

@media (max-width: 374px) {
  .actionbar .btn { padding: 0 20px; }
}
