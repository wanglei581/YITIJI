<!--pages/print/print.wxml-->
<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="nav-back tap" hover-class="tap-press" bindtap="back">
      <text class="ficon i-right nav-back-ic"></text>
    </view>
    <view class="nav-title left">打印服务</view>
    <view class="nav-right">
      <view class="nav-caps tap" hover-class="tap-press" bindtap="tapScan">连接终端</view>
    </view>
  </view>

  <view class="content">

    <view class="print-hero">
      <view class="hero-icon"><text class="ficon i-printer"></text></view>
      <view class="hero-copy">
        <view class="hero-title">手机准备，到机出纸</view>
        <view class="hero-sub">先完成文件与参数准备，再到终端扫码核验</view>
      </view>
    </view>

    <!-- 三步流程条 -->
    <view class="step-bar">
      <block wx:for="{{steps}}" wx:key="n">
        <view class="step">
          <view class="step-n">{{item.n}}</view>
          <view class="step-label">{{item.label}}</view>
        </view>
        <view wx:if="{{index < steps.length - 1}}" class="step-line"></view>
      </block>
    </view>

    <!-- 打印路径 -->
    <view class="section-t">选择服务方式</view>
    <view
      class="path-card sheen tap rise-d{{index+1}}"
      wx:for="{{paths}}"
      wx:key="id"
      data-id="{{item.id}}"
      hover-class="tap-press"
      bindtap="tapPath"
    >
      <view class="pc-ic {{item.accent ? 'a-'+item.accent : 'a-neutral'}}"><text class="ficon i-{{item.icon}}"></text></view>
      <view class="pc-body">
        <view class="pc-title-row">
          <view class="pc-title">{{item.title}}</view>
          <view wx:if="{{item.badge}}" class="pc-badge">{{item.badge}}</view>
        </view>
        <view class="pc-desc">{{item.desc}}</view>
        <view class="pc-flow">{{item.flow}}</view>
      </view>
      <view class="pc-arrow"><text class="ficon i-right"></text></view>
    </view>

    <view class="compliance-note">
      打印状态、出纸完成均以一体机终端实时上报为准，如与实际不符请到店核对。
    </view>

  </view>
</view>
