/* pages/print/print.wxss */
.page-wrap { min-height: 100vh; background: var(--paper); }

.print-hero {
  min-height: 186rpx;
  margin: 8rpx 32rpx 24rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: #eaf2ff;
  border: 1rpx solid #d9e8ff;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.hero-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: var(--teal);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(22, 119, 255, .18);
  flex-shrink: 0;
}
.hero-icon .ficon { width: 46rpx; height: 46rpx; }
.hero-copy { flex: 1; min-width: 0; }
.hero-title { font-size: 34rpx; line-height: 1.3; font-weight: 800; color: #17233e; }
.hero-sub { margin-top: 10rpx; font-size: 23rpx; line-height: 1.55; color: #66758d; }

.path-card {
  display: flex; align-items: center; gap: 22rpx;
  background: var(--surface);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line-soft);
  margin: 0 32rpx 18rpx;
  padding: 28rpx 26rpx;
}
.path-card .pc-ic {
  width: 88rpx; height: 88rpx; border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 42rpx; flex-shrink: 0;
}
.pc-body { flex: 1; min-width: 0; }
.pc-title { font-size: 29rpx; font-weight: 700; color: var(--ink); }
.pc-desc  { font-size: 23rpx; line-height: 1.45; color: var(--muted); margin-top: 7rpx; }
.pc-flow  {
  font-size: 21rpx; color: var(--teal-deep);
  background: var(--teal-wash);
  display: inline-block;
  padding: 6rpx 14rpx; border-radius: var(--r-full);
  margin-top: 12rpx;
}
.pc-arrow { color: var(--ghost); flex-shrink: 0; }
.pc-arrow .ficon { width: 22rpx; height: 22rpx; }

/* ── 三步流程条：上传 → 选门店 → 结算取件 ── */
.step-bar {
  display: flex; align-items: flex-start;
  margin: 0 32rpx 12rpx;
  padding: 24rpx 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-md);
}
.step { width: 104rpx; display: flex; flex-direction: column; align-items: center; gap: 9rpx; flex-shrink: 0; }
.step-n {
  width: 44rpx; height: 44rpx; border-radius: 15rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 750; color: var(--teal);
  background: var(--teal-soft);
}
.step-label { font-size: 21rpx; color: var(--muted); font-weight: 600; text-align: center; white-space: nowrap; }
.step-line { flex: 1; height: 2rpx; margin-top: 21rpx; background: var(--line-soft); }

/* ── 路径标题行 + 推荐标签 ── */
.pc-title-row { display: flex; align-items: center; gap: 12rpx; }
.pc-badge {
  font-size: 19rpx; font-weight: 700;
  color: var(--teal-deep);
  padding: 3rpx 12rpx; border-radius: var(--r-full);
  background: var(--teal-soft);
}
