/* pages/print/print.wxss · 墨翠鎏金白瓷旗舰版 */
.page-wrap { min-height: 100vh; background: var(--paper); }

.print-hero {
  position: relative;
  overflow: hidden;
  min-height: 184rpx;
  margin: 10rpx 32rpx 24rpx;
  padding: 32rpx 30rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(152deg, #184E43 0%, #0E3129 58%, #081D18 100%);
  border: 1rpx solid rgba(212, 186, 135, .30);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .12), 0 16rpx 40rpx -12rpx rgba(8, 29, 24, .42);
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.print-hero::after {
  content: "";
  position: absolute;
  right: -50rpx;
  top: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: var(--r-full);
  background: radial-gradient(circle, rgba(223, 198, 147, .22) 0%, rgba(60, 224, 169, .08) 45%, rgba(8, 29, 24, 0) 72%);
  pointer-events: none;
}
.hero-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: var(--r-md);
  background: rgba(223, 198, 147, .14);
  border: 1rpx solid rgba(223, 198, 147, .32);
  color: var(--gold-bright);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.hero-icon .ficon { width: 44rpx; height: 44rpx; }
.hero-copy { flex: 1; min-width: 0; position: relative; z-index: 1; }
.hero-title { font-size: var(--fs-lg); line-height: 1.3; font-weight: 700; color: #FFFFFF; letter-spacing: .3rpx; }
.hero-sub { margin-top: 10rpx; font-size: var(--fs-sm); line-height: 1.5; color: var(--mint); opacity: .9; }

/* ── 三步流程条：编辑级步进条 + 香槟金连线 ── */
.step-bar {
  display: flex;
  align-items: flex-start;
  margin: 0 32rpx 16rpx;
  padding: 26rpx 24rpx;
  background: var(--surface);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-xs);
}
.step { width: 112rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; flex-shrink: 0; }
.step-n {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--r-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(145deg, var(--teal) 0%, var(--teal-deep) 100%);
  box-shadow: 0 4rpx 10rpx rgba(15, 106, 87, .22);
}
.step-label { font-size: var(--fs-sm); color: var(--ink-soft); font-weight: 600; text-align: center; white-space: nowrap; }
.step-line {
  flex: 1;
  height: 2rpx;
  margin-top: 22rpx;
  background: linear-gradient(90deg, rgba(15, 106, 87, .22) 0%, rgba(182, 154, 104, .42) 50%, rgba(15, 106, 87, .22) 100%);
}

/* ── 分区标题：与首页/AI/我的统一的翡翠鎏金竖条锚点 ── */
.section-t {
  position: relative;
  margin: 28rpx 32rpx 18rpx;
  padding: 0 0 0 18rpx;
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: .4rpx;
}
.section-t::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  border-radius: var(--r-full);
  background: linear-gradient(180deg, var(--teal) 0%, var(--gold) 100%);
}

/* ── 打印方式浮层卡：双层微阴影 + 去方块圆形徽章 + 精致字号胶囊 ── */
.path-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--surface);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-xs);
  margin: 0 32rpx 18rpx;
  padding: 28rpx 26rpx;
}
.path-card .pc-ic {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--r-full);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-lg);
  flex-shrink: 0;
}
.pc-body { flex: 1; min-width: 0; }
.pc-title-row { display: flex; align-items: center; gap: 12rpx; }
.pc-title { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.pc-badge {
  font-size: var(--fs-xs);
  font-weight: 700;
  color: #FFFFFF;
  padding: 3rpx 14rpx;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, #C9AD78 0%, #9E7E48 100%);
  line-height: 1.35;
}
.pc-desc  { font-size: var(--fs-sm); line-height: 1.48; color: var(--muted); margin-top: 8rpx; }
.pc-flow  {
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--teal-deep);
  background: var(--teal-wash);
  border: 1rpx solid rgba(15, 106, 87, .12);
  display: inline-block;
  padding: 5rpx 16rpx;
  border-radius: var(--r-full);
  margin-top: 14rpx;
  line-height: 1.4;
}
.pc-arrow { color: var(--ghost); flex-shrink: 0; }
.pc-arrow .ficon { width: 22rpx; height: 22rpx; }
