.nav-back .i-right { transform: rotate(180deg); }

.guide-card,
.state-card {
  margin: 24rpx 32rpx 0;
  padding: 48rpx 36rpx;
  border-radius: 32rpx;
  border: 1rpx solid var(--line-soft);
  background: var(--surface);
  text-align: center;
}
.guide-card { background: #f3f8ff; border-color: #dce9ff; }
.guide-icon,
.sc-icon {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 26rpx;
  border-radius: 34rpx;
  background: var(--teal);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  box-shadow: 0 12rpx 28rpx rgba(22,119,255,.18);
}
.guide-title,
.sc-title { font-size: 36rpx; line-height: 1.35; font-weight: 750; color: var(--ink); }
.steps { margin: 36rpx 0 42rpx; padding: 20rpx 22rpx; border-radius: 24rpx; background: var(--surface); text-align: left; }
.step { display: flex; align-items: flex-start; gap: 18rpx; padding: 17rpx 0; }
.step + .step { border-top: 1rpx solid var(--line-faint); }
.step-num { width: 44rpx; height: 44rpx; border-radius: 15rpx; background: var(--teal-soft); color: var(--teal); font-size: 22rpx; font-weight: 750; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.step-text { flex: 1; padding-top: 4rpx; color: var(--ink-soft); font-size: 24rpx; line-height: 1.55; }
.btn-scan,
.btn-primary,
.btn-secondary {
  width: 100%;
  min-height: 92rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 700;
}
.btn-scan,
.btn-primary { background: var(--teal); color: #fff; box-shadow: 0 10rpx 24rpx rgba(22,119,255,.16); }
.btn-scan { gap: 12rpx; }
.btn-scan .ficon { width: 38rpx; height: 38rpx; }
.btn-secondary { background: var(--surface); color: var(--teal); border: 2rpx solid var(--teal); }
.state-card { margin-top: 40rpx; padding-top: 68rpx; padding-bottom: 60rpx; }
.state-card.success { background: var(--ok-soft); border-color: transparent; }
.state-card.error { background: var(--error-soft); border-color: transparent; }
.state-card .sc-icon { background: var(--surface-2); color: var(--faint); box-shadow: none; }
.state-card.success .sc-icon { background: var(--ok); color: #fff; }
.state-card.error .sc-icon { background: var(--error); color: #fff; }
.sc-symbol .ficon { width: 52rpx; height: 52rpx; }
.sc-desc { margin: 14rpx 0 40rpx; color: var(--muted); font-size: 24rpx; line-height: 1.65; }
.sc-spinner { width: 78rpx; height: 78rpx; margin: 0 auto 28rpx; border-radius: 50%; border: 6rpx solid var(--line); border-top-color: var(--teal); animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
