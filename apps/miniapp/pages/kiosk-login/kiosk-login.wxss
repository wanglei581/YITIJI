/* pages/kiosk-login/kiosk-login.wxss */

.nav-back .i-right {
  transform: rotate(180deg);
}

.guide-card {
  margin: 48rpx 32rpx;
  padding: 64rpx 48rpx;
  background: linear-gradient(135deg, #fffdf8 0%, #faf7ee 100%);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 158, 134, 0.08);
  text-align: center;
}

.guide-icon {
  font-size: 120rpx;
  color: #1f9e86;
  margin-bottom: 32rpx;
}

.guide-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2d4a3e;
  margin-bottom: 48rpx;
}

.steps {
  text-align: left;
  margin-bottom: 56rpx;
}

.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.step:last-child {
  margin-bottom: 0;
}

.step-num {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #1f9e86;
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 24rpx;
}

.step-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 48rpx;
  color: #5a6f64;
}

.btn-scan {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #1f9e86 0%, #17876f 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(31, 158, 134, 0.3);
}

.btn-scan .ficon {
  font-size: 40rpx;
}

.state-card {
  margin: 96rpx 32rpx;
  padding: 80rpx 48rpx;
  background: #fffdf8;
  border-radius: 32rpx;
  text-align: center;
}

.state-card.success {
  background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
}

.state-card.error {
  background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
}

.sc-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.sc-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  margin-left: auto;
  margin-right: auto;
  border: 6rpx solid currentColor;
  border-radius: 50%;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.state-card .sc-icon {
  color: #94a3b8;
}

.state-card.success .sc-icon {
  color: #22c55e;
}

.state-card.error .sc-icon {
  color: #ef4444;
}

.sc-spinner {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 32rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: #1f9e86;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.sc-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2d4a3e;
  margin-bottom: 24rpx;
}

.sc-desc {
  font-size: 28rpx;
  line-height: 44rpx;
  color: #64748b;
  margin-bottom: 56rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1f9e86;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #1f9e86;
  border: 2rpx solid #1f9e86;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}
