/* pages/job-tracker/job-tracker.wxss */

/* ── 总览条 ─────────────────────────────── */
.summary-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 32rpx 8rpx;
}
.summary-ic { font-size: 30rpx; color: var(--teal); }
.summary-text { font-size: 26rpx; color: var(--muted); }
.summary-num { font-weight: 700; color: var(--ink); }

/* ── 看板 ────────────────────────────────── */
.board-scroll {
  white-space: nowrap;
  padding-bottom: 160rpx;
}
.board-row {
  display: inline-flex;
  padding: 16rpx 24rpx 24rpx;
  gap: 20rpx;
}
.board-col {
  width: 280rpx;
  display: inline-flex;
  flex-direction: column;
  background: var(--ghost);
  border-radius: 20rpx;
  overflow: hidden;
  vertical-align: top;
}

/* 列标题 */
.col-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 20rpx 16rpx;
  border-bottom: 1rpx solid var(--line);
}
.col-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.col-dot-wheat  { background: #c09a4a; }
.col-dot-teal   { background: var(--teal); }
.col-dot-plum   { background: #8b5cf6; }
.col-dot-green  { background: #16a34a; }
.col-dot-slate  { background: #64748b; }
.col-label { flex: 1; font-size: 26rpx; font-weight: 700; color: var(--ink); }
.col-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink-soft);
  background: var(--surface);
  border-radius: 20rpx;
  padding: 2rpx 14rpx;
  min-width: 36rpx;
  text-align: center;
}

.col-body { padding: 14rpx; display: flex; flex-direction: column; gap: 14rpx; }

/* 空状态 */
.col-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
  gap: 8rpx;
}
.col-empty-ic { font-size: 36rpx; color: var(--line); }
.col-empty-text { font-size: 24rpx; color: var(--muted); }

/* ── 卡片 ────────────────────────────────── */
.jt-card {
  background: var(--surface);
  border-radius: 16rpx;
  padding: 18rpx 18rpx 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  white-space: normal;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.card-ic { font-size: 28rpx; color: var(--teal); }
.card-del {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 22rpx;
}
.card-company {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 4rpx;
}
.card-position {
  display: block;
  font-size: 24rpx;
  color: var(--teal);
  margin-bottom: 8rpx;
}
.card-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 6rpx;
}
.card-meta-ic { font-size: 22rpx; color: var(--muted); }
.card-salary { font-size: 22rpx; color: var(--ink-soft); }
.card-note {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ── 全空状态 ─────────────────────────────── */
.empty-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
  gap: 16rpx;
}
.es-ic { font-size: 72rpx; color: var(--line); }
.es-t { font-size: 30rpx; font-weight: 600; color: var(--ink-soft); }
.es-d { font-size: 26rpx; color: var(--muted); text-align: center; }

/* ── 底部添加 ─────────────────────────────── */
.add-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: var(--surface);
  border-top: 1rpx solid var(--line);
}
.add-bar .btn { display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.btn-ic { font-size: 28rpx; }

/* ── 弹窗 ────────────────────────────────── */
.modal-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 100;
}
.modal-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  z-index: 101;
  max-height: 88vh;
  overflow-y: auto;
}
.modal-drag-bar {
  width: 64rpx;
  height: 8rpx;
  background: var(--line);
  border-radius: 8rpx;
  margin: 0 auto 24rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 32rpx;
  text-align: center;
}
.form-group { margin-bottom: 28rpx; }
.form-label { display: block; font-size: 26rpx; color: var(--ink-soft); margin-bottom: 12rpx; }
.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--ghost);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}
.form-picker {
  display: flex;
  align-items: center;
  height: 80rpx;
  background: var(--ghost);
  border-radius: 16rpx;
  padding: 0 24rpx;
}
.picker-val { flex: 1; font-size: 28rpx; color: var(--ink); }
.picker-arrow { font-size: 28rpx; color: var(--muted); transform: rotate(90deg); }
.form-textarea {
  width: 100%;
  min-height: 100rpx;
  background: var(--ghost);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}
.modal-actions { display: flex; gap: 20rpx; margin-top: 16rpx; }
.modal-actions .btn { flex: 1; }

/* ── 状态选择浮层 ─────────────────────────── */
.status-picker {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 16rpx);
  z-index: 101;
}
.sp-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-soft);
  text-align: center;
  margin-bottom: 20rpx;
}
.sp-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 16rpx;
  border-bottom: 1rpx solid var(--line);
}
.sp-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.sp-dot-wheat  { background: #c09a4a; }
.sp-dot-teal   { background: var(--teal); }
.sp-dot-plum   { background: #8b5cf6; }
.sp-dot-green  { background: #16a34a; }
.sp-dot-slate  { background: #64748b; }
.sp-label { flex: 1; font-size: 30rpx; font-weight: 500; color: var(--ink); }
.sp-arrow { font-size: 28rpx; color: var(--muted); }
.sp-cancel {
  display: block;
  width: 100%;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: var(--muted);
  text-align: center;
}
