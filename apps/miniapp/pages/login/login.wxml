<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>
  <view class="navbar">
    <view class="nav-back tap" hover-class="tap-press" bindtap="back">
      <text class="ficon i-right nav-back-ic"></text>
    </view>
    <view class="nav-title">登录 / 注册</view>
    <view style="width:64rpx"></view>
  </view>

  <scroll-view scroll-y class="content" style="padding-bottom:120rpx">
    <view class="ph" style="padding:40rpx 40rpx 16rpx">
      <view class="ph-title">欢迎使用职易达</view>
      <view class="ph-sub">打印记录和 AI 求职服务将关联到你的账号，请使用本人手机号。</view>
    </view>

    <view style="padding:16rpx 40rpx 0">
      <button
        class="wx-login-btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="onPhoneNumber"
        loading="{{wxLoading}}"
        disabled="{{wxLoading}}"
      >
        <text class="ficon i-robot wx-login-ic"></text>
        <text>微信一键登录</text>
      </button>

      <view class="divider">
        <view class="divider-line"></view>
        <text class="divider-text">或短信验证码登录</text>
        <view class="divider-line"></view>
      </view>

      <view class="field" style="margin-bottom:32rpx">
        <view class="fl">手机号码</view>
        <view class="phone-wrap {{phone ? 'focused' : ''}}">
          <view class="phone-prefix">+86</view>
          <input class="phone-input" type="number" maxlength="11"
            placeholder="请输入手机号" placeholder-style="color:var(--faint)"
            value="{{phone}}" bindinput="onPhoneInput" />
          <view class="send-btn {{counting || sending ? 'counting' : ''}} tap" hover-class="tap-press" bindtap="sendCode">
            {{sending ? '发送中' : (counting ? countDown + 's' : '发送验证码')}}
          </view>
        </view>
      </view>

      <view class="field">
        <view class="fl">短信验证码</view>
        <view class="otp-row" style="position:relative">
          <block wx:for="{{otp}}" wx:key="index">
            <view class="otp-box {{item ? 'filled' : ''}} {{code.length === index ? 'active' : ''}}">
              {{item}}
            </view>
          </block>
          <input class="otp-hidden-input" type="number" maxlength="6"
            value="{{code}}" bindinput="onCodeInput" />
        </view>
        <view wx:if="{{codeHint}}" class="code-hint">{{codeHint}}</view>
      </view>
    </view>

    <view style="padding:56rpx 40rpx 0">
      <button class="btn primary block" style="height:112rpx;font-size:32rpx;border-radius:32rpx"
        loading="{{submitting}}" disabled="{{submitting}}"
        bindtap="confirm">{{submitting ? '登录中' : '确认绑定'}}</button>
    </view>

    <view class="agree-row tap" bindtap="toggleAgree">
      <view class="agree-check {{agreed ? 'on' : ''}}">
        <text class="ficon i-right" wx:if="{{agreed}}" style="font-size:20rpx;color:#fff;transform:rotate(-45deg) scaleX(.8)"></text>
      </view>
      <view style="flex:1;font-size:23rpx;color:var(--muted);line-height:1.65">
        我已阅读并同意
        <text class="agree-link tap" catchtap="tapTerms">《服务协议》</text>和
        <text class="agree-link tap" catchtap="tapPrivacy">《隐私政策》</text>，
        授权平台使用手机号提供打印及 AI 求职服务
      </view>
    </view>
  </scroll-view>
</view>
