<!--pages/policies/policies.wxml · P26 政策服务-->
<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="nav-back tap" hover-class="tap-press" bindtap="back"><text class="ficon i-right nav-back-ic"></text></view>
    <view class="nav-title">政策服务</view>
    <view class="nav-right"></view>
  </view>

  <view class="content policy-content">
    <view class="policy-hero">
      <view class="ph-copy">
        <view class="ph-kicker">公开政策信息</view>
        <view class="ph-t">就业创业政策</view>
        <view class="ph-s">汇总官方发布的求职、创业与就业支持政策</view>
      </view>
      <view class="ph-icon"><text class="ficon i-bank"></text></view>
    </view>

    <!-- 自测入口放在分类条之前：用户来这一页多半是「我能不能办」，
         而不是「我想读哪一类文件」。先给答问题的路，再给读原文的路。 -->
    <view class="pc-entry tap" hover-class="tap-press" bindtap="tapSelfCheck"
          role="button" aria-label="政策条件自测，回答几个问题，看看哪些政策可能和你有关">
      <view class="pc-ic"><text class="ficon i-aim"></text></view>
      <view class="pc-body">
        <view class="pc-t">看看哪些政策可能和我有关</view>
        <view class="pc-s">回答几个问题，与已录入的政策条件做机械比对。免登录，作答不保存。</view>
      </view>
      <text class="ficon i-right pc-arrow"></text>
    </view>

    <scroll-view class="cat-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="cat {{activeCat === item.key ? 'on' : ''}} tap" wx:for="{{cats}}" wx:key="key"
        data-key="{{item.key}}" bindtap="tapCat" hover-class="tap-press">
        <view class="c-ic tone-{{item.accent}}"><text class="ficon i-{{item.icon}}"></text></view>
        <view class="c-l">{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="policy-section-head">
      <view class="ps-title">最新政策</view>
      <view class="ps-sub">以官方原文与经办窗口解释为准</view>
    </view>

    <view wx:if="{{loading}}" class="state-card">
      <view class="state-icon"><text class="ficon i-file-text"></text></view>
      <view class="state-title">正在加载政策</view>
      <view class="state-desc">请稍候，正在同步公开政策信息</view>
    </view>

    <view wx:elif="{{loadError}}" class="state-card">
      <view class="state-icon warn"><text class="ficon i-warning"></text></view>
      <view class="state-title">加载失败</view>
      <view class="state-desc">{{loadError}}</view>
      <view class="state-retry tap" hover-class="tap-press" bindtap="reload">重试</view>
    </view>

    <!-- 同招聘会：分「本机没接入」与「该分类下没有」两种。
         政策列表是服务端按 audience 过滤后回来的，客户端分不出「一条都没有」和
         「这个分类没有」—— 除非当前就在「全部政策」。所以用 activeCat 判：
         在「全部」下还是空，就是真的一条都没接入。 -->
    <view wx:elif="{{policies.length === 0 && activeCat === 'all'}}" class="state-card">
      <view class="state-icon"><text class="ficon i-file-text"></text></view>
      <view class="state-title">本机尚未接入政策来源</view>
      <view class="state-desc">政策信息来自官方来源，本机接入后会在这里显示。办理条件与时限请以官方原文及当地经办窗口为准。</view>
    </view>

    <view wx:elif="{{policies.length === 0}}" class="state-card">
      <view class="state-icon"><text class="ficon i-file-text"></text></view>
      <view class="state-title">该人群分类下暂无政策</view>
      <view class="state-desc">换个人群分类，或看全部政策</view>
      <view class="state-retry tap" hover-class="tap-press" bindtap="showAllPolicies">看全部政策</view>
    </view>

    <view wx:else class="policy-list">
      <view class="policy-item tap rise-d{{index + 1}}" wx:for="{{policies}}" wx:key="id"
        hover-class="tap-press" bindtap="tapPolicy" data-id="{{item.id}}">
        <view class="pi-icon tone-{{item.accent}}"><text class="ficon i-{{item.icon}}"></text></view>
        <view class="pi-body">
          <view class="pi-labels">
            <view wx:if="{{item.tag}}" class="chip {{item.tagTone}}">{{item.tag}}</view>
            <view wx:if="{{item.label}}" class="pi-kind">{{item.label}}</view>
          </view>
          <view class="pi-title">{{item.title}}</view>
          <view wx:if="{{item.summary}}" class="pi-sum">{{item.summary}}</view>
          <view class="pi-foot">
            <text>{{item.source ? '来源：' + item.source : '来源未标注'}}</text>
            <text wx:if="{{item.foot}}">{{item.foot}}</text>
          </view>
        </view>
        <text class="ficon i-right pi-arrow"></text>
      </view>
    </view>

    <view class="compliance-note">政策内容来自官方公开发布渠道，具体以官方原文及经办窗口解释为准。</view>
    <view class="spacer-lg"></view>
  </view>
</view>
