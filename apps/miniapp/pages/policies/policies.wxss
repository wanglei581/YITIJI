.page-wrap { min-height: 100vh; background: var(--paper); }
.policy-content { padding-top: 8rpx; }
.policy-hero { min-height: 214rpx; margin: 0 32rpx; padding: 30rpx; border-radius: 32rpx;
  border: 1rpx solid #dce9ff; background: #eef5ff; display: flex; align-items: center;
  justify-content: space-between; gap: 24rpx; }
.ph-copy { flex: 1; min-width: 0; }
.ph-kicker { font-size: 21rpx; font-weight: 650; color: var(--teal-deep); }
.ph-t { margin-top: 9rpx; font-size: 38rpx; font-weight: 780; color: var(--ink); line-height: 1.25; }
.ph-s { margin-top: 9rpx; max-width: 470rpx; font-size: 22rpx; color: var(--muted); line-height: 1.55; }
.ph-icon { width: 96rpx; height: 96rpx; border-radius: 30rpx; background: var(--teal);
  color: #fff; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(22,119,255,.18); }
.ph-icon .ficon { width: 47rpx; height: 47rpx; }

.cat-scroll { white-space: nowrap; padding: 26rpx 32rpx 4rpx; }
.cat { display: inline-flex; flex-direction: column; align-items: center; gap: 12rpx;
  width: 146rpx; padding: 10rpx 0 12rpx; margin-right: 6rpx; border-radius: 24rpx;
  vertical-align: top; border: 1rpx solid transparent; }
.cat.on { background: #fff; border-color: var(--line-soft); }
.c-ic { width: 78rpx; height: 78rpx; border-radius: 24rpx; display: flex; align-items: center;
  justify-content: center; }
.c-ic .ficon { width: 37rpx; height: 37rpx; }
.tone-teal { background: var(--teal-soft); color: var(--teal); }
.tone-slate { background: var(--slate-soft); color: var(--slate); }
.tone-wheat { background: var(--wheat-soft); color: var(--wheat-deep); }
.tone-plum { background: var(--plum-soft); color: var(--plum); }
.tone-clay { background: var(--clay-soft); color: var(--clay); }
.c-l { font-size: 22rpx; color: var(--muted); }
.cat.on .c-l { color: var(--ink); font-weight: 650; }

.policy-section-head { padding: 28rpx 32rpx 18rpx; }
.ps-title { font-size: 32rpx; font-weight: 760; color: var(--ink); }
.ps-sub { margin-top: 5rpx; font-size: 21rpx; color: var(--muted); }
.policy-list { display: flex; flex-direction: column; gap: 16rpx; }
.policy-item { min-height: 190rpx; margin: 0 32rpx; padding: 24rpx; border-radius: 28rpx;
  background: var(--surface); border: 1rpx solid var(--line-soft); display: flex;
  align-items: flex-start; gap: 19rpx; }
.pi-icon { width: 74rpx; height: 74rpx; border-radius: 23rpx; display: flex;
  align-items: center; justify-content: center; flex-shrink: 0; }
.pi-icon .ficon { width: 35rpx; height: 35rpx; }
.pi-body { flex: 1; min-width: 0; }
.pi-labels { min-height: 36rpx; display: flex; align-items: center; gap: 10rpx; }
.pi-kind { font-size: 20rpx; color: var(--muted); }
.pi-title { margin-top: 8rpx; font-size: 29rpx; font-weight: 700; color: var(--ink); line-height: 1.45; }
.pi-sum { margin-top: 9rpx; font-size: 23rpx; color: var(--muted); line-height: 1.55;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.pi-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  margin-top: 16rpx; padding-top: 15rpx; border-top: 1rpx solid var(--line-faint);
  font-size: 20rpx; color: var(--faint); }
.pi-arrow { width: 21rpx; height: 21rpx; color: var(--ghost); align-self: center; }

.state-card { margin: 0 32rpx; padding: 58rpx 40rpx; border-radius: 30rpx;
  background: var(--surface); border: 1rpx solid var(--line-soft); display: flex;
  flex-direction: column; align-items: center; text-align: center; }
.state-icon { width: 92rpx; height: 92rpx; border-radius: 28rpx; background: var(--teal-soft);
  color: var(--teal); display: flex; align-items: center; justify-content: center; }
.state-icon.warn { background: var(--warn-soft); color: var(--warn); }
.state-icon .ficon { width: 43rpx; height: 43rpx; }
.state-title { margin-top: 20rpx; font-size: 30rpx; font-weight: 720; color: var(--ink); }
.state-desc { margin-top: 8rpx; font-size: 23rpx; color: var(--muted); line-height: 1.6; }
