/* pages/ai/ai.wxss · 墨翠鎏金白瓷旗舰版 */
.page-wrap { min-height: 100vh; background: var(--paper); }

/* 小青旗舰入口卡：瓷釉墨翠渐变 + 鎏金细描边 + 顶部内高光 + 精裁肖像金环 */
.xq-card {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 6px 16px 12px;
  padding: 16px;
  border-radius: var(--r-lg);
  background: linear-gradient(155deg, #184E43 0%, #0E3129 58%, #081D18 100%);
  border: 1px solid rgba(212, 186, 135, .30);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .12), 0 10px 28px -8px rgba(8, 29, 24, .40);
}
.xq-card::after {
  content: "";
  position: absolute;
  right: -30px;
  top: -40px;
  width: 140px;
  height: 140px;
  border-radius: var(--r-full);
  background: radial-gradient(circle, rgba(223, 198, 147, .20) 0%, rgba(60, 224, 169, .06) 45%, rgba(8, 29, 24, 0) 70%);
  pointer-events: none;
}
.xq-face {
  width: 50px;
  height: 50px;
  border-radius: var(--r-full);
  flex-shrink: 0;
  border: 2px solid rgba(223, 198, 147, .75);
  box-shadow: 0 0 0 3px rgba(223, 198, 147, .16);
  background: var(--teal-soft);
  position: relative;
  z-index: 1;
}
.xq-body { flex: 1; min-width: 0; position: relative; z-index: 1; }
.xq-name { font-size: var(--fs-lg); font-weight: 700; color: #FFFFFF; letter-spacing: .5px; }
.xq-desc { font-size: var(--fs-sm); color: var(--mint); margin-top: 4px; opacity: .9; }
.xq-go {
  font-size: var(--fs-sm);
  font-weight: 700;
  color: #081E19;
  background: linear-gradient(135deg, #E5CE9E 0%, #BEA16C 100%);
  padding: 7px 15px;
  border-radius: var(--r-full);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 4px 12px rgba(0, 0, 0, .20);
}

/* AI 免责声明：安静高雅的信息条，收口至工具区之后 */
.as-disc {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: var(--fs-sm);
  color: var(--faint);
  background: var(--surface);
  border-radius: var(--r-md);
  box-shadow: var(--sh-xs);
  padding: 12px 14px;
  margin: 16px 16px 10px;
  line-height: 1.55;
}
.as-disc .ficon { color: var(--gold); font-size: var(--fs-base); margin-top: 2px; flex-shrink: 0; }
/* AI 服务说明与投诉：两颗等宽浮层胶囊按钮，守 48px 可点下限 */
.as-links { display: flex; gap: 10px; margin: 0 16px 14px; }
.as-link {
  flex: 1;
  min-width: 0;
  min-height: 48px;
  padding: 0 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  background: var(--surface);
  border-radius: var(--r-md);
  box-shadow: var(--sh-xs);
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--teal-deep);
}
.as-link .ficon { width: 10px; height: 10px; color: var(--ghost); flex-shrink: 0; }

/* AI 工具 Bento 磁贴：纯白无灰框浮层 + 彩色径向光晕圆形徽章 + 奇数组首卡全宽平衡 */
.tiles .tile {
  border-radius: var(--r-lg);
  border: none;
  background: var(--surface);
  box-shadow: var(--sh-xs);
  padding: 16px 15px 15px;
  gap: 10px;
}
.tiles .tile .t-copy { flex: 1; min-width: 0; }
.tiles .tile .t-title { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.tiles .tile .t-desc { font-size: var(--fs-sm); color: var(--muted); line-height: 1.45; margin-top: 3px; }
.tiles .tile .t-ic {
  width: 44px;
  height: 44px;
  border-radius: var(--r-full);
  border: none;
  flex-shrink: 0;
}
.tiles .tile .t-ic.a-teal  { background: radial-gradient(circle at 30% 25%, #EAF7F2 0%, #D3EDE3 100%); color: var(--teal-deep); }
.tiles .tile .t-ic.a-cyan  { background: radial-gradient(circle at 30% 25%, #E7F7F5 0%, #CDEEE9 100%); color: #0B5E54; }
.tiles .tile .t-ic.a-plum  { background: radial-gradient(circle at 30% 25%, #F3EFFD 0%, #E4DCF8 100%); color: var(--plum-deep); }
.tiles .tile .t-ic.a-wheat { background: radial-gradient(circle at 30% 25%, #FCF4E3 0%, #F4E3C2 100%); color: var(--gold-deep); }
.tiles .tile .t-ic.a-slate { background: radial-gradient(circle at 30% 25%, #EEF4FC 0%, #DAE6F7 100%); color: var(--slate-deep); }
.tiles .tile .t-ic.a-clay  { background: radial-gradient(circle at 30% 25%, #FCF1EA 0%, #F4DFD1 100%); color: var(--clay-deep); }

.tiles-balanced .tile:first-child:nth-last-child(3),
.tiles-balanced .tile:first-child:nth-last-child(1),
.tiles .tile.tile-wide {
  grid-column: 1 / -1;
  flex-direction: row;
  align-items: center;
  gap: 14px;
  padding: 16px;
}

/* AI 服务记录：告别廉价虚线框，升级为精致纯白浮层横卡 */
.ai-empty {
  margin: 0 16px;
  padding: 18px 18px;
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: var(--sh-xs);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14px;
  text-align: left;
}
.ai-empty .ae-ic {
  width: 44px;
  height: 44px;
  border-radius: var(--r-full);
  background: radial-gradient(circle at 30% 25%, #FCF4E3 0%, #F3E2C0 100%);
  color: var(--gold-deep);
  font-size: 20px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0;
}
.ae-copy { flex: 1; min-width: 0; }
.ae-text { font-size: var(--fs-md); font-weight: 700; color: var(--ink); letter-spacing: .2px; }
.ae-sub { font-size: var(--fs-sm); color: var(--muted); margin-top: 3px; line-height: 1.45; }

/* 修复分组头贴边 Bug：严格与 .tiles 左右 16px (=32rpx) 边缘对齐 + 翡翠鎏金竖条锚点 */
.grp-head { padding: 34rpx 32rpx 16rpx; }
.grp-head .section-t {
  padding: 0 0 0 16rpx;
  position: relative;
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--ink);
}
.grp-head .section-t::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 26rpx;
  border-radius: var(--r-full);
  background: linear-gradient(180deg, var(--teal) 0%, var(--gold) 100%);
}
.grp-sub { margin-top: 8rpx; padding-left: 16rpx; font-size: var(--fs-sm); color: var(--muted); }

/* 未开放能力：弱化但不哑掉 */
.tiles .tile.pending { background: var(--surface-2); border: 1px dashed var(--line); box-shadow: none; }
.tiles .tile.pending .t-ic { background: var(--slate-wash); color: var(--slate-deep); }
.tiles .tile.pending .t-title { color: var(--muted); }
.tiles .tile.pending .t-desc { color: var(--faint); }
.tiles .tile.pending .t-why {
  margin-top: 6px;
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: var(--fs-xs);
  line-height: 1.4;
  color: var(--slate-deep);
}
.tiles .tile.pending .t-why-ic { font-size: var(--fs-xs); flex-shrink: 0; }
.t-badge {
  margin-left: 6px;
  padding: 2px 8px;
  border-radius: var(--r-full);
  background: var(--slate-soft);
  color: var(--slate-deep);
  font-size: var(--fs-xs);
  font-weight: 600;
  vertical-align: middle;
}
