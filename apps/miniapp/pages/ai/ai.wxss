/* pages/ai/ai.wxss */
.page-wrap { min-height: 100vh; background: var(--paper); }

/* 小青入口卡：纸底 + 左侧墨青细栏，去渐变 */
.xq-card {
  display: flex; align-items: center; gap: 14px;
  margin: 4px 16px 12px;
  padding: 16px;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1px solid var(--line);
  border-left: 4px solid var(--teal);
  box-shadow: 0 1px 2px rgba(16,48,43,.05), 0 4px 12px rgba(16,48,43,.05);
}
.xq-body { flex: 1; min-width: 0; }
.xq-name { font-size: 17px; font-weight: 700; color: var(--ink); letter-spacing: .5px; }
.xq-desc { font-size: 12.5px; color: var(--muted); margin-top: 3px; }
.xq-go {
  font-size: 13px; font-weight: 600; color: var(--teal-deep);
  border: 1px solid rgba(35,84,230,.22);
  padding: 6px 13px; border-radius: var(--r-full);
  flex-shrink: 0;
}

/* AI 免责声明：安静的信息条，无发光、无 emoji 装饰 */
.as-disc {
  display: flex; align-items: flex-start; gap: 7px;
  font-size: 11px; color: var(--faint);
  background: var(--surface-2);
  border: 1px solid var(--line-soft);
  border-radius: var(--r-sm);
  padding: 9px 12px;
  margin: 0 16px 16px;
  line-height: 1.55;
}
.as-disc .ficon { color: var(--teal); font-size: 13px; margin-top: 1px; flex-shrink: 0; }

/* AI 工具磁贴：统一为紫调单色，去彩虹。整块「AI 区」共用一个身份色相，
   工具之间靠图形与文案分辨，而非五种色块——更克制、更像专业工具集。 */
.tiles .tile {
  border-radius: var(--r-md);
  border: 1px solid var(--line);
  box-shadow: 0 1px 2px rgba(16,48,43,.04);
}
.tiles .tile .t-ic {
  background: var(--teal-wash);
  color: var(--teal-deep);
  border: 1px solid rgba(35,84,230,.14);
}

/* 材料和打印不冒充 AI 能力，作为百宝箱内独立目录呈现。 */
.utility-title { padding-top: 24px; }
.service-list {
  margin: 0 16px;
  padding: 0 16px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
}
.service-row {
  min-height: 62px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid var(--line-soft);
}
.service-row:last-child { border-bottom: 0; }
.service-icon {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: var(--r-sm);
  color: var(--clay);
  background: var(--clay-wash);
}
.service-icon .ficon { width: 17px; height: 17px; }
.service-copy { flex: 1; min-width: 0; }
.service-name { color: var(--ink); font-size: 14px; font-weight: 600; }
.service-desc { margin-top: 3px; color: var(--muted); font-size: 11.5px; }
.service-arrow { flex-shrink: 0; color: var(--ghost); font-size: 18px; }


/* 今日早报卡片 */
.dr-card {
  display: flex; align-items: center; justify-content: space-between;
  margin: 4px 16px 12px;
  padding: 14px 16px;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1px solid var(--line);
  border-left: 4px solid var(--teal);
  box-shadow: 0 1px 2px rgba(16,48,43,.05), 0 4px 12px rgba(16,48,43,.05);
}
.dr-left { flex: 1; min-width: 0; }
.dr-badge {
  display: inline-block;
  font-size: 10px; font-weight: 700; letter-spacing: .5px;
  color: #fff; background: var(--teal);
  padding: 2px 7px; border-radius: var(--r-full);
  margin-bottom: 6px;
}
.dr-title { font-size: 14px; font-weight: 600; color: var(--ink); line-height: 1.45; }
.dr-hint  { font-size: 11.5px; color: var(--muted); margin-top: 4px; line-height: 1.4; }
.dr-meta  { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; flex-shrink: 0; margin-left: 12px; }
.dr-date  { font-size: 11px; color: var(--faint); }
.dr-go    { font-size: 20px; color: var(--teal); }

/* 职业圈 section header */
.section-hd { display: flex; align-items: center; justify-content: space-between; padding: 20px 16px 8px; }
.section-t.nm { padding: 0; }
.section-more { font-size: 12.5px; color: var(--teal); }

/* 职业圈动态预览列表 */
.feed-preview-list {
  margin: 0 16px 4px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  overflow: hidden;
}
.feed-item {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--line-soft);
}
.feed-item:last-child { border-bottom: 0; }
.fi-av {
  width: 32px; height: 32px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 700; color: #fff;
  flex-shrink: 0;
}
.fi-body  { flex: 1; min-width: 0; }
.fi-name  { font-size: 12.5px; font-weight: 600; color: var(--ink-soft); }
.fi-content { font-size: 13px; color: var(--ink); line-height: 1.5; margin-top: 2px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.fi-meta  { display: flex; gap: 10px; font-size: 11px; color: var(--faint); margin-top: 4px; }
.fi-likes { margin-left: auto; }

/* 职业圈空态 */
.community-empty {
  margin: 0 16px 4px;
  padding: 20px 16px;
  text-align: center;
  background: var(--surface);
  border: 1px dashed var(--line);
  border-radius: var(--r-md);
}
.ce-text { font-size: 13px; color: var(--muted); }

.ai-empty {
  margin: 0 16px;
  padding: 30px 20px;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1px dashed var(--line);
  display: flex; flex-direction: column; align-items: center; text-align: center;
}
.ai-empty .ae-ic { font-size: 26px; color: var(--ghost); margin-bottom: 10px; }
.ae-text { font-size: 14px; font-weight: 600; color: var(--ink-soft); letter-spacing: .3px; }
.ae-sub { font-size: 12px; color: var(--faint); margin-top: 5px; line-height: 1.5; }

/* 分组头：标题 + 一句处境说明。说明行是这次重组的关键——
   光有「准备材料」四个字，用户仍需逐个点开才知道里面是什么。 */
.grp-head { padding: 26rpx 4rpx 14rpx; }
.grp-head .section-t { padding: 0; }
.grp-sub { margin-top: 6rpx; font-size: 22rpx; color: var(--muted); }
