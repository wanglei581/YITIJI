<!--pages/ai/ai.wxml-->
<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="nav-title left serif">AI百宝箱</view>
  </view>

  <view class="content has-tabbar">

    <!-- 小青入口 -->
    <view class="xq-card sheen tap rise" hover-class="tap-press" bindtap="tapChat">
      <view class="avatar lg mono-plum serif">青</view>
      <view class="xq-body">
        <view class="xq-name serif">求职助手 · 小青</view>
        <view class="xq-desc">简历、打印、政策，随时问我</view>
      </view>
      <view class="xq-go">对话 →</view>
    </view>

    <!-- AI 免责声明（强制） -->
    <view class="as-disc">
      <view class="ficon i-info"></view>
      <text>小青与各项 AI 结果均由 AI 生成，可能存在错误。政策、补贴等信息请以官方渠道为准。</text>
    </view>

    <!-- 工具网格 -->
    <view class="section-t">AI 求职工具</view>
    <view class="tiles">
      <view
        class="tile sheen tap rise-d{{index+1}}"
        wx:for="{{tools}}"
        wx:key="id"
        hover-class="tap-press"
        bindtap="tapTool"
      >
        <view class="t-ic a-{{item.accent}}"><view class="ficon i-{{item.icon}}"></view></view>
        <view class="t-title">{{item.title}}</view>
        <view class="t-desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="section-t utility-title">材料与打印</view>
    <view class="service-list">
      <view
        class="service-row tap"
        wx:for="{{services}}"
        wx:key="id"
        hover-class="tap-press"
        bindtap="tapService"
        data-id="{{item.id}}"
      >
        <view class="service-icon"><view class="ficon i-{{item.icon}}"></view></view>
        <view class="service-copy">
          <view class="service-name">{{item.title}}</view>
          <view class="service-desc">{{item.desc}}</view>
        </view>
        <view class="service-arrow">›</view>
      </view>
    </view>

    <view class="section-t">AI 服务记录</view>
    <view class="ai-empty tap" hover-class="tap-press" bindtap="toRecords">
      <view class="ficon i-history ae-ic"></view>
      <view class="ae-text">查看本人 AI 服务记录</view>
      <view class="ae-sub">从服务端读取诊断、优化和规划记录</view>
    </view>

    <view class="compliance-note">
      AI 提供的诊断、优化、匹配度、职业建议均为参考，最终决策请结合自身情况与官方信息。
    </view>

  </view>
</view>
