/* 语音说简历。字号 var(--fs-*)，圆角 var(--r-*)。底栏两颗 .btn.lg 并排，窄屏走 app.wxss 的 374px 规则。 */

.page-wrap { min-height: 100vh; background: var(--paper); }

.content.has-bar { padding-bottom: calc(108px + var(--sab)); }

.cs-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 18rpx; }
.cs-ic { font-size: var(--fs-md); color: var(--teal); }
.cs-title { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
.cs-list { display: flex; flex-direction: column; gap: 18rpx; }
.cs-item { display: flex; align-items: flex-start; gap: 12rpx; }
.cs-dot { font-size: var(--fs-sm); color: var(--teal); margin-top: 6rpx; flex-shrink: 0; }
.cs-text { flex: 1; font-size: var(--fs-base); line-height: 1.65; color: var(--ink-soft); }

.cbox { display: flex; align-items: flex-start; gap: 20rpx; min-height: 96rpx; padding: 12rpx 0; }
.cb {
  width: 44rpx; height: 44rpx; margin-top: 6rpx; flex-shrink: 0;
  border: 2rpx solid var(--line);
  border-radius: var(--r-xs);
  background: var(--surface);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-sm); color: transparent;
}
.cb.on { background: var(--teal); border-color: var(--teal); color: #fff; }
.cb-body { flex: 1; min-width: 0; }
.cb-title { font-size: var(--fs-base); font-weight: 600; color: var(--ink); line-height: 1.5; }
.cb-desc { margin-top: 8rpx; font-size: var(--fs-sm); color: var(--muted); line-height: 1.6; }

.rv-prompt { font-size: var(--fs-md); font-weight: 600; color: var(--ink); line-height: 1.6; }
.rv-quote {
  margin-top: 16rpx; padding: 20rpx 24rpx;
  background: var(--surface-2);
  border-radius: var(--r-sm);
  font-size: var(--fs-lg); font-weight: 700; color: var(--teal-deep); line-height: 1.5;
}
.rv-fine { margin-top: 16rpx; font-size: var(--fs-sm); color: var(--faint); line-height: 1.6; }
.rv-label { font-size: var(--fs-sm); font-weight: 600; color: var(--muted); margin-bottom: 12rpx; }
.rv-echo {
  padding: 20rpx 24rpx;
  background: var(--surface-2);
  border: 1px solid var(--line-soft);
  border-radius: var(--r-sm);
  font-size: var(--fs-md); color: var(--ink); line-height: 1.7;
}
.rv-input {
  width: 100%; box-sizing: border-box;
  min-height: 96rpx; padding: 22rpx 24rpx;
  background: var(--surface-2);
  border: 1px solid var(--line-soft);
  border-radius: var(--r-sm);
  font-size: var(--fs-md); color: var(--ink); line-height: 1.6;
}
.rv-area { min-height: 168rpx; }
.rv-ph { color: var(--ghost); }
.rv-in { margin: 16rpx 0 0; }
.rv-textline {
  margin: 4rpx 16px 12px;
  min-height: 96rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-base); color: var(--teal-deep);
}
.rv-grow { flex: 1.6; }
