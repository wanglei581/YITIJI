.page-wrap { min-height: 100vh; background: var(--paper); }
.benefit-content { padding-top: 8rpx; }
.benefit-hero {
  min-height: 212rpx;
  margin: 0 32rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  border: 1rpx solid #dce9ff;
  background: #eaf2ff;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.bh-icon {
  width: 94rpx;
  height: 94rpx;
  border-radius: 29rpx;
  background: var(--teal);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(22, 119, 255, .18);
  flex-shrink: 0;
}
.bh-icon .ficon { width: 47rpx; height: 47rpx; }
.bh-copy { flex: 1; min-width: 0; }
.bh-badge { display: inline-flex; height: 40rpx; padding: 0 14rpx; align-items: center; border-radius: 999rpx; background: rgba(255,255,255,.78); color: var(--teal-deep); font-size: 19rpx; font-weight: 650; }
.bh-title { margin-top: 15rpx; font-size: 34rpx; line-height: 1.3; font-weight: 800; color: #17233e; }
.bh-sub { margin-top: 8rpx; font-size: 22rpx; line-height: 1.5; color: #66758d; }
.section-head { padding: 34rpx 36rpx 18rpx; }
.section-title { font-size: 31rpx; font-weight: 750; color: var(--ink); }
.section-sub { margin-top: 5rpx; font-size: 21rpx; color: var(--muted); }
.ben-grid { margin: 0 32rpx; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.ben-cell { min-height: 224rpx; padding: 24rpx; border-radius: 26rpx; background: var(--surface); border: 1rpx solid var(--line-soft); }
.ben-top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.ben-ic { width: 60rpx; height: 60rpx; border-radius: 19rpx; background: var(--teal-soft); color: var(--teal); display: flex; align-items: center; justify-content: center; }
.ben-ic .ficon { width: 29rpx; height: 29rpx; }
.ben-status { max-width: 130rpx; padding: 5rpx 12rpx; border-radius: 999rpx; background: var(--surface-2); color: var(--muted); font-size: 19rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ben-t { margin-top: 18rpx; font-size: 27rpx; font-weight: 700; color: var(--ink); line-height: 1.35; }
.ben-s { margin-top: 7rpx; font-size: 21rpx; line-height: 1.5; color: var(--muted); }
.ben-meta { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line-faint); display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.ben-qty { color: var(--teal); font-size: 24rpx; font-weight: 700; }
.ben-valid { color: var(--faint); font-size: 19rpx; text-align: right; }
.state-cell { grid-column: 1 / -1; min-height: 260rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.state-cell .ben-t { margin-top: 0; }
.ben-empty-icon { width: 86rpx; height: 86rpx; border-radius: 27rpx; margin-bottom: 18rpx; background: var(--surface-2); color: var(--faint); display: flex; align-items: center; justify-content: center; }
.ben-empty-icon .ficon { width: 42rpx; height: 42rpx; }
.vip-note { margin: 28rpx 40rpx 0; padding: 20rpx 22rpx; border-radius: 20rpx; background: var(--surface-2); color: var(--muted); font-size: 21rpx; line-height: 1.65; text-align: center; }
