.page-wrap { min-height: 100vh; background: var(--paper); }

/* 收藏态:图标染青色表示已收藏(ficon 无实心星,用颜色区分) */
.nav-right.faved .ficon { color: var(--teal-deep); }

.company-hero { padding: 48rpx 32rpx 40rpx; display: flex; flex-direction: column;
  align-items: center; background: var(--surface); margin-bottom: 16rpx; text-align: center; }
.ch-logo { width: 168rpx; height: 168rpx; border-radius: 40rpx; background: var(--teal-soft);
  display: flex; align-items: center; justify-content: center; font-size: 76rpx;
  margin-bottom: 26rpx; border: 4rpx solid var(--line-soft); }
.ch-name { font-family: var(--font-serif); font-size: 38rpx; font-weight: 700; color: var(--ink); }
.ch-meta { font-size: 25rpx; color: var(--muted); margin-top: 12rpx; display: flex;
  gap: 16rpx; justify-content: center; flex-wrap: wrap; }

.ch-chips { padding: 8rpx 32rpx 20rpx; }

.cd-block-t { font-size: 27rpx; font-weight: 600; color: var(--ink); margin-bottom: 20rpx; }
.cd-desc { font-size: 27rpx; color: var(--ink-soft); line-height: 1.75; margin-bottom: 18rpx; }
.cd-desc:last-child { margin-bottom: 0; }

.section-cap { font-size: 22rpx; font-weight: 600; color: var(--muted);
  letter-spacing: 1rpx; padding: 16rpx 32rpx 12rpx; }
.card-inner.tight { padding-top: 8rpx; padding-bottom: 12rpx; }

.src-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; font-size: 25rpx; }
.src-row + .src-row { border-top: 1rpx solid var(--line-faint); }
.sr-l { color: var(--muted); flex-shrink: 0; }
.sr-v { color: var(--ink-soft); font-weight: 500; text-align: right; max-width: 62%; }
.sr-v.faint { font-size: 22rpx; color: var(--faint); font-weight: 400; }

.compliance-note.tight { margin-top: -8rpx; }

.job-row { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 0; }
.job-row + .job-row { border-top: 1rpx solid var(--line-faint); }
.jr-left { flex: 1; min-width: 0; }
.jr-title { font-size: 29rpx; font-weight: 500; color: var(--ink); }
.jr-meta { font-size: 23rpx; color: var(--muted); margin-top: 6rpx; }
.jr-salary { font-family: var(--font-serif); font-size: 28rpx; font-weight: 700;
  color: var(--clay); white-space: nowrap; }
.jr-arrow { font-size: 32rpx; color: var(--ghost); }

/* 加载 / 错误态 */
.detail-state { padding: 120rpx 48rpx; text-align: center; color: var(--ink-soft);
  font-size: 28rpx; display: flex; flex-direction: column; align-items: center; gap: 28rpx; }
.detail-state .ds-msg { color: var(--muted); line-height: 1.6; }
.detail-state .ds-back { min-width: 220rpx; }
