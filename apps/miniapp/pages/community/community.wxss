/* pages/community/community.wxss */
.content { height: calc(100vh - 60px); }
.feed-list { padding-top: 8px; }
.feed-title {
  margin-top: 10px;
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--ink);
  line-height: 1.45;
}
.feed-sum {
  margin-top: 8px;
  font-size: var(--fs-base);
  color: var(--ink-soft);
  line-height: 1.6;
}
.feed-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 12px;
  font-size: var(--fs-sm);
  color: var(--muted);
}
.feed-action { margin-top: 16px; min-height: 96rpx; }
.state-card {
  margin: 24px 16px;
  padding: 48px 24px;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1px solid var(--line-soft);
  text-align: center;
}
.es-t { font-size: var(--fs-md); font-weight: 650; color: var(--ink-soft); }
.es-d { margin-top: 8px; font-size: var(--fs-sm); color: var(--muted); line-height: 1.6; }
.load-more-tip {
  text-align: center;
  font-size: var(--fs-sm);
  color: var(--faint);
  padding: 16px 0;
}
.page-pad { height: 40px; }
