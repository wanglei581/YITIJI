/* pages/community/community.wxss */
.page-wrap { min-height: 100vh; background: var(--paper); }

.navbar { display: flex; align-items: center; padding: 8px 16px 10px; }
.nav-back  { font-size: 22px; color: var(--ink); margin-right: 8px; }
.nav-title { flex: 1; font-size: 18px; font-weight: 700; color: var(--ink); }

.content { height: calc(100vh - 60px); }

/* 错误/空态 */
.comm-error, .comm-empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 60px 20px;
}
.ce-icon { font-size: 28px; color: var(--ghost); margin-bottom: 10px; }
.ce-msg  { font-size: 13px; color: var(--muted); text-align: center; }

/* 动态列表 */
.feed-list { padding: 8px 16px 0; display: flex; flex-direction: column; gap: 10px; }

.feed-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  padding: 14px;
  box-shadow: 0 1px 3px rgba(16,48,43,.04);
}

/* 头部：头像 + 名字 + 时间 */
.fc-head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.fc-av {
  width: 36px; height: 36px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 15px; font-weight: 700; color: #fff;
  flex-shrink: 0;
}
.fc-name { font-size: 13.5px; font-weight: 600; color: var(--ink); }
.fc-time { font-size: 11px; color: var(--faint); margin-top: 2px; }

/* 正文 */
.fc-content { font-size: 14px; color: var(--ink); line-height: 1.65; margin-bottom: 12px; }

/* 底部操作栏 */
.fc-foot { display: flex; align-items: center; gap: 16px; border-top: 1px solid var(--line-soft); padding-top: 10px; }
.fc-like, .fc-comments {
  display: flex; align-items: center; gap: 5px;
  font-size: 12.5px; color: var(--muted);
}
.lk-ic  { font-size: 16px; color: var(--muted); }
.lk-ic.liked { color: #e74c3c; }
.cm-ic  { font-size: 15px; }

/* 加载更多 */
.load-more-tip {
  text-align: center; font-size: 12px; color: var(--faint);
  padding: 16px 0;
}

.page-pad { height: 40px; }
