<!--pages/community/community.wxml-->
<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>
  <view class="navbar">
    <view class="nav-back tap" hover-class="tap-press" bindtap="goBack" role="button" aria-label="返回">
      <text class="nav-back-ic ficon i-right"></text>
    </view>
    <view class="nav-title">最新动态</view>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="content" scroll-y enable-back-to-top
    bindscrolltolower="loadMore" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullDownRefresh">

    <view wx:if="{{error}}" class="state-card">
      <view class="es-t">加载失败</view>
      <view class="es-d">{{error}}</view>
    </view>

    <view wx:elif="{{feeds.length === 0 && !loading}}" class="state-card">
      <view class="es-t">暂无动态</view>
      <view class="es-d">政策、权益与平台通知会显示在这里</view>
    </view>

    <view wx:else class="feed-list">
      <view class="card" wx:for="{{feeds}}" wx:key="id">
        <view class="card-inner">
          <view class="chip {{item.kindTone}}" wx:if="{{item.kindLabel}}">{{item.kindLabel}}</view>
          <view class="feed-title">{{item.title}}</view>
          <view class="feed-sum" wx:if="{{item.summary}}">{{item.summary}}</view>
          <view class="feed-meta">
            <text wx:if="{{item.sourceName}}">{{item.sourceName}}</text>
            <text wx:if="{{item.timeAgo}}">{{item.timeAgo}}</text>
          </view>
          <view
            wx:if="{{item.actionLabel && item.actionRoute}}"
            class="btn ghost block tap feed-action"
            hover-class="tap-press"
            bindtap="openRoute"
            data-route="{{item.actionRoute}}"
            role="button"
            aria-label="{{item.actionLabel}}"
          >{{item.actionLabel}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="load-more-tip">加载中…</view>
    <view wx:elif="{{noMore && feeds.length > 0}}" class="load-more-tip">已经到底了</view>
    <view class="page-pad"></view>
  </scroll-view>
</view>
