.page-wrap { min-height: 100vh; background: var(--paper); }

/* 收藏态:图标染青色表示已收藏(ficon 无实心星,用颜色区分) */
.nav-right.faved .ficon { color: var(--teal-deep); }

/* 岗位头部 */
.job-header { background: var(--surface); border-radius: 16rpx; padding: 32rpx; margin: 20rpx 0 0; }
.jh-title { font-size: 38rpx; font-weight: 700; color: var(--ink); line-height: 1.3; }
.jh-salary { font-size: 34rpx; font-weight: 700; color: var(--teal); margin-top: 10rpx; }
.jh-company { font-size: 26rpx; color: var(--muted); margin-top: 8rpx; }
.jh-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }

/* 来源信息卡 */
.info-card { background: var(--surface); border-radius: 14rpx; padding: 24rpx 28rpx; margin-top: 16rpx; }
.ic-title { font-size: 24rpx; font-weight: 600; color: var(--muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 16rpx; }
.ic-row { display: flex; align-items: flex-start; padding: 10rpx 0; border-bottom: 1rpx solid var(--line); }
.ic-row:last-of-type { border-bottom: none; }
.ic-k { font-size: 26rpx; color: var(--muted); width: 140rpx; flex-shrink: 0; }
.ic-v { font-size: 26rpx; color: var(--ink); flex: 1; }
.ic-v.mono { font-family: 'Courier New', monospace; font-size: 24rpx; color: var(--muted); }
.ic-note { font-size: 22rpx; color: var(--ghost); margin-top: 14rpx; line-height: 1.6; }

/* AI 匹配入口 */
.ai-entry { background: var(--surface); border-radius: 14rpx; padding: 24rpx 28rpx;
  display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx;
  border-left: 6rpx solid var(--teal); }
.ae-left { display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 0; }
.ae-ic { font-size: 36rpx; color: var(--teal); flex-shrink: 0; }
.ae-body { flex: 1; min-width: 0; }
.ae-title { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.ae-sub { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.ae-arr { font-size: 28rpx; color: var(--ghost); flex-shrink: 0; }

/* 职责/要求列表 */
.duty-list { padding: 0 4rpx; margin-bottom: 4rpx; }
.duty-item { display: flex; align-items: flex-start; gap: 14rpx; padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line); }
.duty-item:last-child { border-bottom: none; }
.duty-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--teal);
  flex-shrink: 0; margin-top: 14rpx; }
.duty-text { font-size: 28rpx; color: var(--ink); line-height: 1.7; flex: 1; }

/* actionbar flex 比例 */
.flex-1-6 { flex: 1.6; }

/* 加载 / 错误态 */
.detail-state { padding: 120rpx 48rpx; text-align: center; color: var(--ink-soft);
  font-size: 28rpx; display: flex; flex-direction: column; align-items: center; gap: 28rpx; }
.detail-state .ds-msg { color: var(--muted); line-height: 1.6; }
.detail-state .ds-back { min-width: 220rpx; }
