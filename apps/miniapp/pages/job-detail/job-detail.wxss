.page-wrap { min-height: 100vh; background: var(--paper); }
.detail-content { padding-top: 8rpx; }

/* 收藏态:图标染青色表示已收藏(ficon 无实心星,用颜色区分) */
.nav-right.faved .ficon { color: var(--teal-deep); }

/* 岗位头部 */
.job-header { background: var(--surface); border: 1rpx solid var(--line-soft); border-radius: 30rpx; padding: 30rpx; margin: 0 32rpx; }
.source-pill { display: inline-flex; align-items: center; height: 42rpx; padding: 0 16rpx; border-radius: 999rpx; background: var(--teal-soft); color: var(--teal-deep); font-size: 20rpx; font-weight: 650; margin-bottom: 18rpx; }
.jh-title { font-size: 38rpx; font-weight: 700; color: var(--ink); line-height: 1.3; }
.jh-salary { font-size: 34rpx; font-weight: 700; color: var(--teal); margin-top: 10rpx; }
.jh-company { font-size: 26rpx; color: var(--muted); margin-top: 8rpx; }
.jh-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }

/* 来源信息卡 */
.info-card { background: var(--surface); border: 1rpx solid var(--line-soft); border-radius: 26rpx; padding: 24rpx 28rpx; margin: 18rpx 32rpx 0; }
.ic-head { display: flex; align-items: center; gap: 16rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid var(--line-faint); }
.ic-head-icon { width: 58rpx; height: 58rpx; border-radius: 18rpx; background: var(--surface-2); color: var(--teal); display: flex; align-items: center; justify-content: center; }
.ic-head-icon .ficon { width: 28rpx; height: 28rpx; }
.ic-title { font-size: 27rpx; font-weight: 700; color: var(--ink); }
.ic-subtitle { margin-top: 3rpx; font-size: 21rpx; color: var(--muted); }
.ic-row { display: flex; align-items: flex-start; padding: 18rpx 0; border-bottom: 1rpx solid var(--line-faint); }
.ic-row:last-of-type { border-bottom: none; }
.ic-k { font-size: 26rpx; color: var(--muted); width: 140rpx; flex-shrink: 0; }
.ic-v { font-size: 26rpx; color: var(--ink); flex: 1; }
.ic-v.mono { font-family: 'Courier New', monospace; font-size: 24rpx; color: var(--muted); }
.ic-note { font-size: 22rpx; color: var(--muted); margin-top: 16rpx; line-height: 1.6; }

/* AI 匹配入口 */
.ai-entry { background: #f3f8ff; border-radius: 26rpx; padding: 24rpx 28rpx;
  display: flex; align-items: center; justify-content: space-between; margin: 18rpx 32rpx 0;
  border: 1rpx solid #dce9ff; }
.ae-left { display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 0; }
.ae-ic { font-size: 36rpx; color: var(--teal); flex-shrink: 0; }
.ae-body { flex: 1; min-width: 0; }
.ae-title { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.ae-sub { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.ae-arr { font-size: 28rpx; color: var(--ghost); flex-shrink: 0; }

/* 职责/要求列表 */
.section-card { margin: 0 32rpx; padding: 8rpx 26rpx; background: var(--surface); border: 1rpx solid var(--line-soft); border-radius: 26rpx; }
.duty-list { margin-bottom: 4rpx; }
.duty-item { display: flex; align-items: flex-start; gap: 14rpx; padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-faint); }
.duty-item:last-child { border-bottom: none; }
.duty-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--teal);
  flex-shrink: 0; margin-top: 14rpx; }
.duty-text { font-size: 28rpx; color: var(--ink); line-height: 1.7; flex: 1; }

/* actionbar flex 比例 */
.flex-1-6 { flex: 1.6; }

/* 加载 / 错误态 */
.detail-state { margin: 40rpx 32rpx; padding: 80rpx 48rpx; border-radius: 28rpx; background: var(--surface); border: 1rpx solid var(--line-soft); text-align: center; color: var(--ink-soft);
  font-size: 28rpx; display: flex; flex-direction: column; align-items: center; gap: 28rpx; }
.detail-state .state-icon { width: 92rpx; height: 92rpx; border-radius: 28rpx; background: var(--teal-soft); color: var(--teal); display: flex; align-items: center; justify-content: center; }
.detail-state .state-icon .ficon { width: 44rpx; height: 44rpx; }
.detail-state .ds-msg { color: var(--muted); line-height: 1.6; }
.detail-state .ds-back { min-width: 220rpx; }
/* 收藏入口由纯图标改为图标+文字：图标库无星形/心形，i-inbox 不具备可识别性。 */
.nav-right { display: flex; align-items: center; gap: 8rpx; min-height: 64rpx; padding: 0 18rpx; border-radius: 20rpx; }
.nav-right-t { font-size: 24rpx; font-weight: 650; color: var(--ink-soft); }
.nav-right.faved { background: var(--teal-wash); }
.nav-right.faved .nav-right-t, .nav-right.faved .ficon { color: var(--teal-deep); }
