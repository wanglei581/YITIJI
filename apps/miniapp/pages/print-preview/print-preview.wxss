/* pages/print-preview/print-preview.wxss  P09 打印预览 */
.preview-params { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; padding: 16rpx 20rpx;
  background: var(--surface); border: 2rpx solid var(--line); border-radius: var(--r-md); box-shadow: var(--sh-sm); }
.preview-params .pp-chip { font-size: 24rpx; font-weight: 600; color: var(--ink-soft); }
.preview-params .pp-dot { color: var(--faint); font-size: 22rpx; }
.preview-params .pp-amt { margin-left: auto; font-size: 28rpx; font-weight: 700; color: var(--teal-deep); }

.a4-paper { margin: 24rpx auto 0; width: 84%; aspect-ratio: 210 / 297; background: #fff;
  border: 2rpx solid var(--line); border-radius: 8rpx; box-shadow: var(--sh-md); padding: 44rpx 40rpx; box-sizing: border-box; }
.a4-paper .p-name { font-family: var(--font-serif); font-size: 32rpx; font-weight: 700; color: var(--ink); }
.a4-paper .p-tagline { font-size: 20rpx; color: var(--muted); margin-top: 8rpx; }
.a4-paper .p-divider { height: 2rpx; background: var(--line); margin: 20rpx 0; }
.a4-paper .p-section { font-size: 22rpx; font-weight: 600; color: var(--teal-deep); margin-bottom: 20rpx; }
.a4-paper .p-line { height: 14rpx; border-radius: 4rpx; background: var(--line-soft); margin-bottom: 18rpx; }
.a4-paper .p-line.full { width: 100%; }
.a4-paper .p-line.med { width: 72%; }
.a4-paper .p-line.short { width: 46%; }
.a4-paper .p-line.thin { width: 88%; height: 10rpx; background: var(--line-faint); }

.page-indicator { display: flex; align-items: center; justify-content: center; gap: 20rpx; margin-top: 28rpx; }
.page-indicator .pi-nav { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--surface);
  border: 2rpx solid var(--line); display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; color: var(--ink-soft); }
.page-indicator .pi-nav.off { color: var(--faint); opacity: .5; }
.page-indicator .pi-dots { display: flex; gap: 10rpx; }
.page-indicator .pi-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--line); }
.page-indicator .pi-dot.on { background: var(--teal); }
.page-indicator .pi-text { font-size: 24rpx; color: var(--muted); }

/* AI 版式诊断入口 */
.layout-check-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 32rpx 0;
  padding: 24rpx 28rpx;
  background: var(--surface);
  border: 2rpx solid var(--line-faint);
  border-radius: var(--r-md);
  box-shadow: var(--sh-xs);
}
.lce-ic {
  width: 72rpx; height: 72rpx;
  border-radius: 20rpx;
  background: var(--teal-wash);
  color: var(--teal-deep);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; flex-shrink: 0;
}
.lce-main { flex: 1; }
.lce-t {
  font-size: 28rpx; font-weight: 600; color: var(--ink);
  display: flex; align-items: center; gap: 8rpx;
}
.lce-badge {
  font-size: 18rpx; font-weight: 700; color: #fff;
  background: var(--teal); border-radius: var(--r-full);
  padding: 2rpx 12rpx;
}
.lce-s { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.lce-go { color: var(--teal); font-size: 32rpx; }
