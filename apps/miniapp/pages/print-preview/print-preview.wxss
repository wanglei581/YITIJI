/* pages/print-preview/print-preview.wxss  打印预览（墨翠鎏金白瓷） */
.page-wrap { min-height: 100vh; background: var(--paper); }
.content.has-bar { padding-bottom: calc(108px + var(--sab)); }

.file-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 8rpx 32rpx 0;
  padding: 26rpx 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-sm);
}
.fh-ic { width: 88rpx; height: 88rpx; border-radius: var(--r-full); flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.fh-ic .ficon { width: 42rpx; height: 42rpx; }
.fh-main { flex: 1; min-width: 0; }
.fh-name { font-size: var(--fs-md); font-weight: 700; color: var(--ink); word-break: break-all; }
.fh-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 10rpx; }
.fh-tag { flex-shrink: 0; font-size: var(--fs-xs); font-weight: 700; letter-spacing: .5rpx; color: var(--gold-deep); background: var(--gold-soft); border: 1rpx solid var(--gold-line); border-radius: var(--r-xs); padding: 4rpx 12rpx; }
.fh-sub { font-size: var(--fs-sm); color: var(--muted); }

.stage { margin: 24rpx 32rpx 0; }
.sheet {
  width: 100%;
  aspect-ratio: 210 / 297;
  min-height: 968rpx;
  background: #fff;
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-md);
  box-sizing: border-box;
  padding: 48rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.sheet.img { display: block; padding: 16rpx; overflow: hidden; }
.pv-img { width: 100%; height: 100%; border-radius: var(--r-xs); }

.sk-block { width: 46%; height: 88rpx; border-radius: var(--r-sm); background: var(--surface-3); }
.sk-line { height: 18rpx; border-radius: var(--r-xs); background: var(--line-faint); }
.sk-line.w80 { width: 80%; }
.sk-line.w55 { width: 55%; }
.stage-text { margin-top: 12rpx; font-size: var(--fs-sm); color: var(--muted); }

.sheet.doc .doc-ic { width: 128rpx; height: 128rpx; border-radius: var(--r-full); background: var(--teal-wash); color: var(--teal-deep); display: flex; align-items: center; justify-content: center; }
.sheet.doc .doc-ic .ficon { width: 60rpx; height: 60rpx; }
.doc-t { font-size: var(--fs-md); font-weight: 700; color: var(--ink); text-align: center; }
.doc-s { font-size: var(--fs-sm); line-height: 1.6; color: var(--muted); text-align: center; }
.doc-btn { margin-top: 14rpx; }

.sheet.err .err-ic { width: 112rpx; height: 112rpx; border-radius: var(--r-full); background: var(--error-soft); color: var(--error); display: flex; align-items: center; justify-content: center; }
.sheet.err .err-ic .ficon { width: 52rpx; height: 52rpx; }
.err-t { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.err-s { font-size: var(--fs-sm); line-height: 1.6; color: var(--muted); text-align: center; }
.err-btn { margin-top: 14rpx; }

.stage-hint { margin: 16rpx 32rpx 0; font-size: var(--fs-sm); color: var(--faint); text-align: center; }

.spec { padding: 6rpx 28rpx; }
.sp-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 92rpx; border-bottom: 1rpx solid var(--line-faint); }
.sp-row:last-child { border-bottom: none; }
.sp-k { font-size: var(--fs-base); color: var(--muted); flex-shrink: 0; }
.sp-v { font-size: var(--fs-base); font-weight: 650; color: var(--ink); text-align: right; }
.sp-v.pending, .sp-amt.pending { font-weight: 500; color: var(--faint); }
.sp-row.total { min-height: 104rpx; }
.sp-amt { font-size: var(--fs-lg); font-weight: 800; color: var(--teal-deep); font-variant-numeric: tabular-nums; }
