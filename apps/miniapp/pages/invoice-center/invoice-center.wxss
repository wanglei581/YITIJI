/* pages/invoice-center/invoice-center.wxss */
/* 字号与圆角全部采用 app.wxss 的 --fs-* / --r-* 令牌，不新增视觉刻度偏离。 */

.inv-content { padding: 16rpx 0 48rpx; }

.inv-intro {
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.inv-intro-ic {
  width: 76rpx;
  height: 76rpx;
  border-radius: var(--r);
  background: var(--wheat-soft);
  color: var(--wheat-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.inv-intro-ic .ficon { width: 36rpx; height: 36rpx; }
.inv-intro-copy { flex: 1; min-width: 0; }
.inv-intro-title { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.inv-intro-sub { margin-top: 6rpx; font-size: var(--fs-sm); color: var(--muted); line-height: 1.5; }

.inv-banner { padding: 20rpx 24rpx; }
.inv-banner.warn { background: var(--warn-soft); border-color: var(--wheat); }
.inv-banner-text { font-size: var(--fs-sm); color: var(--ink-soft); line-height: 1.5; }

.inv-form-card,
.inv-detail-card { padding: 24rpx; }

.inv-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.inv-panel-title { font-size: var(--fs-lg); font-weight: 700; color: var(--ink); }
.inv-panel-sub { margin-top: 6rpx; font-size: var(--fs-sm); color: var(--muted); word-break: break-all; }
.inv-close {
  min-width: 88rpx;
  min-height: 64rpx;
  padding: 0 16rpx;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  color: var(--muted);
  font-size: var(--fs-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.inv-field { margin-bottom: 20rpx; }
.inv-label { margin-bottom: 10rpx; font-size: var(--fs-sm); font-weight: 600; color: var(--ink-soft); }
.inv-seg { display: flex; gap: 16rpx; }
.inv-seg-item {
  flex: 1;
  min-height: 80rpx;
  border-radius: var(--r);
  border: 1rpx solid var(--line);
  background: var(--surface-2);
  color: var(--ink-soft);
  font-size: var(--fs-base);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.inv-seg-item.on {
  background: var(--teal-soft);
  border-color: var(--teal);
  color: var(--teal-deep);
}
.inv-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--r);
  border: 1rpx solid var(--line);
  background: var(--surface-2);
  font-size: var(--fs-base);
  color: var(--ink);
}
.inv-form-error {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r-sm);
  background: var(--error-soft);
  color: var(--error);
  font-size: var(--fs-sm);
  line-height: 1.5;
}
.inv-privacy {
  margin-bottom: 20rpx;
  font-size: var(--fs-sm);
  color: var(--muted);
  line-height: 1.55;
}
.inv-form-actions { display: flex; gap: 16rpx; }
.inv-act-btn { flex: 1; }

.inv-detail-rows { display: flex; flex-direction: column; gap: 14rpx; }
.inv-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.inv-k { font-size: var(--fs-sm); color: var(--muted); flex-shrink: 0; }
.inv-v { font-size: var(--fs-base); color: var(--ink); text-align: right; word-break: break-all; }
.inv-amt { font-weight: 700; color: var(--ink); }

.inv-return-box {
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r-sm);
  background: var(--error-soft);
}
.inv-return-t { font-size: var(--fs-sm); font-weight: 700; color: var(--error); }
.inv-return-d { margin-top: 6rpx; font-size: var(--fs-sm); color: var(--ink-soft); line-height: 1.5; }
.inv-detail-foot { margin-top: 24rpx; }

.inv-order-card {
  margin: 0 32rpx 20rpx;
  padding: 24rpx;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
}
.inv-oc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.inv-oc-kind { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.inv-oc-meta { display: flex; flex-direction: column; gap: 10rpx; }
.inv-block-note {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  color: var(--muted);
  font-size: var(--fs-sm);
  line-height: 1.5;
}
.inv-oc-foot {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-faint);
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
.inv-btn {
  min-height: 76rpx;
  padding: 0 28rpx;
  border-radius: var(--r);
  font-size: var(--fs-base);
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.inv-btn.ghost { background: var(--surface-2); color: var(--ink-soft); border: 1rpx solid var(--line); }
.inv-btn.pri { background: var(--teal); color: #fff; }

.inv-load-more { margin: 8rpx 32rpx 16rpx; width: auto; }
.inv-foot-warn {
  margin: 12rpx 32rpx;
  text-align: center;
  font-size: var(--fs-sm);
  color: var(--error);
}
.inv-foot-retry { margin-left: 16rpx; color: var(--link); font-weight: 600; }
.inv-foot-note {
  margin: 24rpx 32rpx 0;
  font-size: var(--fs-sm);
  color: var(--muted);
  line-height: 1.6;
  text-align: center;
}
