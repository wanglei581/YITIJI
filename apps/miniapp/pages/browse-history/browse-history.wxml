<!--pages/browse-history/browse-history.wxml-->
<view class="page-wrap">

  <view class="navbar col">
    <view style="height:{{statusBarHeight}}px"></view>
    <view class="nav-inner">
      <view class="nav-back tap" hover-class="tap-press" bindtap="back">
        <text class="ficon i-right nav-back-ic"></text>
      </view>
      <view class="nav-title">浏览与跳转记录</view>
    </view>
  </view>

  <view class="content">

    <view class="filter-bar">
      <view
        class="f-chip {{activeFilter === item.key ? 'on' : ''}}"
        wx:for="{{filters}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="setFilter"
      >{{item.label}}</view>
    </view>

    <!-- 「管理」原本在导航栏右上角，被微信胶囊（···⊙）完全遮挡——胶囊是系统浮层，
         自定义导航栏右侧永远不可用。删除记录是低频次级操作，移到列表上方的工具栏。 -->
    <view class="list-toolbar" wx:if="{{groups.length && state !== 'loading' && state !== 'error'}}">
      <text class="lt-label">{{managing ? '点条目右侧「删除」移除记录' : '记录仅本人可见'}}</text>
      <view class="lt-action {{managing ? 'on' : ''}} tap" hover-class="tap-press" bindtap="toggleManage"
            role="button" aria-label="{{managing ? '退出管理模式' : '进入管理模式，删除浏览记录'}}">
        {{managing ? '完成' : '管理'}}
      </view>
    </view>

    <view class="hs-bar" wx:if="{{!loggedIn && state !== 'loading'}}">
      <view class="hs-bar-body">
        <view class="hs-bar-t">记录当前只存在这台手机上</view>
        <view class="hs-bar-d">登录后浏览与跳转记录保存到账号，一体机上也能回看同一份。</view>
      </view>
      <view class="btn ghost sm" bindtap="goLogin">去登录</view>
    </view>

    <view class="card" wx:if="{{state === 'loading'}}">
      <view class="empty-slot compact">
        <view class="es-t">正在加载记录…</view>
      </view>
    </view>

    <!-- 失败态与空态严格分开：加载不出来不得显示成"暂无浏览记录" -->
    <view class="card" wx:elif="{{state === 'error'}}">
      <view class="empty-slot compact">
        <view class="es-t">加载失败</view>
        <view class="es-d">{{loadError}}</view>
        <view class="es-actions">
          <view class="btn ghost sm" bindtap="retryLoad">重新加载</view>
          <view class="btn ghost sm" wx:if="{{hasLocal}}" bindtap="showLocalCache">查看本机缓存</view>
          <view class="btn ghost sm" wx:if="{{!loggedIn}}" bindtap="goLogin">去登录</view>
        </view>
      </view>
    </view>

    <block wx:elif="{{groups.length}}">
      <view class="card" wx:for="{{groups}}" wx:key="day" wx:for-item="g">
        <view class="hs-day">{{g.day}}</view>
        <view
          class="hs-item tap"
          wx:for="{{g.items}}"
          wx:key="rid"
          wx:for-item="hs"
          hover-class="tap-press"
          data-id="{{hs.id}}"
          data-type="{{hs.type}}"
          bindtap="openItem"
        >
          <view class="hs-ic tone-{{hs.tone}}"><text class="ficon {{hs.icon}}"></text></view>
          <view class="hs-body">
            <view class="hs-t">{{hs.title}}</view>
            <view class="hs-sub">
              <text class="act-tag {{hs.act === 'jump' ? 'at-jump' : 'at-view'}}">{{hs.actLabel}}</text>
              <text class="hs-src">来源:{{hs.source}}</text>
            </view>
          </view>
          <view wx:if="{{managing}}" class="hs-del tap" hover-class="tap-press" catchtap="removeItem" data-rid="{{hs.rid}}">删除</view>
          <view wx:else class="hs-time">{{hs.time}}</view>
        </view>
      </view>
    </block>

    <view class="card" wx:else>
      <view class="empty-slot">
        <text class="ficon i-history es-ic"></text>
        <view class="es-t">暂无浏览记录</view>
        <view class="es-d">浏览岗位、招聘会、企业与政策后可在此回看</view>
      </view>
    </view>

    <view class="hs-note" wx:if="{{note && state === 'ready'}}">{{note}}</view>

    <view class="hs-clear" wx:if="{{managing && hasLocal}}">
      <view class="btn ghost sm" bindtap="clearLocal">清空本机记录</view>
    </view>

    <view class="compliance-note">
      仅记录你的浏览与打开来源平台 / 官方入口的行为,不记录任何投递或预约结果。相关操作均在来源平台完成。
    </view>

  </view>

</view>
