<!--pages/resume-diagnose/resume-diagnose.wxml-->
<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>
  <view class="navbar">
    <view class="nav-back tap" bindtap="goBack"><text class="ficon i-right nav-back-ic"></text></view>
    <view class="nav-center nav-title">AI 诊断报告</view>
  </view>

  <!-- 读取中 -->
  <view wx:if="{{status === 'loading'}}" class="running-state">
    <view class="rs-anim">
      <view class="rs-ring"></view>
      <text class="ficon i-file-text rs-ic"></text>
    </view>
    <view class="rs-title">正在获取诊断报告…</view>
    <view class="rs-sub">AI 分析结果由服务端生成,请稍候</view>
    <view class="rs-disclaimer">分析结果仅供参考,不构成招聘意见</view>
  </view>

  <!-- 无可展示任务:不伪造历史报告,给真实入口 -->
  <view wx:elif="{{status === 'empty'}}" class="running-state">
    <view class="st-ic"><text class="ficon i-file-text"></text></view>
    <view class="rs-title">还没有诊断报告</view>
    <view class="rs-sub">上传或拍摄一份简历,AI 解析完成后会在这里生成报告</view>
    <view wx:if="{{hasSavedTask}}" class="saved-tip tap" bindtap="viewSaved">
      <text>查看上一次的诊断{{savedFileName ? '(' + savedFileName + ')' : ''}}</text>
      <text class="ficon i-right saved-tip-arrow"></text>
    </view>
  </view>

  <!-- 明确失败:把原因说清楚,不停在转圈也不给半份结论 -->
  <view wx:elif="{{status === 'failed'}}" class="running-state">
    <view class="st-ic warn"><text class="ficon i-info"></text></view>
    <view class="rs-title">未能获取诊断报告</view>
    <view class="rs-sub">{{failMsg}}</view>
  </view>

  <view wx:if="{{status !== 'done'}}" class="state-export-disabled">
    <view class="state-export-reason">诊断失败或尚未完成，暂时不能导出。完成诊断后可生成真实 PDF。</view>
    <view class="report-export-actions">
      <button class="btn ghost" disabled="{{true}}" aria-disabled="{{true}}">导出诊断报告 PDF</button>
      <button class="btn ghost" disabled="{{true}}" aria-disabled="{{true}}">导出修改清单</button>
    </view>
  </view>

  <!-- 真实诊断结果 -->
  <view wx:else class="content has-bar">

    <!-- 占位 provider 必须明示,否则用户会把演示结论当成真实分析 -->
    <view wx:if="{{report.isMockProvider}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <text>当前服务端使用占位分析模型,以下内容仅用于流程演示,不能作为简历评估结论。</text>
    </view>

    <!-- 文本抽取质量:截断 / OCR 必须在报告最上方出现 -->
    <view wx:if="{{report.truncatedInput}}" class="notice err">
      <text class="ficon i-info n-ic"></text>
      <text>本次输入超过分析上限，AI 没有看完整份简历。后半部分可能未进入诊断，请不要把缺失内容理解成简历里没有。</text>
    </view>
    <view wx:if="{{report.noticeNeedsReview}}" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <text>简历文字识别置信度{{report.noticeConfidenceLabel}}，部分内容可能未被正确读取，建议先核对原文再参考下面的评分。</text>
    </view>
    <view wx:for="{{report.noticeWarnings}}" wx:for-item="w" wx:key="*this" class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <text>{{w}}</text>
    </view>

    <view wx:if="{{report.targetContext && !report.targetContext.skipped}}" class="direction-strip">
      <text class="direction-label">本次方向</text>
      <text>{{report.targetContext.targetJob || report.targetContext.industry || report.targetContext.major || '已指定方向'}}</text>
    </view>

    <!-- 首屏先给可执行结论，不让分数压过真实问题 -->
    <view wx:if="{{report.firstFixes.length}}" class="section-t first-title">先改这些</view>
    <view wx:if="{{report.firstFixes.length}}" class="first-fixes">
      <view class="first-fix" wx:for="{{report.firstFixes}}" wx:key="focus">
        <view class="first-index">{{index + 1}}</view>
        <view class="first-body">
          <view class="first-focus">{{item.focus}}</view>
          <view wx:if="{{item.reason}}" class="first-reason">{{item.reason}}</view>
        </view>
      </view>
    </view>

    <!-- 无带原文证据的问题时不展示总分，避免把覆盖不足包装成完整判断 -->
    <view wx:if="{{report.showScore}}" class="diag-summary">
      <view class="ds-score">
        <view class="ds-num">{{report.scorePct}}</view>
        <view class="ds-label">综合评分</view>
      </view>
      <view class="ds-counts">
        <view class="ds-c"><view class="ds-n high">{{report.priorities.length}}</view><view class="ds-k">优先改进</view></view>
        <view class="ds-c"><view class="ds-n mid">{{report.suggestions.length}}</view><view class="ds-k">改进建议</view></view>
        <view class="ds-c"><view class="ds-n low">{{report.riskNotes.length}}</view><view class="ds-k">风险提示</view></view>
      </view>
    </view>
    <view wx:if="{{report.showScore}}" class="score-note">综合评分 = 各维度得分合计 {{report.scoreSum}} / {{report.scoreMax}} 折算百分制。这不是录取分，也不是排名或通过率。</view>
    <view wx:else class="notice warn">
      <text class="ficon i-info n-ic"></text>
      <text>本次报告没有返回可核对的原文证据，因此不展示总分。你仍可查看各维建议，并以原件为准。</text>
    </view>

    <view class="section-t">六维怎么看</view>
    <view class="card dim-card">
      <view class="dim-row" wx:for="{{report.sections}}" wx:key="key">
        <view class="dim-head">
          <view class="dim-label">{{item.label}}</view>
          <view class="dim-score">{{item.score}}<text class="dim-max">/{{item.maxScore}}</text></view>
        </view>
        <view class="meter"><i class="{{item.tone}}" style="width:{{item.pct}}%"></i></view>
        <view class="dim-insight">{{item.insight}}</view>
      </view>
    </view>

    <!-- 主体问题清单：维度 / 机械严重度 / 原文引用 / 影响 / 改法 -->
    <view wx:if="{{report.issues.length}}" class="section-t">问题与原文证据</view>
    <view wx:if="{{report.issues.length}}" class="evidence-list">
      <view class="evidence-card" wx:for="{{report.issues}}" wx:key="id">
        <view class="evidence-head">
          <view class="evidence-title">{{item.title}}</view>
          <view class="severity {{item.severityKey}}">{{item.severityLabel}}</view>
        </view>
        <view class="evidence-dim">诊断维度：{{item.dimLabel}}</view>
        <view class="quote" wx:for="{{item.evidence}}" wx:for-item="ev" wx:key="quote">“{{ev.quote}}”</view>
        <view wx:if="{{item.impact}}" class="evidence-row"><text class="evidence-key">影响</text><text>{{item.impact}}</text></view>
        <view wx:if="{{item.fixIt}}" class="evidence-row fix"><text class="evidence-key">改法</text><text>{{item.fixIt}}</text></view>
      </view>
    </view>
    <view wx:if="{{report.issues.length}}" class="tier-rule">严重度按对应维度得分机械分档：不足一半为高，一半到八成为中，八成及以上为低。它不是录取判断。</view>

    <view wx:if="{{report.contentBlocks.length}}" class="section-t">AI 实际看到的内容片段</view>
    <view wx:if="{{report.contentBlocks.length}}" class="content-blocks">
      <view class="content-block" wx:for="{{report.contentBlocks}}" wx:key="key">
        <view class="content-block-title">{{item.label}}</view>
        <view class="content-line" wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this">{{line}}</view>
      </view>
    </view>

    <!-- 风险提示 -->
    <view wx:if="{{report.riskNotes.length}}" class="section-t">风险提示</view>
    <view wx:if="{{report.riskNotes.length}}" class="issue-list">
      <view
        class="issue-item tap"
        wx:for="{{report.riskNotes}}"
        wx:for-item="rk"
        wx:key="*this"
        bindtap="tapText"
        data-title="风险提示"
        data-text="{{rk}}"
      >
        <view class="ii-left"><view class="sev-dot mid"></view></view>
        <view class="ii-body"><view class="ii-tip">{{rk}}</view></view>
        <text class="ficon i-right ii-arr"></text>
      </view>
    </view>

    <!-- 改进建议 -->
    <view wx:if="{{report.suggestions.length}}" class="section-t">改进建议</view>
    <view wx:if="{{report.suggestions.length}}" class="issue-list">
      <view
        class="issue-item tap"
        wx:for="{{report.suggestions}}"
        wx:for-item="sg"
        wx:key="*this"
        bindtap="tapText"
        data-title="改进建议"
        data-text="{{sg}}"
      >
        <view class="ii-left"><view class="sev-dot low"></view></view>
        <view class="ii-body"><view class="ii-tip">{{sg}}</view></view>
        <text class="ficon i-right ii-arr"></text>
      </view>
    </view>

    <view class="export-panel">
      <view class="export-panel-title">带走这份结果</view>
      <view class="pricing-line {{pricing.mode}}">
        <text class="ficon i-info pricing-icon"></text>
        <text>{{pricing.text}}</text>
      </view>
      <view wx:if="{{exportDisabledReason}}" class="export-disabled-reason">{{exportDisabledReason}}</view>
      <view class="report-export-actions">
        <button
          class="btn ghost"
          bindtap="exportReport"
          data-kind="diagnosis_report"
          loading="{{exportingKind === 'diagnosis_report'}}"
          disabled="{{exportDisabled || !!exportingKind}}"
          aria-disabled="{{exportDisabled || !!exportingKind}}"
        >导出诊断报告 PDF</button>
        <button
          class="btn ghost"
          bindtap="exportReport"
          data-kind="change_list"
          loading="{{exportingKind === 'change_list'}}"
          disabled="{{exportDisabled || !!exportingKind}}"
          aria-disabled="{{exportDisabled || !!exportingKind}}"
        >导出修改清单</button>
      </view>

      <view wx:if="{{exportResult}}" class="export-result">
        <view class="export-result-title">{{exportResult.filename}}</view>
        <view class="export-meta">{{exportResult.kindLabel}} · {{exportResult.pageLabel}} · {{exportResult.sizeLabel}}</view>
        <view class="export-meta">有效至 {{exportResult.expiresLabel}} · {{exportCountdown}}</view>
        <view wx:if="{{exportResult.savedToDocuments}}" class="export-save-state saved">已存入我的文档</view>
        <view wx:else class="export-save-state temporary">本次仅可打开，登录后可存我的文档</view>
        <view wx:if="{{exportExpired}}" class="export-expired">打开链接已过期，请重新导出。</view>
        <view wx:else class="export-result-actions">
          <button class="btn ghost" bindtap="openExportPdf" loading="{{openingPdf}}" disabled="{{openingPdf}}" aria-disabled="{{openingPdf}}">打开真实 PDF</button>
          <button class="btn primary" bindtap="printExportPdf">去打印</button>
        </view>
      </view>
    </view>

    <view class="notice info">
      <text class="ficon i-info n-ic"></text>
      <text>诊断结果由 AI 生成，仅供本人修改简历参考。请逐项核对原文，不代表用人单位意见。</text>
    </view>

  </view>

  <!-- 操作栏 -->
  <view wx:if="{{status === 'done'}}" class="actionbar">
    <view class="btn primary block tap" bindtap="tapOptimize">去 AI 优化</view>
  </view>
  <view wx:elif="{{status === 'empty'}}" class="actionbar">
    <view class="btn primary block tap" bindtap="toUpload">上传简历开始诊断</view>
  </view>
  <view wx:elif="{{status === 'failed'}}" class="actionbar">
    <view class="fail-actions">
      <view class="btn ghost tap" bindtap="printOriginal">打印原件</view>
      <view class="btn ghost tap" bindtap="goPrint">去打印</view>
      <view class="btn ghost tap" bindtap="viewJobs">查看岗位</view>
      <view class="btn primary tap" bindtap="retryDiagnosis">重试诊断</view>
    </view>
  </view>
</view>
