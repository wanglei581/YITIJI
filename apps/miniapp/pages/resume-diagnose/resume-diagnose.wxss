.page-wrap { min-height: 100vh; background: var(--paper); }

/* 诊断中动画 */
.running-state { display: flex; flex-direction: column; align-items: center;
  padding: 100rpx 32rpx 0; gap: 20rpx; }
.rs-anim { position: relative; width: 120rpx; height: 120rpx; margin-bottom: 16rpx; }
.rs-ring { position: absolute; inset: 0; border-radius: 50%;
  border: 4rpx solid transparent; border-top-color: var(--teal);
  animation: spin 1s linear infinite; }
.rs-ic { position: absolute; inset: 0; display: flex; align-items: center;
  justify-content: center; font-size: 48rpx; color: var(--teal); }
@keyframes spin { to { transform: rotate(360deg); } }
.rs-title { font-size: var(--fs-lg); font-weight: 700; color: var(--ink); }
.rs-sub { font-size: var(--fs-base); color: var(--muted); text-align: center; }
.rs-disclaimer { font-size: var(--fs-sm); color: var(--ghost); text-align: center;
  margin-top: 8rpx; line-height: 1.6; }

/* 空态 / 失败态图标 */
.st-ic { width: 128rpx; height: 128rpx; border-radius: 50%; background: var(--surface-2);
  color: var(--muted); display: flex; align-items: center; justify-content: center;
  font-size: 52rpx; margin-bottom: 8rpx; }
.st-ic.warn { background: var(--warn-soft); color: var(--warn); }
.state-export-disabled { margin: 28rpx 32rpx calc(170rpx + var(--sab)); padding: 22rpx;
  border: 1rpx solid var(--line-soft); border-radius: var(--r-md); background: var(--surface); }
.state-export-reason { color: var(--muted); font-size: var(--fs-sm); line-height: 1.6; }
.saved-tip { margin-top: 12rpx; min-height: 88rpx; padding: 0 28rpx; border-radius: var(--r-md);
  background: var(--teal-soft); font-size: var(--fs-base); color: var(--teal-deep);
  display: flex; align-items: center; gap: 10rpx; }
.saved-tip-arrow { width: 18rpx; height: 18rpx; }

/* 概览卡 */
.diag-summary { background: var(--surface); border: 1rpx solid #dce9ff;
  border-radius: var(--r-md); padding: 32rpx 28rpx; display: flex; align-items: center;
  gap: 32rpx; margin: 16rpx 32rpx 0; box-shadow: var(--sh-xs); }
.ds-score { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.ds-num { font-size: 60rpx; font-weight: 820; color: var(--teal); line-height: 1; }
.ds-label { font-size: var(--fs-sm); color: var(--muted); margin-top: 6rpx; }
.ds-counts { display: flex; gap: 24rpx; flex: 1; justify-content: center; }
.ds-c { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.ds-n { font-size: var(--fs-xl); font-weight: 700; }
.ds-n.high { color: var(--error); }
.ds-n.mid { color: var(--wheat); }
.ds-n.low { color: var(--slate); }
.ds-k { font-size: var(--fs-sm); color: var(--muted); }

/* 综合分口径说明:必须紧跟概览卡,让用户看到这个分数是怎么来的 */
.score-note { font-size: var(--fs-sm); color: var(--muted); text-align: center;
  margin: 10rpx 0 4rpx; line-height: 1.5; }
.first-title { margin-top: 24rpx; }
.first-fixes { margin: 0 32rpx; display: flex; flex-direction: column; gap: 12rpx; }
.first-fix { display: flex; gap: 18rpx; padding: 22rpx; background: var(--surface);
  border: 1rpx solid var(--line-soft); border-radius: var(--r-sm); }
.first-index { width: 44rpx; height: 44rpx; border-radius: var(--r-xs); background: var(--teal);
  color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  font-size: var(--fs-sm); font-weight: 750; }
.first-body { min-width: 0; flex: 1; }
.first-focus { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.first-reason { margin-top: 7rpx; font-size: var(--fs-sm); color: var(--muted); line-height: 1.55; }
.direction-strip { margin: 14rpx 32rpx 0; padding: 16rpx 20rpx; border-radius: var(--r-sm);
  background: var(--teal-soft); color: var(--teal-deep); font-size: var(--fs-sm); }
.direction-label { margin-right: 14rpx; font-weight: 700; }

/* 维度得分 */
.dim-card { padding: 8rpx 28rpx 20rpx; }
.dim-row { padding: 20rpx 0; }
.dim-row + .dim-row { border-top: 2rpx solid var(--line-faint); }
.dim-head { display: flex; align-items: baseline; justify-content: space-between;
  margin-bottom: 12rpx; }
.dim-label { font-size: var(--fs-md); color: var(--ink); font-weight: 500; }
.dim-score { font-family: var(--font-serif); font-size: var(--fs-md); font-weight: 700;
  color: var(--ink); }
.dim-max { font-size: var(--fs-sm); font-weight: 400; color: var(--ghost); }
.dim-insight { margin-top: 10rpx; font-size: var(--fs-sm); line-height: 1.55; color: var(--muted); }

.evidence-list { margin: 0 32rpx; display: flex; flex-direction: column; gap: 16rpx; }
.evidence-card { padding: 24rpx; background: var(--surface); border: 1rpx solid var(--line-soft);
  border-radius: var(--r-sm); }
.evidence-head { display: flex; align-items: flex-start; gap: 16rpx; }
.evidence-title { flex: 1; min-width: 0; font-size: var(--fs-md); font-weight: 720; color: var(--ink); }
.severity { padding: 7rpx 12rpx; border-radius: var(--r-xs); font-size: var(--fs-xs); font-weight: 700;
  white-space: nowrap; border: 1rpx solid transparent; }
.severity.high { color: var(--error); background: var(--error-soft); border-color: #ffd5d5; }
.severity.mid { color: var(--wheat-deep); background: var(--warn-soft); border-color: #f5d99b; }
.severity.low { color: var(--slate); background: var(--surface-2); border-color: var(--line); }
.evidence-dim { margin-top: 9rpx; font-size: var(--fs-sm); color: var(--muted); }
.quote { margin-top: 14rpx; padding: 16rpx 18rpx; border-left: 5rpx solid var(--teal);
  background: var(--paper); color: var(--ink-soft); font-size: var(--fs-base); line-height: 1.6; }
.evidence-row { margin-top: 15rpx; display: flex; align-items: flex-start; gap: 14rpx;
  font-size: var(--fs-base); color: var(--ink-soft); line-height: 1.55; }
.evidence-row.fix { color: var(--teal-deep); }
.evidence-key { width: 56rpx; flex-shrink: 0; font-weight: 750; }
.tier-rule { margin: 14rpx 32rpx 0; color: var(--muted); font-size: var(--fs-sm); line-height: 1.55; }
.content-blocks { margin: 0 32rpx; display: flex; flex-direction: column; gap: 14rpx; }
.content-block { padding: 22rpx; background: var(--surface); border: 1rpx solid var(--line-soft); border-radius: var(--r-sm); }
.content-block-title { font-size: var(--fs-base); font-weight: 700; color: var(--ink); }
.content-line { margin-top: 10rpx; font-size: var(--fs-sm); color: var(--muted); line-height: 1.55; }
.fail-actions { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.fail-actions .btn { min-width: 0; }

.export-panel { margin: 30rpx 32rpx 0; padding: 24rpx; border: 1rpx solid var(--line-soft);
  border-radius: var(--r-md); background: var(--surface); }
.export-panel-title { font-size: var(--fs-md); font-weight: 750; color: var(--ink); }
.pricing-line { margin-top: 14rpx; padding: 14rpx 16rpx; border-radius: var(--r-xs);
  display: flex; align-items: flex-start; gap: 10rpx; font-size: var(--fs-sm); line-height: 1.55; }
.pricing-line.free { color: var(--teal-deep); background: var(--teal-soft); }
.pricing-line.charged { color: var(--wheat-deep); background: var(--warn-soft); }
.pricing-line.unavailable { color: var(--error); background: var(--error-soft); }
.pricing-icon { margin-top: 3rpx; flex-shrink: 0; }
.export-disabled-reason { margin-top: 12rpx; color: var(--error); font-size: var(--fs-sm); line-height: 1.55; }
.report-export-actions { margin-top: 16rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.report-export-actions .btn { min-width: 0; min-height: 96rpx; padding: 10rpx; font-size: var(--fs-sm); line-height: 1.35; }
.export-result { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.export-result-title { font-size: var(--fs-md); font-weight: 720; color: var(--ink); word-break: break-all; }
.export-meta { margin-top: 8rpx; color: var(--muted); font-size: var(--fs-sm); line-height: 1.5; }
.export-save-state { margin-top: 14rpx; padding: 14rpx; border-radius: var(--r-xs); font-size: var(--fs-sm); line-height: 1.55; }
.export-save-state.saved { color: var(--teal-deep); background: var(--teal-soft); }
.export-save-state.temporary { color: var(--muted); background: var(--surface-2); }
.export-expired { margin-top: 14rpx; color: var(--error); font-size: var(--fs-sm); }
.export-result-actions { margin-top: 16rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.export-result-actions .btn { min-width: 0; min-height: 96rpx; font-size: var(--fs-base); }

/* 问题列表 */
.issue-list { margin: 0 32rpx; background: var(--surface); border: 1rpx solid var(--line-soft);
  border-radius: var(--r-md); overflow: hidden; }
.issue-item { display: flex; align-items: flex-start; gap: 16rpx; padding: 24rpx;
  border-bottom: 1rpx solid var(--line); }
.issue-item:last-child { border-bottom: none; }
.ii-left { padding-top: 8rpx; }
.sev-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.sev-dot.high { background: var(--error); }
.sev-dot.mid { background: var(--wheat); }
.sev-dot.low { background: var(--ghost); }
.ii-body { flex: 1; }
.ii-title { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
.ii-tip { font-size: var(--fs-base); color: var(--ink); margin-top: 8rpx; line-height: 1.6; }
.ii-arr { width: 20rpx; height: 20rpx; color: var(--ghost); flex-shrink: 0; margin-top: 9rpx; }

/* flex */
.flex-1-5 { flex: 1.5; }
