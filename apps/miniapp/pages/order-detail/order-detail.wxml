<!--pages/order-detail/order-detail.wxml-->
<view class="page-wrap">

  <view class="navbar col">
    <view style="height:{{statusBarHeight}}px"></view>
    <view class="nav-inner">
      <view class="nav-back tap" hover-class="tap-press" bindtap="back" aria-role="button" aria-label="返回">
        <text class="ficon i-right nav-back-ic"></text>
      </view>
      <view class="nav-title">订单详情</view>
      <view class="nav-right"></view>
    </view>
  </view>

  <view class="content">

    <view class="card" wx:if="{{loading}}">
      <view class="empty-slot">
        <view class="es-t">正在加载订单详情…</view>
      </view>
    </view>

    <!-- 标题跟着 error 的成因走：换了账号 / 登录失效时再写「加载失败，点此重试」
         会把一次身份清场说成网络问题，用户只会反复去点那一下。 -->
    <view class="card" wx:elif="{{error}}" bindtap="retry">
      <view class="empty-slot">
        <view class="es-t">{{errorTitle}}</view>
        <view class="es-d">{{error}}</view>
      </view>
    </view>

    <block wx:else>
      <view class="card" wx:if="{{refreshNotice}}" bindtap="refreshDetail">
        <view class="empty-slot"><view class="es-d">{{refreshNotice}}</view></view>
      </view>
      <view class="card od-card">
        <view class="od-filename">{{detail.fileName}}</view>
        <view class="od-status-row">
          <view class="chip {{detail.statusTone}}">{{detail.statusLabel}}</view>
        </view>
        <view class="od-rows">
          <view class="od-row">
            <text class="od-label">终端</text>
            <text class="od-val">{{detail.store}}</text>
          </view>
          <view class="od-row">
            <text class="od-label">规格</text>
            <text class="od-val">{{detail.spec}}</text>
          </view>
          <view class="od-row">
            <text class="od-label">{{detail.paid ? '金额' : '本次打印'}}</text>
            <text class="od-val">{{detail.price}}</text>
          </view>
          <view class="od-row">
            <text class="od-label">下单时间</text>
            <text class="od-val">{{detail.createdAt}}</text>
          </view>
        </view>
      </view>

      <view class="card od-pickup-card" wx:if="{{detail.pickup}}">
        <view class="od-pickup">
          <view class="od-pickup-label">到机码</view>
          <view class="od-pickup-code">{{detail.pickup}}</view>
          <view class="od-pickup-hint">到一体机前扫码或手动输入到机码</view>
        </view>
      </view>

      <view class="od-actions">
        <button
          wx:if="{{detail.canCancel}}"
          class="btn ghost-ink block tap {{cancelling ? 'disabled' : ''}}"
          hover-class="tap-press"
          bindtap="cancelOrder"
          disabled="{{cancelling}}"
        >{{cancelling ? '正在取消…' : '取消订单'}}</button>
        <!-- toPrint 去「我的文档」重新选文件，不是按原单原样再打一份，文字照实写。
             有到机码时它降为次按钮：这一单要做的是到机取件，不是重新选文件。 -->
        <button class="btn {{detail.pickup ? 'ghost-ink' : 'primary'}} block tap" hover-class="tap-press" bindtap="toPrint">去我的文档打印</button>
        <!-- 待到机（或允许同码续打）时的主操作：去取件页看二维码、复制或分享到机码。
             只带 orderId，和订单列表同一个口径；取件页自己带登录态查订单真值，码不进 URL。 -->
        <button wx:if="{{detail.pickup}}" class="btn primary block tap" hover-class="tap-press" bindtap="toPickup">查看到机码</button>
      </view>
    </block>

  </view>
</view>
