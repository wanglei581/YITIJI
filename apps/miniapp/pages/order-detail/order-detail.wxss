/* pages/order-detail/order-detail.wxss  订单详情（墨翠鎏金白瓷） */
.od-card { padding: 28rpx; }

.od-filename { font-size: var(--fs-lg); font-weight: 750; color: var(--ink); margin-bottom: 16rpx; }
.od-status-row { margin-bottom: 20rpx; }

.od-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line-faint);
  font-size: var(--fs-base);
}
.od-row:last-child { border-bottom: none; }

.od-label { color: var(--muted); }
.od-val { color: var(--ink); font-weight: 650; }

.od-pickup-card { padding: 0; }
.od-pickup { text-align: center; padding: 32rpx 0; }
.od-pickup-label { font-size: var(--fs-sm); font-weight: 700; color: var(--gold-deep); margin-bottom: 12rpx; }
.od-pickup-code {
  font-size: var(--fs-2xl);
  font-weight: 850;
  letter-spacing: 8rpx;
  color: var(--teal-deep);
  font-family: var(--font-mono, monospace);
}
.od-pickup-hint { margin-top: 12rpx; font-size: var(--fs-sm); color: var(--muted); }

.od-actions { padding: 24rpx 0 8rpx; display: flex; flex-direction: column; gap: 16rpx; }
.od-actions .btn { min-height: 48px; }
.od-actions .btn.primary { min-height: 56px; height: 56px; }
