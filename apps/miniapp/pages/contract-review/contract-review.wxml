<view class="cr-page">
  <!-- app.json 全局 navigationStyle:"custom"，每页必须自画状态栏占位与导航栏。
       此前遗漏导致页面内容被状态栏压住（真机验证发现）。 -->
  <view style="height:{{statusBarHeight}}px"></view>
  <view class="cr-nav">
    <view class="cr-back tap" hover-class="tap-press" bindtap="back" role="button" aria-label="返回">
      <text class="ficon i-right"></text>
    </view>
    <view class="cr-nav-title">合同审查</view>
    <view class="cr-back-ph"></view>
  </view>
  <scroll-view class="cr-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="cr-body">

      <block wx:if="{{step === 'pick'}}">
        <view class="cr-lead">上传或拍下合同，AI 逐条指出需要留意的条款。结果仅供参考，不构成法律意见。</view>
        <view class="cr-sec">这是什么材料</view>
        <view class="type-grid">
          <view class="type-item {{contractType === item.value ? 'on' : ''}} tap" wx:for="{{types}}" wx:key="value"
                hover-class="tap-press" bindtap="pickType" data-value="{{item.value}}" role="button" aria-label="{{item.label}}">
            {{item.label}}
          </view>
        </view>
        <view class="cr-cta tap" hover-class="tap-press" bindtap="pickFile" role="button" aria-label="选择合同：拍照、从相册选择，或从微信聊天中选择文件">选择合同</view>
        <view class="cr-note">可以拍照、从相册选，也可以从微信聊天里选已有文件（{{formatHint}}，15MB 以内）。拍照时整页拍清楚，避免反光与遮挡；字太小时分多次拍。合同已有电子版时，直接选原文件比拍照识别更准。</view>
      </block>

      <block wx:elif="{{step === 'consent'}}">
        <view class="cr-sec">开始前请确认</view>
        <view class="scope-card">
          <view class="scope-row" wx:for="{{scopeRows}}" wx:key="k">
            <text class="scope-k">{{item.k}}</text><text class="scope-v">{{item.v}}</text>
          </view>
          <view class="scope-ver">告知版本 {{consentVersion}} · 免责声明 {{disclaimerVersion}}</view>
        </view>

        <view class="sens-card" wx:if="{{sensitiveRequired || sensitiveNecessity}}">
          <view class="sens-t">敏感个人信息</view>
          <view class="sens-d" wx:if="{{sensitiveNecessity}}">合同通常含姓名、证件号、薪酬等敏感个人信息。处理它只是为了本次条款提示，识别与分析完成后按上面的保留时长删除；不上传不影响你使用其他功能。必要性与影响的完整说明见下方免责声明全文。</view>
          <view class="ck-row tap" wx:if="{{sensitiveRequired}}" hover-class="tap-press" bindtap="toggleSensitive"
                role="checkbox" aria-label="单独同意处理合同中的敏感个人信息">
            <view class="ck {{sensitiveAgreed ? 'on' : ''}}"></view>
            <text class="ck-t">我单独同意处理合同中的敏感个人信息</text>
          </view>
        </view>

        <view class="disc-card" wx:if="{{disclaimerText}}">
          <view class="disc-t">免责声明全文（版本 {{disclaimerVersion}}）</view>
          <scroll-view class="disc-body" scroll-y><text class="disc-x">{{disclaimerText}}</text></scroll-view>
        </view>

        <view class="cr-cta tap {{sensitiveRequired && !sensitiveAgreed ? 'off' : ''}}" hover-class="tap-press"
              bindtap="agree" role="button" aria-label="我已阅读并同意，开始分析">我已阅读并同意，开始分析</view>
        <view class="cr-sub tap" hover-class="tap-press" bindtap="discard" role="button" aria-label="取消">取消</view>
      </block>

      <block wx:elif="{{step === 'confirm'}}">
        <view class="cr-sec">确认分析范围</view>
        <view class="scope-card">
          <view class="scope-row"><text class="scope-k">识别页数</text><text class="scope-v">共 {{pages.total}} 页</text></view>
          <view class="scope-row"><text class="scope-k">本次分析</text><text class="scope-v">前 {{pages.analyzed}} 页</text></view>
        </view>
        <view class="cr-warn" wx:if="{{pages.truncated}}">超出部分不会被分析，也不会出现在结果里。</view>
        <view class="cr-warn" wx:if="{{pages.lowOcr}}">文字识别清晰度较低，可能有遗漏。建议重拍更清晰的照片，或改用合同的原始电子文件后重新上传。</view>

        <view class="ck-row tap" hover-class="tap-press" bindtap="toggleOk" data-k="coverage"
              role="checkbox" aria-label="确认识别页数与要审查的合同一致">
          <view class="ck {{okCoverage ? 'on' : ''}}"></view>
          <text class="ck-t">我已核对：上面的页数与我要审查的合同一致，并知道未分析的部分不会被提示</text>
        </view>
        <view class="ck-row tap" hover-class="tap-press" bindtap="toggleOk" data-k="personal"
              role="checkbox" aria-label="确认是本人相关合同且仅供个人参考">
          <view class="ck {{okPersonal ? 'on' : ''}}"></view>
          <text class="ck-t">这份合同与我本人有关，分析结果仅供我个人参考</text>
        </view>

        <view class="cr-cta tap {{okCoverage && okPersonal ? '' : 'off'}}" hover-class="tap-press"
              bindtap="submitConfirm" role="button" aria-label="继续分析">继续分析</view>
        <view class="cr-sub tap" hover-class="tap-press" bindtap="discard" role="button" aria-label="取消并删除已上传的合同">取消并删除已上传的合同</view>
      </block>

      <block wx:elif="{{step === 'running'}}">
        <view class="cr-run">
          <!-- 进度按服务端真实状态推进，不做匀速假动画：没有真实进度数据时
               编一个自己会走的条，等于伪造能力（§9）。每一格点亮都对应
               服务端一次真实状态变化。 -->
          <view class="pg-bar">
            <view class="pg-fill" style="width:{{stageIdx < 0 ? 0 : (stageIdx + 1) * 20}}%"></view>
          </view>
          <view class="pg-step">第 {{stageIdx < 0 ? 1 : stageIdx + 1}} 步 / 共 5 步</view>

          <view class="pg-list">
            <view class="pg-item {{index < stageIdx ? 'done' : (index === stageIdx ? 'cur' : '')}}"
                  wx:for="{{stages}}" wx:key="key">
              <view class="pg-dot"><text wx:if="{{index < stageIdx}}" class="ficon i-check"></text></view>
              <view class="pg-copy">
                <view class="pg-label">{{item.label}}</view>
                <view class="pg-note" wx:if="{{index === stageIdx}}">{{item.note}}</view>
              </view>
            </view>
          </view>

          <view class="cr-note">已等待 {{waitedSec}} 秒{{etaSec ? '，预计约 ' + etaSec + ' 秒' : ''}}。AI 分析这一步最慢，请不要退出。</view>
        </view>
      </block>

      <block wx:elif="{{step === 'report'}}">
        <view class="cr-sec">审查结果</view>
        <view class="sum-card">
          <view class="sum-row">
            <text class="sum-x lv-p1">重点核对 {{report.priorityCheckCount}}</text>
            <text class="sum-x lv-p2">留意 {{report.attentionCount}}</text>
            <text class="sum-x lv-p3">信息不足 {{report.insufficientInfoCount}}</text>
          </view>
          <view class="sum-n" wx:if="{{report.truncated}}">仅分析了前 {{report.analyzed}} 页（共 {{report.total}} 页），未分析部分不在结果内。</view>
          <view class="sum-n" wx:if="{{report.lowOcr}}">本次文字识别清晰度较低，可能有漏读，建议对照原件复核。</view>
        </view>

        <view class="risk-item" wx:for="{{report.findings}}" wx:key="id">
          <view class="risk-h">
            <text class="risk-lv lv-{{item._cls}}">{{item._label}}</text>
            <text class="risk-t">{{item.title}}</text>
          </view>
          <view class="risk-d">{{item.explanation}}</view>
          <view class="risk-q" wx:if="{{item.evidence.excerpt}}">原文<text wx:if="{{item.evidence.pageNumber}}">（第 {{item.evidence.pageNumber}} 页）</text>：{{item.evidence.excerpt}}</view>
          <view class="risk-ask" wx:if="{{item.verificationQuestion}}">可以这样问对方：{{item.verificationQuestion}}</view>
          <view class="risk-un" wx:if="{{item.uncertainty}}">不确定之处：{{item.uncertainty}}</view>
          <view class="risk-un" wx:if="{{item.basisRef}}">依据：{{item.basisRef}}</view>
        </view>
        <view class="cr-empty" wx:if="{{!report.findings.length}}">本次未识别到需要特别提示的条款。这不代表合同没有问题，仅代表规则与模型未命中。</view>
        <view class="cr-note">结果由 AI 生成，可能存在错误或遗漏，不构成法律意见。涉及争议请咨询劳动监察或法律援助。免责声明版本 {{report.disclaimerVersion}}。</view>
        <view class="cr-sub tap" hover-class="tap-press" bindtap="discard" role="button" aria-label="删除本次记录">删除本次记录</view>
      </block>

      <view class="cr-err" wx:if="{{error}}">{{error}}</view>
      <view class="tab-spacer"></view>
    </view>
  </scroll-view>
</view>
