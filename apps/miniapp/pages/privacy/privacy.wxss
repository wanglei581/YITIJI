/* pages/privacy/privacy.wxss  隐私与数据权利（墨翠鎏金白瓷） */
.grp-label {
  margin: 30rpx 40rpx 14rpx;
  font-size: var(--fs-sm);
  font-weight: 650;
  color: var(--muted);
  letter-spacing: .5rpx;
}
.grp-label:first-of-type { margin-top: 8rpx; }

.pv-group {
  margin: 0 32rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-sm);
  overflow: hidden;
}
.pv-item {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--line-faint);
}
.pv-item:last-child { border-bottom: none; }

.pv-main { flex: 1; }
.pv-t { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
.pv-t.danger { color: var(--clay-deep); }
.pv-s { margin-top: 6rpx; font-size: var(--fs-sm); color: var(--muted); }
.pv-v { font-size: var(--fs-base); color: var(--muted); margin-left: 12rpx; }
.pv-go { margin-left: 12rpx; width: 22rpx; height: 22rpx; color: var(--faint); }
.pv-go.danger { color: var(--clay); }

/* ── 数据导出卡 ─────────────────────────────────────────────── */
.dr-card {
  margin: 0 32rpx;
  padding: 28rpx 26rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-sm);
}
.dr-head { display: flex; align-items: flex-start; }
.dr-ic { width: 40rpx; height: 40rpx; margin-right: 18rpx; color: var(--teal-deep); }
.dr-hmain { flex: 1; }
.dr-t { font-size: var(--fs-lg); font-weight: 700; color: var(--ink); }
.dr-s { margin-top: 6rpx; font-size: var(--fs-sm); color: var(--muted); line-height: 1.5; }

.dr-state {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  background: var(--paper);
  border: 1rpx solid var(--line-faint);
  border-radius: var(--r-md);
}
.dr-row { display: flex; align-items: flex-start; justify-content: space-between; padding: 6rpx 0; }
.dr-k { flex-shrink: 0; font-size: var(--fs-sm); color: var(--faint); }
.dr-v { margin-left: 20rpx; font-size: var(--fs-sm); color: var(--ink-soft); text-align: right; word-break: break-all; }
.dr-v.warn { color: var(--clay-deep); }

.dr-acts { margin-top: 24rpx; }
.dr-tip { margin-top: 14rpx; font-size: var(--fs-sm); color: var(--faint); line-height: 1.5; text-align: center; }

/* ── 本机导出件 ─────────────────────────────────────────────── */
.ef-item { padding: 24rpx; border-bottom: 1rpx solid var(--line-faint); }
.ef-item:last-child { border-bottom: none; }
.ef-name { font-size: var(--fs-base); font-weight: 600; color: var(--ink); word-break: break-all; }
.ef-meta { margin-top: 6rpx; font-size: var(--fs-sm); color: var(--faint); }
.ef-acts { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.ef-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--line);
  background: var(--surface);
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--ink);
}
.ef-btn.danger { color: var(--clay-deep); border-color: var(--clay-soft); }

/* ── 记录与状态 ─────────────────────────────────────────────── */
.state-box {
  margin: 0 32rpx;
  padding: 40rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-sm);
  font-size: var(--fs-base);
  color: var(--muted);
  text-align: center;
}
.state-msg { margin-bottom: 20rpx; line-height: 1.6; }
.state-box .ef-btn { display: inline-flex; }

.rq-item { padding: 22rpx 24rpx; border-bottom: 1rpx solid var(--line-faint); }
.rq-item:last-child { border-bottom: none; }
.rq-line { display: flex; align-items: center; justify-content: space-between; }
.rq-t { font-size: var(--fs-base); font-weight: 600; color: var(--ink); }
.rq-st { flex-shrink: 0; margin-left: 20rpx; font-size: var(--fs-sm); color: var(--teal-deep); font-weight: 650; }
.rq-sub { margin-top: 6rpx; font-size: var(--fs-sm); color: var(--faint); }
.rq-sub.warn { color: var(--clay-deep); }

/* ── 二次验证浮层 ───────────────────────────────────────────── */
.su-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 90; background: rgba(11, 33, 28, .48); }
.su-panel { background: var(--surface); border-bottom-left-radius: var(--r-xl); border-bottom-right-radius: var(--r-xl); box-shadow: var(--sh-lg); }
.su-bar { position: relative; display: flex; align-items: center; justify-content: center; height: 92rpx; }
.su-title { font-size: var(--fs-lg); font-weight: 750; color: var(--ink); }
.su-close { position: absolute; right: 12rpx; top: 0; display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; }
.su-close-ic { width: 28rpx; height: 28rpx; color: var(--faint); }

.su-body { padding: 8rpx 40rpx 44rpx; }
.su-desc { font-size: var(--fs-base); color: var(--muted); line-height: 1.6; }
.su-phone { margin-top: 16rpx; font-size: var(--fs-base); color: var(--ink-soft); }

.su-input {
  margin-top: 28rpx;
  height: 112rpx;
  padding: 0 28rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  font-size: var(--fs-xl);
  letter-spacing: 8rpx;
  color: var(--ink);
}

.su-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.su-resend { display: inline-flex; align-items: center; min-height: 96rpx; padding-right: 20rpx; font-size: var(--fs-base); font-weight: 600; color: var(--teal-deep); }
.su-resend.off { color: var(--ghost); }
.su-expire { font-size: var(--fs-sm); color: var(--faint); }
.su-expire.warn { color: var(--clay-deep); }

.su-error { margin-bottom: 20rpx; padding: 16rpx 20rpx; background: var(--error-soft); border-radius: var(--r-sm); font-size: var(--fs-sm); color: var(--error); line-height: 1.55; }
.su-foot { margin-top: 20rpx; font-size: var(--fs-sm); color: var(--faint); line-height: 1.5; text-align: center; }

.pv-act {
  margin-left: 12rpx;
  min-width: 96rpx;
  min-height: 96rpx;
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  font-size: var(--fs-base);
  font-weight: 650;
  color: var(--teal-deep);
  flex-shrink: 0;
}

.pr-card {
  margin: 0 32rpx;
  padding: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-sm);
}
.pr-line { display: flex; align-items: flex-start; gap: 16rpx; padding: 8rpx 0; }
.pr-k { width: 112rpx; flex-shrink: 0; font-size: var(--fs-sm); font-weight: 650; color: var(--muted); line-height: 1.7; }
.pr-v { flex: 1; min-width: 0; font-size: var(--fs-base); color: var(--ink-soft); line-height: 1.7; }
.pr-acts { display: flex; gap: 16rpx; margin-top: 16rpx; }
.pr-btn {
  flex: 1;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
  border: 1rpx solid var(--line);
  background: var(--surface-2);
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--ink-soft);
}
.pv-link { color: var(--teal-deep); font-weight: 600; }
