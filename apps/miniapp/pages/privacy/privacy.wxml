<view class="page-wrap">
  <view class="navbar col">
    <view style="height:{{statusBarHeight}}px"></view>
    <view class="nav-inner">
      <view class="nav-back tap" hover-class="tap-press" bindtap="back">
        <text class="ficon i-right nav-back-ic"></text>
      </view>
      <view class="nav-title">隐私与数据</view>
      <view class="nav-right"></view>
    </view>
  </view>

  <view class="content">
    <view class="grp-label">隐私规则</view>
    <view class="pv-group">
      <view class="pv-item tap" hover-class="tap-press" bindtap="toPolicy">
        <view class="pv-main">
          <view class="pv-t">隐私政策</view>
          <view class="pv-s">查看当前生效版本、处理目的与保存期限</view>
        </view>
        <text class="ficon i-right pv-go"></text>
      </view>
      <view class="pv-item tap" hover-class="tap-press" bindtap="openPrivacyGuide" role="button" aria-label="小程序用户隐私保护指引">
        <view class="pv-main">
          <view class="pv-t">小程序用户隐私保护指引</view>
          <view class="pv-s">微信里登记的那一份，与首次使用时弹出的一致</view>
        </view>
        <text class="ficon i-right pv-go"></text>
      </view>
      <view class="pv-item tap" hover-class="tap-press" bindtap="toDocuments">
        <view class="pv-main">
          <view class="pv-t">我的文档与到期时间</view>
          <view class="pv-s">查看服务端返回的真实文件期限并可主动删除</view>
        </view>
        <text class="ficon i-right pv-go"></text>
      </view>
    </view>

    <!-- C6：两项声明。登录着显示账号里的记录，没登录显示本机的。 -->
    <view class="grp-label">{{consentGroupLabel}}</view>
    <view class="pv-group">
      <view wx:if="{{consents.error}}" class="pv-item">
        <view class="pv-main"><view class="pv-s">{{consents.error}}</view></view>
      </view>
      <block wx:elif="{{consents.loaded}}">
        <view class="pv-item">
          <view class="pv-main">
            <view class="pv-t">年满 14 周岁声明</view>
            <view class="pv-s">{{consents.age.text}}</view>
          </view>
        </view>
        <view wx:if="{{aiEnabled}}" class="pv-item tap" hover-class="tap-press" bindtap="tapVoiceConsent" role="button" aria-label="录音单独同意，{{consents.voice.text}}">
          <view class="pv-main">
            <view class="pv-t">录音单独同意</view>
            <view class="pv-s">{{consents.voice.text}}</view>
          </view>
          <text class="pv-act">{{consents.voice.on ? '撤回' : '查看'}}</text>
        </view>
        <view wx:if="{{aiEnabled && consents.resume}}" class="pv-item tap" hover-class="tap-press" bindtap="tapResumeConsent" role="button" aria-label="简历 AI 授权，{{consents.resume.text}}">
          <view class="pv-main">
            <view class="pv-t">简历 AI 授权</view>
            <view class="pv-s">{{consents.resume.text}}</view>
          </view>
          <text class="pv-act">{{consents.resume.on ? '撤回' : '查看'}}</text>
        </view>
      </block>
      <view wx:else class="pv-item"><view class="pv-main"><view class="pv-s">正在读取…</view></view></view>
    </view>

    <!-- 个人信息请求：不在意见反馈里开类别（C3），自助入口、联系方式、答复时限写在这里。 -->
    <view class="grp-label">个人信息请求</view>
    <view class="pr-card">
      <view class="pr-line"><text class="pr-k">自己办</text><text class="pr-v">{{selfHelpLine}}</text></view>
      <view class="pr-line"><text class="pr-k">办不了的</text><text class="pr-v">例如更正、注销账号：在「意见反馈」里写清楚，或按「经营者信息」里的联系方式联系我们。</text></view>
      <view class="pr-line"><text class="pr-k">多久答复</text><text class="pr-v">核实是你本人后，{{privacyRequestDays}} 个工作日内处理；办不了的会告诉你理由。</text></view>
      <view class="pr-acts">
        <view class="pr-btn tap" hover-class="tap-press" bindtap="toFeedback" role="button" aria-label="去意见反馈">去意见反馈</view>
        <view class="pr-btn tap" hover-class="tap-press" bindtap="toOperatorInfo" role="button" aria-label="查看经营者信息里的联系方式">经营者信息</view>
      </view>
    </view>

    <view class="grp-label">我的数据权利</view>

    <view wx:if="{{!isLoggedIn}}" class="pv-group">
      <view class="pv-item tap" hover-class="tap-press" bindtap="toLogin">
        <view class="pv-main">
          <view class="pv-t">登录后可导出数据或提交注销</view>
          <view class="pv-s">数据权利只对本人开放，需服务端核验身份</view>
        </view>
        <text class="ficon i-right pv-go"></text>
      </view>
    </view>

    <block wx:else>
      <!-- 数据导出 -->
      <view class="dr-card">
        <view class="dr-head">
          <text class="ficon i-inbox dr-ic"></text>
          <view class="dr-hmain">
            <view class="dr-t">导出我的数据</view>
            <view class="dr-s">短信二次验证后，由服务端后台生成导出包</view>
          </view>
        </view>

        <view wx:if="{{latestExport}}" class="dr-state">
          <view class="dr-row">
            <text class="dr-k">最近一次</text>
            <text class="dr-v">{{latestExport.requestedAtText}} · {{latestExport.statusLabel}}</text>
          </view>
          <view wx:if="{{latestExport.exportExpiresAtText}}" class="dr-row">
            <text class="dr-k">导出包到期</text>
            <text class="dr-v">{{latestExport.exportExpiresAtText}}</text>
          </view>
          <view wx:if="{{latestExport.failureText}}" class="dr-row">
            <text class="dr-k">失败原因</text>
            <text class="dr-v warn">{{latestExport.failureText}}</text>
          </view>
        </view>

        <view wx:if="{{latestExport.canDownload}}" class="dr-acts">
          <view class="btn primary block lg tap" hover-class="tap-press" bindtap="startDownload">取回导出包</view>
          <view class="dr-tip">下载授权一次性：服务端发送完成后即标记已取件。</view>
        </view>
        <view wx:else class="dr-acts">
          <view class="btn primary block lg tap" hover-class="tap-press" bindtap="startExport">发起数据导出</view>
          <view wx:if="{{hasActiveRequest}}" class="dr-tip">已有请求在处理中，完成后才能再次提交。</view>
        </view>
      </view>

      <!-- 本机导出件 -->
      <block wx:if="{{savedFiles.length}}">
        <view class="grp-label">本机导出件</view>
        <view class="pv-group">
          <view class="ef-item" wx:for="{{savedFiles}}" wx:key="fileName">
            <view class="ef-name">{{item.fileName}}</view>
            <view class="ef-meta">{{item.sizeText}} · 仅存在本机，不会自动上传</view>
            <view class="ef-acts">
              <view class="ef-btn tap" hover-class="tap-press" data-index="{{index}}" bindtap="shareFile">转发到微信</view>
              <view class="ef-btn tap" hover-class="tap-press" data-index="{{index}}" bindtap="saveFileToDisk">另存到电脑</view>
              <view class="ef-btn tap" hover-class="tap-press" data-index="{{index}}" bindtap="copyFile">复制内容</view>
              <view class="ef-btn danger tap" hover-class="tap-press" data-index="{{index}}" bindtap="removeFile">删除副本</view>
            </view>
          </view>
        </view>
      </block>

      <!-- 授权与注销 -->
      <view class="pv-group">
        <view wx:if="{{aiEnabled}}" class="pv-item tap" hover-class="tap-press" bindtap="revokeConsent">
          <view class="pv-main">
            <view class="pv-t">撤回 AI 分析授权</view>
            <view class="pv-s">立即生效；不删除简历、文档或打印订单</view>
          </view>
          <text class="ficon i-right pv-go"></text>
        </view>
        <view class="pv-item tap" hover-class="tap-press" bindtap="requestAccountClosure">
          <view class="pv-main">
            <view class="pv-t danger">账号注销</view>
            <view class="pv-s" wx:if="{{!capabilityLoaded}}">正在读取服务端状态…</view>
            <view class="pv-s" wx:elif="{{accountClosureAvailable}}">服务端已开放；不可逆，需二次确认</view>
            <view class="pv-s" wx:else>服务端当前未开放线上自助注销，提交会被拒绝</view>
          </view>
          <text class="ficon i-right pv-go danger"></text>
        </view>
      </view>

      <!-- 处理记录 -->
      <view class="grp-label">处理记录</view>
      <view wx:if="{{loading}}" class="state-box">正在读取服务端记录…</view>
      <view wx:elif="{{loadError}}" class="state-box">
        <view class="state-msg">{{loadError}}</view>
        <view class="ef-btn tap" hover-class="tap-press" bindtap="reload">重试</view>
      </view>
      <view wx:elif="{{!requests.length}}" class="state-box">暂无数据权利请求记录。</view>
      <view wx:else class="pv-group">
        <view class="rq-item" wx:for="{{requests}}" wx:key="id">
          <view class="rq-line">
            <text class="rq-t">{{item.typeLabel}}</text>
            <text class="rq-st">{{item.statusLabel}}</text>
          </view>
          <view class="rq-sub">{{item.requestedAtText}}</view>
          <view wx:if="{{item.failureText}}" class="rq-sub warn">{{item.failureText}}</view>
        </view>
      </view>
    </block>

    <view class="compliance-note">
      导出包为本人相关元数据清单：账号摘要、文件清单、AI 服务记录摘要、打印订单、收藏、权益、浏览与外部跳转记录、通知、反馈、授权与历史请求；不含文件原文与简历正文全文，单个分区超过 500 条会导出失败。导出包由服务端生成后约 23 小时到期。
    </view>
    <view class="compliance-note">
      你的简历不会进入任何简历库，也不会提供给任何单位。个人信息怎么处理、交给哪些受托方，以<text class="pv-link" bindtap="toPolicy">《隐私政策》</text>为准。
    </view>
  </view>

  <!-- 短信二次验证。整屏浮层且内容贴顶：键盘只会遮住下半屏，输入框与按钮始终可见。 -->
  <view wx:if="{{su.open}}" class="su-mask" bindtap="closeStepUp">
    <view class="su-panel" catchtap="keepOpen">
      <view style="height:{{statusBarHeight}}px"></view>
      <view class="su-bar">
        <view class="su-title">{{su.title}}</view>
        <view class="su-close tap" hover-class="tap-press" catchtap="closeStepUp">
          <text class="ficon i-close su-close-ic"></text>
        </view>
      </view>

      <view class="su-body">
        <view class="su-desc">{{su.desc}}</view>
        <view wx:if="{{su.phoneMasked}}" class="su-phone">验证码已发送至 {{su.phoneMasked}}</view>
        <view wx:elif="{{su.sending}}" class="su-phone">正在发送验证码…</view>

        <input
          class="su-input"
          type="number"
          maxlength="6"
          placeholder="请输入 6 位验证码"
          confirm-type="done"
          adjust-position="{{false}}"
          cursor-spacing="24"
          value="{{su.code}}"
          bindinput="onCodeInput"
        />

        <view class="su-meta">
          <view class="su-resend {{su.cooldown > 0 || su.sending ? 'off' : ''}} tap" hover-class="tap-press" catchtap="resendCode">
            <text wx:if="{{su.cooldown > 0}}">{{su.cooldown}}s 后可重发</text>
            <text wx:elif="{{su.sending}}">发送中…</text>
            <text wx:else>重新发送验证码</text>
          </view>
          <view wx:if="{{su.expiresIn > 0}}" class="su-expire">{{su.expiresIn}}s 内有效</view>
          <view wx:elif="{{su.challengeId}}" class="su-expire warn">验证码已过期，请重新发送</view>
        </view>

        <view wx:if="{{su.error}}" class="su-error">{{su.error}}</view>

        <view class="btn primary block lg tap {{su.verifying ? 'disabled' : ''}}" hover-class="tap-press" catchtap="submitStepUp">
          {{su.verifying ? '验证中…' : '验证并继续'}}
        </view>
        <view class="su-foot">验证码只发往你账号已绑定的手机号，本页无法更换接收号码。</view>
      </view>
    </view>
  </view>
</view>
