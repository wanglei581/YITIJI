/* pages/store-select/store-select.wxss */

.store-select-page {
  min-height: 100vh;
  background: var(--bg, #f5f7fa);
  display: flex;
  flex-direction: column;
}

.navbar {
  position: relative;
  height: 88rpx;
  background: var(--card-bg, #ffffff);
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid var(--border, #e5e8ed);
  z-index: 10;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-ic {
  transform: rotate(180deg);
  font-size: 32rpx;
  color: var(--text, #2c3e50);
}

.nav-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text, #2c3e50);
}

.store-scroll {
  flex: 1;
  overflow-y: scroll;
}

.store-body {
  padding: 24rpx;
}

/* 提示卡片 */
.tip-card {
  background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
  border-radius: var(--r-md, 12rpx);
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tip-card .ficon {
  font-size: 32rpx;
  color: var(--teal, #1677ff);
  flex-shrink: 0;
  margin-top: 2rpx;
}

.tip-card text {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-secondary, #5c6b7a);
}

/* 服务点列表 */
.store-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.store-item {
  position: relative;
  background: var(--card-bg, #ffffff);
  border-radius: var(--r-md, 12rpx);
  padding: 32rpx;
  box-shadow: var(--sh-xs, 0 2rpx 8rpx rgba(0,0,0,0.04));
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.store-item.selected {
  border-color: var(--teal, #1677ff);
  box-shadow: 0 4rpx 16rpx rgba(22, 119, 255, 0.15);
}

/* 选中标记 */
.store-check {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 48rpx;
  height: 48rpx;
  background: var(--teal, #1677ff);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: checkIn 0.3s ease;
}

@keyframes checkIn {
  0% { transform: scale(0); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

.store-check .ficon {
  font-size: 28rpx;
  color: #ffffff;
}

/* 服务点信息 */
.store-info {
  padding-right: 60rpx;
}

.store-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.store-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text, #2c3e50);
}

.store-status {
  padding: 6rpx 16rpx;
  border-radius: 32rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.store-status.open {
  background: #e8f5e9;
  color: #2e7d32;
}

.store-status.busy {
  background: #fff3e0;
  color: #e65100;
}

.store-status.closed {
  background: #fce4ec;
  color: #c2185b;
}

.store-address {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.store-address .ficon {
  font-size: 28rpx;
  color: var(--text-tertiary, #8d98a9);
  flex-shrink: 0;
  margin-top: 2rpx;
}

.store-address text {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--text-secondary, #5c6b7a);
}

.store-meta {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 16rpx;
}

.store-distance,
.store-hours {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.store-distance .ficon,
.store-hours .ficon {
  font-size: 24rpx;
  color: var(--text-tertiary, #8d98a9);
}

.store-distance text,
.store-hours text {
  font-size: 24rpx;
  color: var(--text-secondary, #5c6b7a);
}

/* 服务设施 */
.store-facilities {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.facility-tag {
  padding: 6rpx 16rpx;
  background: var(--bg, #f5f7fa);
  border-radius: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary, #5c6b7a);
}

/* 操作按钮 */
.store-actions {
  position: absolute;
  bottom: 32rpx;
  right: 32rpx;
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 56rpx;
  height: 56rpx;
  background: var(--bg, #f5f7fa);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn .ficon {
  font-size: 28rpx;
  color: var(--text-secondary, #5c6b7a);
}

/* 底部确认栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card-bg, #ffffff);
  padding: 24rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  z-index: 100;
}

.selected-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.selected-info .ficon {
  font-size: 32rpx;
  color: var(--teal, #1677ff);
}

.selected-info.empty .ficon {
  color: var(--text-tertiary, #8d98a9);
}

.selected-info text {
  font-size: 28rpx;
  color: var(--text-secondary, #5c6b7a);
}

.selected-info.empty text {
  color: var(--text-tertiary, #8d98a9);
}

.confirm-btn {
  flex-shrink: 0;
  padding: 24rpx 48rpx;
  background: var(--teal, #1677ff);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: all 0.2s ease;
}

.confirm-btn:active {
  transform: scale(0.98);
}

.confirm-btn.disabled {
  background: var(--bg, #f5f7fa);
  color: var(--text-tertiary, #8d98a9);
  transform: none;
}
