/* pages/store-select/store-select.wxss  材料包选点（墨翠鎏金白瓷） */

.store-select-page {
  min-height: 100vh;
  background: var(--paper);
  display: flex;
  flex-direction: column;
}

.navbar {
  position: relative;
  height: 88rpx;
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-ic {
  transform: rotate(180deg);
  font-size: var(--fs-lg);
  color: var(--ink);
}

.nav-title {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--ink);
}

.store-scroll { flex: 1; overflow-y: scroll; }
.store-body { padding: 16rpx 32rpx 24rpx; }

/* 提示卡片（移除旧蓝紫渐变，改为鎏金细框白瓷卡） */
.tip-card {
  background: var(--surface);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-xs);
  padding: 22rpx 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.tip-card .ficon { font-size: var(--fs-lg); color: var(--gold-deep); flex-shrink: 0; margin-top: 2rpx; }
.tip-card text { font-size: var(--fs-base); line-height: 1.6; color: var(--ink-soft); }

.store-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: calc(400rpx + var(--sab));
}
.store-org-tag {
  padding: 4rpx 14rpx;
  border-radius: var(--r-full);
  background: var(--gold-soft);
  border: 1rpx solid var(--gold-line);
  color: var(--gold-deep);
  font-size: var(--fs-xs);
  font-weight: 700;
  flex-shrink: 0;
}

.store-item {
  position: relative;
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 28rpx;
  box-shadow: var(--sh-sm);
  border: 2rpx solid var(--line-soft);
  transition: all 0.2s ease;
}
.store-item.selected {
  border-color: var(--teal);
  background: linear-gradient(180deg, #FFFFFF 0%, #F1F8F5 100%);
  box-shadow: var(--sh-md);
}

.store-check {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 48rpx;
  height: 48rpx;
  background: var(--teal-deep);
  border-radius: var(--r-full);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: checkIn 0.3s ease;
}
@keyframes checkIn {
  0% { transform: scale(0); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}
.store-check .ficon { font-size: var(--fs-base); color: var(--gold-bright); }

.store-info { padding-right: 60rpx; }
.store-header { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 14rpx; }
.store-name { font-size: var(--fs-md); font-weight: 750; color: var(--ink); }

.store-status { padding: 6rpx 16rpx; border-radius: var(--r-full); font-size: var(--fs-sm); font-weight: 600; }
.store-status.open { background: var(--ok-soft); color: var(--ok); }
.store-status.closed { background: var(--error-soft); color: var(--error); }

.store-address { display: flex; align-items: flex-start; gap: 8rpx; margin-bottom: 14rpx; }
.store-address .ficon { font-size: var(--fs-base); color: var(--muted); flex-shrink: 0; margin-top: 4rpx; }
.store-address text { font-size: var(--fs-base); line-height: 1.5; color: var(--muted); }

.store-meta { display: flex; align-items: center; gap: 28rpx; margin-bottom: 12rpx; }
.store-hours { display: flex; align-items: center; gap: 6rpx; }
.store-hours .ficon { font-size: var(--fs-sm); color: var(--faint); }
.store-hours text { font-size: var(--fs-sm); color: var(--muted); }

.store-item.offline { opacity: 0.68; }

.state-card {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line-soft);
  background: var(--surface);
  box-shadow: var(--sh-sm);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.state-t { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.state-d { font-size: var(--fs-base); line-height: 1.6; color: var(--muted); }
.state-card .btn { min-height: 48px; }

.store-summary { margin: 0 0 16rpx; font-size: var(--fs-sm); color: var(--muted); }

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--surface);
  padding: 20rpx 32rpx calc(20rpx + var(--sab));
  border-top: 1rpx solid var(--line-soft);
  box-shadow: 0 -8rpx 24rpx rgba(11, 39, 33, .06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  z-index: 100;
}

.selected-info { flex: 1; display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.selected-info .ficon { font-size: var(--fs-lg); color: var(--teal-deep); flex-shrink: 0; }
.selected-info.empty .ficon { color: var(--faint); }
.selected-info text { font-size: var(--fs-base); color: var(--ink-soft); font-weight: 600; }
.selected-info.empty text { color: var(--faint); font-weight: 400; }

.confirm-btn {
  flex-shrink: 0;
  min-height: 112rpx;
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #16483E 0%, #0A2720 100%);
  border: 1rpx solid rgba(223, 198, 147, .36);
  color: var(--gold-bright);
  border-radius: var(--r-full);
  font-size: var(--fs-base);
  font-weight: 700;
  box-shadow: var(--sh-sm);
  transition: all 0.2s ease;
}
.confirm-btn:active { transform: scale(0.98); }
.confirm-btn.disabled { background: var(--surface-2); border-color: transparent; color: var(--ghost); box-shadow: none; transform: none; }
