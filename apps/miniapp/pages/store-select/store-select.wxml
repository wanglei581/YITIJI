<view class="store-select-page">
  <view style="height:{{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="nav-back icon-action tap" hover-class="tap-press" bindtap="goBack" role="button" aria-label="返回">
      <text class="ficon i-right nav-back-ic"></text>
    </view>
    <text class="nav-title">选择服务点</text>
  </view>

  <scroll-view class="store-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="store-body">
      <!-- 提示信息 -->
      <view class="tip-card">
        <text class="ficon i-info"></text>
        <text>选择要去的一体机，下单后凭到机码在机器上核销并现场付款</text>
      </view>

      <!-- 深链直接进来、没有材料包草稿时，说清为什么不能继续 -->
      <view class="state-card" wx:if="{{!hasPackageData}}">
        <view class="state-t">还没有可下单的材料包</view>
        <view class="state-d">这一步要用上一步选好的文件，而当前没有草稿（可能是直接打开了本页，或草稿已被清理）。请回到第一步重新选择文件。</view>
        <view class="btn primary block tap" hover-class="tap-press" bindtap="backToFiles" role="button">回到选择文件</view>
      </view>

      <view class="state-card" wx:elif="{{state === 'loading'}}">
        <view class="state-t">正在读取服务点…</view>
      </view>

      <view class="state-card" wx:elif="{{state === 'error'}}">
        <view class="state-t">{{errorTitle}}</view>
        <view class="state-d">{{errorText}}</view>
        <view class="btn ghost block tap" hover-class="tap-press" bindtap="retryStores" role="button">重新加载</view>
      </view>

      <view class="state-card" wx:elif="{{!stores.length}}">
        <view class="state-t">本机尚未接入可用服务点</view>
        <view class="state-d">运营方还没有启用任何对外可见的一体机。这不是筛选问题，换条件也不会出现结果，请稍后再来。</view>
      </view>

      <block wx:else>
        <view class="store-summary">共 {{stores.length}} 个服务点，其中 {{onlineCount}} 个当前在线</view>

        <!-- 服务点列表 -->
        <view class="store-list">
          <view
            class="store-item tap {{selectedStore === item.id ? 'selected' : ''}} {{item.isOnline ? '' : 'offline'}}"
            wx:for="{{stores}}"
            wx:key="id"
            hover-class="tap-press"
            bindtap="selectStore"
            data-id="{{item.id}}"
            role="button"
            aria-label="服务点：{{item.name}}"
            aria-disabled="{{!item.isOnline}}"
          >
            <!-- 选中标记 -->
            <view class="store-check" wx:if="{{selectedStore === item.id}}">
              <text class="ficon i-check"></text>
            </view>

            <!-- 服务点信息 -->
            <view class="store-info">
              <view class="store-header">
                <text class="store-name">{{item.name}}</text>
                <view class="store-status {{item.isOnline ? 'open' : 'closed'}}">
                  <text>{{item.isOnline ? '在线' : '离线 · 暂不可下单'}}</text>
                </view>
              </view>

              <view class="store-address">
                <text class="ficon i-map-pin"></text>
                <text>{{item.address}}</text>
              </view>

              <view class="store-meta" wx:if="{{item.lastSeenText}}">
                <view class="store-hours">
                  <text class="ficon i-clock"></text>
                  <text>最近心跳 {{item.lastSeenText}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="compliance-note">下单时服务端会再核一次终端心跳与打印能力；这里显示在线也仍可能被服务端拒单。</view>
        <view class="compliance-note">{{onsiteNotice}}</view>
      </block>

      <!-- 底部占位 -->
      <view style="height: 120rpx;"></view>
    </view>
  </scroll-view>

  <!-- 底部确认栏 -->
  <view class="bottom-bar">
    <view class="selected-info" wx:if="{{selectedStore}}">
      <text class="ficon i-check-circle"></text>
      <text>已选择服务点</text>
    </view>
    <view class="selected-info empty" wx:else>
      <text class="ficon i-info"></text>
      <text>请选择在线服务点</text>
    </view>
    <button
      class="confirm-btn {{selectedStore ? '' : 'disabled'}}"
      bindtap="confirmAndContinue"
      disabled="{{!selectedStore}}"
    >
      确认并继续
    </button>
  </view>
</view>
