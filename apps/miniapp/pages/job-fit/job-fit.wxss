.page-wrap { min-height: 100vh; background: var(--paper); }

/* 运行中 / 空态 / 失败态共用 */
.running-state { display: flex; flex-direction: column; align-items: center;
  padding: 100rpx 32rpx 0; gap: 20rpx; }
.rs-anim { position: relative; width: 120rpx; height: 120rpx; margin-bottom: 16rpx; }
.rs-ring { position: absolute; inset: 0; border-radius: 50%;
  border: 4rpx solid transparent; border-top-color: var(--teal);
  animation: spin 1s linear infinite; }
.rs-ic { position: absolute; inset: 0; display: flex; align-items: center;
  justify-content: center; font-size: 48rpx; color: var(--teal); }
@keyframes spin { to { transform: rotate(360deg); } }
.st-ic { width: 128rpx; height: 128rpx; border-radius: 50%; background: var(--surface-2);
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; color: var(--muted); margin-bottom: 8rpx; }
.st-ic.warn { background: var(--warn-soft); color: var(--warn); }
.rs-title { font-size: 34rpx; font-weight: 700; color: var(--ink); }
.rs-sub { font-size: 26rpx; color: var(--muted); text-align: center; line-height: 1.6; }
.rs-disclaimer { font-size: 22rpx; color: var(--ghost); text-align: center; line-height: 1.6; }
/* 空态/失败态里的下一步入口,触控高度按一体机口径 ≥48px */
.jf-cta { margin-top: 12rpx; min-height: 96rpx; display: flex; align-items: center;
  justify-content: center; gap: 10rpx; padding: 0 34rpx; border-radius: 24rpx;
  background: var(--teal-soft); font-size: 28rpx; color: var(--teal-deep); font-weight: 650; }
.jf-cta-arrow { width: 19rpx; height: 19rpx; }

/* 授权 / 目标岗位表单 */
.jf-p { font-size: 27rpx; color: var(--ink-soft); line-height: 1.75; margin-bottom: 14rpx; }
.jf-p:last-child { margin-bottom: 0; }
.jf-strong { font-weight: 700; color: var(--ink); }
.jf-file { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx;
  padding: 18rpx 20rpx; background: var(--surface-2); border-radius: 12rpx; }
.jf-file-ic { font-size: 30rpx; color: var(--teal); flex-shrink: 0; }
  /* min-width:0 不能省：flex 子项的 min-width 默认是 auto(=min-content)，
     文件名一长就把整行撑出容器，ellipsis 永远不触发。旁边的图标是 flex-shrink:0，
     压不动，于是溢出全部由这一项承担。删掉这行：长文件名把行顶出屏幕。 */
.jf-file-name { font-size: 26rpx; color: var(--ink); flex: 1; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.jf-label { font-size: 25rpx; font-weight: 600; color: var(--ink-soft);
  margin: 20rpx 0 10rpx; }
.jf-label:first-child { margin-top: 0; }
.jf-input { height: 96rpx; padding: 0 22rpx; background: var(--surface-2);
  border-radius: 12rpx; font-size: 28rpx; color: var(--ink); }
.jf-textarea { width: 100%; box-sizing: border-box; height: 200rpx;
  padding: 18rpx 22rpx; background: var(--surface-2); border-radius: 12rpx;
  font-size: 27rpx; color: var(--ink); line-height: 1.65; }
.jf-hint { font-size: 22rpx; color: var(--ghost); line-height: 1.6; margin-top: 12rpx; }
.jf-target-title { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.jf-act { padding: 8rpx 16px 32rpx; }

/* 结果 hero:参考等级为文字三档,页面内没有任何百分比 */
/* 横向内缩用 px 与全局 .card 的 margin:0 16px 对齐,rpx 在宽屏机上会错位 */
.fit-hero { background: var(--surface); border: 1rpx solid #dce9ff;
  border-radius: 30rpx; margin: 0 16px 12px;
  padding: 34rpx 30rpx; display: flex; align-items: center; gap: 28rpx;
  box-shadow: var(--sh-xs); }
.fit-level { flex-shrink: 0; max-width: 46%; padding: 20rpx 24rpx; border-radius: 14rpx;
  background: var(--teal-soft); border: 1rpx solid #d4e6ff; }
.fit-level.teal  { background: var(--teal-soft); border-color: #d4e6ff; }
.fit-level.wheat { background: var(--wheat-soft); border-color: #f6ddb0; }
.fit-level.clay  { background: var(--clay-soft); border-color: #ffd2c2; }
.fit-level.slate { background: var(--slate-soft); border-color: #d8e2ff; }
.fl-label { font-size: 30rpx; font-weight: 800; color: var(--ink); line-height: 1.35; }
.fl-cap { font-size: 20rpx; color: var(--muted); margin-top: 8rpx; }
.fit-info { flex: 1; min-width: 0; }
.fit-job { font-size: 30rpx; font-weight: 720; color: var(--ink); line-height: 1.4; }
.fit-org { font-size: 24rpx; color: var(--muted); margin-top: 6rpx; }
.fit-src { font-size: 21rpx; color: var(--faint); margin-top: 10rpx; line-height: 1.5; }

.jf-summary { font-size: 27rpx; color: var(--ink); line-height: 1.75; }

/* 岗位原文拆解：按信息优先级纵向排布，避免把职责/门槛做成同权重宫格。 */
.jf-breakdown { margin: 0 16px 8px; background: var(--surface); border-radius: 14rpx;
  overflow: hidden; }
.jf-break-row { display: flex; align-items: flex-start; gap: 20rpx; padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--line-faint); }
.jf-break-row:last-child { border-bottom: none; }
.jf-break-cap { width: 112rpx; flex-shrink: 0; font-size: 22rpx; color: var(--muted);
  line-height: 1.65; }
.jf-break-cap.strong { color: var(--ink); font-weight: 700; }
.jf-break-cap.attention { color: var(--clay); font-weight: 600; }
.jf-break-list { flex: 1; min-width: 0; }
.jf-break-item { position: relative; padding-left: 18rpx; margin-bottom: 10rpx;
  font-size: 25rpx; color: var(--ink); line-height: 1.65; }
.jf-break-item:last-child { margin-bottom: 0; }
.jf-break-item::before { content: ''; position: absolute; left: 0; top: 17rpx;
  width: 6rpx; height: 6rpx; border-radius: 50%; background: var(--line); }
.jf-source-note { margin: 0 16px 12px; font-size: 21rpx; color: var(--ghost); line-height: 1.5; }

/* 匹配 / 差距列表 */
.fit-list { background: var(--surface); border-radius: 14rpx; overflow: hidden;
  margin: 0 16px 12px; }
.fit-item { display: flex; align-items: flex-start; gap: 16rpx; padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--line-faint); }
.fit-item:last-child { border-bottom: none; }
.fi-mark { width: 40rpx; height: 40rpx; border-radius: 50%; flex-shrink: 0;
  margin-top: 2rpx; display: flex; align-items: center; justify-content: center; }
.fi-mark .ficon { width: 22rpx; height: 22rpx; }
.fit-item.plus .fi-mark { color: var(--teal); }
.fit-item.plus .fi-mark { background: var(--teal-soft); }
.fit-item.minus .fi-mark { color: var(--warn); background: var(--warn-soft); }
.fi-body { flex: 1; min-width: 0; }
.fi-requirement { margin-bottom: 8rpx; font-size: 21rpx; color: var(--clay);
  font-weight: 600; line-height: 1.55; }
.fi-text { font-size: 28rpx; color: var(--ink); line-height: 1.6; }
/* 证据/建议原文可能很长,列表里截两行,点开看全文 */
.fi-sub { font-size: 24rpx; color: var(--muted); line-height: 1.6; margin-top: 8rpx;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

/* 关键词覆盖 */
.jf-kw-row { margin-bottom: 18rpx; }
.jf-kw-cap { font-size: 23rpx; color: var(--muted); margin-bottom: 10rpx; }

/* 针对性建议 */
.fit-sug { display: flex; align-items: flex-start; gap: 16rpx; padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--line-faint); }
.fit-sug:last-child { border-bottom: none; }
.fs-idx { width: 40rpx; height: 40rpx; border-radius: 50%; flex-shrink: 0;
  background: var(--teal-soft); color: var(--teal-deep);
  font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; margin-top: 2rpx; }
.fs-body { flex: 1; font-size: 27rpx; color: var(--ink); line-height: 1.7; }

/* 后续动作是连续工作流，不做并列大按钮；主次通过行文与图标承载。 */
.jf-next-list { margin: 0 16px 12px; background: var(--surface); border-radius: 14rpx;
  overflow: hidden; }
.jf-next { min-height: 116rpx; display: flex; align-items: center; gap: 18rpx;
  padding: 16rpx 22rpx; border-bottom: 1rpx solid var(--line-faint); box-sizing: border-box; }
.jf-next:last-child { border-bottom: none; }
.jf-next-icon { width: 58rpx; height: 58rpx; flex-shrink: 0; border-radius: 10rpx;
  background: var(--surface-2); color: var(--clay); font-size: 28rpx;
  display: flex; align-items: center; justify-content: center; }
.jf-next-main { flex: 1; min-width: 0; }
.jf-next-title { font-size: 27rpx; color: var(--ink); font-weight: 600; line-height: 1.45; }
.jf-next-sub { margin-top: 5rpx; font-size: 21rpx; color: var(--muted); line-height: 1.45; }
.jf-next-go { flex-shrink: 0; width: 21rpx; height: 21rpx; color: var(--ghost); }
.jf-revoke { min-height: 88rpx; margin: -4rpx 16px 16rpx; display: flex;
  align-items: center; justify-content: center; font-size: 23rpx; color: var(--muted); }

.flex-1-6 { flex: 1.6; }
