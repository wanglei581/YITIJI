/* pages/job-fit/job-fit.wxss  简历对照（墨翠鎏金白瓷） */
.page-wrap { min-height: 100vh; background: var(--paper); }

.running-state { display: flex; flex-direction: column; align-items: center; padding: 100rpx 32rpx 0; gap: 20rpx; }
.rs-anim { position: relative; width: 120rpx; height: 120rpx; margin-bottom: 16rpx; }
.rs-ring { position: absolute; inset: 0; border-radius: var(--r-full); border: 4rpx solid transparent; border-top-color: var(--teal); animation: spin 1s linear infinite; }
.rs-ic { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: var(--fs-2xl); color: var(--teal); }
@keyframes spin { to { transform: rotate(360deg); } }
.st-ic { width: 128rpx; height: 128rpx; border-radius: var(--r-full); background: radial-gradient(circle at 30% 28%, #ECF7F3 0%, #D9EEE6 100%); display: flex; align-items: center; justify-content: center; font-size: var(--fs-2xl); color: var(--teal-deep); margin-bottom: 8rpx; }
.st-ic.warn { background: var(--warn-soft); color: var(--warn); }
.rs-title { font-size: var(--fs-lg); font-weight: 750; color: var(--ink); }
.rs-sub { font-size: var(--fs-base); color: var(--muted); text-align: center; line-height: 1.6; }
.rs-disclaimer { font-size: var(--fs-sm); color: var(--faint); text-align: center; line-height: 1.6; }
.jf-cta { margin-top: 12rpx; min-height: 96rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; padding: 0 36rpx; border-radius: var(--r-full); background: linear-gradient(135deg, #16483E 0%, #0A2720 100%); color: var(--gold-bright); font-size: var(--fs-base); font-weight: 700; box-shadow: var(--sh-sm); }
.jf-cta-arrow { width: 20rpx; height: 20rpx; }

.jf-p { font-size: var(--fs-base); color: var(--ink-soft); line-height: 1.75; margin-bottom: 14rpx; }
.jf-p:last-child { margin-bottom: 0; }
.jf-strong { font-weight: 750; color: var(--ink); }
.jf-file { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx; padding: 18rpx 20rpx; background: var(--paper); border: 1rpx solid var(--line); border-radius: var(--r-sm); }
.jf-file-ic { font-size: var(--fs-md); color: var(--teal); flex-shrink: 0; }
.jf-file-name { font-size: var(--fs-base); color: var(--ink); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.jf-label { font-size: var(--fs-sm); font-weight: 650; color: var(--ink-soft); margin: 20rpx 0 10rpx; }
.jf-label:first-child { margin-top: 0; }
.jf-input { height: 96rpx; padding: 0 22rpx; background: var(--surface-2); border: 1rpx solid var(--line); border-radius: var(--r); font-size: var(--fs-base); color: var(--ink); }
.jf-textarea { width: 100%; box-sizing: border-box; height: 200rpx; padding: 18rpx 22rpx; background: var(--surface-2); border: 1rpx solid var(--line); border-radius: var(--r); font-size: var(--fs-base); color: var(--ink); line-height: 1.65; }
.jf-hint { font-size: var(--fs-sm); color: var(--faint); line-height: 1.6; margin-top: 12rpx; }
.jf-act { padding: 8rpx 16px 32rpx; }

/* 墨翠深松鎏金结果头（合规：不含等级与总评） */
.fit-hero {
  background: linear-gradient(150deg, #16483E 0%, #0C2B24 58%, #071915 100%);
  border: 1rpx solid rgba(223, 198, 147, .28);
  border-radius: var(--r-lg);
  margin: 0 16px 12px;
  padding: 32rpx 30rpx;
  box-shadow: var(--sh-md);
}
.fit-cap { font-size: var(--fs-xs); color: var(--gold-bright); font-weight: 700; }
.fit-job { font-size: var(--fs-lg); font-weight: 800; color: #FFFFFF; line-height: 1.4; margin-top: 8rpx; }
.fit-src { font-size: var(--fs-sm); color: rgba(255, 255, 255, .74); margin-top: 10rpx; line-height: 1.5; }

.jf-breakdown { margin: 0 16px 10px; background: var(--surface); border: 1rpx solid var(--line-soft); border-radius: var(--r-lg); box-shadow: var(--sh-sm); overflow: hidden; }
.jf-break-row { display: flex; align-items: flex-start; gap: 20rpx; padding: 22rpx 24rpx; border-bottom: 1rpx solid var(--line-faint); }
.jf-break-row:last-child { border-bottom: none; }
.jf-break-cap { width: 112rpx; flex-shrink: 0; font-size: var(--fs-sm); color: var(--muted); line-height: 1.65; }
.jf-break-cap.strong { color: var(--ink); font-weight: 700; }
.jf-break-cap.attention { color: var(--clay-deep); font-weight: 650; }
.jf-break-list { flex: 1; min-width: 0; }
.jf-break-item { position: relative; padding-left: 18rpx; margin-bottom: 10rpx; font-size: var(--fs-base); color: var(--ink); line-height: 1.65; }
.jf-break-item:last-child { margin-bottom: 0; }
.jf-break-item::before { content: ''; position: absolute; left: 0; top: 17rpx; width: 6rpx; height: 6rpx; border-radius: var(--r-full); background: var(--gold); }
.jf-source-note { margin: 0 16px 12px; font-size: var(--fs-xs); color: var(--faint); line-height: 1.5; }

.fit-list { background: var(--surface); border: 1rpx solid var(--line-soft); border-radius: var(--r-lg); box-shadow: var(--sh-sm); overflow: hidden; margin: 0 16px 12px; }
.fit-item { display: flex; align-items: flex-start; gap: 16rpx; padding: 22rpx 24rpx; border-bottom: 1rpx solid var(--line-faint); }
.fit-item:last-child { border-bottom: none; }
.fi-mark { width: 40rpx; height: 40rpx; border-radius: var(--r-full); flex-shrink: 0; margin-top: 2rpx; display: flex; align-items: center; justify-content: center; }
.fi-mark .ficon { width: 22rpx; height: 22rpx; }
.fit-item.plus .fi-mark { color: var(--teal-deep); background: var(--teal-soft); }
.fit-item.minus .fi-mark { color: var(--warn); background: var(--warn-soft); }
.fi-body { flex: 1; min-width: 0; }
.fi-requirement { margin-bottom: 8rpx; font-size: var(--fs-xs); color: var(--gold-deep); font-weight: 700; line-height: 1.55; }
.fi-text { font-size: var(--fs-base); color: var(--ink); line-height: 1.6; }
.fi-sub { font-size: var(--fs-sm); color: var(--muted); line-height: 1.6; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

.jf-kw-row { margin-bottom: 18rpx; }
.jf-kw-cap { font-size: var(--fs-sm); color: var(--muted); margin-bottom: 10rpx; }

.fit-sug { display: flex; align-items: flex-start; gap: 16rpx; padding: 22rpx 24rpx; border-bottom: 1rpx solid var(--line-faint); }
.fit-sug:last-child { border-bottom: none; }
.fs-idx { width: 40rpx; height: 40rpx; border-radius: var(--r-full); flex-shrink: 0; background: linear-gradient(135deg, #16483E 0%, #0A2720 100%); color: var(--gold-bright); font-size: var(--fs-sm); font-weight: 700; display: flex; align-items: center; justify-content: center; margin-top: 2rpx; }
.fs-body { flex: 1; font-size: var(--fs-base); color: var(--ink); line-height: 1.7; }

.jf-next-list { margin: 0 16px 12px; background: var(--surface); border: 1rpx solid var(--line-soft); border-radius: var(--r-lg); box-shadow: var(--sh-sm); overflow: hidden; }
.jf-next { min-height: 116rpx; display: flex; align-items: center; gap: 18rpx; padding: 16rpx 22rpx; border-bottom: 1rpx solid var(--line-faint); box-sizing: border-box; }
.jf-next:last-child { border-bottom: none; }
.jf-next-icon { width: 60rpx; height: 60rpx; flex-shrink: 0; border-radius: var(--r-full); background: var(--teal-soft); color: var(--teal-deep); font-size: var(--fs-md); display: flex; align-items: center; justify-content: center; }
.jf-next-main { flex: 1; min-width: 0; }
.jf-next-title { font-size: var(--fs-base); color: var(--ink); font-weight: 700; line-height: 1.45; }
.jf-next-sub { margin-top: 6rpx; font-size: var(--fs-xs); color: var(--muted); line-height: 1.45; }
.jf-next-go { flex-shrink: 0; width: 22rpx; height: 22rpx; color: var(--ghost); }
.jf-revoke { min-height: 88rpx; margin: -4rpx 16px 16rpx; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); color: var(--muted); }
