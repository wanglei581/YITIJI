<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="nav-back tap" bindtap="goBack"><text class="ficon i-right nav-back-ic"></text></view>
    <view class="nav-title">政策详情</view>
    <view class="nav-right"></view>
  </view>

  <view class="content has-bar">

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="detail-state">加载中…</view>

    <!-- 加载失败 -->
    <view wx:elif="{{loadError}}" class="detail-state">
      <view class="ds-msg">{{loadError}}</view>
      <view class="state-retry tap" bindtap="reload">重新加载</view>
      <view class="btn ghost tap ds-back" bindtap="goBack">返回</view>
    </view>

    <!-- 详情内容 -->
    <block wx:else>
    <view class="policy-hero rise-d1">
      <view class="ph-top">
        <view class="ph-labels">
          <view wx:if="{{policy.tag}}" class="chip {{policy.tagTone}}">{{policy.tag}}</view>
          <view wx:if="{{policy.label}}" class="ph-kind">{{policy.label}}</view>
        </view>
        <view class="ph-icon tone-{{policy.accent}}"><text class="ficon i-{{policy.icon}}"></text></view>
      </view>
      <view class="ph-title">{{policy.title}}</view>
      <view class="ph-meta">
        <text>{{policy.sourceOrg || '来源机构未标注'}}</text>
        <text wx:if="{{policy.publishedDate}}">{{policy.publishedDate}}</text>
      </view>
    </view>

    <view wx:if="{{policy.summary}}" class="summary-card rise-d2">
      <view class="summary-icon"><text class="ficon i-file-search"></text></view>
      <view class="summary-body">
        <view class="summary-title">政策摘要</view>
        <view class="summary-text">{{policy.summary}}</view>
      </view>
    </view>

    <view wx:if="{{policy.audience}}" class="audience-card rise-d3">
      <view class="audience-icon"><text class="ficon i-user"></text></view>
      <view>
        <view class="audience-label">适用人群</view>
        <view class="audience-value">{{policy.audience}}</view>
      </view>
    </view>

    <view class="policy-section-head rise-d3">
      <view class="section-title">政策正文</view>
      <view class="section-sub">以下内容来自公开原文</view>
    </view>
    <view wx:if="{{policy.paragraphs && policy.paragraphs.length}}" class="article-card rise-d3">
      <view class="article-paragraph" wx:for="{{policy.paragraphs}}" wx:key="*this">{{item}}</view>
    </view>
    <view wx:else class="article-card article-empty rise-d3">
      <view class="article-empty-icon"><text class="ficon i-file-text"></text></view>
      <view>当前来源未提供正文，请通过官方原文链接核验完整内容。</view>
    </view>

    <view class="source-card rise-d4">
      <view class="source-head">
        <view class="source-icon"><text class="ficon i-link"></text></view>
        <view>
          <view class="source-title">来源信息</view>
          <view class="source-sub">保留发布与同步记录，方便核验</view>
        </view>
      </view>
      <view class="ic-row"><text class="ic-k">发布机构</text><text class="ic-v">{{policy.sourceOrg || '未标注'}}</text></view>
      <view wx:if="{{policy.publishedDate}}" class="ic-row"><text class="ic-k">发布日期</text><text class="ic-v">{{policy.publishedDate}}</text></view>
      <view wx:if="{{policy.syncTime}}" class="ic-row"><text class="ic-k">同步时间</text><text class="ic-v">{{policy.syncTime}}</text></view>
    </view>

    <!-- 合规提示 -->
    <view class="notice info rise-d5">
      <text class="ficon i-info n-ic"></text>
      <text>本页为政策信息展示，不代表办理承诺。申领条件、材料与时限请以官方原文及当地经办窗口为准。</text>
    </view>

    </block>

  </view>

  <view class="actionbar">
    <view class="btn primary block tap {{policy.externalUrl ? '' : 'disabled'}}" bindtap="tapOfficial">
      {{policy.externalUrl ? '复制官方原文链接' : '官方原文链接暂不可用'}}
    </view>
  </view>

</view>
