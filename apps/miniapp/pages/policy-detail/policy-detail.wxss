.page-wrap { min-height: 100vh; background: var(--paper); }

.policy-hero { margin: 12rpx 32rpx 0; padding: 30rpx; border-radius: 32rpx;
  border: 1rpx solid #dce9ff; background: #eef5ff; }
.ph-top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.ph-labels { display: flex; align-items: center; gap: 10rpx; }
.ph-kind { font-size: 21rpx; color: var(--muted); }
.ph-icon { width: 76rpx; height: 76rpx; border-radius: 24rpx; display: flex;
  align-items: center; justify-content: center; flex-shrink: 0; }
.ph-icon .ficon { width: 37rpx; height: 37rpx; }
.tone-teal { background: var(--teal); color: #fff; }
.tone-wheat { background: var(--wheat); color: #fff; }
.tone-slate { background: var(--slate); color: #fff; }
.ph-title { margin-top: 20rpx; font-size: 37rpx; font-weight: 780; color: var(--ink); line-height: 1.45; }
.ph-meta { margin-top: 14rpx; display: flex; align-items: center; justify-content: space-between;
  gap: 18rpx; font-size: 22rpx; color: var(--muted); }

.summary-card, .audience-card, .source-card { margin: 16rpx 32rpx 0; padding: 24rpx;
  border-radius: 28rpx; background: var(--surface); border: 1rpx solid var(--line-soft); }
.summary-card, .audience-card { display: flex; align-items: flex-start; gap: 18rpx; }
.summary-icon, .audience-icon, .source-icon { width: 64rpx; height: 64rpx; border-radius: 20rpx;
  background: var(--teal-soft); color: var(--teal); display: flex; align-items: center;
  justify-content: center; flex-shrink: 0; }
.summary-icon .ficon, .audience-icon .ficon, .source-icon .ficon { width: 30rpx; height: 30rpx; }
.summary-body { flex: 1; min-width: 0; }
.summary-title, .source-title { font-size: 27rpx; font-weight: 700; color: var(--ink); }
.summary-text { margin-top: 9rpx; font-size: 25rpx; color: var(--ink-soft); line-height: 1.75; }
.audience-label { font-size: 21rpx; color: var(--muted); }
.audience-value { margin-top: 6rpx; font-size: 28rpx; font-weight: 700; color: var(--ink); }

.policy-section-head { padding: 30rpx 32rpx 16rpx; }
.section-title { font-size: 32rpx; font-weight: 760; color: var(--ink); }
.section-sub { margin-top: 5rpx; font-size: 21rpx; color: var(--muted); }
.article-card { margin: 0 32rpx; padding: 28rpx; border-radius: 28rpx; background: var(--surface);
  border: 1rpx solid var(--line-soft); }
.article-paragraph { font-size: 26rpx; color: var(--ink-soft); line-height: 1.85; }
.article-paragraph + .article-paragraph { margin-top: 22rpx; }
.article-empty { display: flex; align-items: center; gap: 16rpx; color: var(--muted);
  font-size: 24rpx; line-height: 1.65; }
.article-empty-icon { width: 60rpx; height: 60rpx; border-radius: 19rpx; background: var(--surface-2);
  color: var(--faint); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.article-empty-icon .ficon { width: 29rpx; height: 29rpx; }

.source-head { display: flex; align-items: center; gap: 16rpx; padding-bottom: 18rpx; }
.source-sub { margin-top: 3rpx; font-size: 20rpx; color: var(--muted); }
.ic-row { display: flex; align-items: flex-start; padding: 17rpx 0; border-top: 1rpx solid var(--line-faint); }
.ic-k { width: 140rpx; flex-shrink: 0; font-size: 25rpx; color: var(--muted); }
.ic-v { flex: 1; text-align: right; font-size: 25rpx; color: var(--ink); overflow-wrap: anywhere; }

/* actionbar flex */
.flex-1-6 { flex: 1.6; }

/* 加载 / 错误态 */
.detail-state { padding: 120rpx 48rpx; text-align: center; color: var(--ink-soft);
  font-size: 28rpx; display: flex; flex-direction: column; align-items: center; gap: 28rpx; }
.detail-state .ds-msg { color: var(--muted); line-height: 1.6; }
.detail-state .ds-back { min-width: 220rpx; }
