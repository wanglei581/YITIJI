.page-wrap { min-height: 100vh; background: var(--paper); }

/* 政策头部 */
.policy-hero { background: linear-gradient(135deg, #183a32 0%, #1f9e86 100%);
  padding: 36rpx 32rpx 40rpx; margin: 20rpx 0 0; border-radius: 16rpx; }
.ph-cat { display: inline-flex; align-items: center; font-size: 22rpx; font-weight: 600;
  background: rgba(255,255,255,.2); color: rgba(255,255,255,.9);
  padding: 6rpx 18rpx; border-radius: 20rpx; margin-bottom: 16rpx; }
.ph-title { font-size: 34rpx; font-weight: 700; color: #fff; line-height: 1.5; }
.ph-meta { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx;
  color: rgba(255,255,255,.65); margin-top: 12rpx; }
.ph-dot { opacity: .5; }

/* AI 速读卡 */
.ai-card { background: var(--surface); border-radius: 14rpx; padding: 24rpx 28rpx; margin-top: 16rpx; }
.ai-head { display: flex; align-items: center; gap: 12rpx; font-size: 26rpx; font-weight: 600;
  color: var(--teal); margin-bottom: 14rpx; }
.ai-body { font-size: 28rpx; color: var(--ink); line-height: 1.8; }
.ai-disclaimer { font-size: 22rpx; color: var(--ghost); margin-top: 12rpx; line-height: 1.6; }

/* 补贴标准表格 */
.policy-table { background: var(--surface); border-radius: 12rpx; overflow: hidden; margin-top: 4rpx; }
.pt-row { display: flex; align-items: center; padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--line); }
.pt-row:last-child { border-bottom: none; }
.pt-type { font-size: 28rpx; color: var(--ink); flex: 1; }
.pt-amt { font-size: 30rpx; font-weight: 700; color: var(--teal); flex-shrink: 0; }

/* 申领流程 */
.step-flow { padding: 0 4rpx; }
.sf-item { display: flex; align-items: flex-start; gap: 20rpx; padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line); }
.sf-item:last-child { border-bottom: none; }
.sf-n { width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--teal);
  color: #fff; font-size: 24rpx; font-weight: 700; display: flex; align-items: center;
  justify-content: center; flex-shrink: 0; margin-top: 4rpx; }
.sf-text { font-size: 28rpx; color: var(--ink); line-height: 1.7; flex: 1; }

/* 来源信息卡（复用 fair-detail 结构） */
.info-card { background: var(--surface); border-radius: 14rpx; padding: 24rpx 28rpx; margin-top: 16rpx; }
.ic-title { font-size: 24rpx; font-weight: 600; color: var(--muted); letter-spacing: 1px; margin-bottom: 16rpx; }
.ic-row { display: flex; align-items: flex-start; padding: 10rpx 0; border-bottom: 1rpx solid var(--line); }
.ic-row:last-of-type { border-bottom: none; }
.ic-k { font-size: 26rpx; color: var(--muted); width: 140rpx; flex-shrink: 0; }
.ic-v { font-size: 26rpx; color: var(--ink); flex: 1; }

/* body-text */
.body-text { font-size: 28rpx; color: var(--ink); line-height: 1.8;
  background: var(--surface); border-radius: 12rpx; padding: 20rpx 24rpx; margin-top: 4rpx; }

/* actionbar flex */
.flex-1-6 { flex: 1.6; }

/* 加载 / 错误态 */
.detail-state { padding: 120rpx 48rpx; text-align: center; color: var(--ink-soft);
  font-size: 28rpx; display: flex; flex-direction: column; align-items: center; gap: 28rpx; }
.detail-state .ds-msg { color: var(--muted); line-height: 1.6; }
.detail-state .ds-back { min-width: 220rpx; }
