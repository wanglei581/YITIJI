.page-wrap { min-height: 100vh; background: var(--paper); }
.companies-content { padding-top: 8rpx; }
.companies-hero { min-height: 214rpx; margin: 0 32rpx; padding: 30rpx; border-radius: 32rpx;
  border: 1rpx solid #dce9ff; background: #eef5ff; display: flex; align-items: center;
  justify-content: space-between; gap: 24rpx; }
.coh-copy { flex: 1; min-width: 0; }
.coh-kicker { font-size: 21rpx; font-weight: 650; color: var(--teal-deep); }
.coh-title { margin-top: 9rpx; font-size: 37rpx; font-weight: 780; color: var(--ink); line-height: 1.3; }
.coh-sub { margin-top: 9rpx; font-size: 22rpx; color: var(--muted); line-height: 1.55; }
.coh-icon { width: 96rpx; height: 96rpx; border-radius: 30rpx; background: var(--teal);
  color: #fff; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(22,119,255,.18); }
.coh-icon .ficon { width: 47rpx; height: 47rpx; }
.companies-section-head { padding: 30rpx 32rpx 18rpx; }
.companies-section-title { font-size: 32rpx; font-weight: 760; color: var(--ink); }
.companies-section-sub { margin-top: 5rpx; font-size: 21rpx; color: var(--muted); }
.company-list { display: flex; flex-direction: column; gap: 16rpx; }
.company-card { min-height: 170rpx; margin: 0 32rpx; padding: 24rpx; border-radius: 28rpx;
  background: var(--surface); border: 1rpx solid var(--line-soft); display: flex;
  align-items: flex-start; gap: 19rpx; }
.cc-logo { width: 76rpx; height: 76rpx; border-radius: 24rpx; background: var(--teal-soft);
  color: var(--teal); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.cc-logo .ficon { width: 37rpx; height: 37rpx; }
.cc-info { flex: 1; min-width: 0; }
.cc-name { font-size: 29rpx; font-weight: 720; color: var(--ink); line-height: 1.45; }
.cc-meta { margin-top: 7rpx; font-size: 22rpx; color: var(--muted); }
.cc-tags { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 7rpx; }
.cc-jobs-line { margin-top: 12rpx; font-size: 21rpx; color: var(--muted); line-height: 1.55;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.cc-right { align-self: stretch; display: flex; flex-direction: column; align-items: flex-end;
  justify-content: space-between; gap: 10rpx; flex-shrink: 0; }
.jobs-count { font-size: 20rpx; color: var(--teal); background: var(--teal-soft);
  padding: 5rpx 13rpx; border-radius: 999rpx; font-weight: 650; white-space: nowrap; }
.cc-arrow { width: 21rpx; height: 21rpx; color: var(--ghost); }
.state-card { margin: 0 32rpx; padding: 58rpx 40rpx; border-radius: 30rpx;
  background: var(--surface); border: 1rpx solid var(--line-soft); display: flex;
  flex-direction: column; align-items: center; text-align: center; }
.state-icon { width: 92rpx; height: 92rpx; border-radius: 28rpx; background: var(--teal-soft);
  color: var(--teal); display: flex; align-items: center; justify-content: center; }
.state-icon.warn { background: var(--warn-soft); color: var(--warn); }
.state-icon .ficon { width: 43rpx; height: 43rpx; }
.state-title { margin-top: 20rpx; font-size: 30rpx; font-weight: 720; color: var(--ink); }
.state-desc { margin-top: 8rpx; font-size: 23rpx; color: var(--muted); line-height: 1.6; }
