.page-wrap { min-height: 100vh; background: var(--paper); }

/* 来源选择列表 */
.src-list { background: var(--surface); border-radius: 14rpx; overflow: hidden; }
.src-item { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--line); }
.src-item:last-child { border-bottom: none; }
.src-ic { width: 72rpx; height: 72rpx; border-radius: 18rpx; display: flex;
  align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; }
.src-body { flex: 1; }
.src-title { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.src-desc { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.src-arr { font-size: 30rpx; color: var(--ghost); }

/* 简历库列表 */
.resume-list { background: var(--surface); border-radius: 14rpx; overflow: hidden; }
.resume-item { display: flex; align-items: center; gap: 16rpx; padding: 24rpx;
  border-bottom: 1rpx solid var(--line); }
.resume-item:last-child { border-bottom: none; }
.ri-ic { width: 56rpx; height: 56rpx; border-radius: 12rpx; background: rgba(31,158,134,.12);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: var(--teal); }
.ri-body { flex: 1; }
.ri-name { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.ri-meta { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.ri-arr { font-size: 28rpx; color: var(--ghost); }

/* 空态 */
.empty-hint { display: flex; flex-direction: column; align-items: center;
  padding: 60rpx 32rpx; gap: 12rpx; }
.eh-ic { font-size: 56rpx; color: var(--ghost); }
.eh-text { font-size: 30rpx; font-weight: 600; color: var(--muted); }
.eh-sub { font-size: 26rpx; color: var(--ghost); text-align: center; line-height: 1.6; }
