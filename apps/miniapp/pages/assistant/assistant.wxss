page { height: 100%; overflow: hidden; background: var(--paper); }

.as-wrap { height: 100vh; display: flex; flex-direction: column; background: var(--paper); }
.as-top {
  flex-shrink: 0;
  padding: 0 28rpx 16rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--line-soft);
  box-shadow: 0 4rpx 16rpx rgba(11, 39, 33, .03);
}
.as-row { min-height: 96rpx; display: flex; align-items: center; gap: 16rpx; }
/* 保持 96rpx=48px 可点标准 */
.as-back { width: 96rpx; height: 96rpx; margin-left: -12rpx; display: flex; align-items: center; justify-content: center; color: var(--ink); flex-shrink: 0; }
.as-back-ic { width: 28rpx; height: 28rpx; transform: rotate(180deg); }
/* 精裁小青肖像 + 鎏金细环 */
.as-av {
  width: 74rpx;
  height: 74rpx;
  padding: 3rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: var(--r-full);
  background: linear-gradient(145deg, #DFC693 0%, #174B40 100%);
  flex-shrink: 0;
}
.as-av image, .msg-av-wrap image { width: 100%; height: 100%; border-radius: var(--r-full); display: block; }
.as-name { font-size: var(--fs-md); line-height: 1.2; font-weight: 700; color: var(--ink); }
.as-role { margin-top: 4rpx; font-size: var(--fs-xs); color: var(--muted); }
/* 96rpx=48px 可点区，视觉干净圆形 */
.as-more {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-full);
  background: var(--surface-2);
  color: var(--ink-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.as-more .ficon { width: 28rpx; height: 28rpx; }

.chat-scroll { flex: 1; min-height: 0; overflow: hidden; }
.chat-body { padding: 24rpx 28rpx 20rpx; }

/* 紧凑高雅的 AI 声明条：去掉巨型纵向空白，同时保证链接 48px 可点热区 */
.as-disc {
  margin-bottom: 24rpx;
  padding: 18rpx 22rpx 0;
  border-radius: var(--r-md);
  background: var(--surface);
  box-shadow: var(--sh-xs);
  color: var(--faint);
  font-size: var(--fs-xs);
  line-height: 1.55;
  text-align: center;
}
.as-disc-links {
  margin-top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.as-disc-link {
  display: inline-flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 18rpx;
  color: var(--teal-deep);
  font-size: var(--fs-sm);
  font-weight: 600;
}

.msg { margin-bottom: 26rpx; }
.msg-ai { display: flex; align-items: flex-start; gap: 16rpx; }
.msg-user { display: flex; justify-content: flex-end; }
.msg-av-wrap {
  width: 62rpx;
  height: 62rpx;
  padding: 3rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: var(--r-full);
  background: linear-gradient(145deg, #DFC693 0%, #174B40 100%);
  flex-shrink: 0;
}
.b-ai {
  max-width: 82%;
  padding: 24rpx 26rpx;
  border-radius: var(--r-xs) var(--r-lg) var(--r-lg) var(--r-lg);
  background: var(--surface);
  box-shadow: var(--sh-xs);
}
.b-me {
  max-width: 78%;
  padding: 22rpx 26rpx;
  border-radius: var(--r-lg) var(--r-xs) var(--r-lg) var(--r-lg);
  background: linear-gradient(148deg, #184E43 0%, #0C2B24 100%);
  border: 1rpx solid rgba(212, 186, 135, .22);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(8, 29, 24, .34);
}
.b-ai .bt, .b-me .bt { font-size: var(--fs-base); line-height: 1.65; }
.b-ai .bt { color: var(--ink); }
.b-me .bt { color: #FFFFFF; }

.guide-cards { margin-top: 20rpx; display: flex; flex-direction: column; gap: 14rpx; }
.gc {
  min-height: 96rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--r-md);
  background: var(--paper);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.gc-ic { width: 60rpx; height: 60rpx; border-radius: var(--r-full); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.gc-ic .ficon { width: 28rpx; height: 28rpx; }
.gc-ic.tone-plum { color: var(--plum-deep); background: radial-gradient(circle at 30% 25%, #F3EFFD 0%, #E4DCF8 100%); }
.gc-ic.tone-teal { color: var(--teal-deep); background: radial-gradient(circle at 30% 25%, #EAF7F2 0%, #D3EDE3 100%); }
.gc-t { color: var(--ink); font-size: var(--fs-base); font-weight: 700; }
.gc-s { margin-top: 4rpx; color: var(--muted); font-size: var(--fs-xs); }
.gc-go { width: 18rpx; height: 18rpx; color: var(--ghost); }

/* 快捷问题：柔影纯白胶囊，彻底去粗灰框 */
.quick-scroll { width: 100%; }
.quick-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; padding: 8rpx 0 22rpx; }
.q-chip {
  min-width: 0;
  min-height: 96rpx;
  padding: 0 18rpx;
  border-radius: var(--r-md);
  background: var(--surface);
  box-shadow: var(--sh-xs);
  color: var(--ink-soft);
  font-size: var(--fs-sm);
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  box-sizing: border-box;
}

/* 保存本次要点：收束为精致居中翡翠鎏金胶囊按钮，不再是巨型空白矩形 */
.as-summary { margin: 4rpx 0 16rpx; display: flex; flex-direction: column; align-items: center; }
.as-sum-btn {
  min-height: 96rpx;
  padding: 0 44rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--gold-line);
  background: var(--surface);
  box-shadow: var(--sh-xs);
  color: var(--teal-deep);
  font-size: var(--fs-base);
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.as-sum-hint { margin-top: 14rpx; color: var(--muted); font-size: var(--fs-sm); line-height: 1.5; text-align: center; }
.as-sum-list { width: 100%; margin-top: 12rpx; }
.as-sum-item { padding: 8rpx 0; color: var(--ink); font-size: var(--fs-base); line-height: 1.5; }

/* 底部输入栏：归位 flex 流末端，纯白高定浮层，彻底杜绝遮盖消息 */
.input-bar {
  flex-shrink: 0;
  z-index: 20;
  padding: 18rpx 26rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line-soft);
  background: var(--surface);
  box-shadow: 0 -8rpx 28rpx rgba(11, 39, 33, .06);
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.as-input-col { flex-direction: column; align-items: stretch; gap: 14rpx; }
.as-voice-row { display: flex; align-items: center; gap: 16rpx; }
.as-hold {
  flex: 1;
  min-height: 96rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--gold-line);
  background: linear-gradient(135deg, #F0F7F4 0%, #FBF6EA 100%);
  color: var(--teal-deep);
  font-size: var(--fs-base);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-xs);
}
.as-hold.is-on {
  background: linear-gradient(148deg, #184E43 0%, #0B2721 100%);
  color: var(--gold-bright);
  border-color: rgba(212, 186, 135, .42);
}
.as-hold.is-off { opacity: .45; }
.as-direct { min-height: 96rpx; display: flex; align-items: center; gap: 10rpx; color: var(--muted); font-size: var(--fs-sm); font-weight: 500; }
.as-check { width: 34rpx; height: 34rpx; border-radius: var(--r-xs); border: 2rpx solid var(--line); }
.as-check.on { background: var(--teal); border-color: var(--teal); }
.as-voice-reason { color: var(--warn); font-size: var(--fs-sm); line-height: 1.5; }
.as-type-row { display: flex; align-items: center; gap: 14rpx; }
.ib-input {
  flex: 1;
  height: 92rpx;
  padding: 0 28rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--line-soft);
  background: var(--paper);
  color: var(--ink);
  font-size: var(--fs-base);
}
/* 96rpx=48px 墨翠鎏金圆润发送键 */
.ib-send {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-full);
  background: linear-gradient(148deg, #184E43 0%, #0B2721 100%);
  border: 1rpx solid rgba(212, 186, 135, .30);
  color: var(--gold-bright);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx -4rpx rgba(8, 29, 24, .34);
}
.ib-send .ficon { width: 28rpx; height: 28rpx; transform: rotate(-90deg); }
.ib-disabled { opacity: .4; }
.msg-loading { min-width: 72rpx; min-height: 35rpx; display: flex; align-items: center; gap: 8rpx; }
.dot { width: 11rpx; height: 11rpx; border-radius: var(--r-full); background: var(--faint); animation: dot-pulse 1.2s ease-in-out infinite; }
.dot:nth-child(2) { animation-delay: .2s; }
.dot:nth-child(3) { animation-delay: .4s; }
@keyframes dot-pulse { 0%,80%,100% { opacity: .25; transform: scale(.8); } 40% { opacity: 1; transform: scale(1); } }

/* 降级提示：诚实标注非真实模型输出 */
.msg-fallback {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: var(--wheat-wash);
  border: 1rpx solid var(--wheat-soft);
  border-radius: var(--r-sm);
  font-size: var(--fs-xs);
  color: var(--warn);
  line-height: 1.55;
}
.mf-ic { flex-shrink: 0; margin-top: 2rpx; }
