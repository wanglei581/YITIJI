page {
  background: #eef1ee;
}

.as-wrap {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #eef1ee;
}

/* ——— Header ——— */
.as-top {
  background: linear-gradient(160deg, #1f9e86, #157a67);
  padding: 0 32rpx 32rpx;
  flex-shrink: 0;
}

.as-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding-top: 8rpx;
}

.as-back {
  width: 60rpx; height: 60rpx;
  margin-left: -12rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

.as-back-ic {
  font-size: 40rpx;
  color: #fff;
  transform: rotate(180deg);
}

.as-av {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, #8fd3c4, #4bb59e);
  display: flex; align-items: center; justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, .5);
  flex-shrink: 0;
}

.as-av-ic {
  font-size: 44rpx;
  color: #fff;
}

.as-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.as-role {
  font-size: 23rpx;
  color: rgba(255, 255, 255, .75);
  margin-top: 4rpx;
}

/* ——— Chat scroll ——— */
.chat-scroll {
  flex: 1;
  overflow: hidden;
}

.chat-body {
  padding: 32rpx 32rpx 16rpx;
}

.day-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
  margin: 8rpx 0 28rpx;
}

.as-disc {
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.55;
  background: rgba(255, 255, 255, .6);
  border: 2rpx solid var(--line-faint);
  border-radius: var(--r);
  padding: 16rpx 24rpx;
  margin-bottom: 32rpx;
}

/* ——— Message bubbles ——— */
.msg {
  margin-bottom: 32rpx;
}

.msg-ai {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.msg-user {
  display: flex;
  justify-content: flex-end;
}

.msg-av-wrap {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, #8fd3c4, #4bb59e);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

.msg-av-ic {
  font-size: 30rpx;
  color: #fff;
}

.b-ai {
  background: var(--surface);
  border-radius: 8rpx 30rpx 30rpx 30rpx;
  padding: 24rpx 30rpx;
  box-shadow: var(--sh-xs);
  max-width: 80%;
}

.b-me {
  background: var(--teal);
  border-radius: 30rpx 8rpx 30rpx 30rpx;
  padding: 22rpx 30rpx;
  max-width: 78%;
}

.b-ai .bt {
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.65;
}

.b-me .bt {
  font-size: 28rpx;
  color: #fff;
  line-height: 1.6;
}

/* ——— Guide cards ——— */
.guide-cards {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gc {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--line-faint);
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
}

.gc-ic {
  width: 64rpx; height: 64rpx;
  border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.gc-ic.tone-plum {
  background: var(--plum-wash);
  color: var(--plum-deep);
}

.gc-ic.tone-teal {
  background: var(--teal-wash);
  color: var(--teal-deep);
}

.gc-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.gc-s {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

.gc-go {
  color: var(--teal);
  font-size: 32rpx;
}

/* ——— Quick chips ——— */
.quick-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.quick-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0 24rpx;
}

.q-chip {
  flex-shrink: 0;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: var(--r-full);
  padding: 16rpx 28rpx;
  font-size: 25rpx;
  color: var(--ink-soft);
  white-space: nowrap;
}

/* ——— Input bar (fixed) ——— */
.input-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: var(--surface);
  border-top: 2rpx solid var(--line-faint);
  padding: 20rpx 28rpx;
  padding-bottom: 32rpx; /* 旧基础库兜底 */
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx); /* 支持安全区的机型 */
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ib-mic {
  width: 76rpx; height: 76rpx;
  border-radius: 50%;
  background: var(--surface-2);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  color: var(--ink-soft);
  flex-shrink: 0;
}

.ib-input {
  flex: 1;
  height: 80rpx;
  background: var(--surface-2);
  border-radius: var(--r-full);
  border: 2rpx solid var(--line);
  padding: 0 32rpx;
  font-size: 27rpx;
  color: var(--ink);
}

.ib-send {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: var(--teal);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

/* ——— Loading bubble (三点等待动画) ——— */
.msg-loading {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 0;
}

.dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  background: var(--muted, #999);
  animation: dot-pulse 1.2s ease-in-out infinite;
}
.dot:nth-child(2) { animation-delay: .2s; }
.dot:nth-child(3) { animation-delay: .4s; }

@keyframes dot-pulse {
  0%, 80%, 100% { opacity: .3; transform: scale(.8); }
  40%            { opacity: 1;  transform: scale(1);  }
}

/* ——— 发送中禁用态 ——— */
.ib-disabled {
  opacity: .35;
}
