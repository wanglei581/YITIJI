<view class="as-wrap">
  <!-- padding-right 让开微信胶囊：本行右侧的按钮实测整个落在胶囊矩形内，点不到。
       值由 app.js 运行时按 getMenuButtonBoundingClientRect 算，不能写死 rpx。 -->
  <view class="as-top" style="padding-right:{{capsuleInsetRight}}px">
    <view style="height:{{statusBarHeight}}px"></view>
    <view class="as-row">
      <view class="as-back tap" hover-class="tap-press" bindtap="back">
        <text class="ficon i-right as-back-ic"></text>
      </view>
      <view class="as-av">
        <image src="/assets/xiaoqing-card.jpg" mode="aspectFill" />
      </view>
      <view style="flex:1">
        <view class="as-name">小青</view>
        <view class="as-role">求职服务智能助手</view>
      </view>
      <view class="as-more tap" hover-class="tap-press" bindtap="tapMore">
        <text class="ficon i-setting"></text>
      </view>
    </view>
  </view>

  <!-- 对话区（可滚动） -->
  <scroll-view scroll-y scroll-top="{{scrollTop}}" class="chat-scroll" enhanced enable-flex>
    <view class="chat-body">

      <view class="as-disc">{{disclaimer}}</view>

      <block wx:for="{{messages}}" wx:key="id">
        <!-- AI 消息 -->
        <view wx:if="{{item.role === 'ai'}}" class="msg msg-ai">
          <view class="msg-av-wrap">
            <image src="/assets/xiaoqing-card.jpg" mode="aspectFill" />
          </view>
          <view class="b-ai">
            <view wx:if="{{item.loading}}" class="bt msg-loading">
              <view class="dot"></view><view class="dot"></view><view class="dot"></view>
            </view>
            <view wx:else class="bt">{{item.text}}</view>
            <!-- 降级如实标注。服务端 aiGenerated=false 表示这条是 mock/stub 预置话术，
                 不标出来就是把预置话术冒充成小青的回答。 -->
            <view wx:if="{{item.fallbackNote}}" class="msg-fallback">
              <text class="ficon i-info mf-ic"></text>
              <text>{{item.fallbackNote}}</text>
            </view>
            <!-- 引导卡 -->
            <view wx:if="{{item.cards && item.cards.length}}" class="guide-cards">
              <view wx:for="{{item.cards}}" wx:for-item="card" wx:key="id"
                class="gc tap" hover-class="tap-press"
                data-url="{{card.url}}" bindtap="tapCard">
                <view class="gc-ic tone-{{card.tone}}">
                  <text class="ficon i-{{card.icon}}"></text>
                </view>
                <view style="flex:1">
                  <view class="gc-t">{{card.title}}</view>
                  <view class="gc-s">{{card.sub}}</view>
                </view>
                <text class="ficon i-right gc-go"></text>
              </view>
            </view>
          </view>
        </view>

        <!-- 用户消息 -->
        <view wx:if="{{item.role === 'user'}}" class="msg msg-user">
          <view class="b-me">
            <view class="bt">{{item.text}}</view>
          </view>
        </view>
      </block>

      <!-- 快捷问题 -->
      <view class="quick-scroll">
        <view class="quick-row">
          <view wx:for="{{quickChips}}" wx:key="index"
            class="q-chip tap" hover-class="tap-press"
            data-text="{{item}}" bindtap="tapChip">{{item}}</view>
        </view>
      </view>

      <view class="as-summary">
        <view class="as-sum-btn tap {{savingSummary ? 'ib-disabled' : ''}}" hover-class="tap-press" bindtap="saveSummary">
          {{savingSummary ? '正在保存…' : '保存本次要点'}}
        </view>
        <view wx:if="{{summaryHint}}" class="as-sum-hint">{{summaryHint}}</view>
        <view wx:if="{{summaryHighlights.length}}" class="as-sum-list">
          <view wx:for="{{summaryHighlights}}" wx:key="*this" class="as-sum-item">{{item}}</view>
        </view>
        <view wx:if="{{summaryTodos.length}}" class="as-sum-list">
          <view wx:for="{{summaryTodos}}" wx:key="*this" class="as-sum-item">待办：{{item}}</view>
        </view>
      </view>

      <view style="height:320rpx"></view>
    </view>
  </scroll-view>

  <!-- 底部输入栏（fixed） -->
  <view class="input-bar as-input-col">
    <view class="as-voice-row">
      <view
        class="as-hold {{holding ? 'is-on' : ''}} {{(!asrEnabled || sending || transcribing) ? 'is-off' : ''}}"
        hover-class="tap-press"
        bindtouchstart="onHoldStart"
        bindtouchend="onHoldEnd"
        bindtouchcancel="onHoldCancel"
        aria-role="button"
        aria-pressed="{{holding}}"
      >
        {{holding ? '松手结束' : (transcribing ? '正在转写…' : '按住说话')}}
      </view>
      <view class="as-direct tap" hover-class="tap-press" bindtap="toggleSendDirect">
        <view class="as-check {{sendVoiceDirect ? 'on' : ''}}"></view>
        语音直接发送
      </view>
    </view>
    <view wx:if="{{voiceBlockedReason}}" class="as-voice-reason">{{voiceBlockedReason}}</view>
    <view class="as-type-row">
      <input class="ib-input" placeholder="和小青说点什么…"
        placeholder-style="color:var(--muted)"
        value="{{inputText}}" bindinput="onInputChange"
        confirm-type="send" bindconfirm="sendMsg"
        disabled="{{sending}}" />
      <view class="ib-send tap {{sending ? 'ib-disabled' : ''}}" hover-class="tap-press" bindtap="sendMsg">
        <text class="ficon i-right" style="transform:rotate(-90deg)"></text>
      </view>
    </view>
  </view>
</view>
