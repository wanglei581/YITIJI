<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="nav-back tap" bindtap="goBack"><text class="ficon i-right nav-back-ic"></text></view>
    <view class="nav-title">招聘会详情</view>
  </view>

  <view class="content has-bar">

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="detail-state">加载中…</view>

    <!-- 加载失败 -->
    <view wx:elif="{{loadError}}" class="detail-state">
      <view class="ds-msg">{{loadError}}</view>
      <view class="state-retry tap" bindtap="reload">重新加载</view>
      <view class="btn ghost tap ds-back" bindtap="goBack">返回</view>
    </view>

    <!-- 详情内容 -->
    <block wx:else>
    <view class="fair-hero rise-d1">
      <view class="fh-top">
        <view wx:if="{{fair.tag}}" class="fh-badge {{fair.tagTone}}">{{fair.tag}}</view>
        <view class="fh-icon"><text class="ficon i-calendar"></text></view>
      </view>
      <view class="fh-title">{{fair.title || '招聘会详情'}}</view>
      <view class="fh-org">{{fair.organizer ? '主办：' + fair.organizer : (fair.sourceOrg ? '来源：' + fair.sourceOrg : '主办方未标注')}}</view>
    </view>

    <view class="section-head rise-d2">
      <view class="section-title">活动信息</view>
      <view class="section-sub">时间、地点与公开规模</view>
    </view>
    <view class="info-grid rise-d2">
      <view wx:if="{{fair.startTime}}" class="ig-cell wide">
        <view class="ig-icon"><text class="ficon i-calendar"></text></view>
        <view class="ig-copy">
          <view class="ig-label">开始时间</view>
          <view class="ig-val">{{fair.startTime}}</view>
          <view wx:if="{{fair.endTime}}" class="ig-sub">结束：{{fair.endTime}}</view>
        </view>
      </view>
      <view wx:if="{{fair.venue || fair.city}}" class="ig-cell wide">
        <view class="ig-icon"><text class="ficon i-location"></text></view>
        <view class="ig-copy">
          <view class="ig-label">举办地点</view>
          <view class="ig-val">{{fair.venue || fair.city}}</view>
          <view wx:if="{{fair.venue && fair.city}}" class="ig-sub">{{fair.city}}</view>
        </view>
      </view>
      <view wx:if="{{fair.boothCount !== undefined && fair.boothCount !== null}}" class="ig-cell metric">
        <view class="ig-num">{{fair.boothCount}}</view>
        <view class="ig-label">公开展位数</view>
      </view>
      <view wx:if="{{fair.jobCount !== undefined && fair.jobCount !== null}}" class="ig-cell metric">
        <view class="ig-num">{{fair.jobCount}}</view>
        <view class="ig-label">公开岗位数</view>
      </view>
      <view wx:if="{{fair.expectedAttendance !== undefined && fair.expectedAttendance !== null}}" class="ig-cell metric">
        <view class="ig-num">{{fair.expectedAttendance}}</view>
        <view class="ig-label">预计参与人数</view>
      </view>
    </view>

    <view wx:if="{{fair.description}}" class="detail-card rise-d3">
      <view class="dc-icon"><text class="ficon i-file-text"></text></view>
      <view class="dc-body">
        <view class="dc-title">活动介绍</view>
        <view class="dc-text">{{fair.description}}</view>
      </view>
    </view>

    <view wx:if="{{fair.trafficInfo}}" class="detail-card rise-d4">
      <view class="dc-icon slate"><text class="ficon i-compass"></text></view>
      <view class="dc-body">
        <view class="dc-title">交通信息</view>
        <view class="dc-text">{{fair.trafficInfo}}</view>
      </view>
    </view>

    <view class="source-card rise-d4">
      <view class="source-head">
        <view class="source-icon"><text class="ficon i-link"></text></view>
        <view>
          <view class="source-title">来源信息</view>
          <view class="source-sub">保留来源与同步记录，方便核验</view>
        </view>
      </view>
      <view class="ic-row"><text class="ic-k">来源机构</text><text class="ic-v">{{fair.sourceOrg || '未标注'}}</text></view>
      <view wx:if="{{fair.externalId}}" class="ic-row"><text class="ic-k">外部 ID</text><text class="ic-v mono">{{fair.externalId}}</text></view>
      <view wx:if="{{fair.syncTime}}" class="ic-row"><text class="ic-k">同步时间</text><text class="ic-v">{{fair.syncTime}}</text></view>
      <view wx:if="{{fair.dataSourceNote}}" class="source-note">{{fair.dataSourceNote}}</view>
    </view>

    <!-- 现场助手：这四条对应的后端能力早就为一体机建好了，小程序此前一条都没接，
         导致「行前计划 → 展位导览 → 参展企业 → 现场打材料」整条链在手机上是断的。
         入口放在详情页而不是列表页：只有确定要去哪一场，这四件事才有意义。 -->
    <view class="section-head rise-d4">
      <view class="section-title">现场助手</view>
      <view class="section-sub">到场前后用得上的四件事</view>
    </view>
    <view class="tiles rise-d4">
      <view class="tile sheen tap" hover-class="tap-press" bindtap="tapVenue"
            role="button" aria-label="会场导览，展厅分区与打印点位置">
        <view class="t-ic a-teal"><text class="ficon i-map"></text></view>
        <view class="t-title">会场导览</view>
        <view class="t-desc">展厅分区与打印点位置</view>
      </view>
      <view class="tile sheen tap" hover-class="tap-press" bindtap="tapCompanies"
            role="button" aria-label="参会企业，展位号与岗位清单">
        <view class="t-ic a-slate"><text class="ficon i-bank"></text></view>
        <view class="t-title">参会企业</view>
        <view class="t-desc">展位号与岗位清单</view>
      </view>
      <view class="tile sheen tap" hover-class="tap-press" bindtap="tapMaterials"
            role="button" aria-label="活动资料，主办方发布的可打印资料">
        <view class="t-ic a-wheat"><text class="ficon i-file-text"></text></view>
        <view class="t-title">活动资料</view>
        <view class="t-desc">主办方发布，可打印</view>
      </view>
      <view class="tile sheen tap" hover-class="tap-press" bindtap="tapVisitPlan"
            role="button" aria-label="AI 参会准备单，基于你的简历生成参会准备建议">
        <view class="t-ic a-plum"><text class="ficon i-robot"></text></view>
        <view class="t-title">AI 参会准备单</view>
        <view class="t-desc">按你的简历给准备建议</view>
      </view>
    </view>

    <!-- 合规提示 -->
    <view class="notice info rise-d5">
      <text class="ficon i-info n-ic"></text>
      <text>本终端仅展示招聘会信息，预约/报名请前往来源平台或现场办理，本平台不代收报名信息。</text>
    </view>

    </block>

  </view>

  <!-- 收藏原本在导航栏右上角，被微信胶囊（···⊙）完全遮挡——胶囊是系统浮层，
       自定义导航栏右侧永远不可用。移到底部操作条，与「提醒我」「复制来源链接」并列。 -->
  <view class="actionbar">
    <view class="fav-btn tap {{faved ? 'on' : ''}}" hover-class="tap-press" bindtap="tapFav"
          role="button" aria-label="{{faved ? '取消收藏这场招聘会' : '收藏这场招聘会'}}">
      <text class="ficon i-inbox"></text>
      <text class="fav-btn-t">{{faved ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="btn remind-btn tap {{reminded ? 'on' : ''}}" hover-class="tap-press" bindtap="tapRemind"
          role="button" aria-label="{{reminded ? '已设置开场提醒，点击取消' : '设置开场提醒'}}">
      <text class="ficon i-bell remind-ic"></text>
      <text>{{reminded ? '已提醒' : '提醒我'}}</text>
    </view>
    <view class="btn primary tap {{fair.externalUrl ? '' : 'disabled'}} flex-1-4" bindtap="tapExternalBook">
      {{fair.externalUrl ? '复制来源链接' : '来源链接暂不可用'}}
    </view>
  </view>

</view>
