<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="nav-back tap" bindtap="goBack"><text class="ficon i-right nav-back-ic"></text></view>
    <view class="nav-title">招聘会详情</view>
    <view class="nav-right tap {{faved ? 'faved' : ''}}" hover-class="tap-press" bindtap="tapFav"><text class="ficon i-inbox"></text></view>
  </view>

  <view class="content has-bar">

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="detail-state">加载中…</view>

    <!-- 加载失败 -->
    <view wx:elif="{{loadError}}" class="detail-state">
      <view class="ds-msg">{{loadError}}</view>
      <view class="state-retry tap" bindtap="reload">重新加载</view>
      <view class="btn ghost tap ds-back" bindtap="goBack">返回</view>
    </view>

    <!-- 详情内容 -->
    <block wx:else>
    <!-- Hero banner -->
    <view class="fair-hero rise-d1">
      <view class="fh-badge {{fair.status}}">{{fair.statusText}}</view>
      <view class="fh-title">{{fair.name}}</view>
      <view class="fh-org">主办：{{fair.host}}</view>
    </view>

    <!-- 关键信息四格 -->
    <view class="info-grid rise-d2">
      <view class="ig-cell">
        <view class="ig-label">时间</view>
        <view class="ig-val">{{fair.date}}</view>
      </view>
      <view class="ig-cell">
        <view class="ig-label">形式</view>
        <view class="ig-val">{{fair.format}}</view>
      </view>
      <view class="ig-cell">
        <view class="ig-label">参会单位</view>
        <view class="ig-val">{{fair.companyCount}} 家</view>
      </view>
      <view class="ig-cell">
        <view class="ig-label">面向对象</view>
        <view class="ig-val">{{fair.target}}</view>
      </view>
    </view>

    <!-- 来源信息 -->
    <view class="info-card rise-d3">
      <view class="ic-title">来源信息</view>
      <view class="ic-row"><text class="ic-k">来源机构</text><text class="ic-v">{{fair.sourceOrg}}</text></view>
      <view class="ic-row"><text class="ic-k">外部 ID</text><text class="ic-v mono">{{fair.externalId}}</text></view>
      <view class="ic-row"><text class="ic-k">同步时间</text><text class="ic-v">{{fair.syncTime}}</text></view>
    </view>

    <!-- 活动介绍 -->
    <view class="section-t rise-d3">活动介绍</view>
    <view class="body-text rise-d3">{{fair.intro}}</view>

    <!-- 展位预览 -->
    <view class="section-t rise-d4">展位信息</view>
    <view class="booth-list rise-d4">
      <view class="booth-item" wx:for="{{fair.booths}}" wx:key="pos">
        <view class="bi-zone {{item.zone}}">{{item.zoneLabel}}</view>
        <view class="bi-name">{{item.company}}</view>
        <view class="bi-pos">{{item.boothNo}}</view>
      </view>
    </view>

    <!-- 合规提示 -->
    <view class="notice info rise-d5">
      <text class="ficon i-info n-ic"></text>
      <text>本终端仅展示招聘会信息，预约/报名请前往来源平台或现场办理，本平台不代收报名信息。</text>
    </view>

    </block>

  </view>

  <view class="actionbar">
    <view class="btn primary block tap" bindtap="tapExternalBook">复制来源链接</view>
  </view>

</view>
