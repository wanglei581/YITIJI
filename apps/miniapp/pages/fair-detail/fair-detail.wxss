.page-wrap { min-height: 100vh; background: var(--paper); }

/* 收藏按钮：与主操作并列在底部操作条。不可放导航栏右侧——微信胶囊常驻遮挡。
   ficon 无实心星/心形，纯图标不可识别，故图标下必须带文字标签。 */
.actionbar { display: flex; align-items: center; gap: 16rpx; }
.fav-btn { flex-shrink: 0; min-width: 132rpx; height: 96rpx; padding: 0 20rpx; border-radius: 26rpx;
  border: 1rpx solid var(--line-soft); background: #fff; color: var(--ink-soft);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; }
.fav-btn .ficon { width: 34rpx; height: 34rpx; }
.fav-btn-t { font-size: 21rpx; font-weight: 650; }
.fav-btn.on { border-color: var(--teal); background: var(--teal-wash); color: var(--teal-deep); }

/* 与 UI Notes 效率类 App 一致的冷白信息卡：清楚层级，不用大面积渐变。 */
.fair-hero { margin: 12rpx 32rpx 0; padding: 30rpx; border-radius: 32rpx;
  border: 1rpx solid #dce9ff; background: #eef5ff; }
.fh-top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.fh-badge { display: inline-flex; align-items: center; font-size: 22rpx; font-weight: 600;
  padding: 6rpx 18rpx; border-radius: 999rpx; background: #fff; color: var(--teal-deep); }
.fh-badge.warn { color: var(--warn); }
.fh-badge.muted { color: var(--muted); }
.fh-icon { width: 76rpx; height: 76rpx; border-radius: 24rpx; background: var(--teal);
  color: #fff; display: flex; align-items: center; justify-content: center; }
.fh-icon .ficon { width: 37rpx; height: 37rpx; }
.fh-title { margin-top: 20rpx; font-size: 38rpx; font-weight: 780; color: var(--ink); line-height: 1.4; }
.fh-org { margin-top: 11rpx; font-size: 23rpx; color: var(--muted); line-height: 1.55; }

.section-head { padding: 30rpx 32rpx 16rpx; }
.section-title { font-size: 32rpx; font-weight: 760; color: var(--ink); }
.section-sub { margin-top: 5rpx; font-size: 21rpx; color: var(--muted); }
.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin: 0 32rpx; }
.ig-cell { min-height: 124rpx; padding: 22rpx; border-radius: 26rpx; background: var(--surface);
  border: 1rpx solid var(--line-soft); }
.ig-cell.wide { grid-column: 1 / -1; display: flex; align-items: flex-start; gap: 18rpx; }
.ig-icon { width: 62rpx; height: 62rpx; border-radius: 19rpx; background: var(--teal-soft);
  color: var(--teal); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.ig-icon .ficon { width: 29rpx; height: 29rpx; }
.ig-copy { flex: 1; min-width: 0; }
.ig-label { font-size: 21rpx; color: var(--muted); }
.ig-val { margin-top: 5rpx; font-size: 27rpx; font-weight: 680; color: var(--ink); line-height: 1.45; }
.ig-sub { margin-top: 5rpx; font-size: 21rpx; color: var(--faint); }
.ig-cell.metric { display: flex; flex-direction: column; justify-content: center; }
.ig-num { font-size: 38rpx; line-height: 1; font-weight: 800; color: var(--ink); }
.metric .ig-label { margin-top: 10rpx; }

.detail-card, .source-card { margin: 16rpx 32rpx 0; padding: 24rpx; border-radius: 28rpx;
  background: var(--surface); border: 1rpx solid var(--line-soft); }
.detail-card { display: flex; align-items: flex-start; gap: 18rpx; }
.dc-icon, .source-icon { width: 64rpx; height: 64rpx; border-radius: 20rpx; background: var(--teal-soft);
  color: var(--teal); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.dc-icon.slate { background: var(--slate-soft); color: var(--slate); }
.dc-icon .ficon, .source-icon .ficon { width: 30rpx; height: 30rpx; }
.dc-body { flex: 1; min-width: 0; }
.dc-title, .source-title { font-size: 27rpx; font-weight: 700; color: var(--ink); }
.dc-text { margin-top: 9rpx; font-size: 25rpx; color: var(--ink-soft); line-height: 1.75; white-space: pre-wrap; }
.source-head { display: flex; align-items: center; gap: 16rpx; padding-bottom: 18rpx; }
.source-sub { margin-top: 3rpx; font-size: 20rpx; color: var(--muted); }
.ic-row { display: flex; align-items: flex-start; padding: 17rpx 0; border-top: 1rpx solid var(--line-faint); }
.ic-row:last-of-type { border-bottom: none; }
.ic-k { font-size: 26rpx; color: var(--muted); width: 140rpx; flex-shrink: 0; }
.ic-v { font-size: 25rpx; color: var(--ink); flex: 1; text-align: right; overflow-wrap: anywhere; }
.ic-v.mono { font-family: 'Courier New', monospace; font-size: 24rpx; color: var(--muted); }
.source-note { margin-top: 14rpx; padding: 16rpx 18rpx; border-radius: 18rpx; background: var(--surface-2);
  font-size: 21rpx; color: var(--muted); line-height: 1.6; }

/* actionbar flex 比例 */
.flex-1-4 { flex: 1.4; }

/* 提醒按钮 */
/* 三按钮并列后收窄内边距，保证「复制来源链接」不被挤压换行 */
.remind-btn { display: flex; align-items: center; justify-content: center; gap: 8rpx;
  background: var(--surface); border: 1.5rpx solid var(--line); color: var(--muted);
  font-size: 27rpx; border-radius: var(--r-md, 24rpx);
  flex-shrink: 0; min-width: 150rpx; padding: 0 18rpx; }
.remind-btn.on { background: var(--teal-soft); border-color: var(--teal); color: var(--teal-deep); font-weight: 600; }
.remind-ic { width: 32rpx; height: 32rpx; flex-shrink: 0; }

/* 加载 / 错误态 */
.detail-state { padding: 120rpx 48rpx; text-align: center; color: var(--ink-soft);
  font-size: 28rpx; display: flex; flex-direction: column; align-items: center; gap: 28rpx; }
.detail-state .ds-msg { color: var(--muted); line-height: 1.6; }
.detail-state .ds-back { min-width: 220rpx; }

/* 无 externalUrl 时第三颗按钮文案变长（「来源链接暂不可用」8 字），
   而前两颗是 flex-shrink:0 的自定义按钮，压不动。
   320pt 实算：fav 56.3(min-width 132rpx) + remind 64(min-width 150rpx)
   + 第三颗 8×15+48=168 + 两段 gap 13.7 = 302 > 可用 288，溢 14px。
   app.wxss 的窄屏规则只收 .btn.lg，这三颗都不是 lg，收不到。
   **也不能让它收**：remind-btn 是 class="btn remind-btn"，页面给的 padding 是
   18rpx（320pt 下 7.7px），被 .actionbar .btn(0,2,0) 盖成 16px 反而撑宽 16.6px。
   所以只收第三颗（.btn.primary）的内边距：168 → 144，总计 278，余 10px。
   删掉这段：320pt 上「来源链接暂不可用」末字被屏幕切掉。 */
@media (max-width: 374px) {
  .actionbar .btn.primary { padding: 0 12px; }
}
