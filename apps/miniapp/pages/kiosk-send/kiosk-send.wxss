/* pages/kiosk-send/kiosk-send.wxss  传文件到一体机（墨翠鎏金白瓷） */
.page-wrap { min-height: 100vh; background: var(--paper); }

.navbar { display: flex; align-items: center; height: 88rpx; padding: 0 24rpx; background: var(--paper); }
.nav-back { width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; }
.nav-back .ficon { transform: rotate(180deg); font-size: var(--fs-lg); color: var(--ink); }
.nav-title { flex: 1; text-align: center; font-size: var(--fs-lg); font-weight: 700; color: var(--ink); padding-right: 96rpx; }

.content { padding: 24rpx 32rpx 64rpx; }

.guide-card, .state-card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-sm);
  padding: 52rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.guide-icon, .sc-icon { font-size: var(--fs-2xl); color: var(--teal-deep); margin-bottom: 24rpx; }
.guide-title, .sc-title { font-size: var(--fs-lg); font-weight: 750; color: var(--ink); margin-bottom: 14rpx; }
.guide-desc, .sc-desc { font-size: var(--fs-base); color: var(--muted); line-height: 1.65; margin-bottom: 36rpx; }

.sent-list { width: 100%; margin-bottom: 30rpx; }
.sent-item {
  font-size: var(--fs-base);
  color: var(--ink-soft);
  padding: 18rpx 24rpx;
  background: var(--paper);
  border: 1rpx solid var(--line-faint);
  border-radius: var(--r-md);
  margin-bottom: 12rpx;
  word-break: break-all;
}

.btn-primary, .btn-secondary {
  width: 100%;
  min-height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--r-full);
  font-size: var(--fs-md);
  font-weight: 700;
  border: none;
}
.btn-primary {
  background: linear-gradient(135deg, #16483E 0%, #0A2720 100%);
  color: var(--gold-bright);
  box-shadow: var(--sh-sm);
}
.btn-secondary {
  background: var(--teal-wash);
  border: 1rpx solid rgba(15, 106, 87, .24);
  color: var(--teal-deep);
}

.album-btn { margin-top: 24rpx; }
.doc-card { margin-top: 24rpx; }
.doc-list { text-align: left; }
.doc-item { min-height: 96rpx; }
.doc-meta { font-size: var(--fs-sm); color: var(--muted); }
.sent-title { word-break: break-all; }
