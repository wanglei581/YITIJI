<!--pages/kiosk-send/kiosk-send.wxml-->
<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="nav-back tap" hover-class="tap-press" bindtap="goBack" aria-label="返回">
      <text class="ficon i-right"></text>
    </view>
    <view class="nav-title">传文件到一体机</view>
  </view>

  <view class="content">

    <!-- 空闲：可以选文件。两个来源，一张码只收一份 -->
    <block wx:if="{{phase === 'idle'}}">
      <view class="guide-card">
        <text class="guide-icon ficon i-printer"></text>
        <view class="guide-title">已连上终端</view>
        <view class="guide-desc">选一份文件传过去，终端屏幕上会自己出现。一张码只收一份，单个文件不超过 10MB。</view>
        <button class="btn-primary" bindtap="chooseAndSend">从微信聊天选文件</button>
      </view>

      <!-- 从我的文档选：要登录。去登录再回来，这一单的令牌还在页面内存里 -->
      <view class="state-card doc-card">
        <view class="sc-title">从我的文档选</view>
        <view wx:if="{{docNote}}" class="sc-desc">{{docNote}}</view>
        <view wx:if="{{docState === 'login' && !docNote}}" class="sc-desc">登录后可以直接选「我的文档」里已有的文件，不用再从手机传一遍。</view>
        <button wx:if="{{docState === 'login'}}" class="btn-secondary" bindtap="goLogin">登录后从我的文档选</button>
        <view wx:elif="{{docState === 'loading'}}" class="sc-desc">正在读取我的文档…</view>
        <button wx:elif="{{docState === 'error'}}" class="btn-secondary" bindtap="reloadDocs">重新读取</button>
        <view wx:elif="{{docState === 'empty'}}" class="sc-desc">我的文档里还没有能传的文件</view>
        <view wx:elif="{{docState === 'list'}}" class="sent-list doc-list">
          <view wx:for="{{docs}}" wx:key="id" class="sent-item doc-item tap" hover-class="{{item.tooLarge ? 'none' : 'tap-press'}}" data-id="{{item.id}}" bindtap="pickDoc" aria-role="button" aria-disabled="{{item.tooLarge}}">
            <view>{{item.name}}</view>
            <view class="doc-meta">{{item.meta}}</view>
            <view wx:if="{{item.tooLarge}}" class="doc-meta">超过 10MB，这一单收不了</view>
          </view>
        </view>
        <view wx:if="{{docState === 'list' && docTruncated}}" class="sc-desc">这里只列了最近 50 份文件。</view>
      </view>
    </block>

    <!-- 兑换扫码凭据中（微信扫码直接进来的那几条入口）-->
    <block wx:elif="{{phase === 'resolving'}}">
      <view class="state-card">
        <view class="sc-title">正在连接终端…</view>
        <view class="sc-desc">正在核对二维码</view>
      </view>
    </block>

    <!-- 传输中 -->
    <block wx:elif="{{phase === 'uploading'}}">
      <view class="state-card">
        <view class="sc-title">正在传给终端…</view>
        <view class="sc-desc">请不要关闭小程序</view>
      </view>
    </block>

    <!-- 完成：一张码只收一份，回到一体机继续，不再发送。说法与一体机同一句 -->
    <block wx:elif="{{phase === 'done'}}">
      <view class="state-card">
        <text class="sc-icon ficon i-check"></text>
        <view class="sc-title sent-title">已传给这台一体机：《{{sent[0].name}}》</view>
        <view class="sc-desc">请回到一体机屏幕确认后继续。</view>
        <button class="btn-secondary" bindtap="goBack">回一体机继续</button>
      </view>
    </block>

    <!-- 结果未知：可能已经到达，不能说已收到，也不能再传一次 -->
    <block wx:elif="{{phase === 'unknown'}}">
      <view class="state-card">
        <view class="sc-title">结果还不确定</view>
        <view class="sc-desc">{{errorMsg}}</view>
        <button class="btn-secondary" bindtap="goBack">回一体机核对</button>
      </view>
    </block>

    <!-- 失败：服务端明确拒收（可以重选）、或兑换没回应（可以再兑换）才给重试；码失效不给 -->
    <block wx:elif="{{phase === 'error'}}">
      <view class="state-card">
        <view class="sc-title">没能传过去</view>
        <view class="sc-desc">{{errorMsg}}</view>
        <button wx:if="{{canRetry || resolveRetry}}" class="btn-primary" bindtap="retry">重试</button>
      </view>
    </block>

  </view>
</view>
