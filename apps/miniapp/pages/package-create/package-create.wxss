page { height: 100%; overflow: hidden; background: var(--paper); }
.package-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); }
.package-scroll { flex: 1; min-height: 0; }
.package-body { padding: 0 32rpx 40rpx; }

/* 文件列表 */
.file-list { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 20rpx; }
.file-item {
  min-height: 116rpx;
  padding: 20rpx 22rpx;
  border-radius: 26rpx;
  border: 1rpx solid var(--line-soft);
  background: #fff;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.file-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--teal-soft);
  color: var(--teal);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.file-icon .ficon { width: 31rpx; height: 31rpx; }
.file-info { flex: 1; min-width: 0; }
.file-name {
  font-size: 27rpx;
  font-weight: 650;
  display: block;
}
.file-size {
  margin-top: 5rpx;
  font-size: 21rpx;
  color: var(--muted);
  display: block;
}
.file-remove {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--surface-2);
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
}
.file-remove .ficon { width: 24rpx; height: 24rpx; }

.add-file-btn {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.add-file-btn .ficon { width: 26rpx; height: 26rpx; }

/* 打印参数 */
.param-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
}
.param-label {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.counter {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.counter-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--surface-2);
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}
.counter-val {
  min-width: 48rpx;
  text-align: center;
  font-size: 29rpx;
  font-weight: 650;
  color: var(--ink);
}

/* 价格卡片 */
.price-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  border: 1rpx solid var(--line-soft);
  background: #fff;
}
.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
}
.price-row + .price-row { margin-top: 8rpx; }
.price-row.total {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-faint);
}
.price-label {
  font-size: 25rpx;
  color: var(--muted);
}
.price-row.total .price-label {
  font-size: 27rpx;
  font-weight: 650;
  color: var(--ink);
}
.price-val {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
}
.price-val.price {
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--clay);
}
.price-val .sup {
  font-size: 22rpx;
  font-weight: 400;
  margin-right: 2rpx;
}
