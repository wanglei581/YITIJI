page { height: 100%; overflow: hidden; background: var(--paper); }
.package-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); }
.package-scroll { flex: 1; min-height: 0; }
.package-body { padding: 0 32rpx 40rpx; }

/* 文件列表 */
.file-list { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 20rpx; }
.file-item {
  min-height: 116rpx;
  padding: 20rpx 22rpx;
  border-radius: 26rpx;
  border: 1rpx solid var(--line-soft);
  background: #fff;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.file-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--teal-soft);
  color: var(--teal);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.file-icon .ficon { width: 31rpx; height: 31rpx; }
.file-info { flex: 1; min-width: 0; }
.file-name {
  font-size: 27rpx;
  font-weight: 650;
  display: block;
}
.file-size {
  margin-top: 5rpx;
  font-size: 21rpx;
  color: var(--muted);
  display: block;
}
.file-remove {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--surface-2);
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
}
.file-remove .ficon { width: 24rpx; height: 24rpx; }

.add-file-btn {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.add-file-btn .ficon { width: 26rpx; height: 26rpx; }

/* 打印参数 */
.param-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
}
.param-label {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.counter {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
/* 份数加减键，实测 45x45 低于 48px 可点标准 → 96rpx=48px */
.counter-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  background: var(--surface-2);
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}
.counter-val {
  min-width: 48rpx;
  text-align: center;
  font-size: 29rpx;
  font-weight: 650;
  color: var(--ink);
}

/* 勾选框：整行可点（>=48px），勾选态由服务端 fileId 决定，不存本地副本 */
.file-check {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--r-sm);
  border: 1rpx solid var(--line-soft);
  background: var(--surface-2);
  color: var(--teal);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.file-check .ficon { width: 26rpx; height: 26rpx; }
.file-item.on { border-color: var(--teal); background: var(--teal-soft); }
.file-item.on .file-check { background: var(--teal); color: #fff; border-color: var(--teal); }

/* 六态文本块：loading / empty / error / 未登录 / 检查中 / 待确认都走这一套 */
.state-block { display: flex; flex-direction: column; gap: 14rpx; }
.state-t { font-size: var(--fs-md); font-weight: 650; color: var(--ink); }
.state-d { font-size: var(--fs-base); line-height: 1.6; color: var(--muted); }
.ready-line { display: flex; align-items: center; gap: 10rpx; color: var(--teal); }
.ready-line .ficon { width: 26rpx; height: 26rpx; }
.state-block .btn { min-height: 48px; }
.load-more { min-height: 48px; margin-top: 12rpx; }

/* 隐私检查发现项：按文件分组，文件名必须出现 —— 只说「发现 3 处」用户不知道改哪份 */
.pii-group { margin-top: 12rpx; }
.pii-file { font-size: var(--fs-base); font-weight: 650; color: var(--ink); }
.pii-finding {
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: var(--fs-sm);
  color: var(--ink-soft);
}
.pii-snippet { color: var(--muted); word-break: break-all; }

/* 底部操作栏只显示「已选 N 个文件」，不显示任何本页算出来的金额 */
.actionbar .ab-price .label { font-size: var(--fs-sm); color: var(--muted); }
/* 盖掉 app.wxss 里那套「衬线大号 clay 色」价格样式：这里显示的是文件数，
   套价格样式会被读成金额，而本页刻意不给任何金额。 */
.actionbar .ab-price .val { font-family: inherit; font-size: var(--fs-md); font-weight: 650; color: var(--ink); }
