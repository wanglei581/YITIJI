/* pages/package-create/package-create.wxss  创建材料包（墨翠鎏金白瓷） */
page { height: 100%; overflow: hidden; background: var(--paper); }
.package-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); }
.package-scroll { flex: 1; min-height: 0; }
.package-body { padding: 12rpx 32rpx 40rpx; }

.file-list { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 20rpx; }
.file-item {
  min-height: 116rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--r-lg);
  border: 2rpx solid var(--line-soft);
  background: var(--surface);
  box-shadow: var(--sh-sm);
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.file-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--r-full);
  background: radial-gradient(circle at 30% 28%, #ECF7F3 0%, #D9EEE6 100%);
  color: var(--teal-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.file-icon .ficon { width: 32rpx; height: 32rpx; }
.file-info { flex: 1; min-width: 0; }
.file-name { font-size: var(--fs-base); font-weight: 700; color: var(--ink); display: block; }
.file-size { margin-top: 6rpx; font-size: var(--fs-xs); color: var(--muted); display: block; }
.file-remove {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--r-full);
  background: var(--surface-2);
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
}
.file-remove .ficon { width: 24rpx; height: 24rpx; }

.add-file-btn { margin-top: 10rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.add-file-btn .ficon { width: 26rpx; height: 26rpx; }

.param-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; }
.param-label { font-size: var(--fs-base); font-weight: 650; color: var(--ink); }

.counter { display: flex; align-items: center; gap: 24rpx; }
.counter-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-lg);
  font-weight: 700;
}
.counter-val { min-width: 48rpx; text-align: center; font-size: var(--fs-md); font-weight: 750; color: var(--ink); }

.file-check {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--r-full);
  border: 2rpx solid var(--line);
  background: var(--paper);
  color: var(--teal);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.file-check .ficon { width: 26rpx; height: 26rpx; }
.file-item.on { border-color: var(--teal); background: linear-gradient(180deg, #FFFFFF 0%, #F1F8F5 100%); box-shadow: var(--sh-md); }
.file-item.on .file-check { background: var(--teal-deep); color: var(--gold-bright); border-color: var(--teal-deep); }

.state-block { display: flex; flex-direction: column; gap: 14rpx; }
.state-t { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.state-d { font-size: var(--fs-base); line-height: 1.6; color: var(--muted); }
.ready-line { display: flex; align-items: center; gap: 10rpx; color: var(--teal-deep); font-weight: 650; }
.ready-line .ficon { width: 26rpx; height: 26rpx; }
.state-block .btn { min-height: 48px; }
.load-more { min-height: 48px; margin-top: 12rpx; }

.pii-group { margin-top: 12rpx; }
.pii-file { font-size: var(--fs-base); font-weight: 700; color: var(--ink); }
.pii-finding {
  margin-top: 8rpx;
  padding: 14rpx 18rpx;
  border-radius: var(--r-sm);
  background: var(--paper);
  border: 1rpx solid var(--line-faint);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: var(--fs-sm);
  color: var(--ink-soft);
}
.pii-snippet { color: var(--muted); word-break: break-all; }

.actionbar .ab-price .label { font-size: var(--fs-sm); color: var(--muted); }
.actionbar .ab-price .val { font-family: inherit; font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
