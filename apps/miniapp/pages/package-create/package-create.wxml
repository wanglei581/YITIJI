<view class="page-wrap">
  <view style="height:{{statusBarHeight}}px"></view>

  <view class="navbar col">
    <view class="nav-back icon-action tap" hover-class="tap-press" bindtap="goBack" role="button" aria-label="返回">
      <text class="ficon i-right nav-back-ic"></text>
    </view>
    <text class="nav-title">创建材料包</text>
  </view>

  <scroll-view class="package-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="package-body">
      <!-- 步骤指示 -->
      <view class="steps">
        <view class="st done on">
          <view class="n">1</view>
          <text class="nl">选择文件</text>
        </view>
        <view class="line done"></view>
        <view class="st done">
          <view class="n">2</view>
          <text class="nl">打印设置</text>
        </view>
        <view class="line"></view>
        <view class="st">
          <view class="n">3</view>
          <text class="nl">确认下单</text>
        </view>
      </view>

      <block wx:if="{{!isLoggedIn}}">
        <view class="card flat">
          <view class="card-inner state-block">
            <view class="state-t">请先登录小程序</view>
            <view class="state-d">材料包只能用你本人已保存在服务端的文件，登录后才能读取。</view>
            <view class="btn primary block tap" hover-class="tap-press" bindtap="toLogin" role="button">去登录</view>
          </view>
        </view>
      </block>

      <block wx:else>
        <!-- 文件选择：来源是本人服务端文件，不是本地临时文件 -->
        <view class="section-t">选择材料（可多选）</view>

        <view wx:if="{{docState === 'loading'}}" class="card flat">
          <view class="card-inner state-block">
            <view class="state-t">正在读取我的文件…</view>
          </view>
        </view>

        <view wx:elif="{{docState === 'error'}}" class="card flat">
          <view class="card-inner state-block">
            <view class="state-t">{{docErrorTitle}}</view>
            <view class="state-d">{{docErrorText}}</view>
            <view class="btn ghost block tap" hover-class="tap-press" bindtap="retryDocs" role="button">重新加载</view>
          </view>
        </view>

        <block wx:elif="{{docs.length}}">
          <view class="file-list">
            <view
              class="file-item tap {{item.selected ? 'on' : ''}}"
              wx:for="{{docs}}"
              wx:key="id"
              hover-class="tap-press"
              data-id="{{item.id}}"
              bindtap="toggleDoc"
              role="checkbox"
              aria-checked="{{item.selected}}"
              aria-label="{{item.name}}"
            >
              <view class="file-check">
                <text wx:if="{{item.selected}}" class="ficon i-check"></text>
              </view>
              <view class="file-info">
                <text class="file-name">{{item.name}}</text>
                <text class="file-size">{{item.purposeLabel}}{{item.sizeText ? ' · ' + item.sizeText : ''}}{{item.needsPii ? ' · 需隐私检查' : ''}}</text>
              </view>
            </view>
          </view>
          <view
            wx:if="{{docCursor}}"
            class="btn ghost block tap load-more"
            hover-class="tap-press"
            bindtap="loadMoreDocs"
            role="button"
          >{{docLoadingMore ? '正在加载…' : '加载更多文件'}}</view>
          <!-- 翻页失败只在页脚说一句：已经加载出来的文件（和用户勾好的选择）必须留在屏幕上 -->
          <view class="state-d" wx:if="{{docMoreErrorText}}">
            {{docMoreErrorText}}
            <text class="link tap" hover-class="tap-press" bindtap="retryMoreDocs" role="button">重试</text>
          </view>
        </block>

        <view wx:else class="card flat">
          <view class="card-inner state-block">
            <view class="state-t">还没有可放进材料包的文件</view>
            <view class="state-d">材料包只收本人已保存在服务端的打印文档、简历与求职信。先从微信聊天添加一个文件。</view>
          </view>
        </view>

        <view class="add-file-btn btn ghost block tap" hover-class="tap-press" bindtap="addFile" role="button" aria-label="从微信聊天添加文件">
          <text class="ficon i-upload"></text>
          <text>{{uploading ? '正在上传…' : '从微信聊天添加文件'}}</text>
        </view>

        <!-- 打印参数 -->
        <view class="section-t">打印设置</view>
        <view class="card flat">
          <view class="card-inner">
            <view class="param-row">
              <text class="param-label">彩色/黑白</text>
              <view class="seg">
                <view class="s {{colorMode === 'bw' ? 'on' : ''}}" bindtap="setColorMode" data-mode="bw" role="button" aria-label="黑白打印">黑白</view>
                <view class="s {{colorMode === 'color' ? 'on' : ''}}" bindtap="setColorMode" data-mode="color" role="button" aria-label="彩色打印">彩色</view>
              </view>
            </view>
            <view class="divider"></view>
            <view class="param-row">
              <text class="param-label">单双面</text>
              <view class="seg">
                <view class="s {{duplex === 'single' ? 'on' : ''}}" bindtap="setDuplex" data-mode="single" role="button" aria-label="单面打印">单面</view>
                <view class="s {{duplex === 'double' ? 'on' : ''}}" bindtap="setDuplex" data-mode="double" role="button" aria-label="双面打印">双面</view>
              </view>
            </view>
            <view class="divider"></view>
            <view class="param-row">
              <text class="param-label">份数</text>
              <view class="counter">
                <view class="counter-btn icon-action tap" hover-class="tap-press" bindtap="decreaseCopies" role="button" aria-label="减少份数">
                  <text>-</text>
                </view>
                <text class="counter-val">{{copies}}</text>
                <view class="counter-btn icon-action tap" hover-class="tap-press" bindtap="increaseCopies" role="button" aria-label="增加份数">
                  <text>+</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 打印隐私检查：服务端硬性要求，不做的话下单那一步必被拒 -->
        <view class="section-t">打印隐私检查</view>
        <view class="card flat">
          <view class="card-inner">
            <view wx:if="{{piiPhase === 'scanning'}}" class="state-d">正在检查所选文件中的手机号、证件号等敏感片段…</view>

            <view wx:elif="{{piiPhase === 'error'}}" class="state-block">
              <view class="state-d">{{piiError}}</view>
              <view class="btn ghost block tap" hover-class="tap-press" bindtap="retryPrivacy" role="button">重新检查</view>
            </view>

            <view wx:elif="{{piiPhase === 'review'}}" class="state-block">
              <view class="state-t">发现 {{piiFindingCount}} 处可能的敏感信息</view>
              <view wx:for="{{piiGroups}}" wx:key="taskId" class="pii-group">
                <view class="pii-file">{{item.fileName}}</view>
                <view wx:for="{{item.findings}}" wx:for-item="finding" wx:key="id" class="pii-finding">
                  <text>{{finding.label}}{{finding.pageNumber ? ' · 第' + finding.pageNumber + '页' : ''}}</text>
                  <text class="pii-snippet">{{finding.snippet || '未返回原文片段'}}</text>
                </view>
              </view>
              <view class="state-d">继续表示你确认这些内容属于本次打印文件，并选择原样保留。</view>
              <view class="btn primary block tap" hover-class="tap-press" bindtap="confirmPrivacy" role="button">{{piiSubmitting ? '确认中…' : '确认保留并继续'}}</view>
            </view>

            <view wx:elif="{{piiPhase === 'ready'}}" class="state-d ready-line">
              <text class="ficon i-check"></text>
              <text>隐私检查已完成，可以继续选择服务点</text>
            </view>

            <view wx:else class="state-block">
              <view class="state-d">已选 {{selectedCount}} 个文件。服务端要求材料包内每个文件都先完成打印隐私检查。</view>
              <view class="btn ghost block tap" hover-class="tap-press" bindtap="runPrivacyScan" role="button">开始隐私检查</view>
            </view>
          </view>
        </view>

        <!-- 真实边界：小程序只组包拿码，钱在机器上付 -->
        <view class="compliance-note">{{onsiteNotice}}</view>
        <view class="compliance-note">{{noCancelNotice}}</view>
        <view class="compliance-note">页数与金额全部由服务端按真实文件核定，本页不做任何本地计价。</view>
      </block>

      <view class="spacer-lg"></view>
    </view>
  </scroll-view>

  <!-- 底部操作栏：不展示任何本页算出来的金额 -->
  <view class="actionbar" wx:if="{{isLoggedIn}}">
    <view class="ab-price">
      <view class="label">已选</view>
      <view class="val">{{selectedCount}} 个文件</view>
    </view>
    <view class="btn primary tap" hover-class="tap-press" bindtap="createPackage" role="button" aria-label="选择服务点">选择服务点</view>
  </view>
</view>
