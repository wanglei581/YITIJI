/* pages/daily-report/daily-report.wxss */
.nav-date { font-size: var(--fs-sm); color: var(--muted); }
.empty-slot {
  padding: 60rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.es-t { font-size: var(--fs-md); font-weight: 650; color: var(--ink-soft); }
.es-d { margin-top: 8rpx; font-size: var(--fs-sm); color: var(--muted); line-height: 1.6; }
.empty-slot .btn { margin-top: 28rpx; min-height: 112rpx; }
.mod-title { font-size: var(--fs-md); font-weight: 700; color: var(--ink); line-height: 1.4; }
.mod-sum { margin-top: 8rpx; font-size: var(--fs-base); color: var(--ink-soft); line-height: 1.6; }
.mod-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-faint);
  min-height: 96rpx;
}
.mod-row-body { flex: 1; min-width: 0; }
.mod-row-t { font-size: var(--fs-base); font-weight: 650; color: var(--ink); }
.mod-row-s { margin-top: 4rpx; font-size: var(--fs-sm); color: var(--muted); }
.mod-btn { min-height: 96rpx; min-width: 96rpx; flex-shrink: 0; }
.card-inner .mod-btn.block { margin-top: 16rpx; }
