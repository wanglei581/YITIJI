/* pages/ai-records/ai-records.wxss */
.rec-day {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
  padding: 4rpx 0 16rpx;
}

.rec-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line-faint);
}
.rec-item:last-child { border-bottom: none; }
.rec-main { flex: 1; min-width: 0; display: flex; align-items: center; gap: 20rpx; padding: 8rpx 0; }

.rec-ic {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--r);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.rec-ic.tone-plum  { background: var(--plum-wash);  color: var(--plum-deep); }
.rec-ic.tone-teal  { background: var(--teal-wash);  color: var(--teal-deep); }
.rec-ic.tone-wheat { background: var(--wheat-wash); color: var(--wheat-deep); }

.rec-body { flex: 1; min-width: 0; }
.rec-t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}
.rec-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-action { flex-shrink: 0; color: var(--muted); font-size: 23rpx; }
.rec-action.ready { color: var(--teal-deep); font-weight: 600; }
.rec-more { flex-shrink: 0; padding: 22rpx 8rpx 22rpx 16rpx; color: var(--muted); font-size: 24rpx; letter-spacing: 2rpx; }

.empty-slot {
  padding: 60rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.empty-slot.compact { padding: 38rpx 20rpx; }
.es-ic { font-size: 88rpx; color: var(--faint); margin-bottom: 20rpx; }
.es-t { font-size: 30rpx; font-weight: 600; color: var(--ink-soft); }
.es-d { margin-top: 8rpx; font-size: 24rpx; color: var(--muted); }
