<!--pages/ai-records/ai-records.wxml-->
<view class="page-wrap">

  <view class="navbar col">
    <view style="height:{{statusBarHeight}}px"></view>
    <view class="nav-inner">
      <view class="nav-back tap" hover-class="tap-press" bindtap="back">
        <text class="ficon i-right nav-back-ic"></text>
      </view>
      <view class="nav-title">AI 服务记录</view>
      <view class="nav-right"></view>
    </view>
  </view>

  <view class="content">

    <view class="filter-bar">
      <view
        class="f-chip {{activeFilter === item.key ? 'on' : ''}}"
        wx:for="{{filters}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="setFilter"
      >{{item.label}}</view>
    </view>

    <!-- 未登录提示 -->
    <view class="card" wx:if="{{loginRequired}}">
      <view class="empty-slot">
        <text class="ficon i-robot es-ic"></text>
        <view class="es-t">请先登录</view>
        <view class="es-d">登录后可查看 AI 服务历史记录</view>
        <view class="btn teal" style="margin-top:32rpx" bindtap="goLogin">去登录</view>
      </view>
    </view>

    <block wx:elif="{{groups.length}}">
      <view class="card" wx:for="{{groups}}" wx:key="day" wx:for-item="g">
        <view class="rec-day">{{g.day}}</view>
        <view
          class="rec-item tap"
          wx:for="{{g.items}}"
          wx:key="id"
          wx:for-item="rec"
          hover-class="tap-press"
          data-id="{{rec.id}}"
          bindtap="openRecord"
        >
          <view class="rec-ic tone-{{rec.tone}}"><text class="ficon {{rec.icon}}"></text></view>
          <view class="rec-body">
            <view class="rec-t">{{rec.title}}</view>
            <view class="rec-sub">{{rec.sub}}</view>
          </view>
          <view class="rec-r">
            <view class="rec-score" wx:if="{{rec.score}}">{{rec.score}}</view>
            <view class="chip teal">信息</view>
          </view>
        </view>
      </view>
    </block>

    <view class="card" wx:else>
      <view class="empty-slot">
        <text class="ficon i-robot es-ic"></text>
        <view class="es-t">暂无 AI 服务记录</view>
        <view class="es-d">使用简历诊断、优化、模拟面试后可在此回看</view>
      </view>
    </view>

    <view class="compliance-note">
      AI 服务记录仅保存在你的账户中,所有 AI 结果均为参考,不代表任何招聘方评价。
    </view>

  </view>

</view>
