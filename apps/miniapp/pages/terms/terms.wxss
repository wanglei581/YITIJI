/* 服务协议页 */
.legal-wrap {
  min-height: 100vh;
  background: #f4f1e8;
  box-sizing: border-box;
}
.legal-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}
.legal-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}
.legal-back-ic {
  width: 36rpx;
  height: 36rpx;
  color: #274b43;
  transform: rotate(180deg);
}
.legal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #10302b;
}
.legal-body {
  height: calc(100vh - 88rpx);
}
.legal-card {
  margin: 16rpx 32rpx 48rpx;
  padding: 40rpx;
  background: #fffdf8;
  border: 1rpx solid #e2dccb;
  border-radius: 24rpx;
}
.legal-h {
  display: block;
  margin-top: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #274b43;
}
.legal-h:first-child {
  margin-top: 0;
}
.legal-p {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #5d6b63;
}
