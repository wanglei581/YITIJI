/* ============================================================
   职易达微信小程序 · Commercial UI v3
   视觉基准：UINotes 成熟效率类 App 的冷白、轻量、强层级体系
   ============================================================ */

/* ── Design Tokens ──────────────────────────────────────────── */
page {
  /* iOS 异形屏底部安全区(Android/传统屏优雅降级为 0) */
  --sab:          env(safe-area-inset-bottom);
  /* 基础色板 */
  --paper:        #f5f7fa;
  --paper-deep:   #eef2f7;
  --surface:      #ffffff;
  --surface-2:    #f7f9fc;
  --surface-3:    #edf2f8;

  /* 文字色阶 */
  --ink:          #131a2a;
  --ink-soft:     #344054;
  --muted:        #5A6478;  /* 4.5:1 达标，正文次要信息 */
  /* --faint 原 #98a2b3 在 --paper 上仅约 2.4:1，低于 WCAG 4.5:1；
     GB/T 47797-2026《政务服务平台适老化服务建设指南》2026-11-01 实施后，
     文本对比度是投标评分项。加深到达标值，仍保留层级差。 */
  --faint:        #6E7A90;
  --ghost:        #AEB8C8;  /* 仅用于禁用态与装饰，不承载正文 */
  /* 蓝色作为正文/链接文字时对比不足（#1677ff 约 3.8:1），
     文字场景一律用 --link，图标与填充仍可用 --teal。 */
  --link:         #0B5ED7;

  /* 分割线 */
  --line:         #dfe6ef;
  --line-soft:    #e9eef5;
  --line-faint:   #f1f4f8;

  /* 主品牌 · 靛蓝。
     原 #1677ff 是 Ant Design 默认蓝，满街都是，是「模板感」的直接来源之一。
     加深并偏靛后：① 一眼脱离默认感；② 更贴政务/院校采购场景的稳重语义；
     ③ 在 --paper 上对比度达标，正文与链接可直接使用，不必再走兜底色。
     不改用青绿：BOSS 直聘即青绿，换过去是撞车不是差异化。
     真正的识别特征交给功能色系统（金刚区四色），主色只负责稳。 */
  --teal:         #2354E6;
  --teal-deep:    #1A3FB8;
  --teal-mid:     #4B79F0;
  --teal-soft:    #E7EDFD;
  --teal-wash:    #F3F6FE;

  /* 价格橙褐 · clay */
  --clay:         #f06a3c;
  --clay-deep:    #d34d24;
  --clay-soft:    #ffebe3;
  --clay-wash:    #fff7f3;

  /* 招聘暖金 · wheat */
  --wheat:        #e99b18;
  --wheat-deep:   #b96d08;
  --wheat-soft:   #fff1d6;
  --wheat-wash:   #fff9ed;

  /* AI 紫调 · plum */
  --plum:         #6c5ce7;
  --plum-deep:    #5142c7;
  --plum-mid:     #8475f5;
  --plum-soft:    #ece9ff;
  --plum-wash:    #f7f5ff;

  /* 信息蓝 · slate */
  --slate:        #3e6fe5;
  --slate-deep:   #2857c6;
  --slate-soft:   #e8efff;
  --slate-wash:   #f4f7ff;

  /* 功能色 */
  --ok:           #12a879;
  --ok-soft:      #e4f7f0;
  --warn:         #d88b0d;
  --warn-soft:    #fff2d9;
  --error:        #e5484d;
  --error-soft:   #ffeaeb;

  /* 圆角 */
  --r-xs:   6px;
  --r-sm:   9px;
  --r:      12px;
  --r-md:   16px;
  --r-lg:   20px;
  --r-xl:   24px;
  --r-full: 999px;

  /* 阴影 */
  --sh-xs:  0 1px 3px rgba(28, 45, 72, .035);
  --sh-sm:  0 4px 14px rgba(28, 45, 72, .055);
  --sh:     0 8px 24px rgba(28, 45, 72, .07);
  --sh-md:  0 12px 34px rgba(28, 45, 72, .09);
  --sh-lg:  0 18px 52px rgba(28, 45, 72, .11);

  /* 字体（小程序无法加载 web 字体，回退系统字体） */
  --font-serif: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  --font-sans:  -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  --font-mono:  'SF Mono', Consolas, monospace;

  /* ── 字阶 ───────────────────────────────────────────────────────
     页面层用 rpx（页面 wxss 里 rpx:px ≈ 3821:300），app.wxss 自己用 px，
     这个分工是有意的：共享组件保持固定物理尺寸，页面内容随屏宽缩放。
     所以字阶定在 rpx，供页面 wxss 使用。

     定这套阶之前实测过：全部页面 wxss 里 20–34rpx 之间用了 14 个不同值，
     21 / 23 / 25 / 27 都在大量出现。那不是字阶，是噪音——每页各自挑了个
     差不多的数。单看没人察觉，累积起来就是"哪儿都对不齐"。

     取值从实际高频值收敛而来，比例约 1.15–1.2：
       22(96次) 24(80) 26(79) 28(74) 23(71) 21(60) 27(55) 25(42) 30(41) 32(32)

     存量页面不做盲目迁移——我无法视觉验证，批量改字号是拿观感赌。
     新增与改动的页面用令牌，另有棘轮门禁盯着偏离值不再增长。 */
  --fs-xs:    20rpx;   /* 10px  角标、时间戳 */
  --fs-sm:    22rpx;   /* 11px  次要说明、meta 行 */
  --fs-base:  26rpx;   /* 13px  正文 */
  --fs-md:    30rpx;   /* 15px  强调正文、列表主标题 */
  --fs-lg:    34rpx;   /* 17px  卡片与分区标题 */
  --fs-xl:    40rpx;   /* 20px  页面标题 */
  --fs-2xl:   52rpx;   /* 26px  数字、大标 */

  background: var(--paper);
  font-family: var(--font-sans);
  color: var(--ink);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, image, button { box-sizing: border-box; }

/* ── 一级交互可访问性基线 ─────────────────────────────────────── */
.icon-action {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.text-action {
  min-height: 72rpx;
  padding: 0 8rpx;
  display: inline-flex;
  align-items: center;
}

/* ── 自定义导航栏 ───────────────────────────────────────────── */
.navbar {
  height: 48px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  position: relative;
  background: var(--paper);
}
.navbar .nav-back {
  width: 32px; height: 32px;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; color: var(--ink);
}
/* 返回箭头：复用 i-right（右向 chevron）翻转为左向 */
.navbar .nav-back .nav-back-ic { transform: rotate(180deg); }
.navbar .nav-title {
  position: absolute; left: 50%; transform: translateX(-50%);
  font-size: 16px; font-weight: 650; color: var(--ink);
  font-family: var(--font-sans);
  letter-spacing: 0;
  white-space: nowrap;
}
.navbar .nav-title.left { position: static; transform: none; font-size: 20px; font-weight: 750; }
.navbar .nav-caps {
  font-size: 11px; color: var(--muted);
  background: var(--surface-2);
  padding: 3px 8px; border-radius: var(--r-full);
  border: 1px solid var(--line-soft);
}
.navbar .nav-right { display: flex; align-items: center; gap: 8px; }
.navbar.light .nav-title,
.navbar.light .nav-back { color: #fff; }

/* 列式 navbar：statusBar 占位条嵌在 navbar 内部时，需纵向堆叠 */
.navbar.col { flex-direction: column; height: auto; padding: 0; }
.nav-inner {
  height: 46px; width: 100%;
  padding: 0 16px;
  display: flex; align-items: center; justify-content: space-between;
  flex-shrink: 0; position: relative;
}
/* nav-center 与 nav-title 同用：nav-title 已 absolute 居中，此处仅作语义占位 */
.nav-center { }

/* ── 页面根容器（全局兜底：铺满视口 + 纸底） ──────────────────── */
.page-wrap { min-height: 100vh; background: var(--paper); }

/* ── 可滚动内容区 ────────────────────────────────────────────── */
.content {
  flex: 1;
  padding-bottom: 24px;
}
.content.has-tabbar { padding-bottom: calc(88px + var(--sab)); }
.content.has-bar { padding-bottom: calc(80px + var(--sab)); }

/* ── 底部 TabBar（页面内展示态；实际导航用 custom-tab-bar 组件） ── */
.tabbar {
  /* min-height + border-box:安全区靠 padding 叠加撑高,不压扁图标文字 */
  min-height: 66px;
  padding: 8px 6px calc(10px + var(--sab));
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  /* 浮起纸片:顶圆角 + 向上柔光,取代生硬的一条上边线 */
  background: var(--surface);
  border-top: 1px solid var(--line-faint);
  border-radius: 0;
  box-shadow: 0 -4px 18px rgba(28, 45, 72, .04);
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 100;
}
.tabbar .tab {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; gap: 4px;
  min-height: 48px;
  padding-top: 2px;
}
/* 图标药丸:选中态用青底托住图标,非选中透明,布局不抖 */
.tabbar .tab .tb {
  display: flex; align-items: center; justify-content: center;
  width: 42px; height: 28px; border-radius: 10px;
  background: transparent;
  transition: background-color .22s ease, transform .22s ease;
}
.tabbar .tab .ti { font-size: 23px; line-height: 1; color: var(--faint); transition: color .22s ease; }
.tabbar .tab .tl { font-size: 11px; color: var(--muted); letter-spacing: .2px; transition: color .22s ease; }
.tabbar .tab.on .tb { background: var(--teal-soft); transform: none; }
.tabbar .tab.on .ti { color: var(--teal-deep); }
.tabbar .tab.on .tl { color: var(--teal-deep); font-weight: 600; }
.tabbar .tab:active .tb { transform: scale(.92); }

/* ── 底部操作条 ──────────────────────────────────────────────── */
.actionbar {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 10px 16px calc(14px + var(--sab));
  background: var(--surface);
  border-top: 1px solid var(--line-soft);
  display: flex; align-items: center; gap: 12px;
  z-index: 100;
}
.actionbar .ab-price { flex: 1; }
.actionbar .ab-price .label { font-size: 11px; color: var(--muted); }
.actionbar .ab-price .val { font-family: var(--font-serif); font-size: 22px; font-weight: 700; color: var(--clay); }
.actionbar .ab-price .val sup { font-size: 13px; font-weight: 400; margin-right: 1px; }

/* ── 卡片 ────────────────────────────────────────────────────── */
.card {
  background: var(--surface);
  border-radius: var(--r-md);
  border: 1px solid var(--line-soft);
  box-shadow: var(--sh-xs);
  margin: 0 16px 12px;
  overflow: hidden;
}
.card.flat { box-shadow: none; border: 1px solid var(--line-soft); }
.card.wash { background: var(--teal-wash); }
.card.plum-wash { background: var(--plum-wash); }
.card.wheat-wash { background: var(--wheat-wash); }
.card.clay-wash { background: var(--clay-wash); }
.card-inner { padding: 16px; }
.card-inner.lg { padding: 20px; }
.card-inner.sm { padding: 12px 14px; }
.card-sep { height: 1px; background: var(--line-faint); margin: 0 16px; }

.section-t {
  padding: 22px 16px 10px;
  font-size: 16px; font-weight: 700;
  color: var(--ink);
  letter-spacing: 0;
  text-transform: none;
}
.card-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 16px 10px;
  border-bottom: 1px solid var(--line-faint);
}
.card-head .ch-title { font-family: var(--font-serif); font-size: 15px; font-weight: 600; color: var(--ink); letter-spacing: .3px; }
.card-head .ch-more { font-size: 12px; color: var(--teal); }

/* ── 按钮 ────────────────────────────────────────────────────── */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  height: 52px; padding: 0 24px;
  border-radius: 14px;
  font-size: 15px; font-weight: 600;
  font-family: var(--font-sans);
  border: none;
  letter-spacing: .2px;
  white-space: nowrap;
  line-height: 1;
}
.btn::after { border: none; }
.btn.primary  { background: var(--teal); color: #fff; box-shadow: 0 8px 18px rgba(35, 84, 230, .22); }
.btn.dark     { background: var(--ink); color: #fff; }
.btn.clay     { background: var(--clay); color: #fff; }
.btn.plum     { background: var(--plum); color: #fff; }
.btn.ghost    { background: transparent; color: var(--teal); border: 1.5px solid var(--teal); }
.btn.ghost-ink { background: transparent; color: var(--ink); border: 1.5px solid var(--line); }
.btn.wx       { background: #07c160; color: #fff; }
.btn.sm  { height: 40px; padding: 0 16px; font-size: 13px; }
.btn.lg  { height: 60px; padding: 0 32px; font-size: 16px; }
.btn.block { width: 100%; }
.btn.icon-only { width: 52px; padding: 0; }
.btn.disabled, .btn[disabled] { opacity: .4; }

/* ── 磁贴 ────────────────────────────────────────────────────── */
.tiles {
  display: grid; grid-template-columns: repeat(2, 1fr);
  gap: 10px; padding: 0 16px 4px;
}
.tiles.c3 { grid-template-columns: repeat(3, 1fr); }
.tiles.c4 { grid-template-columns: repeat(4, 1fr); }

.tile {
  background: var(--surface);
  border-radius: var(--r-md);
  padding: 16px 14px 14px;
  border: 1px solid var(--line-soft);
  box-shadow: none;
  display: flex; flex-direction: column; gap: 8px;
}
.tile .t-ic {
  width: 44px; height: 44px;
  border-radius: 13px;
  display: flex; align-items: center; justify-content: center;
  font-size: 22px;
}
.tile .t-title { font-size: 14px; font-weight: 600; color: var(--ink); }
.tile .t-desc  { font-size: 12px; color: var(--muted); line-height: 1.4; }
.tiles.c3 .tile { padding: 12px 10px; gap: 6px; }
.tiles.c3 .tile .t-ic { width: 36px; height: 36px; border-radius: 10px; font-size: 18px; }
.tiles.c3 .tile .t-title { font-size: 12px; }

/* 磁贴颜色：浅色 wash 底 + 同色描边 + 深色图标（去饱和"糖果块"感） */
.a-teal   { background: var(--teal-wash);  color: var(--teal-deep);  border: 1px solid rgba(35,84,230,.16); }
/* ai 页「发起打印」用到 a-cyan；此前只有 me.wxss 的页面级 .tone-cyan，管不到这里 */
.a-cyan   { background: #E0F7F3;            color: #0F766E;           border: 1px solid rgba(15,118,110,.16); }
.a-clay   { background: var(--clay-wash);  color: var(--clay-deep);  border: 1px solid rgba(211,77,36,.18); }
.a-wheat  { background: var(--wheat-wash); color: var(--wheat-deep); border: 1px solid rgba(226,150,12,.20); }
.a-plum   { background: var(--plum-wash);  color: var(--plum-deep);  border: 1px solid rgba(124,58,237,.16); }
.a-slate  { background: var(--slate-wash); color: var(--slate-deep); border: 1px solid rgba(74,91,120,.16); }
.a-ink    { background: var(--surface-3);  color: var(--ink-soft);   border: 1px solid var(--line); }

/* ── 列表行 ─────────────────────────────────────────────────── */
.row-item {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 16px;
}
.row-item + .row-item { border-top: 1px solid var(--line-faint); }
.row-item .ic {
  width: 40px; height: 40px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; flex-shrink: 0;
  background: var(--teal-soft); color: var(--teal);
}
.row-item .rc { flex: 1; min-width: 0; }
.row-item .rc .rt { font-size: 15px; font-weight: 500; color: var(--ink); }
.row-item .rc .rs { font-size: 12px; color: var(--muted); margin-top: 2px; }
.row-item .r-arrow { color: var(--ghost); font-size: 16px; flex-shrink: 0; }
.row-item .r-right { flex-shrink: 0; display: flex; align-items: center; gap: 6px; }

/* ── 筛选条 / chip / badge ──────────────────────────────────── */
.filter-bar {
  display: flex; gap: 8px; padding: 10px 16px;
  white-space: nowrap;
}

.f-chip {
  display: inline-flex; align-items: center;
  height: 32px; padding: 0 14px;
  border-radius: var(--r-full);
  font-size: 13px; color: var(--muted);
  background: var(--surface); border: 1px solid var(--line);
  white-space: nowrap; flex-shrink: 0;
}
.f-chip.on { background: var(--ink); color: #fff; border-color: var(--ink); }
.f-chip.teal { background: var(--teal-soft); color: var(--teal-deep); border-color: transparent; }

.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip {
  display: inline-flex; align-items: center;
  height: 24px; padding: 0 10px;
  border-radius: var(--r-full);
  font-size: 11.5px; font-weight: 500;
  background: var(--surface-2); color: var(--muted);
  border: 1px solid var(--line-soft);
}
.chip.ok    { background: var(--ok-soft); color: var(--ok); border-color: transparent; }
.chip.warn  { background: var(--warn-soft); color: var(--warn); border-color: transparent; }
.chip.err   { background: var(--error-soft); color: var(--error); border-color: transparent; }
.chip.teal  { background: var(--teal-soft); color: var(--teal-deep); border-color: transparent; }
.chip.plum  { background: var(--plum-soft); color: var(--plum-deep); border-color: transparent; }
.chip.clay  { background: var(--clay-soft); color: var(--clay-deep); border-color: transparent; }
.chip.wheat { background: var(--wheat-soft); color: var(--wheat-deep); border-color: transparent; }
.chip.ink   { background: var(--ink); color: #fff; border-color: transparent; }

.badge {
  display: inline-flex; align-items: center;
  height: 20px; padding: 0 7px;
  border-radius: 4px;
  font-size: 10.5px; font-weight: 600;
  background: var(--surface-2); color: var(--muted);
}
.badge.warn  { background: var(--warn-soft); color: var(--warn); }
.badge.err   { background: var(--error-soft); color: var(--error); }
.badge.teal  { background: var(--teal-soft); color: var(--teal-deep); }
.badge.mute  { background: var(--surface-3); color: var(--faint); }

/* ── 分段控件 ────────────────────────────────────────────────── */
.seg {
  display: flex; background: var(--surface-2);
  border-radius: 12px;
  padding: 3px; margin: 0 16px;
  border: 1px solid var(--line-soft);
}
.seg .s {
  flex: 1; height: 34px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 9px;
  font-size: 13px; font-weight: 500; color: var(--muted);
}
.seg .s.on {
  background: var(--surface);
  color: var(--ink); font-weight: 600;
  box-shadow: var(--sh-xs);
}

/* ── 步骤指示 ───────────────────────────────────────────────── */
.steps {
  display: flex; align-items: center;
  padding: 12px 20px;
  gap: 0;
}
.steps .line { flex: 1; height: 1.5px; background: var(--line-soft); }
.steps .line.done { background: var(--teal-soft); }
.steps .st {
  display: flex; flex-direction: column; align-items: center; gap: 4px;
  position: relative; z-index: 1;
}
.steps .st .n {
  width: 28px; height: 28px;
  border-radius: var(--r-full);
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 700;
  background: var(--surface-2); color: var(--faint);
  border: 1.5px solid var(--line);
}
.steps .st .nl { font-size: 10px; color: var(--faint); white-space: nowrap; }
.steps .st.done .n { background: var(--teal-soft); color: var(--teal); border-color: var(--teal-soft); }
.steps .st.done .nl { color: var(--teal); }
.steps .st.on .n { background: var(--teal); color: #fff; border-color: var(--teal); box-shadow: 0 0 0 3px var(--teal-soft); }
.steps .st.on .nl { color: var(--teal); font-weight: 600; }

/* ── 进度条 / Meter ─────────────────────────────────────────── */
.progress { height: 8px; background: var(--surface-2); border-radius: var(--r-full); overflow: hidden; }
.progress i { display: block; height: 100%; background: var(--teal); border-radius: var(--r-full); }

.meter { height: 6px; background: var(--line-soft); border-radius: var(--r-full); overflow: hidden; }
.meter i { display: block; height: 100%; border-radius: var(--r-full); background: var(--teal); }
.meter i.clay  { background: var(--clay); }
.meter i.wheat { background: var(--wheat); }
.meter i.plum  { background: var(--plum); }
.meter i.slate { background: var(--slate); }

/* ── 评分环 (score-ring) ────────────────────────────────────── */
.score-ring {
  width: 100px; height: 100px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  position: relative;
  flex-shrink: 0;
}
.score-ring .sr-inner {
  width: 72px; height: 72px;
  background: var(--surface);
  border-radius: 50%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  position: relative; z-index: 1;
}
.score-ring .sr-val {
  font-family: var(--font-serif);
  font-size: 26px; font-weight: 700; color: var(--ink);
  line-height: 1;
}
.score-ring .sr-label { font-size: 10px; color: var(--muted); margin-top: 2px; }

/* ── 提示条 notice ───────────────────────────────────────────── */
.notice {
  display: flex; align-items: flex-start; gap: 8px;
  padding: 10px 14px;
  border-radius: var(--r-sm);
  background: var(--teal-wash);
  margin: 0 16px 10px;
  font-size: 13px; color: var(--ink-soft); line-height: 1.5;
}
.notice .n-ic { font-size: 15px; flex-shrink: 0; margin-top: 1px; }
.notice.warn  { background: var(--warn-soft); color: var(--wheat-deep); }
.notice.err   { background: var(--error-soft); color: var(--error); }
.notice.info  { background: var(--slate-wash); color: var(--slate-deep); }
.notice.plum  { background: var(--plum-wash); color: var(--plum-deep); }

/* ── 表单字段 field ──────────────────────────────────────────── */
.field { display: flex; flex-direction: column; gap: 6px; }
.field .fl { font-size: 12px; font-weight: 600; color: var(--muted); letter-spacing: .3px; }
.field .inp {
  height: 52px; width: 100%;
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: var(--r);
  padding: 0 14px;
  font-size: 15px; color: var(--ink);
  font-family: var(--font-sans);
  display: flex; align-items: center;
}
.field .inp .ph { color: var(--ghost); }
.field .inp.ta { height: 100px; padding: 12px 14px; align-items: flex-start; }
.field .inp.active { border-color: var(--teal); background: var(--teal-wash); }

/* ── 取件码 ─────────────────────────────────────────────────── */
.pickup-code {
  font-family: var(--font-serif);
  font-size: 42px; font-weight: 700; color: var(--ink);
  letter-spacing: 8px;
}
.pickup-code.big { font-size: 52px; letter-spacing: 12px; }

/* ── 头像 ───────────────────────────────────────────────────── */
.avatar {
  width: 52px; height: 52px; border-radius: 50%;
  background: var(--teal-soft);
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; overflow: hidden; flex-shrink: 0;
}
.avatar.sm  { width: 36px; height: 36px; font-size: 16px; }
.avatar.lg  { width: 64px; height: 64px; font-size: 30px; }
.avatar.xl  { width: 84px; height: 84px; font-size: 38px; }
/* 字号化头像内的线性图标 */
.avatar .ficon { font-size: .5em; color: rgba(255,253,248,.9); }
/* 印章式字号头像（编辑感，替代 emoji 人像） */
.avatar.mono-plum {
  background: var(--plum-wash);
  border: 1px solid rgba(124,58,237,.24);
  color: var(--plum-deep);
  font-weight: 700; letter-spacing: 1px;
}

/* ── 合规声明 ───────────────────────────────────────────────── */
.compliance-note {
  padding: 10px 16px;
  font-size: 10.5px; color: var(--faint);
  line-height: 1.55; text-align: center;
}

/* ── 空态 ───────────────────────────────────────────────────── */
.empty {
  display: flex; flex-direction: column; align-items: center; gap: 10px;
  padding: 48px 24px;
  text-align: center;
}
.empty .e-ic {
  width: 64px; height: 64px; border-radius: 50%;
  background: var(--surface-2);
  display: flex; align-items: center; justify-content: center;
  font-size: 30px;
}
.empty .e-title { font-size: 15px; font-weight: 600; color: var(--ink-soft); }
.empty .e-desc  { font-size: 13px; color: var(--muted); line-height: 1.55; }

/* ── 列表加载/错误态 ─────────────────────────────────────────── */
.list-state {
  padding: 40px 24px; text-align: center;
  font-size: 13px; color: var(--muted);
}
.state-retry {
  margin-top: 6px; padding: 8px 22px; border-radius: 999px;
  background: var(--teal); color: #fff; font-size: 13px; font-weight: 600;
}

/* ── 页头 pagehead ───────────────────────────────────────────── */
.pagehead { padding: 12px 16px 16px; }
.pagehead .ph-title {
  font-family: var(--font-sans); font-size: 24px; font-weight: 750;
  color: var(--ink); line-height: 1.25; letter-spacing: 0;
}
.pagehead .ph-sub { font-size: 13px; color: var(--muted); margin-top: 4px; line-height: 1.5; }

/* ═══ AI 专属组件系统 ═══ */
.ai-card {
  background: var(--plum-wash);
  border-radius: var(--r-md);
  padding: 16px;
  margin: 0 16px 12px;
  border-left: 3px solid var(--plum-soft);
}
.ai-card .ac-head {
  display: flex; align-items: center; gap: 8px; margin-bottom: 10px;
}
.ai-card .ac-head .ac-ic { font-size: 16px; }
.ai-card .ac-head .ac-title { font-size: 13px; font-weight: 600; color: var(--plum); }
.ai-card .ac-head .ac-badge {
  margin-left: auto;
  font-size: 10px; color: var(--plum-deep); background: var(--plum-soft);
  padding: 2px 7px; border-radius: var(--r-full);
}

.ai-status {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 12px; color: var(--plum);
  padding: 5px 10px;
  background: var(--plum-wash);
  border-radius: var(--r-full);
}
.ai-status .dots { display: flex; gap: 3px; }
.ai-status .dots view {
  width: 4px; height: 4px; border-radius: 50%;
  background: var(--plum);
  animation: ai-pulse 1.2s ease-in-out infinite;
}
.ai-status .dots view:nth-child(2) { animation-delay: .2s; }
.ai-status .dots view:nth-child(3) { animation-delay: .4s; }
@keyframes ai-pulse { 0%,60%,100% { opacity: .3; transform: scale(.8); } 30% { opacity: 1; transform: scale(1); } }

.ai-badge {
  display: inline-flex; align-items: center; gap: 3px;
  height: 18px; padding: 0 6px;
  border-radius: 4px;
  font-size: 10px; font-weight: 600;
  background: var(--plum-soft); color: var(--plum-deep);
}
.ai-badge.ref { background: var(--slate-soft); color: var(--slate-deep); }

.evidence-quote {
  border-left: 3px solid var(--plum-soft);
  padding: 8px 12px;
  background: var(--plum-wash);
  border-radius: 0 var(--r-sm) var(--r-sm) 0;
  margin: 8px 0;
}
.evidence-quote .eq-label { font-size: 10px; color: var(--plum); font-weight: 600; margin-bottom: 4px; }
.evidence-quote .eq-text  { font-size: 13px; color: var(--ink-soft); line-height: 1.5; font-style: italic; }

.risk-tier {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 14px;
  border-radius: var(--r);
  font-size: 13px;
}
.risk-tier .rt-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.risk-tier .rt-label { font-weight: 600; flex-shrink: 0; }
.risk-tier .rt-desc { color: var(--muted); font-size: 12px; }
.risk-tier.high { background: var(--teal-wash); }
.risk-tier.high .rt-dot { background: var(--teal); }
.risk-tier.high .rt-label { color: var(--teal-deep); }
.risk-tier.mid  { background: var(--wheat-wash); }
.risk-tier.mid .rt-dot { background: var(--wheat); }
.risk-tier.mid .rt-label { color: var(--wheat-deep); }
.risk-tier.low  { background: var(--clay-wash); }
.risk-tier.low .rt-dot { background: var(--clay); }
.risk-tier.low .rt-label { color: var(--clay-deep); }

.diff-view { display: flex; flex-direction: column; gap: 0; border-radius: var(--r); overflow: hidden; }
.diff-view .dv-before { background: var(--error-soft); padding: 12px 14px; }
.diff-view .dv-after  { background: var(--ok-soft); padding: 12px 14px; }
.diff-view .dv-label { font-size: 10px; font-weight: 700; letter-spacing: .5px; margin-bottom: 6px; }
.diff-view .dv-before .dv-label { color: var(--error); }
.diff-view .dv-after .dv-label  { color: var(--ok); }
.diff-view .dv-text { font-size: 13px; line-height: 1.6; color: var(--ink-soft); }

/* ═══ 业务卡片系统 ═══ */
.job-card {
  background: var(--surface);
  border-radius: var(--r-md);
  padding: 16px;
  margin: 0 16px 10px;
  border: 1px solid var(--line-soft);
  box-shadow: none;
}
.job-card .jc-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
.job-card .jc-title { font-size: 16px; font-weight: 650; color: var(--ink); font-family: var(--font-sans); letter-spacing: 0; }
.job-card .jc-salary { font-family: var(--font-sans); font-size: 16px; font-weight: 700; color: var(--teal); white-space: nowrap; }
.job-card .jc-company { font-size: 13px; color: var(--muted); margin-top: 4px; }
.job-card .jc-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
.job-card .jc-bottom {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 10px; padding-top: 10px;
  border-top: 1px solid var(--line-faint);
  font-size: 11px; color: var(--faint);
}
.job-card .jc-match {
  display: inline-flex; align-items: center; gap: 5px;
  height: 20px; padding: 0 9px; border-radius: var(--r-full);
  font-size: 11px; font-weight: 600;
}
/* 状态圆点：随 high/mid/low 文字色自动着色，替代字符 ◈，字形可控 */
.job-card .jc-match::before {
  content: ''; width: 5px; height: 5px; border-radius: 50%;
  background: currentColor; flex-shrink: 0;
}
.job-card .jc-match.high  { background: var(--teal-soft); color: var(--teal-deep); }
.job-card .jc-match.mid   { background: var(--wheat-soft); color: var(--wheat-deep); }
.job-card .jc-match.low   { background: var(--clay-soft); color: var(--clay-deep); }

.fair-card {
  background: var(--surface);
  border-radius: var(--r-md);
  padding: 16px;
  margin: 0 16px 10px;
  box-shadow: var(--sh-xs);
}
.fair-card .fc-banner {
  height: 80px; border-radius: var(--r);
  background: var(--wheat-wash);
  border: 1px solid var(--wheat-soft);
  margin-bottom: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 32px;
}
.fair-card .fc-title { font-family: var(--font-serif); font-size: 16px; font-weight: 600; color: var(--ink); letter-spacing: .3px; }
.fair-card .fc-meta { font-size: 12px; color: var(--muted); margin-top: 6px; display: flex; gap: 12px; }
.fair-card .fc-status { margin-top: 10px; display: flex; align-items: center; justify-content: space-between; }

.company-card {
  background: var(--surface);
  border-radius: var(--r-md);
  padding: 14px 16px;
  margin: 0 16px 8px;
  box-shadow: var(--sh-xs);
  display: flex; align-items: center; gap: 12px;
}
.company-card .cc-logo {
  width: 48px; height: 48px; border-radius: 12px;
  background: var(--surface-2); border: 1px solid var(--line-soft);
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; flex-shrink: 0;
}
.company-card .cc-info { flex: 1; min-width: 0; }
.company-card .cc-name { font-size: 15px; font-weight: 600; color: var(--ink); }
.company-card .cc-meta { font-size: 12px; color: var(--muted); margin-top: 2px; }
.company-card .cc-tags { display: flex; gap: 4px; margin-top: 6px; flex-wrap: wrap; }

/* ═══ 工具类 ═══ */
.divider { height: 1px; background: var(--line-faint); margin: 4px 0; }
.spacer-sm { height: 8px; }
.spacer { height: 16px; }
.spacer-lg { height: 24px; }
.section-gap { height: 8px; background: var(--paper-deep); }

.serif { font-family: var(--font-sans); }
.muted { color: var(--muted); }
.faint { color: var(--faint); }
.teal  { color: var(--teal); }
.clay  { color: var(--clay); }
.wheat { color: var(--wheat); }
.plum  { color: var(--plum); }
.center { text-align: center; }
.row    { display: flex; align-items: center; }
.between { justify-content: space-between; }
.wrap   { flex-wrap: wrap; }
.gap-4  { gap: 4px; }
.gap-8  { gap: 8px; }
.gap-12 { gap: 12px; }
.price  { font-family: var(--font-serif); font-weight: 700; color: var(--clay); }

.fs10 { font-size: 10px; }
.fs11 { font-size: 11px; }
.fs12 { font-size: 12px; }
.fs13 { font-size: 13px; }
.fs15 { font-size: 15px; }
.fs17 { font-size: 17px; }

.fw5  { font-weight: 500; }
.fw6  { font-weight: 600; }
.fw7  { font-weight: 700; }

.mt2  { margin-top: 2px; }
.mt4  { margin-top: 4px; }
.mt8  { margin-top: 8px; }
.mt12 { margin-top: 12px; }
.mt16 { margin-top: 16px; }
.mb8  { margin-bottom: 8px; }
.mb12 { margin-bottom: 12px; }
.px16 { padding-left: 16px; padding-right: 16px; }
.py8  { padding-top: 8px; padding-bottom: 8px; }

.line-clamp-1 { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

/* ══════════════════════════════════════════════════════════════
   质感层 · 墨青纸感（去 AI 味：无光晕/无彩色辉光/无重毛玻璃/无白高光）
   克制的点按反馈 + 安静的入场；卡片靠纸感描边与极淡墨影分层
   ══════════════════════════════════════════════════════════════ */

/* ── 点按反馈：轻微下沉，不做夸张缩放 ── */
.tap { transition: transform .18s ease, opacity .18s ease, background-color .18s ease; }
.tap-press { transform: scale(.988); opacity: .96; }
.tap-press-strong { transform: scale(.978); opacity: .94; }

/* ── 入场：安静上浮，位移更小、更慢 ── */
@keyframes rise {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fade { from { opacity: 0; } to { opacity: 1; } }
.rise    { animation: rise .44s ease both; }
.rise-d1 { animation: rise .44s ease .05s both; }
.rise-d2 { animation: rise .44s ease .10s both; }
.rise-d3 { animation: rise .44s ease .15s both; }
.rise-d4 { animation: rise .44s ease .20s both; }
.rise-d5 { animation: rise .44s ease .25s both; }
.rise-d6 { animation: rise .44s ease .30s both; }
.fade-in { animation: fade .5s ease both; }

/* ── "glass" 一律降级为纸感实底 + 细描边（保留类名，语义改为半透纸） ──
   深色 hero 上用低透明白纸；浅底上用米纸实底。无 backdrop blur。 */
.glass {
  background: rgba(255,253,248,.12);
  border: 1px solid rgba(255,253,248,.22);
}
.glass-dark {
  background: rgba(16,48,43,.20);
  border: 1px solid rgba(255,253,248,.10);
}
.glass-paper {
  background: var(--surface);
  border: 1px solid var(--line);
}

/* ── 分层：统一极淡的中性墨影，绝不用彩色辉光 ── */
.elev-teal, .elev-plum, .elev-clay, .elev-soft {
  box-shadow: 0 1px 2px rgba(16,48,43,.05), 0 4px 14px rgba(16,48,43,.06);
}

/* ── sheen 保留类名但取消白色高光，改为无操作（去塑料反光感） ── */
.sheen { position: relative; }
.sheen::before { content: none; }


/* ══════════════════════════════════════════════════════════════
   Ant Design Outlined 图标（阿里/Ant Group 开源）· mask 可染色
   .ficon 继承父级 currentColor；父容器 .a-* 决定色相
   ══════════════════════════════════════════════════════════════ */
.ficon {
  display: inline-block;
  width: 1em; height: 1em;
  background-color: currentColor;
  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
  -webkit-mask-position: center; mask-position: center;
  -webkit-mask-size: contain; mask-size: contain;
  vertical-align: -0.12em;
  flex-shrink: 0;
}
