{
  "name": "terminal-agent",
  "version": "0.4.15",
  "private": true,
  "description": "Windows Terminal Agent — Phase 8.1C: DPAPI token encryption / SQLite idempotency / single-instance lock / Windows service / offline PATCH queue",
  "scripts": {
    "agent": "ts-node src/index.ts agent",
    "print": "ts-node src/index.ts print",
    "list-printers": "ts-node src/index.ts list-printers",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "dev": "ts-node src/index.ts",
    "verify:direct-http-agents": "ts-node scripts/verify-direct-http-agents.ts",
    "verify:local-qr-proxy": "ts-node scripts/verify-local-qr-proxy.ts",
    "verify:local-print-wake": "ts-node scripts/verify-local-print-wake.ts",
    "verify:task-runner-wake": "ts-node scripts/verify-task-runner-wake.ts",
    "verify:task-reliability": "ts-node scripts/verify-task-reliability.ts",
    "verify:print-retry-attempt": "ts-node scripts/verify-print-retry-attempt.ts",
    "verify:print-truth-hardening": "ts-node scripts/verify-print-truth-hardening.ts",
    "verify:print-monitor-truth": "ts-node scripts/verify-print-monitor-truth.ts",
    "verify:legacy-residue-cleanup": "ts-node scripts/agent-crash-privacy.helper.ts",
    "verify:print-queue-residue": "ts-node scripts/verify-print-queue-residue.ts",
    "verify:print-queue-residue-windows": "ts-node scripts/verify-print-queue-residue-windows.ts",
    "verify:boot-spool-guard": "node scripts/verify-boot-spool-guard.mjs",
    "verify:boot-spool-guard-windows": "ts-node scripts/verify-boot-spool-guard-windows.ts",
    "verify:image-scale-truth": "ts-node scripts/verify-image-scale-truth.ts",
    "verify:usb-import-agent": "ts-node scripts/verify-usb-import-agent.ts",
    "verify:remote-commands": "ts-node scripts/verify-remote-commands.ts",
    "verify:agent-restart-windows": "ts-node scripts/verify-agent-restart-windows.ts",
    "verify:remote-commands-windows": "ts-node scripts/verify-remote-commands-windows.ts",
    "verify:printer-config": "node scripts/verify-printer-config.mjs",
    "verify:agent-profile-guard": "node scripts/verify-agent-profile-guard.mjs",
    "verify:print-scan-agent": "node scripts/verify-print-scan-agent.mjs",
    "verify:scan-watcher": "ts-node scripts/verify-scan-watcher.ts",
    "verify:scan-deletion-audit": "ts-node scripts/verify-scan-deletion-audit.ts",
    "verify:scan-input-health": "ts-node scripts/verify-scan-input-health.ts && pnpm run verify:scan-input-lockout-telemetry",
    "verify:scan-input-lockout-telemetry": "ts-node scripts/verify-scan-input-lockout-telemetry.ts",
    "verify:network-diagnostics": "ts-node scripts/verify-network-diagnostics.ts",
    "verify:form-data-security": "node scripts/verify-form-data-security.mjs",
    "verify:agent-config-resilience": "node scripts/verify-agent-config-resilience.mjs",
    "verify:windows-service-recovery": "node scripts/verify-windows-service-recovery.mjs",
    "verify:agent-unauthorized": "node scripts/verify-agent-unauthorized.mjs",
    "verify:release-observation-boundary": "node scripts/verify-release-observation-boundary.mjs",
    "verify:production-provisioning": "node scripts/verify-production-provisioning.mjs",
    "verify:installer-inputs": "node installer/verify-installer-inputs.mjs && pnpm run verify:signing-workflow-contract",
    "verify:signing-workflow-contract": "node installer/verify-signing-workflow-contract.mjs",
    "installer:stage": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-staging.ps1",
    "installer:build": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-msi.ps1",
    "installer:build-exe": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-exe.ps1",
    "verify:singleton-process": "node scripts/verify-singleton-process.mjs",
    "verify:field-day-evidence": "node scripts/verify-field-day-evidence.mjs"
  },
  "dependencies": {
    "axios": "1.20.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^4.0.0",
    "commander": "^12.1.0",
    "form-data": "^4.0.6",
    "node-windows": "1.0.0-beta.8",
    "pdf-to-printer": "^5.4.0",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.13.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
