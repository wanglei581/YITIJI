<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>StagingRoot=$(StagingRoot);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Agent.wxs" />
    <Compile Include="$(GeneratedFragment)" Link="GeneratedPayload.wxs" />
  </ItemGroup>
</Project>
