<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="AI Job Print Agent"
    Manufacturer="AI Job Print"
    Version="$(var.ProductVersion)"
    UpgradeCode="8B8F74AC-9B68-44B8-88E7-BEB906221919"
    Scope="perMachine">
    <Property Id="BOUND_AGENT">
      <RegistrySearch Id="BoundAgentSearch" Bitness="always64" Root="HKLM" Key="Software\AIJobPrint\Agent" Name="Bound" Type="raw" />
      <DirectorySearch Id="BoundAgentStateSearch" Path="[CommonAppDataFolder]AIJobPrintAgent">
        <FileSearch Id="BoundAgentTokenSearch" Name="agent.token" />
      </DirectorySearch>
    </Property>
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer AI Job Print Agent is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AIJobPrintAgent">
        <Directory Id="BOOTSTRAPDIR" Name="bootstrap">
          <Component Id="AgentServiceComponent" Guid="4BB83A61-04C6-473E-B528-A20F2D0DE494" Bitness="always64">
            <File Id="AgentServiceExecutable" Source="$(var.StagingRoot)\bootstrap\aijobprintagent.exe" KeyPath="yes" Checksum="yes" />
            <File Id="AgentServiceConfiguration" Source="$(var.StagingRoot)\bootstrap\aijobprintagent.xml" Checksum="yes" />
          </Component>
          <Component Id="UnboundAgentServiceComponent" Guid="D5D6B9A6-7A3B-48C2-9D36-F7E72A6C4CB1" Bitness="always64" Condition="NOT BOUND_AGENT">
            <RegistryValue Root="HKLM" Key="Software\AIJobPrint\Agent" Name="UnboundServiceComponent" Type="integer" Value="1" KeyPath="yes" />
            <ServiceInstall
              Id="UnboundAgentServiceInstall"
              Name="aijobprintagent.exe"
              DisplayName="AIJobPrintAgent"
              Description="AI Job Print Terminal Agent"
              Type="ownProcess"
              Start="demand"
              ErrorControl="normal"
              Account="LocalSystem" />
            <ServiceControl
              Id="UnboundAgentServiceControl"
              Name="aijobprintagent.exe"
              Stop="both"
              Remove="uninstall"
              Wait="yes" />
          </Component>
          <Component Id="BoundAgentServiceComponent" Guid="A6D88C0F-6B5C-47DB-A1DC-B04CB2C0E4BF" Bitness="always64" Condition="BOUND_AGENT">
            <RegistryValue Root="HKLM" Key="Software\AIJobPrint\Agent" Name="BoundServiceComponent" Type="integer" Value="1" KeyPath="yes" />
            <ServiceInstall
              Id="BoundAgentServiceInstall"
              Name="aijobprintagent.exe"
              DisplayName="AIJobPrintAgent"
              Description="AI Job Print Terminal Agent"
              Type="ownProcess"
              Start="auto"
              ErrorControl="normal"
              Account="LocalSystem" />
            <ServiceControl
              Id="BoundAgentServiceControl"
              Name="aijobprintagent.exe"
              Start="install"
              Stop="both"
              Remove="uninstall"
              Wait="yes" />
          </Component>
        </Directory>
        <Directory Id="PROVISIONDIR" Name="provision">
          <Component Id="ProvisioningWizardComponent" Guid="EAE4A871-94BE-4A31-BEA4-7ACFB4FA77E8" Bitness="always64">
            <File Id="ProvisionLauncher" Source="$(var.StagingRoot)\provision\provision-terminal.cmd" Checksum="yes" />
            <File Id="ProvisionWizard" Source="$(var.StagingRoot)\provision\provision-installed-agent.ps1" Checksum="yes" />
            <File Id="ProvisionProductionScript" Source="$(var.StagingRoot)\provision\install-production-agent.ps1" Checksum="yes" />
            <File Id="ProvisionServiceIdentity" Source="$(var.StagingRoot)\provision\service-identity.ps1" Checksum="yes" />
            <File Id="ControlCenterScript" Source="$(var.StagingRoot)\provision\terminal-control-center.ps1" Checksum="yes" />
            <File Id="ControlCenterLauncher" Source="$(var.StagingRoot)\provision\launch-control-center.vbs" KeyPath="yes" Checksum="yes" />
            <Shortcut
              Id="ControlCenterStartMenuShortcut"
              Directory="AgentProgramMenuFolder"
              Name="终端控制中心"
              Description="绑定、配置并维护 AI 求职打印服务终端"
              Target="[#ControlCenterLauncher]"
              WorkingDirectory="PROVISIONDIR" />
            <Shortcut
              Id="ControlCenterDesktopShortcut"
              Directory="DesktopFolder"
              Name="AI 求职打印服务终端"
              Description="打开 AI 求职打印服务终端控制中心"
              Advertise="yes"
              WorkingDirectory="PROVISIONDIR" />
            <RemoveFolder Id="RemoveProvisioningProgramMenuFolder" Directory="AgentProgramMenuFolder" On="uninstall" />
          </Component>
        </Directory>
        <Directory Id="KIOSKDIR" Name="kiosk">
          <!-- Kiosk browser launcher + watchdog. Files only: the logon task is
               registered by the elevated provisioning flow, never by the MSI. -->
          <Component Id="KioskWatchdogComponent" Guid="3C2E5F84-7B1D-4C0A-9E52-6A1F0D9B7E21" Bitness="always64">
            <File Id="KioskWatchdogScript" Source="$(var.StagingRoot)\kiosk\kiosk-watchdog.ps1" KeyPath="yes" Checksum="yes" />
            <File Id="KioskWatchdogRegister" Source="$(var.StagingRoot)\kiosk\register-kiosk-watchdog.ps1" Checksum="yes" />
            <File Id="KioskLauncher" Source="$(var.StagingRoot)\kiosk\launch-kiosk.cmd" Checksum="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AGENTSTATEDIR" Name="AIJobPrintAgent">
        <Component Id="AgentStateDirectoryComponent" Guid="B5AEAB48-0EB6-496C-909E-B1F9E04EDE53" Permanent="yes" NeverOverwrite="yes" Bitness="always64">
          <CreateFolder />
          <RegistryValue Root="HKLM" Key="Software\AIJobPrint\Agent" Name="StateDirectoryCreated" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
      <Directory Id="CommonMicrosoftFolder" Name="Microsoft">
        <Directory Id="CommonWindowsFolder" Name="Windows">
          <Directory Id="CommonStartMenuFolder" Name="Start Menu">
            <Directory Id="CommonStartMenuProgramsFolder" Name="Programs">
              <Directory Id="AgentProgramMenuFolder" Name="AI Job Print Terminal">
                <Component Id="AgentPanelShortcutComponent" Guid="E565227D-70C5-4C17-A63E-2322DA18C0E4" Bitness="always64">
                  <File Id="AgentPanelInternetShortcut" Source="$(var.InstallerSourceRoot)\assets\AI Job Print Terminal.url" KeyPath="yes" />
                  <RemoveFolder Id="RemoveAgentProgramMenuFolder" On="uninstall" />
                </Component>
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="AI Job Print Agent" Level="1">
      <ComponentRef Id="AgentServiceComponent" />
      <ComponentRef Id="UnboundAgentServiceComponent" />
      <ComponentRef Id="BoundAgentServiceComponent" />
      <ComponentRef Id="AgentStateDirectoryComponent" />
      <ComponentRef Id="AgentPanelShortcutComponent" />
      <ComponentRef Id="ProvisioningWizardComponent" />
      <ComponentRef Id="KioskWatchdogComponent" />
      <ComponentGroupRef Id="AgentPayload" />
    </Feature>
  </Package>
</Wix>
