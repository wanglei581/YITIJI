<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="AI Job Print Agent"
    Manufacturer="AI Job Print"
    Version="$(var.ProductVersion)"
    UpgradeCode="8B8F74AC-9B68-44B8-88E7-BEB906221919"
    Scope="perMachine">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer AI Job Print Agent is already installed." />
    <!-- 真机-7（2026-09-28）：已绑定终端升级或修复后，恢复自动启动与失败重启策略，并尽力启动一次。
         绑定标记由 install-production-agent.ps1 在绑定成功后写入；未绑定的新装机保持手动 + 停止。
         只调用系统自带的 sc.exe、参数固定；启动失败不得让安装回滚（ServiceControl Start=install
         在 Windows CI 上实测 1920 → 1603），所以四个动作一律 Return="ignore"。
         开机防护和每日重启由安装脚本注册。完全卸载时删掉这两个计划任务，并把打印服务恢复为自动且在运行。
         大版本升级会卸掉旧产品，但升级后不会重跑安装脚本，所以条件带 NOT UPGRADINGPRODUCTCODE，升级时不撤防护。
         任务不存在、服务已在运行时 schtasks/sc 都会返回非 0，这四个动作同样 Return="ignore"。 -->
    <Property Id="AGENTBOUND" Secure="yes">
      <RegistrySearch Id="AgentBoundMarkerSearch" Root="HKLM" Key="SOFTWARE\AIJobPrint\Agent" Name="Bound" Type="raw" Bitness="always64" />
    </Property>

    <CustomAction Id="AgentServiceRestoreAutoStart" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]sc.exe&quot; config aijobprintagent.exe start= auto" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="AgentServiceRestoreRecovery" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]sc.exe&quot; failure aijobprintagent.exe reset= 86400 actions= restart/60000/restart/300000/restart/1800000" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="AgentServiceRestoreFailureFlag" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]sc.exe&quot; failureflag aijobprintagent.exe 1" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="AgentServiceBestEffortStart" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]sc.exe&quot; start aijobprintagent.exe" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoveBootSpoolGuardTask" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Delete /TN &quot;AIJobPrintBootSpoolGuard&quot; /F" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoveDailyRebootTask" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Delete /TN &quot;AIJobPrintDailyReboot&quot; /F" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RestoreSpoolerAutomatic" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]sc.exe&quot; config Spooler start= auto" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="StartSpoolerService" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]sc.exe&quot; start Spooler" Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="AgentServiceRestoreAutoStart" After="StartServices" Condition="AGENTBOUND = &quot;#1&quot; AND NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="AgentServiceRestoreRecovery" After="AgentServiceRestoreAutoStart" Condition="AGENTBOUND = &quot;#1&quot; AND NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="AgentServiceRestoreFailureFlag" After="AgentServiceRestoreRecovery" Condition="AGENTBOUND = &quot;#1&quot; AND NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="AgentServiceBestEffortStart" After="AgentServiceRestoreFailureFlag" Condition="AGENTBOUND = &quot;#1&quot; AND NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="RemoveBootSpoolGuardTask" After="StopServices" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveDailyRebootTask" After="RemoveBootSpoolGuardTask" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RestoreSpoolerAutomatic" After="RemoveDailyRebootTask" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="StartSpoolerService" After="RestoreSpoolerAutomatic" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AIJobPrintAgent">
        <Directory Id="BOOTSTRAPDIR" Name="bootstrap">
          <Component Id="AgentServiceComponent" Guid="4BB83A61-04C6-473E-B528-A20F2D0DE494" Bitness="always64">
            <File Id="AgentServiceExecutable" Source="$(var.StagingRoot)\bootstrap\aijobprintagent.exe" KeyPath="yes" Checksum="yes" />
            <File Id="AgentServiceConfiguration" Source="$(var.StagingRoot)\bootstrap\aijobprintagent.xml" Checksum="yes" />
            <ServiceInstall
              Id="AgentServiceInstall"
              Name="aijobprintagent.exe"
              DisplayName="AIJobPrintAgent"
              Description="AI Job Print Terminal Agent"
              Type="ownProcess"
              Start="demand"
              ErrorControl="normal"
              Account="LocalSystem" />
            <ServiceControl
              Id="AgentServiceControl"
              Name="aijobprintagent.exe"
              Stop="both"
              Remove="uninstall"
              Wait="yes" />
          </Component>
        </Directory>
        <Directory Id="PROVISIONDIR" Name="provision">
          <Component Id="ProvisioningWizardComponent" Guid="EAE4A871-94BE-4A31-BEA4-7ACFB4FA77E8" Bitness="always64">
            <File Id="ProvisionLauncher" Source="$(var.StagingRoot)\provision\provision-terminal.cmd" Checksum="yes" />
            <File Id="ProvisionWizard" Source="$(var.StagingRoot)\provision\provision-installed-agent.ps1" Checksum="yes" />
            <File Id="ProvisionProductionScript" Source="$(var.StagingRoot)\provision\install-production-agent.ps1" Checksum="yes" />
            <File Id="ProvisionServiceIdentity" Source="$(var.StagingRoot)\provision\service-identity.ps1" Checksum="yes" />
            <File Id="ControlCenterScript" Source="$(var.StagingRoot)\provision\terminal-control-center.ps1" Checksum="yes" />
            <File Id="BootSpoolGuardScript" Source="$(var.StagingRoot)\provision\boot-spool-guard.ps1" Checksum="yes" />
            <File Id="BootSpoolGuardTaskScript" Source="$(var.StagingRoot)\provision\boot-spool-guard-task.ps1" Checksum="yes" />
            <File Id="DailyRebootScript" Source="$(var.StagingRoot)\provision\daily-reboot.ps1" Checksum="yes" />
            <File Id="DailyRebootTaskScript" Source="$(var.StagingRoot)\provision\daily-reboot-task.ps1" Checksum="yes" />
            <File Id="ControlCenterLauncher" Source="$(var.StagingRoot)\provision\launch-control-center.vbs" KeyPath="yes" Checksum="yes" />
            <Shortcut
              Id="ControlCenterStartMenuShortcut"
              Directory="AgentProgramMenuFolder"
              Name="终端控制中心"
              Description="绑定、配置并维护 AI 求职打印服务终端"
              Target="[#ControlCenterLauncher]"
              WorkingDirectory="PROVISIONDIR" />
            <Shortcut
              Id="ControlCenterDesktopShortcut"
              Directory="DesktopFolder"
              Name="AI 求职打印服务终端"
              Description="打开 AI 求职打印服务终端控制中心"
              Advertise="yes"
              WorkingDirectory="PROVISIONDIR" />
            <RemoveFolder Id="RemoveProvisioningProgramMenuFolder" Directory="AgentProgramMenuFolder" On="uninstall" />
          </Component>
        </Directory>
        <Directory Id="KIOSKDIR" Name="kiosk">
          <!-- Kiosk browser launcher + watchdog. Files only: the logon task is
               registered by the elevated provisioning flow, never by the MSI. -->
          <Component Id="KioskWatchdogComponent" Guid="3C2E5F84-7B1D-4C0A-9E52-6A1F0D9B7E21" Bitness="always64">
            <File Id="KioskWatchdogScript" Source="$(var.StagingRoot)\kiosk\kiosk-watchdog.ps1" KeyPath="yes" Checksum="yes" />
            <File Id="KioskWatchdogRegister" Source="$(var.StagingRoot)\kiosk\register-kiosk-watchdog.ps1" Checksum="yes" />
            <File Id="KioskLauncher" Source="$(var.StagingRoot)\kiosk\launch-kiosk.cmd" Checksum="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AGENTSTATEDIR" Name="AIJobPrintAgent">
        <Component Id="AgentStateDirectoryComponent" Guid="B5AEAB48-0EB6-496C-909E-B1F9E04EDE53" Permanent="yes" NeverOverwrite="yes" Bitness="always64">
          <CreateFolder />
          <RegistryValue Root="HKLM" Key="Software\AIJobPrint\Agent" Name="StateDirectoryCreated" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
      <Directory Id="CommonMicrosoftFolder" Name="Microsoft">
        <Directory Id="CommonWindowsFolder" Name="Windows">
          <Directory Id="CommonStartMenuFolder" Name="Start Menu">
            <Directory Id="CommonStartMenuProgramsFolder" Name="Programs">
              <Directory Id="AgentProgramMenuFolder" Name="AI Job Print Terminal">
                <Component Id="AgentPanelShortcutComponent" Guid="E565227D-70C5-4C17-A63E-2322DA18C0E4" Bitness="always64">
                  <File Id="AgentPanelInternetShortcut" Source="$(var.InstallerSourceRoot)\assets\AI Job Print Terminal.url" KeyPath="yes" />
                  <RemoveFolder Id="RemoveAgentProgramMenuFolder" On="uninstall" />
                </Component>
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="AI Job Print Agent" Level="1">
      <ComponentRef Id="AgentServiceComponent" />
      <ComponentRef Id="AgentStateDirectoryComponent" />
      <ComponentRef Id="AgentPanelShortcutComponent" />
      <ComponentRef Id="ProvisioningWizardComponent" />
      <ComponentRef Id="KioskWatchdogComponent" />
      <ComponentGroupRef Id="AgentPayload" />
    </Feature>
  </Package>
</Wix>
